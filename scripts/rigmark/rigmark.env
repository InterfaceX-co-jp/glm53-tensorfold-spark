# RigMark pins for the vLLM-kit vs TensorFold sweep (docs/RIGMARK.md). Sourced by scripts/rigmark/*.sh.
# A caller export wins over each line (e.g. COMPARISON_ID=... scripts/rigmark/run.sh tensorfold).

# github.com/alexellis/rigmark, MIT. Pinned: `rigmark compare` refuses receipts from different benchmark revisions,
# so both runs of one sweep must use this exact, clean checkout. Protocol 1.1.0, prompts 1.0.0.
RIGMARK_URL="${RIGMARK_URL:-https://github.com/alexellis/rigmark}"
RIGMARK_REV="${RIGMARK_REV:-c5a0db01b0542ac291883ab049b6141efae0c7d3}"

# One ID for both engines of a sweep (byte-identical prompts); a new ID for the next sweep, so neither the vLLM prefix
# cache nor TensorFold's NVMe session store (/sessions survives restarts) can replay an earlier sweep's "cold" prompts.
COMPARISON_ID="${COMPARISON_ID:-2026-09-glm53-exl3-2xspark-vllm-vs-tensorfold-v1}"

# The request body every published GLM-5.3 RigMark receipt uses (alexellis/rigmark results/reference/glm53-*.json):
# thinking stays on (both templates default to it), effort Low. Overrides the vLLM kit's server default (max) and
# TensorFold's (high), so both engines render byte-identical prompts. Do not change it within a sweep.
[ -n "${EXTRA_BODY:-}" ] || EXTRA_BODY='{"chat_template_kwargs":{"reasoning_effort":"low"}}'

# Standard suite = rigmark's defaults; run.sh passes no --runs / --decode-tokens / --prefill-* / --concurrency* flags.
# SKIP_PREFILL: auto (skip only when preflight finds no /tokenize or no token-id /v1/completions) | 0 | 1
SKIP_PREFILL="${SKIP_PREFILL:-auto}"

# Labels (appear on the card and in the compare table)
LABEL_VLLM="${LABEL_VLLM:-glm53-flash-exl3-vllm-kit-tp2-low}"
LABEL_TENSORFOLD="${LABEL_TENSORFOLD:-glm53-flash-exl3-tensorfold-tp2-low}"

# Where results go (relative to the repo root)
OUT_ROOT="${OUT_ROOT:-results/rigmark}"
