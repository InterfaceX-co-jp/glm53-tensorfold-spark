diff --git c/src/tensorfold/families/glm5_next/cuda/batchplan.py i/src/tensorfold/families/glm5_next/cuda/batchplan.py
new file mode 100644
index 0000000..4ec490f
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/batchplan.py
@@ -0,0 +1,249 @@
+"""Host-side scheduling for GLM53_TF_BATCH rounds (patches/0120, ``batch.py``). Pure Python, no torch: the unit
+tests run anywhere.
+
+Rank 0 decides everything that depends on the outside world (clients, clocks, free memory) and ships it to rank 1
+as one int list before every round (``encode_plan`` / ``parse_plan``):
+
+    [n_cancel, slot..., n_admit, (slot, resume length, header length, header...)..., n_piece, slot...]
+
+- cancels: slots whose request ends now (the client went away, or a background request steps aside);
+- admits: queued requests placed in free slots, each with its request header (``encode_header``: sampling, stop,
+  max tokens, rank 0's cost-depth flag, its ``tf_knobs`` block and policy code, all resolved on rank 0);
+- pieces: slots that prefill their next piece of prompt this round (at most one; ``Fairness``).
+
+Everything else in a round (piece bounds, drafts, windows, sampling, keeps, when a request ends, the round's model
+cost for batch-aware depths) is a function of shared inputs, computed alike on both ranks.
+"""
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+from typing import Sequence
+
+from . import knobs as knobs_mod
+
+HEADER_FIXED = 12            # ints before the knob block: see ``encode_header``
+
+
+# -- request headers ---------------------------------------------------------------------------------------------
+def f64_ints(x: float) -> list[int]:
+    return list(struct.unpack("<2i", struct.pack("<d", float(x))))
+
+
+def ints_f64(lo: int, hi: int) -> float:
+    return struct.unpack("<d", struct.pack("<2i", int(lo), int(hi)))[0]
+
+
+@dataclass
+class Header:
+    """What rank 1 needs of a request (besides its prompt)."""
+
+    max_tokens: int
+    stop_eos: bool
+    draft: bool
+    seed: int                  # 0 with temperature 0
+    temperature: float
+    top_k: int
+    top_p: float
+    cost: int                  # patches/0071: rank 0's cost-depth flag
+    values: dict               # patches/0090: every knob in ``knobs.HEADER``
+    code: list                 # the policy code (lookup settings included)
+
+
+def encode_header(h: Header) -> list[int]:
+    seed = int(h.seed) & 0xFFFFFFFFFFFFFFFF
+    out = [int(h.max_tokens), int(bool(h.stop_eos)), int(bool(h.draft)), seed & 0x7FFFFFFF, (seed >> 31) & 0x7FFFFFFF,
+           seed >> 62, *f64_ints(h.temperature), int(h.top_k), *f64_ints(h.top_p), int(h.cost)]
+    assert len(out) == HEADER_FIXED
+    return out + knobs_mod.encode(h.values) + [int(c) for c in h.code]
+
+
+def decode_header(ints: Sequence[int]) -> Header:
+    ints = [int(v) for v in ints]
+    max_tokens, stop_eos, draft, s_lo, s_hi, s_top, t_lo, t_hi, top_k, p_lo, p_hi, cost = ints[:HEADER_FIXED]
+    values, code = knobs_mod.decode(ints[HEADER_FIXED:])
+    seed = (s_top << 62) | (s_hi << 31) | s_lo
+    return Header(max_tokens, bool(stop_eos), bool(draft), seed, ints_f64(t_lo, t_hi), top_k, ints_f64(p_lo, p_hi),
+                  cost, values, code)
+
+
+# -- round plans -------------------------------------------------------------------------------------------------
+def encode_plan(cancels: Sequence[int], admits: Sequence[tuple[int, int, Sequence[int]]],
+                pieces: Sequence[int]) -> list[int]:
+    plan = [len(cancels), *cancels, len(admits)]
+    for slot, cached, header in admits:
+        plan += [int(slot), int(cached), len(header), *header]
+    return plan + [len(pieces), *pieces]
+
+
+def parse_plan(plan: Sequence[int]) -> tuple[list[int], list[tuple[int, int, list[int]]], list[int]]:
+    plan = [int(v) for v in plan]
+    nc = plan[0]
+    cancels = plan[1:1 + nc]
+    at = 1 + nc
+    na = plan[at]
+    at += 1
+    admits = []
+    for _ in range(na):
+        slot, cached, n = plan[at:at + 3]
+        admits.append((slot, cached, plan[at + 3:at + 3 + n]))
+        at += 3 + n
+    npieces = plan[at]
+    pieces = plan[at + 1:at + 1 + npieces]
+    if at + 1 + npieces != len(plan):
+        raise RuntimeError(f"a round plan of {len(plan)} ints parsed to {at + 1 + npieces}: both ranks must run the "
+                           "same patched TensorFold")
+    return cancels, admits, pieces
+
+
+# -- prefill pieces ---------------------------------------------------------------------------------------------
+def piece_rows(piece: int, grid: int) -> int:
+    """A piece's tokens: ``piece`` (GLM53_TF_BATCH_PIECE), for a fast prefill (grid C > 0) rounded down to a multiple
+    of C and at least C (a fast piece must end on the chunk grid to leave a resumable snapshot)."""
+
+    piece = max(1, int(piece))
+    if grid:
+        return max(grid, piece // grid * grid)
+    return piece
+
+
+def piece_end(done: int, n: int, piece: int, grid: int) -> int:
+    """Where the piece starting at ``done`` of an ``n``-token prompt ends: the prompt's end, or the next piece bound.
+    Fast pieces start on the grid (a grid snapshot or 0), so they end on it too."""
+
+    if grid and done % grid:
+        raise ValueError(f"a fast prefill piece starts at {done}, off the chunk grid {grid}")
+    step = piece_rows(piece, grid)
+    return n if n - done <= step else done + step
+
+
+class Fairness:
+    """Rank 0: when a prefill piece may run while other sequences decode. ``share`` is the part of the time prefill
+    pieces may take (GLM53_TF_BATCH_PREFILL_SHARE, 0 < share <= 1): a piece of t seconds is followed by at least
+    t (1 - share) / share seconds of decode rounds (and at least one round) before the next piece. With nothing
+    decoding, pieces run back to back (one a round, so new arrivals are admitted between them)."""
+
+    def __init__(self, share: float = 0.5) -> None:
+        if not 0.0 < share <= 1.0:
+            raise ValueError(f"GLM53_TF_BATCH_PREFILL_SHARE={share}: expected 0 < share <= 1")
+        self.share = float(share)
+        self.debt = 0.0          # decode seconds owed before the next piece
+        self.rounds = 1          # decode rounds since the last piece
+
+    def allow(self, decoding: bool) -> bool:
+        if not decoding:
+            return True
+        return self.rounds >= 1 and self.debt <= 0.0
+
+    def after(self, piece_s: float, round_s: float, prefilling: bool) -> None:
+        """After a round: its piece's seconds (0 without one) and its decode seconds."""
+
+        if piece_s > 0.0:
+            self.debt = max(self.debt, 0.0) + piece_s * (1.0 - self.share) / self.share
+            self.rounds = 0
+        if round_s > 0.0:
+            self.debt -= round_s
+            self.rounds += 1
+        if not prefilling:
+            self.debt, self.rounds = 0.0, 1
+
+
+def pick_piece(prefilling: Sequence[tuple[int, int, int]]) -> int | None:
+    """The slot whose prompt prefills next, from (slot, tokens left, admission order): the fewest tokens left (a
+    short request behind a long prompt gets its first token soon), ties to the earliest admitted."""
+
+    if not prefilling:
+        return None
+    return min(prefilling, key=lambda p: (p[1], p[2], p[0]))[0]
+
+
+# -- queue and placement -------------------------------------------------------------------------------------------
+def admission_order(background: Sequence[bool]) -> list[int]:
+    """Queue indices in admission order: every foreground request in arrival order, then background ones."""
+
+    return [i for i, b in enumerate(background) if not b] + [i for i, b in enumerate(background) if b]
+
+
+def victim(slots: Sequence[tuple[int, bool, int]], foreground_waiting: bool, free: int) -> int | None:
+    """A running background request that steps aside (its caller receives the same tokens when it runs again from
+    the start), from (slot, background, admitted round): only when a foreground request waits and no slot is free;
+    the most recently admitted one (it has done the least)."""
+
+    if not foreground_waiting or free:
+        return None
+    bg = [(adm, slot) for slot, b, adm in slots if b]
+    return max(bg)[1] if bg else None
+
+
+def is_title_request(messages, tools) -> bool:
+    """A client's session-title request (``tensorfold.server.app.is_title_request``): a short system prompt about a
+    title, no tools, short messages. Runs as a background request."""
+
+    if tools or not messages or not isinstance(messages, list) or not isinstance(messages[0], dict) \
+            or messages[0].get("role") != "system":
+        return False
+    size = sum(len(m.get("content")) if isinstance(m, dict) and isinstance(m.get("content"), str) else 4096
+               for m in messages)
+    text = messages[0].get("content")
+    return size < 4096 and isinstance(text, str) and "title" in text.lower()
+
+
+# -- the round's model cost (batch-aware draft depths) -------------------------------------------------------------
+def verify_ms(table: Sequence[float], rows: int) -> float:
+    """Model ms of a forward of ``rows`` rows from the calibrated window costs (1..len(table) rows), extended past
+    the table along the slope of its upper half (rows of other sequences add experts as extra draft rows do)."""
+
+    table = list(table)
+    n = len(table)
+    if rows <= n:
+        return float(table[max(rows, 1) - 1])
+    half = n // 2
+    slope = (table[-1] - table[half - 1]) / max(n - half, 1) if n >= 2 else 0.0
+    return float(table[-1] + max(slope, 0.0) * (rows - n))
+
+
+class RoundCosts:
+    """Committed tokens and model ms of the recent rounds of all sequences (the same on both ranks: the costs are
+    the load-time table and the tokens are committed ones). ``rate()`` is the aggregate rate a round's rows must beat
+    when more than one sequence shares the rounds (a row of one sequence slows every other one), else None (a
+    request alone keeps its own running rate)."""
+
+    WINDOW = 16
+
+    def __init__(self, costs: dict) -> None:
+        self.costs = costs
+        self.verify = list(costs["verify"])
+        self.rounds: list[tuple[int, float]] = []
+        self.shared = False
+
+    def round_ms(self, parts: Sequence[tuple[str, int, int, int]]) -> float:
+        """parts: per sequence (arm, rows, MTP steps, backlog); "s" serial, "l" lookup, "m" MTP, "f" DFlash2."""
+
+        from .lookup import round_ms
+
+        total = sum(r for _, r, _, _ in parts)
+        ms = verify_ms(self.verify, total)
+        for arm, rows, steps, backlog in parts:
+            if arm in ("m", "f"):
+                ms += round_ms(self.costs, arm, rows, steps, backlog) - round_ms(self.costs, "l", rows, 0, 0)
+        return ms
+
+    def record(self, parts: Sequence[tuple[str, int, int, int]], tokens: int) -> None:
+        self.rounds.append((int(tokens), self.round_ms(parts)))
+        del self.rounds[:-self.WINDOW]
+        self.shared = len(parts) > 1
+
+    def rate(self) -> float | None:
+        if not self.shared or not self.rounds:
+            return None
+        ms = sum(m for _, m in self.rounds)
+        return sum(k for k, _ in self.rounds) / ms if ms > 0 else None
+
+    def table(self, others: int) -> list[float]:
+        """A sequence's window costs when ``others`` rows of other sequences share its forward: row k's marginal ms is
+        the slope of the curve at others + k (only the differences matter to ``depth.best_k``)."""
+
+        if others <= 0:
+            return list(self.verify)
+        return [verify_ms(self.verify, others + k + 1) for k in range(len(self.verify))]
