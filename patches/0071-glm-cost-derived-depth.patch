diff --git i/src/tensorfold/families/glm5_next/cuda/depth.py w/src/tensorfold/families/glm5_next/cuda/depth.py
new file mode 100644
index 0000000..e285806
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/depth.py
@@ -0,0 +1,254 @@
+"""Cost-derived draft depth (patches/0071): each round verifies the number of drafts that pays best, priced with
+the load-time costs, instead of cutting the chain at a fixed probability product (c3:0.35, fcN:0.3) or gating
+lookup drafts on a ratio.
+
+The model. A round that verifies k drafts commits
+
+    E(k) = 1 + q_1 + q_1 q_2 + ... + q_1 ... q_k
+
+tokens on average, where q_j is the chance draft j is kept given drafts 1..j-1 were, and costs
+
+    C(k) = draft ms(k) + verify[k]       (a window of k + 1 rows; ``calib`` / ``GlmEngine._calibrate``)
+
+The drafters' own probabilities of their picks (the numbers cN:P and fcN:P already multiply) are miscalibrated, so
+q_j = clip(p_j x f_j) with f_j a running correction per draft position and drafter: (kept drafts at position j) /
+(sum of the drafter's p over the drafts verified at position j), both decayed each round and seeded with a prior
+of f = 1 (``Calibration``).
+
+The choice. With lambda the request's running rate (committed tokens per model ms over its recent rounds, all
+drafters), the depth maximizes the round's surplus E(k) - lambda C(k): a draft is worth verifying when the tokens
+it adds on average buy more than the time it costs at the rate the request already runs at. At the fixed point
+(lambda = the rate the policy achieves) this is the depth that maximizes the long-run tokens per ms (a renewal
+argument), and unlike maximizing E(k) / C(k) round by round it does not let one cheap round's ratio decide.
+
+- DFlash2 (one block pass proposes up to 7 picks with their probabilities; the pass is paid whatever k is):
+  k = argmax over 1..K of E(k) - lambda verify[k].
+- MTP (a chain: each further draft costs an MTP step): draft j joins the window when q_1..q_j (its marginal
+  expected token) >= lambda x its row's marginal verify ms; the chain runs another step only when the next
+  draft's expected token, P_j x (the next position's running acceptance), pays for the step plus its row.
+- Lookup (patches/0020, gated in ``auto``): the band's running acceptance p for every position, k as for DFlash2
+  with the drafters' catch-up of the committed rows, and the round is a lookup round only when its best surplus is
+  positive at the request's rate.
+
+The first draft of an MTP or DFlash2 round is always verified (as upstream: the drafter already ran).
+
+Rank consistency. Every input is the same on both ranks: the probabilities come from all-gathered candidates
+(the values cN:P / fcN:P already branch on), the kept counts from committed tokens, the costs from the request's
+table (the slower rank's at load, or rank 0's frozen table in the header with patches/0070), and the arithmetic
+is the same Python float operations in the same order. Nothing here reads a clock. Drafts only propose: the
+window, keyed sampler and commit decide every token, so replies equal serial decoding whatever k is.
+
+No torch here: the unit tests run anywhere.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Sequence
+
+MAX_DRAFTS = 7            # a verify window holds the pending token and up to 7 drafts
+PRIOR = 2.0               # the correction's prior weight (in units of summed probability)
+DECAY = 0.97              # evidence at a position fades by this each round that verifies it
+AHEAD_PRIOR = 0.8         # an unseen position's acceptance before evidence: optimistic, so the chain explores it
+AHEAD_WEIGHT = 2.0        # (a position the chain rarely reaches keeps being tried until its evidence says no)
+RATE_WINDOW = 16          # rounds in the running rate
+F_MIN, F_MAX = 0.2, 3.0   # the correction factor's range
+Q_MAX = 0.995             # a calibrated probability never reaches 1 (a draft can always be rejected)
+
+
+def env_cost() -> bool:
+    """GLM53_TF_DEPTH: ``cost`` makes plain ``auto`` choose depths here; anything else (default ``threshold``)
+    keeps upstream's thresholds. Read on rank 0 only: the choice travels in the request header."""
+
+    v = os.environ.get("GLM53_TF_DEPTH", "threshold").strip().lower() or "threshold"
+    if v not in ("cost", "threshold"):
+        raise ValueError(f"GLM53_TF_DEPTH={v!r}: expected cost or threshold")
+    return v == "cost"
+
+
+# -- the depth arithmetic -----------------------------------------------------------------------------------------
+def expected_tokens(qs: Sequence[float]) -> list[float]:
+    """[E(0), E(1), ..., E(len(qs))]: tokens a round verifying k drafts commits on average."""
+
+    out, run, e = [1.0], 1.0, 1.0
+    for q in qs:
+        run *= q
+        e += run
+        out.append(e)
+    return out
+
+
+def best_k(qs: Sequence[float], verify: Sequence[float], rate: float, *, fixed_ms: float = 0.0,
+           row_ms: float = 0.0, least: int = 1) -> tuple[int, float]:
+    """(k, surplus): the k from ``least`` to len(qs) (bounded by the window table) maximizing
+    E(k) - rate x (fixed_ms + verify[k] + row_ms x E(k)); ``row_ms``: the catch-up each committed row costs later.
+    Ties go to the smaller k. (0, -inf) when no k is allowed."""
+
+    es = expected_tokens(qs)
+    top = min(len(qs), len(verify) - 1)
+    best, best_s = 0, float("-inf")
+    for k in range(max(least, 0), top + 1):
+        s = es[k] - rate * (fixed_ms + verify[k] + row_ms * es[k])
+        if s > best_s + 1e-12:
+            best, best_s = k, s
+    return best, best_s
+
+
+class Calibration:
+    """Per drafter and draft position: decayed kept drafts, summed drafter probabilities and trials."""
+
+    def __init__(self, positions: int = MAX_DRAFTS) -> None:
+        self.kept = {a: [0.0] * positions for a in "mf"}
+        self.prob = {a: [0.0] * positions for a in "mf"}
+        self.tried = {a: [0.0] * positions for a in "mf"}
+
+    def factor(self, arm: str, j: int) -> float:
+        j = min(j, len(self.kept[arm]) - 1)
+        f = (self.kept[arm][j] + PRIOR) / (self.prob[arm][j] + PRIOR)
+        return min(max(f, F_MIN), F_MAX)
+
+    def q(self, arm: str, j: int, p: float) -> float:
+        """Draft j's (0-based) chance to be kept given the ones before it were, from the drafter's probability."""
+
+        return min(max(float(p), 0.0) * self.factor(arm, j), Q_MAX)
+
+    def ahead(self, arm: str, j: int) -> float:
+        """The running acceptance at position j, before its draft exists (the MTP chain's look-ahead)."""
+
+        j = min(j, len(self.kept[arm]) - 1)
+        return min((self.kept[arm][j] + AHEAD_PRIOR * AHEAD_WEIGHT) / (self.tried[arm][j] + AHEAD_WEIGHT), Q_MAX)
+
+    def record(self, arm: str, probs: Sequence[float], keep: int) -> None:
+        """A verified round: ``probs`` its drafts' own probabilities, ``keep`` the rows committed (1 + drafts
+        kept). Draft j was reached when j < keep and kept when j < keep - 1."""
+
+        for j, p in enumerate(probs[:len(self.kept[arm])]):
+            if j >= keep:
+                break
+            self.kept[arm][j] = self.kept[arm][j] * DECAY + (1.0 if j < keep - 1 else 0.0)
+            self.prob[arm][j] = self.prob[arm][j] * DECAY + max(float(p), 0.0)
+            self.tried[arm][j] = self.tried[arm][j] * DECAY + 1.0
+
+
+def _round_ms(costs: dict, arm: str, rows: int, steps: int, backlog: int) -> float:
+    from .lookup import round_ms
+
+    return round_ms(costs, arm, rows, steps, backlog)
+
+
+class DepthOptimizer:
+    """A request's depth choices (``decode.auto_decode``, through ``decode.draft`` and the DFlash2 branch, and the
+    lookup gate). A function of the request's costs, the drafters' probabilities and the committed tokens."""
+
+    def __init__(self, costs: dict, *, most_m: int = MAX_DRAFTS, most_f: int = MAX_DRAFTS) -> None:
+        self.costs = costs
+        self.verify = list(costs["verify"])
+        self.most_m = max(1, min(int(most_m), len(self.verify) - 1))
+        self.most_f = max(1, min(int(most_f), len(self.verify) - 1))
+        self.cal = Calibration()
+        self.rounds: list[tuple[int, float]] = []     # (tokens committed, model ms) of recent rounds
+        self.used: list[float] = []                   # the drafter probabilities of this round's drafts
+        self._chain = 1.0
+        self._rate = self.rate()
+
+    # the running rate lambda
+    def rate(self) -> float:
+        if self.rounds:
+            return sum(k for k, _ in self.rounds) / sum(ms for _, ms in self.rounds)
+        c = self.costs
+        first = c.get("mtp", 0.0) or c.get("block", 0.0)
+        return 2.0 / (self.verify[min(1, len(self.verify) - 1)] + first)
+
+    def _dv(self, j: int) -> float:
+        """The marginal verify ms of draft j (1-based): window of j + 1 rows against j rows."""
+
+        j = min(j, len(self.verify) - 1)
+        return self.verify[j] - self.verify[j - 1]
+
+    # MTP: decided draft by draft inside ``decode.draft``
+    def mtp_begin(self) -> None:
+        self.used = []
+        self._chain = 1.0
+        self._rate = self.rate()
+
+    def mtp_next(self, j: int, p: float, count: int) -> tuple[bool, bool]:
+        """Draft j (0-based) was sampled with probability ``p``: (verify it, run the MTP step for draft j + 1)."""
+
+        q = self.cal.q("m", j, p)
+        chain = self._chain * q
+        lam = self._rate
+        take = j == 0 or chain >= lam * self._dv(j + 1)
+        if not take:
+            return False, False
+        self._chain = chain
+        self.used.append(float(p))
+        if j + 1 >= count or j + 2 > len(self.verify) - 1:
+            return True, False
+        # the next draft's chance: its position's running acceptance, pulled toward this draft's (drafter
+        # confidence runs in streaks: a sure draft is usually followed by a sure one)
+        gain = chain * 0.5 * (self.cal.ahead("m", j + 1) + q)
+        return True, gain >= lam * (self.costs.get("mtp_step", 0.0) + self._dv(j + 2))
+
+    # DFlash2: one block, all picks known
+    def f_depth(self, probs: Sequence[float]) -> int:
+        qs = [self.cal.q("f", j, p) for j, p in enumerate(probs[:self.most_f])]
+        k, _ = best_k(qs, self.verify, self.rate(), least=1)
+        k = max(1, min(k, len(probs)))
+        self.used = [float(p) for p in probs[:k]]
+        return k
+
+    # lookup: a band's running acceptance p for every draft
+    def lookup_depth(self, p: float, most: int, row_ms: float) -> tuple[int, float]:
+        return best_k([min(max(p, 0.0), Q_MAX)] * most, self.verify, self.rate(), row_ms=row_ms, least=1)
+
+    def record(self, arm: str, rows: int, steps: int, backlog: int, keep: int) -> None:
+        """After a verified round of any drafter: the calibration (MTP, DFlash2) and the running rate."""
+
+        if arm in ("m", "f"):
+            self.cal.record(arm, self.used, keep)
+        self.used = []
+        self.rounds.append((keep, _round_ms(self.costs, arm, rows, steps, backlog)))
+        del self.rounds[:-RATE_WINDOW]
+
+
+class Always:
+    """A ``decode.DrafterChoice`` stand-in that always picks one drafter (``om`` / ``of``)."""
+
+    def __init__(self, arm: str) -> None:
+        self.arm = arm
+
+    def pick(self) -> str:
+        return self.arm
+
+    def record(self, *args) -> None:
+        pass
+
+
+# -- policy specs ---------------------------------------------------------------------------------------------------
+OPT_KIND = 6              # [6, most drafts, drafter (0 MTP, 1 DFlash2), 0]
+
+
+def parse_policy(spec: str) -> list[int] | None:
+    """``om[N]`` / ``of[N]`` -> [OPT_KIND, N, 0 or 1, 0] (N from 1 to 7, default 7); ``o`` is ``auto`` with cost
+    depths (``engine.encode_policy``). None for other specs."""
+
+    spec = str(spec).strip()
+    if spec[:2] not in ("om", "of"):
+        return None
+    rest = spec[2:]
+    try:
+        most = int(rest) if rest else MAX_DRAFTS
+    except ValueError:
+        most = -1
+    if not 1 <= most <= MAX_DRAFTS:
+        raise ValueError(f"draft policy {spec!r}: expected o, om[N] or of[N] (N from 1 to {MAX_DRAFTS})")
+    return [OPT_KIND, most, int(spec[1] == "f"), 0]
+
+
+def as_cost(code: list[int]) -> list[int]:
+    """The cost-depth version of a code ``o`` resolved to: auto codes stay (the header's flag marks them); a fixed
+    drafter code (``engine._effective`` maps ``auto`` to DFlash2 on some checkpoints) becomes ``of`` / ``om``."""
+
+    if code[0] in (4, 5, OPT_KIND) or code[0] == 0:
+        return list(code)
+    return [OPT_KIND, max(1, min(int(code[1]), MAX_DRAFTS)), int(code[0] // 10 == 1), 0]
