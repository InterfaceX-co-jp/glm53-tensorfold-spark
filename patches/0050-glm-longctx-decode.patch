+# lower index), and a row with more than 512 pools never reaches them: its top 512 (and so its tokens) are the
+# same. ``pool_bucket`` rounds that bound up to a power of two (at least 1024 pools, at most the capacity's), so a
+# CUDA graph captured for a bucket serves every position in it.
+
+MIN_BUCKET = 1024
+
+
+def pool_bucket(end: int, cap_pools: int) -> int:
+    """Pools to score for rows ending at position ``end - 1`` (max npool = end // 4): a power of two >= 1024,
+    capped at the cache's ``cap_pools``."""
+
+    need = end // POOL
+    if need > cap_pools:
+        raise ValueError(f"pool_bucket: {need} pools past the cache's {cap_pools}")
+    b = MIN_BUCKET
+    while b < need:
+        b *= 2
+    return min(b, cap_pools)
+
+
+@triton.jit
+def _keys(S, K, NP, BLOCK: tl.constexpr):
+    """Program (r, block): a unique int64 key per score, ordered as the stable descending sort orders them:
+    (score, then the lower pool) -> larger key. -0.0 ranks as +0.0 (they compare equal) and NaN above +inf."""
+
+    r = tl.program_id(0).to(tl.int64)
+    p = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    ok = p < NP
+    s = tl.load(S + r * NP + p, mask=ok, other=float("-inf"))
+    b = s.to(tl.int32, bitcast=True)
+    b = tl.where(s == 0.0, 0, b)
+    b = tl.where(s != s, 0x7FC00000, b)
+    b = tl.where(b < 0, b ^ 0x7FFFFFFF, b)            # sign-magnitude -> two's-complement order
+    key = (b.to(tl.int64) << 32) + (0x7FFFFFFF - p).to(tl.int64)
+    tl.store(K + r * NP + p, key, mask=ok)
+
+
+@triton.jit
+def _expand(POOLS, TOK, CNT, POS, W: tl.constexpr, K: tl.constexpr, PL: tl.constexpr):
+    """Program r: the row's tokens from its ascending pools and its position (read on the device), as
+    ``select_tokens`` lists them: 4 tokens a pool, then the visible tokens of the incomplete last pool, -1 after;
+    a dense row (at most K complete pools) gets count 0 and no tokens."""
+
+    r = tl.program_id(0)
+    q = tl.load(POS) + r
+    npool = (q + 1) // PL
+    sp = npool > K
+    j = tl.arange(0, K * PL)
+    pool = tl.load(POOLS + r * K + j // PL).to(tl.int32)
+    tok = tl.where(sp, pool * PL + j % PL, -1)
+    tl.store(TOK + r * W + j, tok)
+    lane = tl.arange(0, PL)
+    tail_len = q + 1 - npool * PL
+    tail = tl.where(sp & (lane < tail_len), npool * PL + lane, -1)
+    tl.store(TOK + r * W + K * PL + lane, tail, mask=lane < PL - 1)
+    tl.store(CNT + r, tl.where(sp, K * PL + tail_len, 0))
+
+
+class LongScratch:
+    """Preallocated buffers of the capturable selection and sparse attention for windows of up to ``rows`` rows
+    and a cache of ``capacity`` tokens (scores and keys for every pool the cache holds)."""
+
+    def __init__(self, rows: int, capacity: int, heads: int, dim: int, device) -> None:
+        self.rows = rows
+        self.cap_pools = capacity // POOL
+        n = rows * self.cap_pools
+        width = TOPK_POOLS * POOL + POOL - 1
+        self.scores = torch.empty((n,), dtype=torch.float32, device=device)
+        self.keys = torch.empty((n,), dtype=torch.int64, device=device)
+        self.top_v = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.top_i = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.pools = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.perm = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.tokens = torch.empty((rows, width), dtype=torch.int32, device=device)
+        self.counts = torch.empty((rows,), dtype=torch.int32, device=device)
+        nch = triton.cdiv(width, 512)
+        self.po = torch.empty((nch * rows * heads * dim,), dtype=torch.float32, device=device)
+        self.pm = torch.empty((nch * rows * heads,), dtype=torch.float32, device=device)
+        self.pl = torch.empty((nch * rows * heads,), dtype=torch.float32, device=device)
+
+    def part(self, R: int, H: int, D: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        nch = triton.cdiv(self.tokens.shape[1], 512)
+        return self.po[:nch * R * H * D], self.pm[:nch * R * H], self.pl[:nch * R * H]
+
+
+def select_tokens_dev(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, pos_dev: torch.Tensor, R: int,
+                      np_: int, sc: LongScratch) -> tuple[torch.Tensor, torch.Tensor]:
+    """``select_tokens`` with the position read on the device, scoring ``np_`` pools (>= every row's npool and
+    >= 512), into ``sc``'s buffers: no host value, allocation or sync, so a CUDA graph can hold it. The same
+    scores (the same kernel), and the same top 512: keys are unique and ordered as the stable descending sort
+    orders the scores, so ``torch.topk`` over them returns exactly that set, whatever its algorithm and order;
+    the set is then sorted ascending, as ``select_tokens`` lists it."""
+
+    if R > sc.rows or not TOPK_POOLS <= np_ <= sc.cap_pools:
+        raise ValueError(f"select_tokens_dev: {R} rows / {np_} pools outside the scratch ({sc.rows} / {sc.cap_pools})")
+    if qi.stride(0) != qi.shape[1] or wts.stride(1) != 1:
+        raise ValueError("select_tokens: index queries must be contiguous rows, weights unit-stride columns")
+    scores = sc.scores[:R * np_].view(R, np_)
+    _scores[(R, triton.cdiv(np_, 64))](qi, wts, wts.stride(0), pk, scores, pos_dev, R, np_, 128 ** -0.5, BP=64,
+                                      num_warps=4, **_heads(qi, wts))
+    keys = sc.keys[:R * np_].view(R, np_)
+    _keys[(R, triton.cdiv(np_, 1024))](scores, keys, np_, BLOCK=1024, num_warps=4)
+    torch.topk(keys, TOPK_POOLS, dim=1, largest=True, sorted=False, out=(sc.top_v[:R], sc.top_i[:R]))
+    torch.sort(sc.top_i[:R], dim=1, out=(sc.pools[:R], sc.perm[:R]))
+    tokens, counts = sc.tokens[:R], sc.counts[:R]
+    _expand[(R,)](sc.pools, tokens, counts, pos_dev, W=tokens.shape[1], K=TOPK_POOLS, PL=POOL, num_warps=4)
+    return tokens, counts
+
