diff --git a/src/tensorfold/families/glm5_next/cuda/decode_overlap.py b/src/tensorfold/families/glm5_next/cuda/decode_overlap.py
new file mode 100644
index 0000000..f947748
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/decode_overlap.py
@@ -0,0 +1,200 @@
+"""patches/0370 (N1b): host work off the decode round's critical path (GLM53_TF_DECODE_OVERLAP, off by default).
+
+A decode round's GPU work waits for host work in three places that do not need to be there (docs/DECODE-OVERLAP.md):
+
+- ``sync``: the explicit ``torch.cuda.synchronize()`` after the verify forward (``Batcher._verify``; ``auto_decode`` /
+  ``mtp_decode`` / ``dflash_decode`` / ``serial_decode``). The sampler's readback synchronizes anyway; the explicit
+  one only made the host wait before launching the sampler's top-k and all-gather, and timed the forward for 0070's
+  online calibration, which now reads two CUDA events instead.
+- ``emit``: rank 0 hands a round's tokens to the HTTP threads after the NEXT round's verify forward has been
+  launched (batch mode), so their detokenizing / SSE work holds the GIL while the host waits for the GPU instead of
+  while it drafts; a request's last tokens go out when it ends. Without batching, a request's tokens go to an
+  emitter thread (``Emitter``) instead of running the HTTP callback inside the decode loop.
+- ``plan``: in a round where every slot decodes and nothing waits (no queue, no prompt prefilling), rank 0 decides
+  the NEXT round's plan (its cancels) while this round's verify forward runs and sends it inside the sampler's
+  all-gather, which both ranks make anyway (``rider_*``): no plan share at the top of the next round (two to four
+  NCCL all-gathers, each with a host synchronization). Any other round plans as before. Both ranks must agree
+  (checked at load).
+- ``gil``: the interpreter's thread switch interval ``GLM53_TF_SWITCH_US`` (default 500 us instead of Python's 5 ms),
+  so the round loop gets the GIL back from an HTTP thread sooner when its GPU wait ends.
+
+``1`` = all four; a comma list picks some (``sync,plan``). Scheduling only: the same kernels on the same inputs, the
+same collectives in the same order on both ranks, so replies are unchanged (drafted == serial, batched == alone).
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+import queue
+import sys
+import threading
+from dataclasses import dataclass
+from typing import Any, Callable, Sequence
+
+PARTS = ("sync", "emit", "plan", "gil")
+
+
+@dataclass(frozen=True)
+class Overlap:
+    sync: bool = False
+    emit: bool = False
+    plan: bool = False
+    gil: bool = False
+    switch_us: int = 500
+
+    @property
+    def on(self) -> bool:
+        return self.sync or self.emit or self.plan or self.gil
+
+    def code(self) -> int:
+        return sum(1 << i for i, p in enumerate(PARTS) if getattr(self, p))
+
+    def describe(self) -> str:
+        return ",".join(p for p in PARTS if getattr(self, p)) or "off"
+
+
+def parse(spec: str | None, switch_us: str | None = None) -> Overlap:
+    """GLM53_TF_DECODE_OVERLAP: ``0`` / empty (off), ``1`` (all), or a comma list of ``sync``, ``emit``, ``plan``,
+    ``gil``; GLM53_TF_SWITCH_US: the switch interval with ``gil`` (100..5000 us)."""
+
+    s = str(spec or "").strip().lower()
+    if s in ("", "0", "off", "false", "no"):
+        parts: set[str] = set()
+    elif s in ("1", "on", "true", "yes", "all"):
+        parts = set(PARTS)
+    else:
+        parts = {p.strip() for p in s.replace(";", ",").split(",") if p.strip()}
+        bad = parts - set(PARTS)
+        if bad:
+            raise ValueError(f"GLM53_TF_DECODE_OVERLAP={spec!r}: unknown part(s) {sorted(bad)}; expected 0, 1 or a "
+                             f"comma list of {', '.join(PARTS)}")
+    us = str(switch_us or "").strip()
+    try:
+        us_i = int(us) if us else 500
+    except ValueError:
+        raise ValueError(f"GLM53_TF_SWITCH_US={switch_us!r}: expected microseconds (100..5000)") from None
+    if not 100 <= us_i <= 5000:
+        raise ValueError(f"GLM53_TF_SWITCH_US={us_i}: expected 100..5000 microseconds")
+    return Overlap(**{p: p in parts for p in PARTS}, switch_us=us_i)
+
+
+@functools.lru_cache(maxsize=1)
+def env() -> Overlap:
+    """The process's setting (read once; tests call ``env.cache_clear()``)."""
+
+    return parse(os.environ.get("GLM53_TF_DECODE_OVERLAP"), os.environ.get("GLM53_TF_SWITCH_US"))
+
+
+_GIL_SET = False
+
+
+def apply_gil(ov: Overlap | None = None) -> None:
+    """``gil``: set the interpreter's switch interval once a process (both ranks; idempotent)."""
+
+    global _GIL_SET
+    ov = env() if ov is None else ov
+    if ov.gil and not _GIL_SET:
+        sys.setswitchinterval(ov.switch_us / 1e6)
+        _GIL_SET = True
+
+
+# -- emit (without batching): the HTTP callback on its own thread ----------------------------------------------------
+class Emitter:
+    """``on_tokens`` run on a thread of its own, in order: the decode loop only queues the token lists. ``close``
+    delivers everything still queued, joins, and raises the first exception the callback raised (the loop decoded on
+    meanwhile: without batching a request's decode never listened to the callback's answer)."""
+
+    def __init__(self, fn: Callable[[list[int]], Any], name: str = "tf-emit") -> None:
+        self.fn = fn
+        self.q: queue.SimpleQueue = queue.SimpleQueue()
+        self.error: BaseException | None = None
+        self.thread = threading.Thread(target=self._run, name=name, daemon=True)
+        self.thread.start()
+
+    def _run(self) -> None:
+        while True:
+            item = self.q.get()
+            if item is None:
+                return
+            if self.error is not None:
+                continue
+            try:
+                self.fn(item)
+            except BaseException as exc:        # noqa: BLE001 - raised by ``close`` on the decode thread
+                self.error = exc
+
+    def __call__(self, tokens: Sequence[int]) -> bool:
+        self.q.put(list(tokens))
+        return False
+
+    def close(self, raise_error: bool = True) -> None:
+        self.q.put(None)
+        self.thread.join()
+        if self.error is not None and raise_error:
+            raise self.error
+
+
+# -- sync: the forward's time for 0070's online calibration from CUDA events ------------------------------------------
+class ForwardTimer:
+    """Two CUDA events around a verify forward (``start`` / ``stop``); ``ms`` after the sampler's readback has
+    synchronized. Without CUDA (tests on the CPU) it falls back to the host clock."""
+
+    def __init__(self) -> None:
+        import time
+
+        import torch
+
+        self._clock = time.perf_counter
+        self.cuda = torch.cuda.is_available()
+        if self.cuda:
+            self.a = torch.cuda.Event(enable_timing=True)
+            self.b = torch.cuda.Event(enable_timing=True)
+        self.t0 = 0.0
+
+    def start(self) -> None:
+        self.t0 = self._clock()
+        if self.cuda:
+            self.a.record()
+
+    def stop(self) -> None:
+        if self.cuda:
+            self.b.record()
+
+    def ms(self) -> float:
+        if self.cuda:
+            self.b.synchronize()
+            return float(self.a.elapsed_time(self.b))
+        return (self._clock() - self.t0) * 1e3
+
+
+# -- plan: the next round's plan inside the sampler's all-gather ------------------------------------------------------
+RIDER_EXTRA = 8
+
+
+def rider_size(slots: int) -> int:
+    """int32 words appended to every batched sampler exchange (both ranks: the same size): a flag, the plan's length
+    and a cancels-only plan of up to ``slots`` cancels (``batchplan.encode_plan``: 3 + cancels ints)."""
+
+    return int(slots) + RIDER_EXTRA
+
+
+def rider_encode(plan: Sequence[int] | None, size: int) -> list[int]:
+    """Rank 0's words: [1, len, plan..., 0...] for a plan, [0, ...] for none (rank 1 always sends [0, ...])."""
+
+    if plan is None:
+        return [0] * size
+    plan = [int(v) for v in plan]
+    if 2 + len(plan) > size:
+        raise ValueError(f"a {len(plan)}-int plan does not fit the {size}-word rider")
+    return [1, len(plan), *plan] + [0] * (size - 2 - len(plan))
+
+
+def rider_decode(words: Sequence[int]) -> list[int] | None:
+    words = [int(v) for v in words]
+    if not words or words[0] == 0:
+        return None
+    if words[0] != 1 or not 0 <= words[1] <= len(words) - 2:
+        raise RuntimeError(f"a round plan rider {words[:4]}...: both ranks must run the same patched TensorFold with "
+                           "the same GLM53_TF_DECODE_OVERLAP")
+    return words[2:2 + words[1]]
