diff --git a/src/tensorfold/families/glm5_next/cuda/cpupin.py b/src/tensorfold/families/glm5_next/cuda/cpupin.py
new file mode 100644
index 0000000..a487b8a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/cpupin.py
@@ -0,0 +1,394 @@
+"""patches/0370 (N1a): the engine's host threads on GB10's fast cores (GLM53_TF_CPU_PIN, off by default).
+
+GB10 has 10 Cortex-X925 cores (``CPU part`` 0xd85, up to 3.9 GHz, 2 MB L2) and 10 Cortex-A725 (0xd87, 2.8 GHz,
+512 KB L2) in two clusters: on both Sparks cpus 0-4 / 10-14 are A725, 5-9 / 15-19 X925; cluster 0-9 shares an 8 MB
+L3, cluster 10-19 a 16 MB one; ``cpu_capacity`` 718 / 731 (A725), 997 / 1017 / 1024 (X925; cpu 19 the highest).
+Nothing pinned anything before this patch: the kernel's scheduler placed the round loop, NCCL's proxy and 0230's
+busy-spinning RoCE proxy wherever it liked (sampled on the prod container: mostly X925, sometimes cpu 0 / 10).
+
+Settings (both ranks read their own; scheduling only, replies unchanged):
+
+- ``0`` / unset: nothing pinned (as before).
+- ``fast``: every thread of the process on the fast cores the container allows (the same as starting the container
+  with ``--cpuset-cpus`` = those cores, ``CPUSET`` in scripts/serve.sh), without dedicating any core.
+- ``1`` / ``auto`` / ``roles``: dedicated cores, best first (highest ``cpu_capacity``, then the larger L3, then the
+  higher id): the round loop's thread (``serve``: rank 0's batch thread, rank 1's main thread; without batching the
+  request's thread while it decodes) on the best one; 0230's RoCE proxy (``GLM53_TF_ROCE_CPU``, when
+  ``GLM53_TF_COMM_BACKEND=roce`` and that is unset) on the next; NCCL's threads (``comm``, named by
+  ``NCCL_SET_THREAD_NAME=1``) on the next two; every other thread (HTTP, tokenizer, session disk, torch pools:
+  ``rest``) on the remaining cores. On GB10: serve 19, roce 18, comm 16-17, rest 0-15.
+- explicit roles, ``;``-separated, any subset (the rest from ``auto``): ``serve=19;roce=18;comm=16-17;rest=0-15``,
+  plus ``nice=N`` (0..19) for the HTTP request threads (default 0: a lower priority buys nothing while they have
+  cores of their own, and a descheduled thread that holds the GIL stalls the round loop).
+
+Threads made later inherit their maker's cpus: the HTTP threads the main thread's (``rest``), a thread made by the
+round loop its single core; ``tick`` (every round, cheap) re-sorts the threads every ``GLM53_TF_CPU_PIN_EVERY`` s
+(30). ``serving`` names the round loop's thread ``tf-serve`` (``ps -L -o tid,psr,pcpu,comm``). Linux only; on
+anything else (or when the allowed cpus cannot be read) a warning and nothing pinned.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import ctypes
+import os
+import sys
+import threading
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+SYS_CPU = Path("/sys/devices/system/cpu")
+X925, A725 = 0xD85, 0xD87
+
+
+@dataclass
+class Plan:
+    mode: str                                   # "fast" | "roles"
+    serve: frozenset[int]
+    comm: frozenset[int]
+    rest: frozenset[int]
+    roce: int | None = None
+    nice: int = 0
+    fast: tuple[int, ...] = ()
+
+    def describe(self) -> str:
+        roce = f" roce {self.roce}" if self.roce is not None else ""
+        return (f"{self.mode}: serve {cpulist(self.serve)}{roce} comm {cpulist(self.comm)} rest {cpulist(self.rest)}"
+                + (f", HTTP nice {self.nice}" if self.nice else ""))
+
+
+def cpulist(cpus) -> str:
+    """{0, 1, 2, 5} -> "0-2,5"."""
+
+    out, run = [], []
+    for c in sorted(cpus):
+        if run and c == run[-1] + 1:
+            run.append(c)
+            continue
+        if run:
+            out.append(f"{run[0]}-{run[-1]}" if len(run) > 1 else str(run[0]))
+        run = [c]
+    if run:
+        out.append(f"{run[0]}-{run[-1]}" if len(run) > 1 else str(run[0]))
+    return ",".join(out)
+
+
+def parse_cpulist(text: str) -> frozenset[int]:
+    cpus: set[int] = set()
+    for part in str(text).replace(" ", "").split(","):
+        if not part:
+            continue
+        if "-" in part:
+            a, b = part.split("-", 1)
+            if int(b) < int(a):
+                raise ValueError(f"cpu range {part!r}")
+            cpus.update(range(int(a), int(b) + 1))
+        else:
+            cpus.add(int(part))
+    return frozenset(cpus)
+
+
+@dataclass
+class Cpu:
+    id: int
+    capacity: int = 0
+    l3_kb: int = 0
+    part: int = 0
+    max_khz: int = 0
+
+
+def _read(path: Path) -> str:
+    try:
+        return path.read_text().strip()
+    except OSError:
+        return ""
+
+
+def _kb(text: str) -> int:
+    t = text.upper()
+    try:
+        return int(t[:-1]) * (1024 if t.endswith("M") else 1) if t[-1:] in "KM" else int(t or 0) // 1024
+    except ValueError:
+        return 0
+
+
+def read_cpus(root: Path = SYS_CPU, cpuinfo: Path = Path("/proc/cpuinfo")) -> dict[int, Cpu]:
+    """Every cpu's capacity, L3 size, part number and max clock (whatever the system exposes)."""
+
+    cpus: dict[int, Cpu] = {}
+    for d in sorted(root.glob("cpu[0-9]*")):
+        try:
+            n = int(d.name[3:])
+        except ValueError:
+            continue
+        c = Cpu(n)
+        c.capacity = int(_read(d / "cpu_capacity") or 0)
+        c.max_khz = int(_read(d / "cpufreq" / "cpuinfo_max_freq") or 0)
+        for idx in sorted((d / "cache").glob("index*")):
+            if _read(idx / "level") == "3":
+                c.l3_kb = _kb(_read(idx / "size"))
+        cpus[n] = c
+    cur = None
+    for line in _read(cpuinfo).splitlines():
+        key, _, val = line.partition(":")
+        key, val = key.strip(), val.strip()
+        if key == "processor":
+            cur = int(val) if val.isdigit() else None
+        elif key == "CPU part" and cur is not None:
+            cpus.setdefault(cur, Cpu(cur)).part = int(val, 16)
+    return cpus
+
+
+def fast_cpus(cpus: dict[int, Cpu], allowed) -> list[int]:
+    """The allowed fast cores, best first: X925 by part number, else the top capacity / clock class; ordered by
+    capacity, L3 size, id (all descending)."""
+
+    allowed = set(allowed)
+    pool = [c for n, c in cpus.items() if n in allowed]
+    if not pool:
+        return sorted(allowed, reverse=True)
+    if any(c.part == X925 for c in pool):
+        fast = [c for c in pool if c.part == X925]
+    else:
+        key = (lambda c: c.capacity) if any(c.capacity for c in pool) else (lambda c: c.max_khz)
+        top = max(key(c) for c in pool)
+        fast = [c for c in pool if key(c) >= 0.9 * top] if top else pool
+    fast.sort(key=lambda c: (c.capacity, c.l3_kb, c.max_khz, c.id), reverse=True)
+    return [c.id for c in fast]
+
+
+def plan(spec: str | None, cpus: dict[int, Cpu], allowed, *, roce: bool = False) -> Plan | None:
+    """GLM53_TF_CPU_PIN -> a Plan (None: off)."""
+
+    s = str(spec or "").strip()
+    low = s.lower()
+    if low in ("", "0", "off", "no", "false"):
+        return None
+    allowed = frozenset(allowed)
+    if not allowed:
+        raise ValueError("GLM53_TF_CPU_PIN: no cpus allowed")
+    fast = fast_cpus(cpus, allowed)
+    if low == "fast":
+        f = frozenset(fast)
+        return Plan("fast", f, f, f, None, 0, tuple(fast))
+    explicit: dict[str, str] = {}
+    if low not in ("1", "on", "auto", "roles", "yes", "true"):
+        for part in s.split(";"):
+            if not part.strip():
+                continue
+            key, eq, val = part.partition("=")
+            key = key.strip().lower()
+            if not eq or key not in ("serve", "comm", "roce", "rest", "nice"):
+                raise ValueError(f"GLM53_TF_CPU_PIN={spec!r}: expected 0, fast, auto, or roles like "
+                                 "'serve=19;roce=18;comm=16-17;rest=0-15;nice=0'")
+            explicit[key] = val.strip()
+    order = list(fast)
+    serve = frozenset(order[:1])
+    left = order[1:]
+    roce_cpu = None
+    if roce and len(left) >= 3:
+        roce_cpu, left = left[0], left[1:]
+    comm = frozenset(left[:2]) if len(left) >= 3 else frozenset()
+    dedicated = serve | comm | ({roce_cpu} if roce_cpu is not None else set())
+    rest = allowed - dedicated or allowed
+    if not comm:
+        comm = rest
+    p = Plan("roles", serve, comm, rest, roce_cpu, 0, tuple(fast))
+    for key, val in explicit.items():
+        if key == "nice":
+            n = int(val)
+            if not 0 <= n <= 19:
+                raise ValueError(f"GLM53_TF_CPU_PIN nice={n}: expected 0..19")
+            p.nice = n
+            continue
+        if key == "roce":
+            p.roce = None if val.lower() in ("", "none", "-1") else int(val)
+            got = frozenset([p.roce]) if p.roce is not None else frozenset()
+        else:
+            got = parse_cpulist(val)
+            if not got:
+                raise ValueError(f"GLM53_TF_CPU_PIN {key}= is empty")
+            setattr(p, key, got)
+        if not got <= allowed:
+            raise ValueError(f"GLM53_TF_CPU_PIN {key}={val}: cpus {cpulist(got - allowed)} are not allowed here "
+                             f"(allowed: {cpulist(allowed)})")
+    return p
+
+
+# -- the process's state --------------------------------------------------------------------------------------------
+@dataclass
+class _State:
+    plan: Plan | None = None
+    serve_tids: set[int] = field(default_factory=set)
+    every: float = 30.0
+    next_sweep: float = 0.0
+    lock: threading.Lock = field(default_factory=threading.Lock)
+    ready: bool = False
+
+
+_S = _State()
+_PR_SET_NAME = 15
+
+
+def _libc():
+    try:
+        return ctypes.CDLL(None, use_errno=True)
+    except OSError:
+        return None
+
+
+def set_thread_name(name: str) -> None:
+    """The calling thread's OS name (``comm``, 15 bytes), best effort."""
+
+    lib = _libc()
+    if lib is not None and hasattr(lib, "prctl"):
+        try:
+            lib.prctl(_PR_SET_NAME, ctypes.c_char_p(name.encode()[:15]), 0, 0, 0)
+        except Exception:                       # noqa: BLE001 - a name is only for ps
+            pass
+
+
+def _tids() -> list[int]:
+    try:
+        return [int(t) for t in os.listdir("/proc/self/task")]
+    except OSError:
+        return []
+
+
+def _comm(tid: int) -> str:
+    return _read(Path(f"/proc/self/task/{tid}/comm"))
+
+
+def _set(tid: int, cpus) -> bool:
+    try:
+        if set(os.sched_getaffinity(tid)) != set(cpus):
+            os.sched_setaffinity(tid, cpus)
+        return True
+    except (ProcessLookupError, PermissionError, OSError):
+        return False
+
+
+def classify(tid: int, name: str, current: frozenset[int], p: Plan, serve_tids) -> frozenset[int] | None:
+    """The cpus a thread belongs on (None: leave it). The RoCE proxy pins itself (``GLM53_TF_ROCE_CPU``): a thread
+    that sits on exactly the roce cpu is left there."""
+
+    if tid in serve_tids:
+        return p.serve
+    if name.startswith("NCCL"):
+        return p.comm
+    if p.roce is not None and current == frozenset([p.roce]):
+        return None
+    return p.rest
+
+
+def sweep() -> int:
+    """Every thread of this process onto its role's cpus; -> threads moved (or already right)."""
+
+    p = _S.plan
+    if p is None:
+        return 0
+    done = 0
+    for tid in _tids():
+        try:
+            cur = frozenset(os.sched_getaffinity(tid))
+        except OSError:
+            continue
+        want = classify(tid, _comm(tid), cur, p, _S.serve_tids)
+        if want is not None and want != cur and _set(tid, want):
+            done += 1
+    _S.next_sweep = time.monotonic() + _S.every
+    return done
+
+
+def early(rank: int = 0) -> Plan | None:
+    """Engine start, before NCCL makes its threads: the plan, NCCL's thread names, the RoCE proxy's cpu, and the
+    main thread (whose cpus later threads inherit) on ``rest``."""
+
+    if not sys.platform.startswith("linux"):
+        if os.environ.get("GLM53_TF_CPU_PIN", "").strip() not in ("", "0"):
+            print("[tensorfold] GLM53_TF_CPU_PIN: not Linux, nothing pinned", file=sys.stderr, flush=True)
+        return None
+    try:
+        allowed = os.sched_getaffinity(0)
+        roce = os.environ.get("GLM53_TF_COMM_BACKEND", "nccl").strip().lower() == "roce"
+        p = plan(os.environ.get("GLM53_TF_CPU_PIN"), read_cpus(), allowed, roce=roce)
+    except OSError as exc:
+        print(f"[tensorfold] GLM53_TF_CPU_PIN: cannot read the cpus ({exc}); nothing pinned", file=sys.stderr,
+              flush=True)
+        return None
+    _S.plan = p
+    if p is None:
+        return None
+    _S.every = float(os.environ.get("GLM53_TF_CPU_PIN_EVERY", "") or 30.0)
+    os.environ.setdefault("NCCL_SET_THREAD_NAME", "1")
+    if p.roce is not None:
+        os.environ.setdefault("GLM53_TF_ROCE_CPU", str(p.roce))
+        try:
+            p.roce = int(os.environ["GLM53_TF_ROCE_CPU"])
+        except ValueError:
+            pass
+    os.sched_setaffinity(0, p.rest)
+    _S.ready = True
+    print(f"[tensorfold] CPU pinning (patches/0370) rank {rank}: {p.describe()} (fast cores here: "
+          f"{cpulist(p.fast)}, allowed {cpulist(allowed)})", flush=True)
+    return p
+
+
+def serving() -> None:
+    """The calling thread runs the round loop: it gets ``serve``, its name, and every other thread is sorted."""
+
+    p = _S.plan
+    if p is None:
+        return
+    tid = threading.get_native_id()
+    with _S.lock:
+        _S.serve_tids.add(tid)
+    set_thread_name("tf-serve")
+    _set(tid, p.serve)
+    sweep()
+
+
+@contextlib.contextmanager
+def serving_request():
+    """Without batching: the request's (HTTP) thread decodes on ``serve`` while it runs, then goes back."""
+
+    p = _S.plan
+    if p is None or p.mode == "fast":
+        yield
+        return
+    tid = threading.get_native_id()
+    with _S.lock:
+        _S.serve_tids.add(tid)
+    try:
+        before = os.sched_getaffinity(0)
+    except OSError:
+        before = p.rest
+    _set(tid, p.serve)
+    try:
+        yield
+    finally:
+        with _S.lock:
+            _S.serve_tids.discard(tid)
+        _set(tid, before)
+
+
+def http_thread() -> None:
+    """Rank 0's request threads: a name, and ``nice`` when set."""
+
+    p = _S.plan
+    if p is None:
+        return
+    set_thread_name("tf-http")
+    if p.nice:
+        try:
+            os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), p.nice)
+        except OSError:
+            pass
+
+
+def tick() -> None:
+    """Every round (cheap): a sweep when one is due."""
+
+    if _S.plan is not None and time.monotonic() >= _S.next_sweep:
+        sweep()
