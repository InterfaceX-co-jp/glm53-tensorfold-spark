+def hc_fused_ok(x: torch.Tensor, gathered: torch.Tensor, fn: torch.Tensor) -> bool:
+    """The fused post + partial kernel applies: a fast chunk (hc_pre's partial is ``fast_qmm.hc_partial``), 4
+    contiguous streams, fn contiguous, K blocks that split every stream evenly into 64-wide steps."""
+
+    if not (HC_FUSED & 1) or _HC_FUSED_BROKEN or FAST_HC is None or getattr(FAST_HC, "__name__", "") != "hc_partial":
