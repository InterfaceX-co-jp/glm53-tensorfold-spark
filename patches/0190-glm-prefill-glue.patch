     glue.combine(lb.ey[a:a + r], lb.wts[a:a + r], out)
     if profile.ON:
         profile.lap("moe.combine")
diff --git i/src/tensorfold/families/glm5_next/cuda/pfglue.py w/src/tensorfold/families/glm5_next/cuda/pfglue.py
new file mode 100644
index 0000000..3ff754f
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/pfglue.py
@@ -0,0 +1,314 @@
+"""Prefill "glue" for GLM-5.3-Flash on CUDA (patches/0190): the small ops between the big matmuls that a fast 8,192-row
+chunk now spends most of its non-expert time in, each behind its own knob (per request through patches/0090's
+header, so one load can A/B them).
+
+Measured (28,045-token cold prompt, fast + lean 8,192-row chunks, fast2 experts, overlap, latent KV; 23.09 s):
+``moe.router`` 1,268 ms, ``hc`` 2,916 ms (with the gather waits the overlap moves there), ``mtp.*`` ~1,300 ms,
+``moe.combine`` 802, ``moe.shared`` 961.
+
+1. ``moe_glue`` (GLM53_TF_MOE_GLUE = bits, default 0), windows of 64+ rows (decode / verify windows and graph
+   captures keep the old kernels):
+   - bit 1: the MoE grouping by a stable sort and a scatter (``glue.group_sorted``) instead of ``glue._group``, one
+     program that walks the chunk's R x 9 picks twice and its R member columns twice (O(R) serial on one SM: ~5-8 ms
+     a MoE layer at 8,192 rows, estimated from the loop counts; most of ``moe.router``). The outputs are integers
+     equal element for element to ``_group``'s (ids, count, members);
+   - bit 2: the router's 8 K slices in one kernel (``glue._router_fused``: each slice's dot chain as before, the
+     slices added in order in registers; no [8, R, 288] fp32 partial buffer written and read back, 150 MB a layer
+     at 8,192 rows);
+   - bit 4: the combine reads the shared expert's fp32 output where its matmul wrote it (``glue._combine_s``)
+     instead of a copy in its slot of ``ey`` (32 KB a row a MoE layer of traffic).
+   Same bits in every case, so replies, snapshots and the session store do not depend on the knob.
+
+2. ``mtp_window`` (GLM53_TF_MTP_PREFILL_WINDOW = tokens, default 0 = off): a prefill of n tokens runs the MTP head
+   (one DSA + MoE layer, every position) only on positions p >= lo = (n - W) rounded down to a multiple of 64. For
+   positions below lo the head's caches (latent / K,V rows, its indexer's keys and gates, and the pools those rows
+   complete) are ZEROED and ``mtp_len`` advances as if absorbed. The MTP head only drafts: a draft is verified by the
+   main model's window, and the keyed sampler and commit decide every token, so replies are those of the full head
+   (drafted == serial holds for any draft source). What changes is which drafts are proposed, i.e. speed, never
+   the reply. Determinism: the skipped rows are zeros whatever ran before, so the head's caches after a prefill are
+   a function of (prompt, W, the resume point); a resumed prefill's head rows below its resume point are those the
+   earlier request wrote (its own n and W), so drafts (not replies) after a resume may differ from a fresh prefill's,
+   as patches/0065 already allows for the DFlash2 ring. ``lo`` depends on the prompt length only (not on C or the
+   chunking), so the fast rule's chunk-size independence (patches/0085) holds for the head's rows too.
+   Batch mode (patches/0120) prefills a prompt in pieces, each a prefill of a prefix: every piece keeps its own last
+   W positions, so the saving there is smaller (never a correctness issue).
+
+3. ``hc_fused`` (GLM53_TF_HC_FUSED = 0..3, default 0; fast chunks through patches/0084's pipeline): bit 0 runs
+   hc_post and the next hc_pre's 24 mixing dots + square sums as one kernel (``glue._hc_post_part``: the new streams
+   are fed from registers into the partial's tensor-core dots instead of being re-read, one launch fewer per slab);
+   bit 1 runs hc_pre's finish with its 16 partial loads unrolled (``glue._hc_finish_u``: all in flight at once, added
+   in the same block order; the per-row finish was a chain of 16 dependent L2 round trips). Same arithmetic as the
+   separate kernels, operation for operation; the GPU test checks the bits (a Triton reduction's order follows the
+   layout the compiler picks, so "same code, same shapes, same warps" is checked, not assumed). Row-independent
+   (per-row mixes; 64-row tiles of independent mma rows).
+
+4. ``attn_bm32`` (GLM53_TF_ATTN_BM32, default 0): bf16 fast chunks use the latent attention's 32-query tiles (all 32
+   local heads of a row in one tile: one gather of the row's selected latent rows instead of two), which FP8 fast
+   chunks already use (patches/0083). 0060 measured -24% a layer for 1024 sparse rows and identical bits to the
+   16-query tile; decode keeps 16 (1-4-row windows are faster with it). The fast rule does not need prefill bits to
+   equal decode bits (fastpf), only determinism and row independence, which a tile of one row's heads has. The knob
+   is per request only because the bits are the same (checked on the GPU): were they not, snapshots of the two
+   settings must not mix, and it would have to be a load-time switch.
+
+5. ``GLM53_TF_LATENT_TC=1`` (load-time, default 0; NEW arithmetic): bf16 fast chunks run the latent absorb / expand
+   on bf16 tensor cores (``latent.absorb_tc`` / ``expand_tc``, patches/0083's kernels, tested against float64 there)
+   instead of the fp32 FMA-pipe kernels, which are most of ``dsa.o_proj`` (1.9 s of a 28k prompt) and part of
+   ``dsa.proj``. The operands are rounded to bf16 at the dot (q, u and kv_b's dequantized tile; fp32 sums in the same
+   K order): the usual bf16 matmul precision, not FP8's e4m3. Fast replies change (like GLM53_TF_KDA_PROJ_BF16);
+   drafted == serial and resumed == fresh hold (deterministic, row-independent 64-row tiles), and its snapshots are
+   tagged G + 2 (``pfgrid.TC``) so no prefill resumes from the other arithmetic. Both ranks must agree (checked at
+   load). Off by default: it is the user's call whether bf16-level reply changes are acceptable (FP8 prefill was
+   rejected for its e4m3 divergence).
+
+Items 1, 3, 4 give the same bits; 2 changes the MTP head's rows only; 5 is new arithmetic (opt-in, load-time).
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Sequence
+
+GROUP_ENV = "GLM53_TF_MOE_GLUE"
+MTP_ENV = "GLM53_TF_MTP_PREFILL_WINDOW"
+HC_ENV = "GLM53_TF_HC_FUSED"
+BM32_ENV = "GLM53_TF_ATTN_BM32"
+TC_ENV = "GLM53_TF_LATENT_TC"
+GRID = 64
+
+
+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        v = int(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected an integer") from None
+    if v < 0:
+        raise ValueError(f"{name}={raw!r}: expected 0 or more")
+    return v
+
+
+def moe_glue_default() -> int:
+    """GLM53_TF_MOE_GLUE bits: 1 sorted grouping, 2 one-kernel router, 4 the combine reading the shared expert in
+    place (7 = all)."""
+
+    v = _int_env(GROUP_ENV, 0)
+    if v > 7:
+        raise ValueError(f"{GROUP_ENV}={v}: expected 0 to 7")
+    return v
+
+
+def group_default() -> bool:
+    return bool(moe_glue_default() & 1)
+
+
+def moe_glue(glue) -> int:
+    """The current ``moe_glue`` value from glue's switches."""
+
+    return int(bool(glue.GROUP_SORT)) | (2 if glue.ROUTER_FUSED else 0) | (4 if glue.SHARED_INPLACE else 0)
+
+
+def set_moe_glue(glue, v: int) -> None:
+    glue.GROUP_SORT = bool(v & 1)
+    glue.ROUTER_FUSED = bool(v & 2)
+    glue.SHARED_INPLACE = bool(v & 4)
+
+
+def mtp_window_default() -> int:
+    return _int_env(MTP_ENV, 0)
+
+
+def bm32_default() -> bool:
+    return bool(_int_env(BM32_ENV, 0))
+
+
+def hc_default() -> int:
+    """GLM53_TF_HC_FUSED: 0 off, 1 hc_post + the next hc_pre's partial dots in one kernel, 2 hc_pre's finish with its
+    loads unrolled, 3 both (fast chunks through 0084's pipeline only)."""
+
+    v = _int_env(HC_ENV, 0)
+    if v > 3:
+        raise ValueError(f"{HC_ENV}={v}: expected 0 to 3")
+    return v
+
+
+# what the next prefill runs (``tf_knobs.mtp_window`` switches it per request; both ranks, the header carries it)
+MTP_WINDOW = mtp_window_default()
+
+
+def mtp_start(n: int, window: int | None = None) -> int:
+    """The first position of an n-token prompt whose MTP row is computed: 0 (window off or the prompt fits), else
+    (n - window) rounded down to a multiple of 64 (so the zeroed pools are whole and the rule is a function of n)."""
+
+    window = MTP_WINDOW if window is None else window
+    if window <= 0 or n <= window:
+        return 0
+    return (n - window) // GRID * GRID
+
+
+def zero_mtp_rows(st, s: int, e: int) -> None:
+    """The MTP head's cache rows [s, e) (latent or K/V, its indexer's keys and gates) and the pools rows s..e-1
+    complete (p with s <= 4p + 3 < e) set to zero: what a skipped position leaves, whatever ran before."""
+
+    if e <= s:
+        return
+    kc = getattr(st, "mtp_kc", None)
+    if kc is None:
+        return
+    kc[s:e].zero_()
+    vc = getattr(st, "mtp_vc", None)
+    if vc is not None and vc is not kc:
+        vc[s:e].zero_()
+    index = getattr(st, "index", None)
+    if index is not None:
+        ik, ig, pk = index[-1]
+        ik[s:e].zero_()
+        ig[s:e].zero_()
+        p0, p1 = s // 4, e // 4
+        if p1 > p0:
+            pk[p0:p1].zero_()
+
+
+def absorb(e, hidden, next_tokens: Sequence[int], p0: int, lo: int, absorb_fn):
+    """``decode.absorb`` of rows at positions p0, p0 + 1, ... (hidden [k, D], the tokens after them), with the rows
+    below ``lo`` skipped: their head caches zeroed and ``mtp_len`` advanced past them. ``absorb_fn``: decode.absorb.
+    Returns the last absorbed row's logits (None when every row was skipped; prefill does not read them).
+    With ``MTP_CACHE`` (GLM53_TF_MTP_PREFILL_CACHE=1) the rows only write the head's caches (``cache_absorb``)."""
+
+    if MTP_CACHE and cache_ok(e):
+        absorb_fn = cache_absorb
+    k = len(next_tokens)
+    skip = min(max(lo - p0, 0), k)
+    if skip == 0:
+        return absorb_fn(e, hidden, next_tokens)
+    st = e.st
+    if st.mtp_drafted:                           # as decode.absorb: drafted rows are not kept
+        st.set_mtp_len(st.mtp_len - st.mtp_drafted)
+        st.mtp_drafted = 0
+    s = st.mtp_len
+    if s + skip > st.mtp_kc.shape[0]:
+        raise ValueError("MTP window: the head's cache is full")
+    zero_mtp_rows(st, s, s + skip)
+    st.set_mtp_len(s + skip)
+    if skip == k:
+        return None
+    return absorb_fn(e, hidden[skip:], list(next_tokens[skip:]))
+
+
+# -- MTP prefill cache rows (GLM53_TF_MTP_PREFILL_CACHE, load-time) ----------------------------------------------
+#
+# A prefill absorbs every prompt position into the MTP head only for the head's caches: a row's cache entries (its
+# latent row, its indexer key and gate, the pools it completes) are functions of the row's own input (the main
+# model's hidden row and the next token) through row-local kernels, and prefill never reads the head's logits or
+# output rows (the pending last row is absorbed with its kept token in decode, by ``decode.draft``). So the head's
+# queries, index selection, sparse attention, o_proj, MoE (and their all-gathers) and final norm / lm_head over the
+# prompt were thrown away: ~90 ms a 2,048-row piece at 16k (5% of it), measured 2026-09-28 (results/W1). With this
+# switch prefill runs exactly the calls that produce the cache entries (the same functions on the same rows: the
+# same bits), and nothing after them. Decode, verify and drafting keep ``mtp.mtp_compute``. Both ranks must agree
+# (they would otherwise run different collectives): checked at load with ``load_settings``. Latent KV only (the
+# expanded cache keeps the full head); ``mtp_window`` still applies (rows below its start are zeroed, not written).
+
+CACHE_ENV = "GLM53_TF_MTP_PREFILL_CACHE"
+
+
+def mtp_cache_default() -> bool:
+    return bool(_int_env(CACHE_ENV, 0))
+
+
+MTP_CACHE = mtp_cache_default()
+
+
+def cache_ok(e) -> bool:
+    """Prefill's MTP rows can go through ``cache_absorb`` on this engine (latent KV, an MTP head, latent buffers)."""
+
+    w = getattr(e, "w", None)
+    if w is None or getattr(w, "mtp", None) is None or getattr(e, "mbuf", None) is None:
+        return False
+    meta = getattr(w, "meta", None)
+    return bool(meta.get("latent_kv")) if isinstance(meta, dict) else False
+
+
+def cache_absorb(e, hidden, next_tokens: Sequence[int]):
+    """``decode.absorb`` for prefill: the rows' head cache entries only, in chunks of the head's buffers, ``mtp_len``
+    advanced as ``absorb`` does. Returns None (prefill does not read the head's logits)."""
+
+    st = e.st
+    if st.mtp_drafted:                           # as decode.absorb: drafted rows are not kept
+        st.set_mtp_len(st.mtp_len - st.mtp_drafted)
+        st.mtp_drafted = 0
+    step = e.mbuf.rows
+    for s0 in range(0, len(next_tokens), step):
+        part = list(next_tokens[s0:s0 + step])
+        mtp_cache_rows(e.w, st, e.mbuf, part, hidden[s0:s0 + step])
+        st.set_mtp_len(st.mtp_len + len(part))
+    return None
+
+
+def mtp_cache_rows(w, st, b, next_tokens: Sequence[int], hidden) -> None:
+    """``mtp.mtp_compute``'s calls up to the head's cache writes (latent row, indexer key / gate, pools), on the
+    same buffers and rows, and nothing after them: the cache entries have the full head's bits."""
+
+    from . import glue, latent, profile, qmm, sparse
+    from .forward import _join
+    from .mtp import mtp_stage
+
+    n = mtp_stage(w, st, b, next_tokens, hidden)
+    c = w.cfg
+    m = w.mtp
+    D = c.hidden
+    glue.embed(b.ids[:n], w.embed, D, 1, b.me[:n])
+    if b.zero_first:
+        b.me[0].zero_()
+    glue.rmsnorm(b.me[:n], m.enorm, c.eps, b.mcat[:n, :D])
+    glue.rmsnorm(b.hin[:n], m.hnorm, c.eps, b.mcat[:n, D:])
+    qmm.matmul(b.mcat[:n], m.eh, qmm.group_sums(b.mcat[:n], b.mxs[:n]), out=b.mx[:n], part=b.sk)
+    layer = m.layer
+    glue.rmsnorm(b.mx[:n], layer.in_norm, c.eps, b.normed[:n], b.xs[:n])
+    if profile.ON:
+        profile.lap("misc")
+    a = layer.dsa
+    # latent._project's first matmul and the kv norm (the q half is not needed), then _attend's cache write
+    qmm.matmul(b.normed[:n], a.proj, b.xs[:n], out=b.dp[:n], part=b.sk)
+    glue.rmsnorm(b.dp[:n, c.q_lora:], a.kv_norm, c.eps, b.lat[:n], b.xs_lat[:n])
+    latent.latent_write(b.lat[:n], st.mtp_kc, st.mtp_pos_dev)
+    if profile.ON:
+        profile.lap("dsa.proj")
+    if st.index is not None:                     # latent._index_proj, then _attend's index_update
+        ix = a.index
+        ik, ig, pk = st.index[-1]
+        qmm.matmul(b.normed[:n], ix.kw, b.xs[:n], out=b.ikr[:n], part=b.sk)
+        glue.router(b.normed[:n], ix.gate, b.igr[:n])
+        sparse.index_update(b.ikr[:n, :c.index_dim], b.igr[:n], ix.ln_w, ix.ln_b, ix.ape, ik, ig, pk, st.mtp_pos_dev)
+        if profile.ON:
+            profile.lap("dsa.indexer")
+    _join(w)
+
+
+def latent_tc_default() -> bool:
+    return bool(_int_env(TC_ENV, 0))
+
+
+def latent_tc(w) -> bool:
+    """A fast prefill on this engine runs the tensor-core latent absorb / expand (``latent.BF16_TC`` on a latent-KV
+    engine): its snapshot tag gets ``pfgrid.TC``. False without torch / the latent module (host fakes)."""
+
+    import sys
+
+    latent = sys.modules.get(__package__ + ".latent") if __package__ else None
+    if latent is None or not getattr(latent, "BF16_TC", False):        # never imported / off: host fakes, defaults
+        return False
+    meta = getattr(w, "meta", None)
+    return bool(meta.get("latent_kv")) if isinstance(meta, dict) else False
+
+
+def load_settings() -> list[int]:
+    """The load-time switches both ranks must agree on (they decide a fast prefill's bits)."""
+
+    return [int(latent_tc_default()), int(mtp_cache_default())]
+
+
+def settings() -> list[int]:
+    """The load-time defaults (both ranks print them; the per-request values travel in the header)."""
+
+    return [moe_glue_default(), mtp_window_default(), hc_default(), int(bm32_default())]
