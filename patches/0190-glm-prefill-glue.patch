+# -- patches/0190: hc_post and the next hc_pre's mixing dots in one pass (``tf_knobs.hc_fused``) ----------------------
+# In a fast chunk (0084's slabs) a site ran hc_post (read X and the gathered partials, write X'), then hc_pre's
+# ``fast_qmm.hc_partial`` (read X' again, 24 dots with fn + the sum of squares per K block), then ``_hc_finish``. The
+# fused kernel computes X' tile by tile in registers, stores it, and feeds the SAME bf16 tile straight into the
+# partial's dot and square sum. Bits: each X' element is ``_hc_post``'s expression, operand for operand (the same
+# fp32 ops in the same order); each partial is ``_hc_partial_mm``'s chain for its row (the same [BM, BK] tiles
+# of the same bf16 values against the same fn tiles, one tl.dot per BK step in ascending t from a zero accumulator,
+# the same per-row square sum per step, the same shapes and warps). ``_hc_finish`` then runs unchanged (or its
+# unrolled twin ``_hc_finish_u``: the 16 partial loads issued at once, added in the same block order). The GPU test
+# checks every output bit for bit against the separate kernels; the knob stays off where it would not.
+HC_FUSED = 0           # bit 0: hc_post + partial fused; bit 1: _hc_finish_u (per request: tf_knobs.hc_fused)
+HC_FUSED_BM = 64       # rows a program of the fused kernel (the partial's own BM is 64)
+HC_FUSED_STAGES = 1    # software-pipelining depth of the fused kernel's column loop (shared memory; no bit changes)
+_HC_FUSED_BROKEN = ""  # set when the fused kernel cannot run here (e.g. out of shared memory): the separate kernels run
+
+
+@triton.jit
+def _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c0, c1, c2, c3, ps, acc, ss,
+                 WIDE: tl.constexpr, SD: tl.constexpr):
+    """One stream's tile: X'_s = bf16(post_s * branch + (((c0s X0 + c1s X1) + c2s X2) + c3s X3)), stored, then the
+    partial's dot and square-sum step on the stored values."""
+
+    mixed = ((c0[:, None] * x0 + c1[:, None] * x1) + c2[:, None] * x2) + c3[:, None] * x3
+    v = ps[:, None] * branch + mixed
+    vb = v.to(tl.bfloat16)
+    tl.store(XOUT + off_x + SD + d[None, :], vb, mask=ok[:, None])
+    w = tl.load(FN + m[:, None] * WIDE + SD + d[None, :], mask=m[:, None] < 24, other=0.0)
+    acc = tl.dot(vb, tl.trans(w), acc)
+    xf = vb.to(tl.float32)
+    ss += tl.sum(xf * xf, axis=1)
+    return acc, ss
+
+
+@triton.jit
+def _hc_post_part(X, XOUT, G, POST, COMB, FN, PART, RS, R, D: tl.constexpr, S: tl.constexpr, WORLD: tl.constexpr,
+                  NB: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr):
+    """Program (row tile, q): columns [q KB, (q + 1) KB) of every stream (KB = S D / NB), i.e. K blocks
+    s (NB / S) + q of the flattened streams: ``_hc_post`` there, then ``fast_qmm._hc_partial_mm``'s partials of
+    those blocks from the new values (S = 4)."""
+
+    pid = tl.program_id(0)
+    q = tl.program_id(1)
+    WIDE: tl.constexpr = S * D
+    KB: tl.constexpr = WIDE // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    k = tl.arange(0, BK)
+    cb = COMB + rr * 16
+    c00 = tl.load(cb + 0, mask=ok, other=0.0)
+    c10 = tl.load(cb + 4, mask=ok, other=0.0)
+    c20 = tl.load(cb + 8, mask=ok, other=0.0)
+    c30 = tl.load(cb + 12, mask=ok, other=0.0)
+    c01 = tl.load(cb + 1, mask=ok, other=0.0)
+    c11 = tl.load(cb + 5, mask=ok, other=0.0)
+    c21 = tl.load(cb + 9, mask=ok, other=0.0)
+    c31 = tl.load(cb + 13, mask=ok, other=0.0)
+    c02 = tl.load(cb + 2, mask=ok, other=0.0)
+    c12 = tl.load(cb + 6, mask=ok, other=0.0)
+    c22 = tl.load(cb + 10, mask=ok, other=0.0)
+    c32 = tl.load(cb + 14, mask=ok, other=0.0)
+    c03 = tl.load(cb + 3, mask=ok, other=0.0)
+    c13 = tl.load(cb + 7, mask=ok, other=0.0)
+    c23 = tl.load(cb + 11, mask=ok, other=0.0)
+    c33 = tl.load(cb + 15, mask=ok, other=0.0)
+    p0 = tl.load(POST + rr * S + 0, mask=ok, other=0.0)
+    p1 = tl.load(POST + rr * S + 1, mask=ok, other=0.0)
+    p2 = tl.load(POST + rr * S + 2, mask=ok, other=0.0)
+    p3 = tl.load(POST + rr * S + 3, mask=ok, other=0.0)
+    a0 = tl.zeros((BM, 32), dtype=tl.float32)
+    a1 = tl.zeros((BM, 32), dtype=tl.float32)
+    a2 = tl.zeros((BM, 32), dtype=tl.float32)
+    a3 = tl.zeros((BM, 32), dtype=tl.float32)
+    s0 = tl.zeros((BM,), dtype=tl.float32)
+    s1 = tl.zeros((BM,), dtype=tl.float32)
+    s2 = tl.zeros((BM,), dtype=tl.float32)
+    s3 = tl.zeros((BM,), dtype=tl.float32)
+    off_x = rr[:, None] * WIDE
+    for t in range(KB // BK):
+        d = q * KB + t * BK + k
+        g = tl.load(G + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        for kk in tl.static_range(1, WORLD):
+            g = g + tl.load(G + kk * RS + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        branch = g.to(tl.bfloat16).to(tl.float32)
+        x0 = tl.load(X + off_x + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x1 = tl.load(X + off_x + D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x2 = tl.load(X + off_x + 2 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x3 = tl.load(X + off_x + 3 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        a0, s0 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c00, c10, c20, c30, p0, a0, s0,
+                              WIDE, 0)
+        a1, s1 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c01, c11, c21, c31, p1, a1, s1,
+                              WIDE, D)
+        a2, s2 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c02, c12, c22, c32, p2, a2, s2,
+                              WIDE, 2 * D)
+        a3, s3 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c03, c13, c23, c33, p3, a3, s3,
+                              WIDE, 3 * D)
+    QB: tl.constexpr = NB // S                          # K blocks a stream
+    pm = ok[:, None] & (m[None, :] < 24)
+    tl.store(PART + (rr[:, None] * NB + q) * 32 + m[None, :], a0, mask=pm)
+    tl.store(PART + (rr * NB + q) * 32 + 24, s0, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + QB + q) * 32 + m[None, :], a1, mask=pm)
+    tl.store(PART + (rr * NB + QB + q) * 32 + 24, s1, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + 2 * QB + q) * 32 + m[None, :], a2, mask=pm)
+    tl.store(PART + (rr * NB + 2 * QB + q) * 32 + 24, s2, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + 3 * QB + q) * 32 + m[None, :], a3, mask=pm)
+    tl.store(PART + (rr * NB + 3 * QB + q) * 32 + 24, s3, mask=ok)
+
+
+@triton.jit
+def _hc_finish_u(X, PART, BASE, SCALE, NW, OUT, XS, POST, COMB, eps_norm, hc_eps,
+                 D: tl.constexpr, S: tl.constexpr, NB: tl.constexpr, ITERS: tl.constexpr, BLOCK: tl.constexpr):
+    """``_hc_finish`` with the partial blocks' loads unrolled (all in flight at once, added in the same block order
+    into the same accumulators); every other line is ``_hc_finish``'s."""
+
+    r = tl.program_id(0)
+    m = tl.arange(0, 32)
+    mix = tl.zeros((32,), dtype=tl.float32)
+    ss = 0.0
+    for b in tl.static_range(NB):
+        mix += tl.load(PART + (r * NB + b) * 32 + m)
+        ss += tl.load(PART + (r * NB + b) * 32 + 24)
+    rinv = 1.0 / tl.sqrt(ss / (S * D) + eps_norm)
+    mix = mix * rinv
+    s_pre = tl.load(SCALE + 0)
+    s_post = tl.load(SCALE + 1)
+    s_comb = tl.load(SCALE + 2)
+    sv = tl.arange(0, 4)
+    base = tl.load(BASE + m, mask=m < 24, other=0.0)
+    pre_logit = tl.sum(tl.where(m[None, :] == sv[:, None], (mix * s_pre + base)[None, :], 0.0), axis=1)
+    post_logit = tl.sum(tl.where(m[None, :] == (sv[:, None] + 4), (mix * s_post + base)[None, :], 0.0), axis=1)
+    pre = 1.0 / (1.0 + tl.exp(-pre_logit)) + hc_eps
+    post = 2.0 * (1.0 / (1.0 + tl.exp(-post_logit)))
+    ii = tl.arange(0, 4)[:, None]
+    jj = tl.arange(0, 4)[None, :]
+    flat = 8 + ii * 4 + jj
+    cl = tl.sum(tl.where(m[None, None, :] == flat[:, :, None], (mix * s_comb + base)[None, None, :], 0.0), axis=2)
+    cmax = tl.max(cl, axis=1)
+    ce = tl.exp(cl - cmax[:, None])
+    comb = ce / tl.sum(ce, axis=1)[:, None] + hc_eps
+    comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    for _ in range(ITERS - 1):
+        comb = comb / (tl.sum(comb, axis=1)[:, None] + hc_eps)
+        comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    tl.store(POST + r * S + sv, post)
+    tl.store(COMB + r * 16 + ii * 4 + jj, comb)
+    d = tl.arange(0, BLOCK)
+    p0 = tl.sum(tl.where(sv == 0, pre, 0.0), axis=0)
+    p1 = tl.sum(tl.where(sv == 1, pre, 0.0), axis=0)
+    p2 = tl.sum(tl.where(sv == 2, pre, 0.0), axis=0)
+    p3 = tl.sum(tl.where(sv == 3, pre, 0.0), axis=0)
+    x0 = tl.load(X + r * (S * D) + d).to(tl.float32)
+    x1 = tl.load(X + r * (S * D) + D + d).to(tl.float32)
+    x2 = tl.load(X + r * (S * D) + 2 * D + d).to(tl.float32)
+    x3 = tl.load(X + r * (S * D) + 3 * D + d).to(tl.float32)
+    c = (((p0 * x0 + p1 * x1) + p2 * x2) + p3 * x3).to(tl.bfloat16).to(tl.float32)
+    rinv2 = 1.0 / tl.sqrt(tl.sum(c * c, axis=0) / D + eps_norm)
+    w = tl.load(NW + d).to(tl.float32)
+    y = (w * (c * rinv2).to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16)
+    tl.store(OUT + r * D + d, y)
+    g = tl.sum(tl.reshape(y.to(tl.float32), (BLOCK // 64, 64)), axis=1)
+    tl.store(XS + r * (D // 64) + tl.arange(0, BLOCK // 64), g)
+
