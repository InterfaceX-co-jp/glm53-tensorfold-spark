diff --git i/src/tensorfold/families/glm5_next/cuda/vision.py w/src/tensorfold/families/glm5_next/cuda/vision.py
new file mode 100644
index 0000000..78adaf4
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/vision.py
@@ -0,0 +1,416 @@
+"""patches/0500: image input for GLM-5.3-Flash, engine side (GLM53_TF_VISION=1, rank 0's vision tower).
+
+**The language model needs nothing but embeddings.** GLM-5.3-Flash's LM is NoPE throughout (``qk_rope_head_dim`` 0:
+MLA attention and the DSA indexer rotate nothing, the KDA layers have no positions) and transformers'
+``Glm5NextModel.forward`` passes plain ``arange`` positions that no layer reads: no M-RoPE, no 3D positions. An
+image is its vision rows ``masked_scatter``-ed into ``inputs_embeds`` at the ``<|image|>`` positions (then
+expanded over the 4 hyper-connection streams like any token's embedding). ``vision_prep.py`` puts one virtual id
+(>= ``VBASE``) at each such position; ``glue.embed`` asks this module for those rows (``ACTIVE``, set around a
+prefill whose prompt has them), so every forward path that embeds prompt rows (exact, fast, lean, pipelined,
+row-split, the batcher's pieces, the MTP head's absorb) gets the image rows with no change of its own.
+
+**The tower** (``Tower``: ``Glm5NextVisionModel`` in PyTorch, BF16, rank 0 only, 1.13 GB): a linear patch embedding
+(the Conv3d over [3, 2, 14, 14] with stride = kernel, as a matmul; the image's frame is duplicated over the temporal
+pair by the processor), 24 pre-norm blocks (RMSNorm; qkv with bias, per-head RMSNorm of q and k, a 2D axial RoPE over
+the whole head: h then w positions over 16 frequencies of base 10000; full bidirectional attention within the image,
+no windows; SwiGLU MLP 1024 -> 4096 with the gate clamped at 10 and up at +-10), a final RMSNorm, the 2 x 2 spatial
+merge as a Conv2d (again a matmul over the merge window, 4096 inputs -> 4096) and the merger (proj, LayerNorm, GELU,
+the clamped SwiGLU 4096 -> 10240 -> 4096). Attention runs per image through ``scaled_dot_product_attention`` (flash on
+GB10: no N^2 memory at 32k patches). ``tests/test_vision.py`` checks it against transformers' model on CPU.
+
+**Both ranks** need the rows: rank 0 encodes (``Encoder``, with a cache of recent images' rows by digest) and ships
+them after the prompt (``exchange``: the sorted ids, then the rows as int32 words, through the engine's all-gather);
+rank 1 needs no tower. A prompt without virtual ids exchanges nothing, so text requests are unchanged, whatever the
+knob.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import math
+import os
+import threading
+from collections import OrderedDict
+from pathlib import Path
+from typing import Any, Sequence
+
+import torch
+import torch.nn.functional as F
+
+from .vision_prep import VBASE, has_vids
+
+PREFIX = "model.visual."
+ACTIVE: "Table | None" = None           # the table ``glue.embed`` substitutes rows from (None: nothing to do)
+_ACTIVE_LOCK = threading.Lock()
+
+
+# -- the table the embedding reads -----------------------------------------------------------------------------------
+class Table:
+    """Virtual ids -> rows: ``keys`` sorted int32 [K] and ``rows`` bf16 [K, D], on the device."""
+
+    def __init__(self, keys: torch.Tensor, rows: torch.Tensor) -> None:
+        if keys.ndim != 1 or rows.ndim != 2 or keys.shape[0] != rows.shape[0]:
+            raise ValueError("vision table: keys [K] and rows [K, D]")
+        self.keys = keys.to(torch.int32).contiguous()
+        self.rows = rows.contiguous()
+        self.n = int(keys.shape[0])
+
+    def clamp(self, ids: torch.Tensor) -> torch.Tensor:
+        """``ids`` with every virtual id replaced by 0 (a valid row for the embedding kernel to read)."""
+
+        return torch.where(ids >= VBASE, torch.zeros_like(ids), ids)
+
+    def fixup(self, ids: torch.Tensor, out: torch.Tensor, copies: int, dims: int) -> None:
+        """Overwrite the embedded rows of ``out`` ([R, copies * D]) whose id is in the table with the table's row, in
+        every stream copy. Device-side only (no host sync), so it can follow any eager embedding."""
+
+        R = int(ids.shape[0])
+        if R == 0 or self.n == 0:
+            return
+        pos = torch.searchsorted(self.keys, ids.to(torch.int32).contiguous()).clamp_(max=self.n - 1)
+        hit = self.keys[pos] == ids
+        rows = self.rows[pos].to(out.dtype)
+        o = out.view(R, copies, dims)
+        o.copy_(torch.where(hit[:, None, None], rows[:, None, :].expand(R, copies, dims), o))
+
+
+@contextlib.contextmanager
+def active(table: "Table | None"):
+    """``glue.embed`` substitutes ``table``'s rows inside this block (nothing when ``table`` is None)."""
+
+    global ACTIVE
+    if table is None:
+        yield
+        return
+    with _ACTIVE_LOCK:
+        prev, ACTIVE = ACTIVE, table
+    try:
+        yield
+    finally:
+        with _ACTIVE_LOCK:
+            ACTIVE = prev
+
+
+def embed_ids(ids: torch.Tensor) -> tuple["Table | None", torch.Tensor]:
+    """For ``glue.embed``: (the active table, the ids its kernel may read). None outside a vision prefill and while a
+    CUDA graph is captured (graphs only ever see decode rows, which are vocabulary ids)."""
+
+    t = ACTIVE
+    if t is None or torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        return None, ids
+    return t, t.clamp(ids)
+
+
+# -- rank 0 <-> rank 1 -----------------------------------------------------------------------------------------------
+CHUNK_ROWS = 1024                        # rows a gather: 8 MB of bf16 sent, 16 MB received
+DEVICE = "cuda"                          # where rank 1 receives the rows (tests: "cpu")
+
+
+def exchange(g, prompt: Sequence[int], table: "Table | None") -> "Table | None":
+    """After the prompt: rank 0's table for the prompt's virtual ids, on both ranks (``g``: the ``GlmEngine``, whose
+    ``_share`` and ``comm`` carry it). Nothing is exchanged for a prompt without virtual ids (both ranks see the same
+    prompt, so both skip). Rank 1 checks the ids it receives are its prompt's."""
+
+    if not has_vids(prompt):
+        return None
+    want = sorted({int(t) for t in prompt if int(t) >= VBASE})
+    if g.rank == 0:
+        if table is None:
+            raise RuntimeError("a prompt with image rows but no vision table on rank 0")
+        keys = [int(k) for k in table.keys.tolist()]
+        if keys != want:
+            raise RuntimeError("rank 0's vision table does not match the prompt's image rows")
+        dims = int(table.rows.shape[1])
+        g._share([len(keys), dims])
+        g._share(keys)
+        rows = table.rows.to(torch.bfloat16).contiguous()
+    else:
+        count, dims = g._share(None)
+        keys = g._share(None)
+        if keys != want or count != len(keys):
+            raise RuntimeError("rank 1: the vision table rank 0 sent does not match the prompt's image rows")
+        rows = torch.empty((count, dims), dtype=torch.bfloat16, device=DEVICE)
+    words = dims // 2                                    # bf16 pairs as int32 (the all-gather's integer path)
+    for a in range(0, len(keys), CHUNK_ROWS):
+        b = min(len(keys), a + CHUNK_ROWS)
+        mine = rows[a:b].view(torch.int32).reshape(-1) if g.rank == 0 else \
+            torch.zeros(((b - a) * words,), dtype=torch.int32, device=DEVICE)
+        got = torch.empty((2 * (b - a) * words,), dtype=torch.int32, device=rows.device)
+        g.comm.all_gather(mine.contiguous(), got)
+        if g.rank != 0:
+            rows[a:b].view(torch.int32).copy_(got[:(b - a) * words].view(b - a, words))
+    if g.rank == 0:
+        return table
+    return Table(torch.tensor(keys, dtype=torch.int32, device=DEVICE), rows)
+
+
+# -- the vision tower -------------------------------------------------------------------------------------------------
+class Tower:
+    """``Glm5NextVisionModel`` (inference only): ``encode(pixels, grid)`` -> the image's LM rows [N / 4, 4096]."""
+
+    def __init__(self, cfg: dict, tensors: dict[str, torch.Tensor], *, device="cuda", dtype=torch.bfloat16) -> None:
+        self.hidden = int(cfg.get("hidden_size", 1024))
+        self.heads = int(cfg.get("num_heads", 16))
+        self.head_dim = self.hidden // self.heads
+        self.depth = int(cfg.get("depth", 24))
+        self.out = int(cfg.get("out_hidden_size", 4096))
+        self.merge = int(cfg.get("spatial_merge_size", 2))
+        self.patch = int(cfg.get("patch_size", 14))
+        self.temporal = int(cfg.get("temporal_patch_size", 2))
+        self.channels = int(cfg.get("in_channels", 3))
+        self.eps = float(cfg.get("rms_norm_eps", 1e-5))
+        self.limit = float(cfg.get("swiglu_limit", 10.0))
+        rope = cfg.get("rope_parameters") or {}
+        self.theta = float(rope.get("rope_theta", 10000.0))
+        if (rope.get("rope_type") or "axial") != "axial":
+            raise ValueError("vision_config: only the axial rope is supported")
+        if cfg.get("hidden_act", "silu") != "silu":
+            raise ValueError("vision_config: hidden_act must be silu")
+        self.device, self.dtype = torch.device(device), dtype
+
+        def t(name: str) -> torch.Tensor:
+            x = tensors[PREFIX + name]
+            return x.to(device=self.device, dtype=dtype).contiguous()
+
+        D = self.hidden
+        self.patch_w = t("patch_embed.proj.weight").reshape(D, -1)          # [D, 3 * 2 * 14 * 14]
+        self.patch_b = t("patch_embed.proj.bias")
+        self.blocks = []
+        for i in range(self.depth):
+            p = f"blocks.{i}."
+            self.blocks.append({k: t(p + k) for k in (
+                "norm1.weight", "norm2.weight", "attn.qkv.weight", "attn.qkv.bias", "attn.proj.weight",
+                "attn.proj.bias", "attn.q_norm.weight", "attn.k_norm.weight", "mlp.gate_proj.weight",
+                "mlp.gate_proj.bias", "mlp.up_proj.weight", "mlp.up_proj.bias", "mlp.down_proj.weight",
+                "mlp.down_proj.bias")})
+        self.post_norm = t("post_layernorm.weight")
+        self.down_w = t("downsample.weight").reshape(self.out, -1)          # [out, D * m * m] (C, kh, kw)
+        self.down_b = t("downsample.bias")
+        self.m_proj = t("merger.proj.weight")
+        self.m_ln_w = t("merger.post_projection_norm.weight")
+        self.m_ln_b = t("merger.post_projection_norm.bias")
+        self.m_gate = t("merger.gate_proj.weight")
+        self.m_up = t("merger.up_proj.weight")
+        self.m_down = t("merger.down_proj.weight")
+        spatial = self.head_dim // 2
+        self.inv_freq = 1.0 / (self.theta ** (torch.arange(0, spatial, 2, dtype=torch.float) / spatial))
+        self.inv_freq = self.inv_freq.to(self.device)
+
+    @property
+    def nbytes(self) -> int:
+        n = 0
+        for v in vars(self).values():
+            if isinstance(v, torch.Tensor):
+                n += v.numel() * v.element_size()
+        for blk in self.blocks:
+            n += sum(v.numel() * v.element_size() for v in blk.values())
+        return n
+
+    @classmethod
+    def load(cls, model_dir: Path, *, device="cuda", dtype=torch.bfloat16) -> "Tower":
+        """The checkpoint's ``model.visual.*`` tensors (BF16 in GLM-5.3-Flash's checkpoints, one shard)."""
+
+        from safetensors import safe_open
+
+        model_dir = Path(model_dir)
+        cfg = json.loads((model_dir / "config.json").read_text())
+        vcfg = dict(cfg.get("vision_config") or {})
+        if not vcfg:
+            raise ValueError(f"{model_dir}/config.json has no vision_config: this checkpoint has no vision tower")
+        index = model_dir / "model.safetensors.index.json"
+        if index.exists():
+            wmap = json.loads(index.read_text())["weight_map"]
+            files: dict[str, list[str]] = {}
+            for name, f in wmap.items():
+                if name.startswith(PREFIX):
+                    files.setdefault(f, []).append(name)
+        else:
+            files = {"model.safetensors": None}
+        tensors: dict[str, torch.Tensor] = {}
+        for f, names in files.items():
+            with safe_open(str(model_dir / f), framework="pt", device="cpu") as h:
+                for name in names if names is not None else [k for k in h.keys() if k.startswith(PREFIX)]:
+                    tensors[name] = h.get_tensor(name)
+        if not tensors:
+            raise ValueError(f"{model_dir}: no {PREFIX}* tensors (a text-only checkpoint)")
+        return cls(vcfg, tensors, device=device, dtype=dtype)
+
+    # -- pieces (transformers' op order) --
+    def _rms(self, x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+        dt = x.dtype
+        h = x.to(torch.float32)
+        h = h * torch.rsqrt(h.pow(2).mean(-1, keepdim=True) + self.eps)
+        return w * h.to(dt)
+
+    def _rope(self, gh: int, gw: int) -> tuple[torch.Tensor, torch.Tensor]:
+        """cos, sin [N, head_dim] for the patches in the processor's order (merge windows, row-major inside)."""
+
+        m = self.merge
+        hpos, wpos = torch.meshgrid(torch.arange(gh, device=self.device), torch.arange(gw, device=self.device),
+                                    indexing="ij")
+        shape = (gh // m, m, gw // m, m)
+        hpos = hpos.reshape(shape).transpose(1, 2).flatten()
+        wpos = wpos.reshape(shape).transpose(1, 2).flatten()
+        pos = torch.stack([hpos, wpos], dim=-1)[..., None].float()             # [N, 2, 1]
+        freqs = pos * self.inv_freq.float()                                     # [N, 2, F]
+        cos, sin = freqs.cos(), freqs.sin()
+
+        def recompose(f):
+            hw = torch.cat([f[:, 0], f[:, 1]], dim=-1)
+            return torch.cat([hw, hw], dim=-1)
+        return recompose(cos), recompose(sin)
+
+    @staticmethod
+    def _rotate_half(x: torch.Tensor) -> torch.Tensor:
+        h = x.shape[-1] // 2
+        return torch.cat((-x[..., h:], x[..., :h]), dim=-1)
+
+    def _swiglu(self, x, gw, gb, uw, ub, dw, db) -> torch.Tensor:
+        gate = F.linear(x, gw, gb).clamp(max=self.limit)
+        up = F.linear(x, uw, ub).clamp(min=-self.limit, max=self.limit)
+        return F.linear(F.silu(gate) * up, dw, db)
+
+    def _block(self, x: torch.Tensor, blk: dict, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+        N = x.shape[0]
+        H, hd = self.heads, self.head_dim
+        h = self._rms(x, blk["norm1.weight"])
+        q, k, v = F.linear(h, blk["attn.qkv.weight"], blk["attn.qkv.bias"]).reshape(N, 3, H, hd).permute(
+            1, 0, 2, 3).unbind(0)
+        q = self._rms(q, blk["attn.q_norm.weight"])
+        k = self._rms(k, blk["attn.k_norm.weight"])
+        c, s = cos.unsqueeze(-2).float(), sin.unsqueeze(-2).float()
+        qf, kf = q.float(), k.float()
+        q = ((qf * c) + (self._rotate_half(qf) * s)).to(x.dtype)
+        k = ((kf * c) + (self._rotate_half(kf) * s)).to(x.dtype)
+        q, k, v = (t.transpose(0, 1).unsqueeze(0) for t in (q, k, v))            # [1, H, N, hd]
+        a = F.scaled_dot_product_attention(q, k, v, scale=hd ** -0.5)
+        a = a.transpose(1, 2).reshape(N, -1)
+        x = x + F.linear(a, blk["attn.proj.weight"], blk["attn.proj.bias"])
+        h = self._rms(x, blk["norm2.weight"])
+        return x + self._mlp_rows(h, blk)
+
+    def _mlp_rows(self, h: torch.Tensor, blk: dict, chunk: int = 8192) -> torch.Tensor:
+        """The block's MLP, row-chunked (rows are independent; the chunk rule is fixed, so the bits are too)."""
+
+        args = (blk["mlp.gate_proj.weight"], blk["mlp.gate_proj.bias"], blk["mlp.up_proj.weight"],
+                blk["mlp.up_proj.bias"], blk["mlp.down_proj.weight"], blk["mlp.down_proj.bias"])
+        if h.shape[0] <= chunk:
+            return self._swiglu(h, *args)
+        return torch.cat([self._swiglu(h[a:a + chunk], *args) for a in range(0, h.shape[0], chunk)])
+
+    @torch.no_grad()
+    def encode(self, pixels: torch.Tensor, grid: Sequence[int]) -> torch.Tensor:
+        """One image's patches [N, 3 * 2 * 14 * 14] (``vision_prep.preprocess``) and grid (1, gh, gw) -> its LM rows
+        [N / merge^2, out_hidden] in the prompt's order."""
+
+        t, gh, gw = (int(v) for v in grid)
+        if t != 1 or gh % self.merge or gw % self.merge or pixels.shape[0] != gh * gw:
+            raise ValueError(f"vision: patches {tuple(pixels.shape)} do not fit the grid {tuple(grid)}")
+        x = pixels.to(device=self.device, dtype=self.dtype)
+        x = F.linear(x, self.patch_w, self.patch_b)
+        cos, sin = self._rope(gh, gw)
+        for blk in self.blocks:
+            x = self._block(x, blk, cos, sin)
+        x = self._rms(x, self.post_norm)
+        m = self.merge
+        x = x.view(-1, m, m, self.hidden).permute(0, 3, 1, 2).reshape(-1, self.hidden * m * m)
+        x = F.linear(x, self.down_w, self.down_b)
+        x = F.linear(x, self.m_proj)
+        x = F.gelu(F.layer_norm(x, (self.out,), self.m_ln_w, self.m_ln_b, 1e-5))
+        return self._swiglu(x, self.m_gate, None, self.m_up, None, self.m_down, None)
+
+    @staticmethod
+    def flops(grid: Sequence[int], cfg: dict | None = None) -> float:
+        """Forward FLOPs of one image (matmuls and attention; 2 a multiply-add)."""
+
+        cfg = cfg or {}
+        D = int(cfg.get("hidden_size", 1024))
+        I = int(cfg.get("intermediate_size", 4096))
+        O = int(cfg.get("out_hidden_size", 4096))
+        P = int(cfg.get("projection_intermediate_size", 10240))
+        depth = int(cfg.get("depth", 24))
+        m = int(cfg.get("spatial_merge_size", 2))
+        k = int(cfg.get("in_channels", 3)) * int(cfg.get("temporal_patch_size", 2)) * int(cfg.get("patch_size", 14)) ** 2
+        _, gh, gw = (int(v) for v in grid)
+        N = gh * gw
+        T = N // (m * m)
+        per_block = 2 * N * D * (3 * D + D + 3 * I) + 4 * N * N * D
+        return (2 * N * k * D + depth * per_block + 2 * T * (D * m * m) * O + 2 * T * (O * O + 3 * O * P))
+
+
+# -- rank 0: images -> a table ----------------------------------------------------------------------------------------
+class Encoder:
+    """Rank 0's tower plus a cache of recent images' rows (GLM53_TF_VISION_CACHE_MB, default 256, host memory; keyed by
+    the image digest, so a conversation's earlier images are not encoded again every turn)."""
+
+    def __init__(self, model_dir: Path, *, device="cuda") -> None:
+        self.tower = Tower.load(model_dir, device=device)
+        self.cfg = json.loads((Path(model_dir) / "config.json").read_text()).get("vision_config") or {}
+        self.cache: OrderedDict[bytes, torch.Tensor] = OrderedDict()
+        self.cache_bytes = 0
+        self.cache_cap = int(float(os.environ.get("GLM53_TF_VISION_CACHE_MB", "256") or 256) * 1024 * 1024)
+        self.lock = threading.Lock()
+        self.last: dict[str, Any] = {}
+        self.stream = None
+        self.run_lock = threading.Lock()
+
+    def rows(self, prep) -> torch.Tensor:
+        """One ``vision_prep.Prepared`` image's rows on the device (the cache's, or encoded now)."""
+
+        with self.lock:
+            hit = self.cache.get(prep.digest)
+            if hit is not None:
+                self.cache.move_to_end(prep.digest)
+                return hit.to(self.tower.device, non_blocking=False)
+        out = self.tower.encode(prep.pixels, prep.grid)
+        if out.shape[0] != prep.tokens:
+            raise RuntimeError(f"vision: {out.shape[0]} rows for an image of {prep.tokens} tokens")
+        if self.cache_cap > 0:
+            host = out.to("cpu")
+            with self.lock:
+                self.cache[prep.digest] = host
+                self.cache_bytes += host.numel() * host.element_size()
+                while self.cache_bytes > self.cache_cap and self.cache:
+                    _, old = self.cache.popitem(last=False)
+                    self.cache_bytes -= old.numel() * old.element_size()
+        return out
+
+    def table(self, request) -> Table:
+        """A ``vision_prep.Request``'s images -> the ``Table`` of their virtual ids (sorted) and rows."""
+
+        import time
+
+        t0 = time.perf_counter()
+        cuda = self.tower.device.type == "cuda"
+        if cuda and getattr(self, "stream", None) is None:
+            self.stream = torch.cuda.Stream()
+        # one request's images at a time (bounded memory), on its own stream (the batch loop may be running a round
+        # meanwhile), waited for before the table is used
+        with self.run_lock, (torch.cuda.stream(self.stream) if cuda else contextlib.nullcontext()):
+            table, keys, encoded = self._table(request)
+            if cuda:
+                self.stream.synchronize()
+        self.last = {"images": len(request.images), "rows": len(keys), "encoded": encoded,
+                     "vision_s": round(time.perf_counter() - t0, 4)}
+        return table
+
+    def _table(self, request):
+        keys, parts, encoded, seen = [], [], 0, set()
+        for prep in request.images:
+            if prep.digest in seen:                 # the same image twice: the same ids, the same rows
+                continue
+            seen.add(prep.digest)
+            cached = prep.digest in self.cache
+            r = self.rows(prep)
+            encoded += 0 if cached else 1
+            keys.extend(prep.vids)
+            parts.append(r)
+        rows = torch.cat(parts) if len(parts) > 1 else parts[0]
+        order = sorted(range(len(keys)), key=keys.__getitem__)
+        uniq = [keys[i] for i in order]
+        if len(set(uniq)) != len(uniq):
+            raise RuntimeError("vision: two image rows share a virtual id")
+        idx = torch.tensor(order, dtype=torch.long, device=rows.device)
+        table = Table(torch.tensor(uniq, dtype=torch.int32, device=rows.device), rows.index_select(0, idx))
+        return table, keys, encoded
