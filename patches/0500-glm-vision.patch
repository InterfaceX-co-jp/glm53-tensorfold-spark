@@ -0,0 +1,587 @@
+"""patches/0500: image input for GLM-5.3-Flash, host side (rank 0's HTTP threads; no GPU).
+
+- **Content parts.** OpenAI chat messages may carry ``{"type": "image_url", "image_url": {"url": ..., "detail": ...}}``
+  parts (also the string form ``"image_url": "..."``, ``input_image`` and ``image``). ``data:`` URLs (base64) and, with
+  GLM53_TF_VISION_FETCH=1 (the default), ``http(s)`` URLs; nothing else (no ``file:``).
+- **Fetch and decode** (``load_bytes``, ``decode``): at most GLM53_TF_VISION_MAX_BYTES a download (default 20 MB),
+  GLM53_TF_VISION_FETCH_TIMEOUT seconds (default 10), at most GLM53_TF_VISION_MAX_PIXELS decoded pixels (default
+  64 M: decompression bombs are refused before decoding). Converted to RGB as vLLM's media loader does it: RGBA / LA
+  / transparent palettes composited on white, anything else ``convert("RGB")``.
+- **Preprocessing** (``preprocess``): transformers' ``Glm5NextImageProcessor`` (the torchvision backend, which HF's
+  ``AutoProcessor`` and vLLM load) step for step: ``smart_resize`` to the processor's token budget (``min_image_tokens``
+  16 to ``max_image_tokens`` 8,000 tokens of 28 x 28 pixels), bicubic antialiased resize of the uint8 image to the
+  content size (aspect kept, never upscaled once the image meets the minimum), zero padding to the aligned canvas,
+  fused rescale / normalize ``(x - 255 mean) / (255 std)`` in float32, and the patch layout (merge-window major,
+  the frame duplicated over the temporal patch). ``tests/test_vision_prep.py`` checks the pixels and token counts
+  against transformers on CPU.
+- **The prompt** (``markup`` / ``expand``): each image part renders as ``<|begin_of_image|><|image|><|end_of_image|>``
+  (what the checkpoint family's vision chat template emits; this checkpoint's template renders a "you cannot see
+  images" reminder instead, so the parts are replaced before the template runs), then the one ``<|image|>`` of each
+  image becomes its N = grid_h x grid_w / 4 rows.
+- **Virtual token ids** (``vids``): the N rows of an image are not N copies of ``<|image|>`` (154854) but ids at or
+  above ``VBASE`` (2^24, far past the 154,880-token vocabulary) derived from the image: a SHA-256 of the
+  preprocessed canvas, the grid and the processor settings, then a 31-bit hash of (that digest, row index) per row.
+  Every cache keyed by token ids (the engine's snapshots, the session store, the prefix share, the NVMe tier, the
+  request log's hashes) therefore tells two images apart with no change to it, and shares state between requests
+  only where the image is the same. The engine's embedding (``vision.py``) turns those ids into the vision tower's
+  rows; nothing else reads them (the lookup drafter never proposes one).
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import io
+import json
+import math
+import os
+import secrets
+import threading
+import urllib.parse
+import urllib.request
+from collections import OrderedDict
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Sequence
+
+VBASE = 1 << 24                        # every virtual id is >= this (the vocabulary is 154,880)
+VLIMIT = (1 << 31) - 1                 # ids travel as int32
+VSPAN = VLIMIT - VBASE                 # ~2^31 values
+IMAGE_TYPES = ("image_url", "input_image", "image")
+VERSION = b"tensorfold-glm5-vision/1"
+
+
+class VisionError(ValueError):
+    """A request's image problem (HTTP 400)."""
+
+
+def is_vid(t: int) -> bool:
+    return VBASE <= int(t) <= VLIMIT
+
+
+def has_vids(ids: Sequence[int]) -> bool:
+    return any(int(t) >= VBASE for t in ids)
+
+
+# -- settings ----------------------------------------------------------------------------------------------------
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        return int(float(raw))
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+
+
+def enabled() -> bool:
+    raw = os.environ.get("GLM53_TF_VISION", "0").strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_VISION={raw!r}: expected 0 or 1")
+    return raw == "1"
+
+
+@dataclass
+class Settings:
+    """The processor (``processor_config.json``), the special ids (``config.json``) and the server's limits."""
+
+    mean: tuple[float, float, float] = (0.48145466, 0.4578275, 0.40821073)
+    std: tuple[float, float, float] = (0.26862954, 0.26130258, 0.27577711)
+    patch: int = 14
+    merge: int = 2
+    temporal: int = 2
+    min_tokens: int = 16
+    max_tokens: int = 8000
+    rescale: float = 1 / 255
+    image_token: int = 154854
+    begin_token: int = 154830
+    end_token: int = 154831
+    vision_config: dict = field(default_factory=dict)
+    # server limits (GLM53_TF_VISION_*)
+    max_images: int = 8
+    cap_tokens: int = 0                # 0: the processor's max_image_tokens
+    low_tokens: int = 0                # detail="low": 0 = ignored (as vLLM)
+    fetch: bool = True
+    fetch_timeout: float = 10.0
+    max_bytes: int = 20 * 1024 * 1024
+    max_pixels: int = 64 * 1024 * 1024
+
+    @classmethod
+    def read(cls, model_dir: Path | None = None) -> "Settings":
+        s = cls()
+        if model_dir is not None:
+            model_dir = Path(model_dir)
+            p = model_dir / "processor_config.json"
+            if p.exists():
+                ip = json.loads(p.read_text()).get("image_processor", {})
+                s.mean = tuple(float(v) for v in ip.get("image_mean", s.mean))
+                s.std = tuple(float(v) for v in ip.get("image_std", s.std))
+                s.patch = int(ip.get("patch_size", s.patch))
+                s.merge = int(ip.get("merge_size", s.merge))
+                s.temporal = int(ip.get("temporal_patch_size", s.temporal))
+                s.min_tokens = int(ip.get("min_image_tokens", s.min_tokens))
+                s.max_tokens = int(ip.get("max_image_tokens", s.max_tokens))
+                if int(ip.get("patch_expand_factor", 1)) != 1:
+                    raise ValueError("processor_config.json: patch_expand_factor != 1 is not supported")
+                if not ip.get("do_rescale", True):
+                    s.rescale = 1.0
+            c = model_dir / "config.json"
+            if c.exists():
+                cfg = json.loads(c.read_text())
+                s.image_token = int(cfg.get("image_token_id", s.image_token))
+                s.begin_token = int(cfg.get("image_start_token_id", s.begin_token))
+                s.end_token = int(cfg.get("image_end_token_id", s.end_token))
+                s.vision_config = dict(cfg.get("vision_config") or {})
+        s.max_images = _env_int("GLM53_TF_VISION_MAX_IMAGES", s.max_images)
+        s.cap_tokens = _env_int("GLM53_TF_VISION_MAX_TOKENS", 0)
+        s.low_tokens = _env_int("GLM53_TF_VISION_LOW_TOKENS", 0)
+        s.fetch = (os.environ.get("GLM53_TF_VISION_FETCH", "1").strip() or "1") != "0"
+        s.fetch_timeout = float(os.environ.get("GLM53_TF_VISION_FETCH_TIMEOUT", "10") or 10)
+        s.max_bytes = _env_int("GLM53_TF_VISION_MAX_BYTES", s.max_bytes)
+        s.max_pixels = _env_int("GLM53_TF_VISION_MAX_PIXELS", s.max_pixels)
+        if s.cap_tokens < 0 or s.low_tokens < 0 or s.max_images < 1:
+            raise ValueError("GLM53_TF_VISION_MAX_TOKENS / _LOW_TOKENS must be >= 0, _MAX_IMAGES >= 1")
+        return s
+
+    def budget(self, detail: str | None) -> int:
+        """The most tokens an image may take: the processor's maximum, capped by GLM53_TF_VISION_MAX_TOKENS, and by
+        GLM53_TF_VISION_LOW_TOKENS for ``detail: "low"`` when set."""
+
+        most = self.max_tokens
+        if self.cap_tokens:
+            most = min(most, self.cap_tokens)
+        if detail == "low" and self.low_tokens:
+            most = min(most, self.low_tokens)
+        return max(most, self.min_tokens)
+
+    def key(self) -> bytes:
+        """What the embeddings depend on besides the pixels (part of every image digest)."""
+
+        return json.dumps({"mean": self.mean, "std": self.std, "patch": self.patch, "merge": self.merge,
+                           "temporal": self.temporal, "rescale": self.rescale, "vision": self.vision_config},
+                          sort_keys=True).encode()
+
+
+# -- the processor's arithmetic ------------------------------------------------------------------------------------
+def smart_resize(num_frames: int, height: int, width: int, temporal_factor: int = 2, factor: int = 28,
+                 min_pixels: int = 16, max_pixels: int = 8000) -> tuple[int, int]:
+    """transformers ``glm5_next.image_processing_glm5_next.smart_resize`` (min / max given in tokens)."""
+
+    pixels_per_token = temporal_factor * factor ** 2
+    min_pixels *= pixels_per_token
+    max_pixels *= pixels_per_token
+
+    def align(value, f):
+        return math.ceil(value / f) * f
+
+    def fit_within_budget(aligned_frames):
+        minimum_pixels = aligned_frames * factor ** 2
+        if max_pixels < minimum_pixels:
+            raise ValueError(f"max_pixels={max_pixels} is too small. At least {minimum_pixels} pixels are required "
+                             "for one aligned patch.")
+        low, high = 1, height
+        best_height, best_width = factor, factor
+        while low <= high:
+            content_height = (low + high) // 2
+            content_width = max(1, math.floor(width * content_height / height))
+            candidate_height = align(content_height, factor)
+            candidate_width = align(content_width, factor)
+            if aligned_frames * candidate_height * candidate_width <= max_pixels:
+                best_height, best_width = candidate_height, candidate_width
+                low = content_height + 1
+            else:
+                high = content_height - 1
+        return best_height, best_width
+
+    aligned_frames = max(temporal_factor, round(num_frames / temporal_factor) * temporal_factor)
+    aligned_height = align(height, factor)
+    aligned_width = align(width, factor)
+    budget = aligned_frames * aligned_height * aligned_width
+    if budget < min_pixels:
+        scale = math.sqrt(min_pixels / (num_frames * height * width))
+        aligned_height = align(max(1, math.ceil(height * scale)), factor)
+        aligned_width = align(max(1, math.ceil(width * scale)), factor)
+        budget = aligned_frames * aligned_height * aligned_width
+    if budget > max_pixels:
+        aligned_height, aligned_width = fit_within_budget(aligned_frames)
+    return aligned_height, aligned_width
+
+
+def canvas_size(height: int, width: int, s: Settings, max_tokens: int) -> tuple[int, int, int, int]:
+    """(canvas h, canvas w, content h, content w): ``Glm5NextImageProcessor.resize``'s sizes."""
+
+    factor = s.patch * s.merge
+    t = s.temporal
+    target_h, target_w = smart_resize(num_frames=t, height=height, width=width, temporal_factor=t, factor=factor,
+                                      min_pixels=s.min_tokens, max_pixels=max_tokens)
+    scale = min(target_h / height, target_w / width)
+    if t * height * width >= t * factor ** 2 * s.min_tokens:
+        scale = min(1.0, scale)
+    content_h = max(1, min(target_h, math.floor(height * scale)))
+    content_w = max(1, min(target_w, math.floor(width * scale)))
+    return target_h, target_w, content_h, content_w
+
+
+def image_tokens(height: int, width: int, s: Settings, max_tokens: int | None = None) -> int:
+    """The rows an image of this size takes in the prompt (``Glm5NextProcessor._get_num_multimodal_tokens``)."""
+
+    ch, cw, _, _ = canvas_size(height, width, s, s.max_tokens if max_tokens is None else max_tokens)
+    return (ch // s.patch) * (cw // s.patch) // (s.merge ** 2)
+
+
+def _resize_uint8(img, size: tuple[int, int]):
+    """[3, H, W] uint8 -> [3, h, w] uint8, bicubic with antialiasing: torchvision's ``resize`` when installed (what the
+    transformers backend calls), else the same ``interpolate`` call it makes on CPU (native uint8 bicubic)."""
+
+    import torch
+
+    if tuple(img.shape[-2:]) == tuple(size):
+        return img
+    try:
+        from torchvision.transforms.v2 import functional as tvF
+
+        return tvF.resize(img, list(size), interpolation=tvF.InterpolationMode.BICUBIC, antialias=True)
+    except ImportError:
+        out = torch.nn.functional.interpolate(img[None], size=list(size), mode="bicubic", align_corners=False,
+                                              antialias=True)
+        return out[0]
+
+
+@dataclass
+class Prepared:
+    """One image, preprocessed: the patches the tower reads, its grid, rows and digest."""
+
+    pixels: Any                          # torch.float32 [grid_h * grid_w, 3 * temporal * patch * patch]
+    grid: tuple[int, int, int]           # (1, grid_h, grid_w) in patches
+    tokens: int                          # rows in the prompt (grid_h * grid_w / merge^2)
+    digest: bytes                        # SHA-256 of the canvas, the grid and the settings
+    size: tuple[int, int]                # the decoded image's (height, width)
+    vids: list[int] = field(default_factory=list)
+
+
+def preprocess(image, s: Settings, max_tokens: int | None = None) -> Prepared:
+    """A decoded RGB ``PIL.Image`` -> ``Prepared`` exactly as ``Glm5NextImageProcessor`` (torchvision backend)."""
+
+    import numpy as np
+    import torch
+
+    if image.mode != "RGB":
+        image = image.convert("RGB")
+    arr = torch.from_numpy(np.asarray(image, dtype=np.uint8).copy()).permute(2, 0, 1).contiguous()   # pil_to_tensor
+    height, width = int(arr.shape[1]), int(arr.shape[2])
+    most = s.max_tokens if max_tokens is None else max_tokens
+    target_h, target_w, content_h, content_w = canvas_size(height, width, s, most)
+    if (content_h, content_w) != (height, width):
+        arr = _resize_uint8(arr, (content_h, content_w))
+    if (content_h, content_w) != (target_h, target_w):
+        arr = torch.nn.functional.pad(arr, (0, target_w - content_w, 0, target_h - content_h), value=0)
+    canvas = arr.contiguous()
+    # fused rescale + normalize (transformers' TorchvisionBackend.rescale_and_normalize -> tvF.normalize)
+    mean = torch.tensor(s.mean) * (1.0 / s.rescale)
+    std = torch.tensor(s.std) * (1.0 / s.rescale)
+    x = canvas.to(torch.float32)
+    x = (x - mean[:, None, None]) / std[:, None, None]
+    p, m, t = s.patch, s.merge, s.temporal
+    gh, gw = target_h // p, target_w // p
+    x = x.reshape(1, 3, gh // m, m, p, gw // m, m, p).permute(0, 2, 5, 3, 6, 1, 4, 7)
+    x = x.unsqueeze(6).expand(-1, -1, -1, -1, -1, -1, t, -1, -1).reshape(gh * gw, 3 * t * p * p)
+    h = hashlib.sha256(VERSION)
+    h.update(s.key())
+    h.update(json.dumps([target_h, target_w, gh, gw]).encode())
+    h.update(canvas.numpy().tobytes())
+    return Prepared(x.contiguous(), (1, gh, gw), gh * gw // (m * m), h.digest(), (height, width))
+
+
+# -- fetching and decoding -------------------------------------------------------------------------------------------
+def load_bytes(url: str, s: Settings) -> bytes:
+    """A part's image bytes: a ``data:`` URL, or (GLM53_TF_VISION_FETCH=1) an ``http(s)`` download."""
+
+    if not isinstance(url, str) or not url:
+        raise VisionError("an image part needs a URL (image_url.url)")
+    if url.startswith("data:"):
+        head, sep, data = url.partition(",")
+        if not sep:
+            raise VisionError("a data: URL without a comma")
+        if ";base64" not in head:
+            raw = urllib.parse.unquote_to_bytes(data)
+        else:
+            if len(data) > (s.max_bytes * 4) // 3 + 8:
+                raise VisionError(f"image larger than {s.max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+            try:
+                raw = base64.b64decode(data.strip(), validate=False)
+            except (binascii.Error, ValueError):
+                raise VisionError("the data: URL is not valid base64") from None
+        if len(raw) > s.max_bytes:
+            raise VisionError(f"image larger than {s.max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+        return raw
+    scheme = urllib.parse.urlsplit(url).scheme.lower()
+    if scheme not in ("http", "https"):
+        raise VisionError(f"image URL scheme {scheme or '(none)'!r}: only data:, http and https are accepted")
+    if not s.fetch:
+        raise VisionError("this server does not fetch image URLs (GLM53_TF_VISION_FETCH=0): send a data: URL")
+    req = urllib.request.Request(url, headers={"User-Agent": "tensorfold-glm53-vision/1"})
+    try:
+        with urllib.request.urlopen(req, timeout=s.fetch_timeout) as r:
+            size = r.headers.get("Content-Length")
+            if size is not None and size.isdigit() and int(size) > s.max_bytes:
+                raise VisionError(f"image larger than {s.max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+            raw = r.read(s.max_bytes + 1)
+    except VisionError:
+        raise
+    except Exception as exc:                        # URLError, HTTPError, timeouts, ...
+        raise VisionError(f"could not fetch the image URL: {exc}") from None
+    if len(raw) > s.max_bytes:
+        raise VisionError(f"image larger than {s.max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+    return raw
+
+
+def decode(raw: bytes, s: Settings):
+    """Bytes -> an RGB ``PIL.Image`` (vLLM's conversion: transparency composited on white)."""
+
+    from PIL import Image
+
+    try:
+        img = Image.open(io.BytesIO(raw))
+        w, h = img.size
+        if w * h > s.max_pixels:
+            raise VisionError(f"image of {w}x{h} pixels: more than {s.max_pixels} (GLM53_TF_VISION_MAX_PIXELS)")
+        if getattr(img, "n_frames", 1) > 1:
+            img.seek(0)                              # an animated image: its first frame
+        img.load()
+    except VisionError:
+        raise
+    except Exception as exc:
+        raise VisionError(f"could not decode the image: {exc}") from None
+    return to_rgb(img)
+
+
+def to_rgb(img):
+    from PIL import Image
+
+    if img.mode == "RGB":
+        return img
+    if img.mode == "P" and "transparency" in img.info:
+        img = img.convert("RGBA")
+    if img.mode in ("RGBA", "LA", "PA"):
+        rgba = img.convert("RGBA")
+        bg = Image.new("RGBA", rgba.size, (255, 255, 255, 255))
+        return Image.alpha_composite(bg, rgba).convert("RGB")
+    return img.convert("RGB")
+
+
+# -- content parts ---------------------------------------------------------------------------------------------------
+@dataclass
+class Ref:
+    """One image part: where it is and how much detail was asked."""
+
+    url: str
+    detail: str | None = None
+
+
+def part_ref(part: Any) -> Ref | None:
+    """An image content part's reference, None for any other part. Raises for a malformed image part."""
+
+    if not isinstance(part, dict) or part.get("type") not in IMAGE_TYPES:
+        return None
+    kind = part["type"]
+    val = part.get("image_url") if kind != "image" else (part.get("image") or part.get("image_url") or part.get("url"))
+    if kind == "input_image" and val is None:
+        val = part.get("url")
+    detail = part.get("detail")
+    if isinstance(val, dict):
+        detail = val.get("detail", detail)
+        val = val.get("url")
+    if not isinstance(val, str) or not val:
+        raise VisionError(f"an {kind} part needs a URL string")
+    return Ref(val, str(detail).lower() if detail is not None else None)
+
+
+def markup(messages: list, nonce: str) -> tuple[list, list[Ref]]:
+    """``messages`` with every image part replaced by a text part holding a sentinel (``sentinel(nonce, i)``), and
+    the image references in that order. The input is not modified."""
+
+    out, refs = [], []
+    for m in messages:
+        content = m.get("content") if isinstance(m, dict) else None
+        if not isinstance(content, list):
+            out.append(m)
+            continue
+        parts = []
+        for part in content:
+            ref = part_ref(part)
+            if ref is None:
+                parts.append(part)
+                continue
+            parts.append({"type": "text", "text": sentinel(nonce, len(refs))})
+            refs.append(ref)
+        out.append(dict(m, content=parts))
+    return out, refs
+
+
+def sentinel(nonce: str, i: int) -> str:
+    return f"\x00tf-image-{nonce}-{i}\x00"
+
+
+def count_images(messages: Any) -> int:
+    if not isinstance(messages, list):
+        return 0
+    n = 0
+    for m in messages:
+        content = m.get("content") if isinstance(m, dict) else None
+        if isinstance(content, list):
+            n += sum(1 for p in content if isinstance(p, dict) and p.get("type") in IMAGE_TYPES)
+    return n
+
+
+def splice(text: str, nonce: str, count: int, s: Settings) -> tuple[str, list[int]]:
+    """The rendered text with each sentinel replaced by ``<|begin_of_image|><|image|><|end_of_image|>``, and the
+    indices of the images the template kept, in prompt order."""
+
+    order = []
+    out = text
+    positions = []
+    for i in range(count):
+        tag = sentinel(nonce, i)
+        at = out.find(tag)
+        if at >= 0:
+            positions.append((at, i))
+    for _, i in sorted(positions):
+        order.append(i)
+    for i in range(count):
+        out = out.replace(sentinel(nonce, i), PLACEHOLDER)
+    if "\x00tf-image-" in out:
+        raise VisionError("an image sentinel survived the chat template")
+    return out, order
+
+
+PLACEHOLDER = "<|begin_of_image|><|image|><|end_of_image|>"
+
+
+# -- virtual ids -----------------------------------------------------------------------------------------------------
+class Registry:
+    """Rank 0's recent virtual ids -> the image digest they were given to (LRU of ``cap`` ids): a new image whose ids
+    meet another image's is derived again with the next salt, so no two images seen in this process share an id."""
+
+    def __init__(self, cap: int = 1 << 18) -> None:
+        self.cap = cap
+        self.owner: OrderedDict[int, bytes] = OrderedDict()
+        self.salts: OrderedDict[bytes, int] = OrderedDict()
+        self.lock = threading.Lock()
+
+    def vids(self, digest: bytes, n: int) -> list[int]:
+        with self.lock:
+            salt = self.salts.get(digest, 0)
+            while True:
+                ids = derive(digest, n, salt)
+                clash = len(set(ids)) != n or any(self.owner.get(v, digest) != digest for v in ids)
+                if not clash:
+                    break
+                salt += 1
+            self.salts[digest] = salt
+            self.salts.move_to_end(digest)
+            while len(self.salts) > self.cap // 16:
+                self.salts.popitem(last=False)
+            for v in ids:
+                self.owner[v] = digest
+                self.owner.move_to_end(v)
+            while len(self.owner) > self.cap:
+                self.owner.popitem(last=False)
+            return ids
+
+
+def derive(digest: bytes, n: int, salt: int = 0) -> list[int]:
+    """Row k of an image: VBASE + a 31-bit hash of (digest, salt, k). Two different images share row k's id with
+    probability 2^-31, and a cached prefix ending j rows into an image matches another image's with 2^-31j."""
+
+    base = hashlib.sha256(digest + salt.to_bytes(4, "little")).digest()
+    out = []
+    for k in range(n):
+        h = hashlib.blake2b(base + k.to_bytes(4, "little"), digest_size=8).digest()
+        out.append(VBASE + int.from_bytes(h, "little") % VSPAN)
+    return out
+
+
+def expand(ids: Sequence[int], images: Sequence[Prepared], s: Settings, *, virtual: bool = True) -> list[int]:
+    """The rendered prompt's ids with each image's single ``<|image|>`` (between ``<|begin_of_image|>`` and
+    ``<|end_of_image|>``) replaced by its rows: its virtual ids, or (``virtual=False``, ``/tokenize``) N image
+    tokens. Every ``<|image|>`` of the prompt must be one of the images' (text cannot smuggle one in)."""
+
+    out: list[int] = []
+    k = 0
+    ids = [int(t) for t in ids]
+    for i, t in enumerate(ids):
+        if t != s.image_token:
+            out.append(t)
+            continue
+        framed = 0 < i < len(ids) - 1 and ids[i - 1] == s.begin_token and ids[i + 1] == s.end_token
+        if k >= len(images) or not framed:
+            raise VisionError("the prompt holds an image placeholder token (<|image|>) that is not an image part")
+        img = images[k]
+        out.extend(img.vids if virtual else [s.image_token] * img.tokens)
+        k += 1
+    if k != len(images):
+        raise VisionError(f"{len(images)} image(s) sent, {k} placed in the prompt by the chat template")
+    return out
+
+
+# -- a request's images ----------------------------------------------------------------------------------------------
+@dataclass
+class Request:
+    """A chat request's images, preprocessed, in prompt order (what the engine's vision tower reads)."""
+
+    images: list[Prepared]
+
+    @property
+    def extra(self) -> int:
+        """Prompt rows the images add past their one placeholder each."""
+
+        return sum(img.tokens - 1 for img in self.images)
+
+
+class Host:
+    """Rank 0's image front end: settings, the id registry, a small cache of decoded / preprocessed images."""
+
+    def __init__(self, model_dir: Path | None) -> None:
+        self.s = Settings.read(model_dir)
+        self.registry = Registry()
+        self.cache: OrderedDict[tuple[str, int], Prepared] = OrderedDict()
+        self.cache_bytes = 0
+        self.cache_cap = _env_int("GLM53_TF_VISION_PREP_MB", 256) * 1024 * 1024
+        self.lock = threading.Lock()
+
+    def prepare_ref(self, ref: Ref) -> Prepared:
+        most = self.s.budget(ref.detail)
+        key = (hashlib.sha256(ref.url.encode()).hexdigest(), most) if ref.url.startswith("data:") else None
+        if key is not None:
+            with self.lock:
+                hit = self.cache.get(key)
+                if hit is not None:
+                    self.cache.move_to_end(key)
+                    return hit
+        img = decode(load_bytes(ref.url, self.s), self.s)
+        prep = preprocess(img, self.s, most)
+        prep.vids = self.registry.vids(prep.digest, prep.tokens)
+        if key is not None:
+            with self.lock:
+                self.cache[key] = prep
+                self.cache_bytes += prep.pixels.numel() * 4
+                while self.cache_bytes > self.cache_cap and len(self.cache) > 1:
+                    _, old = self.cache.popitem(last=False)
+                    self.cache_bytes -= old.pixels.numel() * 4
+        return prep
+
+    def render(self, template, messages: list, *, tools, enable_thinking, extra) -> tuple[str, list[Ref]]:
+        """The chat template's text with image placeholders, and the image references it kept, in prompt order."""
+
+        nonce = secrets.token_hex(6)
+        marked, refs = markup(messages, nonce)
+        if len(refs) > self.s.max_images:
+            raise VisionError(f"{len(refs)} images in one request: at most {self.s.max_images} "
+                              "(GLM53_TF_VISION_MAX_IMAGES)")
+        text = template.render(marked, tools=tools, enable_thinking=enable_thinking, extra=extra)
+        text, order = splice(text, nonce, len(refs), self.s)
+        return text, [refs[i] for i in order]
+
+    def request(self, refs: list[Ref]) -> Request:
+        return Request([self.prepare_ref(r) for r in refs])
