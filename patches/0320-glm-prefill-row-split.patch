@@ -112,3 +141,27 @@ def check(comm) -> None:
     c = getattr(comm, "check", None)
     if c is not None:
         c()
+
+
+# -- patches/0320: row swaps between the two ranks (GLM53_TF_PREFILL_PP) ------------------------------------------------
+def swap(comm, sends: list[torch.Tensor], recvs: list[torch.Tensor]) -> None:
+    """Two ranks: ``sends[i]`` to the other rank's ``recvs[i]`` (``NCCL.swap``: send/recv in one group). A
+    communicator without ``swap`` (the RoCE one forwards to its NCCL base; test stand-ins) trades through its
+    all-gather: each pair padded to the larger of the two sizes, as bytes. Either way a copy."""
+
+    fn = getattr(comm, "swap", None)
+    if fn is not None:
+        fn(sends, recvs)
+        return
+    rank = comm.rank
+    for s, r in zip(sends, recvs):
+        sb, rb = s.contiguous().view(-1).view(torch.uint8), r.view(-1).view(torch.uint8)
+        n = max(sb.numel(), rb.numel())
+        if n == 0:
+            continue
+        pad = torch.zeros((n,), dtype=torch.uint8, device=s.device)
+        pad[:sb.numel()].copy_(sb)
+        both = torch.empty((2 * n,), dtype=torch.uint8, device=s.device)
+        comm.all_gather(pad, both)
+        other = both[(1 - rank) * n:(1 - rank) * n + rb.numel()]
+        rb.copy_(other)
