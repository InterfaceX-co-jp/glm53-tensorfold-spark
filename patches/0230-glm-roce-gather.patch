+# -- patches/0230: the model's exchanges, which GLM53_TF_COMM_BACKEND=roce may send over RoCE --------------------------
+def fast_gather(comm, send: torch.Tensor, recv: torch.Tensor) -> None:
+    """``comm.all_gather`` for an exchange of the model (partials, sampler candidates, drafter rows): the RoCE
+    communicator (``roce.RoceComm``) sends it over RoCE when it is small enough; any other communicator (NCCL, the
+    tests' stand-ins) gathers it as before. Control exchanges (settings, headers, prompts, calibration) keep calling
+    ``comm.all_gather``: they stay on NCCL, which may wait for the other rank forever."""
+
+    fast = getattr(comm, "all_gather_fast", None)
+    if fast is None:
+        comm.all_gather(send, recv)
+    else:
+        fast(send, recv)
+
+
+def check(comm) -> None:
+    """Raise if the communicator's RoCE runtime recorded a failure (a host memory read; no-op for NCCL). Called
+    after the samplers' exchanges have synchronized, so a timed-out step is never turned into tokens."""
+
+    c = getattr(comm, "check", None)
+    if c is not None:
+        c()
