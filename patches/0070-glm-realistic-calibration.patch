+"""Draft cost calibration on real text, and its optional online refinement (patches/0070).
+
+Why. ``GlmEngine._calibrate`` prices a verify window of R rows for ``decode.DrafterChoice`` and the prompt-lookup
+gate (``lookup.py``). Upstream times those windows on uniformly random token ids. On a MoE model an extra row
+costs mostly the experts it adds to the window, and random ids route to nearly independent experts, while the
+consecutive tokens of real text share many of theirs; so random windows overprice every row past the first (the
+real model calibrated 30.0, 40.0, 44.7, ... ms for 1, 2, 3, ... rows: +10 ms for the second row), and every choice
+that weighs a deeper window against its cost drafts too little.
+
+Load time (``GLM53_TF_CALIB``):
+
+- ``real`` (the default): rank 0 tokenizes ``TEXT`` (prose and code) with the checkpoint's ``tokenizer.json`` and
+  shares the ids with rank 1 (``GlmEngine._share``), so both ranks prefill the same prompt; without a tokenizer
+  (the synthetic test checkpoints) the prompt is ``fallback_ids``. The model then decodes ``SPANS x MAX_ROWS``
+  tokens greedily from it, and every window is timed on the model's own consecutive continuation tokens at their
+  own positions: span s prefills the prompt and the first s x MAX_ROWS continuation tokens, then times windows of
+  1 to MAX_ROWS of the next ones (exactly the window a fully accepted round verifies there). A window's cost is
+  the mean over the spans of its fastest run.
+- ``random``: upstream (uniform random ids, the same seed), for A/B.
+
+Either way each piece's time is the slower rank's (an all-gather, then the maximum), so both ranks hold the same
+table: the maximum over the same gathered numbers is the same float on both.
+
+Online (``GLM53_TF_CALIB_ONLINE=1``, off by default): rank 0 keeps an exponential moving average of the verify
+windows it actually runs in ``decode.auto_decode``, per window size (``OnlineCosts``). Before each request rank 0
+freezes its current table into integer microseconds and sends it in the request header (``GlmEngine._share``);
+both ranks decode the same integers into the same floats and use that table, unchanged, for the whole request.
+Rank 1's own timings never enter any decision. Not used with GLM53_TF_BATCH > 1 (batched rounds keep the
+load-time table).
+
+No torch here: the unit tests run anywhere.
+"""
+
+from __future__ import annotations
+
+import os
+import statistics
+from pathlib import Path
+from typing import Sequence
+
+MODES = ("random", "real")
+SPANS = 3                 # continuation spans a window size is timed on (real mode)
+PROMPT_MAX = 256          # tokens of TEXT kept
+
+# A short fixed text of the kinds this server decodes: prose, a numbered explanation, and code with a docstring.
+TEXT = """The committee met on Tuesday to review the quarterly results. Revenue grew by eleven percent, driven mostly
+by the new subscription plans, while operating costs stayed flat. Two questions remained open: whether to expand
+the support team before the summer, and how to price the enterprise tier for customers with more than fifty seats.
+
+Here is a short function that answers the second question from the usage data:
+
+```python
+def enterprise_price(seats: int, base: float = 12.0, discount: float = 0.15) -> float:
+    \"\"\"Monthly price for a team: the first fifty seats at the base rate, the rest discounted.\"\"\"
+    if seats <= 50:
+        return seats * base
+    return 50 * base + (seats - 50) * base * (1.0 - discount)
+
+
+for team in (10, 50, 120):
+    print(f"{team} seats: ${enterprise_price(team):,.2f} a month")
+```
+
+In summary, the pricing keeps small teams unchanged and rewards larger ones, and the"""
+
+
+def mode() -> str:
+    """GLM53_TF_CALIB: ``real`` (default) or ``random`` (upstream)."""
+
+    m = os.environ.get("GLM53_TF_CALIB", "real").strip().lower() or "real"
+    if m not in MODES:
+        raise ValueError(f"GLM53_TF_CALIB={m!r}: expected one of {', '.join(MODES)}")
+    return m
+
+
+def online() -> bool:
+    """GLM53_TF_CALIB_ONLINE (default 0): refine the verify windows' costs from the windows rounds run."""
+
+    return os.environ.get("GLM53_TF_CALIB_ONLINE", "0").strip().lower() not in ("0", "false", "off", "no", "")
+
+
+def fallback_ids(vocab: int, n: int = 64) -> list[int]:
+    """A fixed prompt without a tokenizer: ids spread over the vocabulary by a fixed rule (no rng state)."""
+
+    return [(7919 * (i + 1) + 104729) % max(vocab - 2, 1) + 1 for i in range(n)]
+
+
+def prompt_ids(model_dir: Path | None, vocab: int) -> list[int]:
+    """``TEXT`` in the checkpoint's own tokens (``tokenizer.json``), or ``fallback_ids`` when there is none.
+    Called on rank 0 only; the engine shares the result."""
+
+    ids: list[int] = []
+    path = Path(model_dir) / "tokenizer.json" if model_dir is not None else None
+    if path is not None and path.is_file():
+        try:
+            from tokenizers import Tokenizer
+
+            ids = list(Tokenizer.from_file(str(path)).encode(TEXT, add_special_tokens=False).ids)
+        except Exception:            # noqa: BLE001 - any tokenizer trouble: the fixed ids below
+            ids = []
+    ids = [int(t) for t in ids if 0 <= int(t) < vocab][:PROMPT_MAX]
+    return ids if len(ids) >= 16 else fallback_ids(vocab)
+
+
+def slower(names: Sequence[str], gathered: Sequence[float]) -> dict[str, float]:
+    """Each piece's time as the slower rank's, from the all-gathered [rank 0's times..., rank 1's times...]. A
+    function of the gathered list only, which is the same on both ranks."""
+
+    n = len(names)
+    return {k: max(float(gathered[i]), float(gathered[n + i])) for i, k in enumerate(names)}
+
+
+def fit_line(rows: Sequence[int], ys: Sequence[float]) -> tuple[float, float]:
+    """(base, slope) of the line through (rows, ys): median of pairwise slopes, then the median intercept (as
+    upstream fits the windows of 2 rows and more)."""
+
+    slope = statistics.median((ys[j] - ys[i]) / (rows[j] - rows[i]) for i in range(len(rows))
+                              for j in range(i + 1, len(rows)))
+    base = statistics.median(y - slope * r for r, y in zip(rows, ys))
+    return base, slope
+
+
+def window_costs(both: dict[str, float], most: int, spans: int) -> list[float]:
+    """Verify windows of 1 to ``most`` rows from the reconciled pieces: ``v{r}`` (random mode) or ``v{r}_{s}``
+    per span s (real mode, averaged over the spans); the windows of 2 rows and more on their fitted line."""
+
+    if spans:
+        v = {r: statistics.fmean(both[f"v{r}_{s}"] for s in range(spans)) for r in range(1, most + 1)}
+    else:
+        v = {r: both[f"v{r}"] for r in range(1, most + 1)}
+    rows = list(range(2, most + 1))
+    base, slope = fit_line(rows, [v[r] for r in rows])
+    return [v[1]] + [base + slope * r for r in rows]
+
+
+# -- online refinement (rank 0) ------------------------------------------------------------------------------------
+US = 1000.0               # the header carries milliseconds as integer microseconds
+
+
+def encode_table(verify: Sequence[float]) -> list[int]:
+    return [max(1, min(int(round(float(v) * US)), 10**9)) for v in verify]
+
+
+def decode_table(ints: Sequence[int]) -> list[float]:
+    return [int(v) / US for v in ints]
+
+
+def with_table(costs: dict, ints: Sequence[int]) -> dict:
+    """``costs`` with its verify windows replaced by a table from the header (unchanged for an empty table)."""
+
+    if not ints:
+        return costs
+    out = dict(costs)
+    out["verify"] = decode_table(ints)
+    return out
+
+
+class OnlineCosts:
+    """Rank 0's running verify-window costs: an EMA per window size seeded with the load-time table (which counts
+    as one sample). ``observe`` after each verify window; ``table`` freezes the current estimate for a request."""
+
+    def __init__(self, verify: Sequence[float], *, alpha: float | None = None, least: int | None = None) -> None:
+        self.base = [float(v) for v in verify]
+        self.ema = list(self.base)
+        self.n = [0] * len(self.base)
+        self.alpha = float(os.environ.get("GLM53_TF_CALIB_EMA", "0.05")) if alpha is None else float(alpha)
+        self.least = int(os.environ.get("GLM53_TF_CALIB_MIN", "8")) if least is None else int(least)
+        if not 0.0 < self.alpha <= 1.0 or self.least < 1:
+            raise ValueError(f"GLM53_TF_CALIB_EMA={self.alpha} (0 to 1) / GLM53_TF_CALIB_MIN={self.least} (>= 1)")
+
+    def observe(self, rows: int, ms: float) -> None:
+        """A verify window of ``rows`` rows took ``ms``. A sample counts as at most 1.5 times (at least half) the
+        current estimate, so a slow moment (page migration) moves the estimate by at most alpha / 2 of itself."""
+
+        i = int(rows) - 1
+        if not 0 <= i < len(self.ema) or not ms > 0.0:
+            return
+        est = self.ema[i]
+        x = min(max(float(ms), 0.5 * est), 1.5 * est)
+        a = max(self.alpha, 1.0 / (self.n[i] + 2))
+        self.ema[i] = est + a * (x - est)
+        self.n[i] += 1
+
+    def current(self) -> list[float]:
+        """Measured sizes (at least ``least`` windows) at their EMA; the others from the line through the
+        measured sizes of 2 rows and more (or the load-time value shifted by the one measured size's change),
+        then made non-decreasing in the row count."""
+
+        seen = [self.n[i] >= self.least for i in range(len(self.ema))]
+        out = [self.ema[i] if seen[i] else self.base[i] for i in range(len(self.ema))]
+        rows = [i + 1 for i in range(1, len(self.ema)) if seen[i]]
+        if len(rows) >= 2:
+            base, slope = fit_line(rows, [self.ema[r - 1] for r in rows])
+            for i in range(1, len(out)):
+                if not seen[i]:
+                    out[i] = base + slope * (i + 1)
+        elif len(rows) == 1:
+            shift = self.ema[rows[0] - 1] - self.base[rows[0] - 1]
+            for i in range(1, len(out)):
+                if not seen[i]:
+                    out[i] = self.base[i] + shift
+        for i in range(1, len(out)):
+            out[i] = max(out[i], out[i - 1])
+        return out
+
+    def table(self) -> list[int]:
+        return encode_table(self.current())
