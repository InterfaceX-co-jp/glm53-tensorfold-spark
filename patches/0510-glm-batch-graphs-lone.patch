diff --git i/src/tensorfold/families/glm5_next/cuda/vsplit.py w/src/tensorfold/families/glm5_next/cuda/vsplit.py
new file mode 100644
index 0000000..a90830c
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/vsplit.py
@@ -0,0 +1,255 @@
+"""patches/0510: the lone verify forward's CUDA graph in pieces, and a launch probe (both off by default).
+
+THEORY-2 §1.2: at one stream, ~1.1 ms a round of GPU idle sits inside ``cudaGraphLaunch`` of the ~1,650-node verify
+graph (the host is in the call, the graph's first kernel starts only when it returns; measured under nsys node
+tracing, which inflates it). Two knobs:
+
+- ``GLM53_TF_VERIFY_SPLIT=N`` (0 / 1 = off; 2-8): the engine's main graphs (``Graphs.main``: the lone verify / serial
+  step, and patches/0050's long-context main graphs) are captured as N graphs over consecutive layer ranges, replayed
+  back to back. The first piece (~1/N of the nodes) launches in ~1/N of the time and runs while the host launches
+  the rest. The pieces run exactly ``forward._compute``'s kernels in its order (``compute_pieces``; each piece ends
+  with the prefetch side stream's join, a wait only), so the bits are the unsplit graph's.
+- ``GLM53_TF_GRAPH_PROBE=N`` (0 = off): every main-graph replay is timed without per-node tracing: the host time of
+  each piece's ``replay()`` and the first node's start. A stamp kernel (``%globaltimer``) is captured as node 0 of the
+  first piece; an eager stamp right before the replay marks when the (idle) stream could have started. First-node
+  delay = node 0 stamp - eager stamp - the host time between the eager stamp's launch returning and ``replay()``.
+  Every N probed replays rank 0 (and 1) prints one line per graph key: replay host us and first-node delay us
+  (p50 / p90). One sync every N replays; the stamps write only the probe's own buffer (same bits).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+
+import torch
+
+SPLIT_MAX = 8
+
+
+def split_env(env=None) -> int:
+    """GLM53_TF_VERIFY_SPLIT -> pieces (1 = off)."""
+
+    env = os.environ if env is None else env
+    raw = str(env.get("GLM53_TF_VERIFY_SPLIT", "") or "0").strip().lower()
+    if raw in ("0", "1", "off", "no", "false", ""):
+        return 1
+    try:
+        n = int(raw)
+    except ValueError:
+        n = -1
+    if not 2 <= n <= SPLIT_MAX:
+        raise ValueError(f"GLM53_TF_VERIFY_SPLIT={raw!r}: expected 0 (off) or 2..{SPLIT_MAX} pieces")
+    return n
+
+
+def probe_env(env=None) -> int:
+    """GLM53_TF_GRAPH_PROBE -> replays between reports (0 = off)."""
+
+    env = os.environ if env is None else env
+    raw = str(env.get("GLM53_TF_GRAPH_PROBE", "") or "0").strip()
+    try:
+        n = int(raw)
+    except ValueError:
+        n = -1
+    if n < 0:
+        raise ValueError(f"GLM53_TF_GRAPH_PROBE={raw!r}: expected 0 (off) or the replays between reports")
+    return n
+
+
+def split_bounds(n_layers: int, n: int, first: int | None = None) -> list[tuple[int, int]]:
+    """Layer ranges [lo, hi) of ``n`` pieces over ``n_layers`` layers, in order, covering every layer once. ``first``
+    (default: an even share) is the first piece's layer count: a short first piece starts the GPU soonest; the rest
+    share the remaining layers evenly (earlier pieces take the remainder)."""
+
+    if n_layers < 1 or n < 1:
+        raise ValueError(f"split_bounds({n_layers}, {n})")
+    n = min(n, n_layers)
+    if n == 1:
+        return [(0, n_layers)]
+    if first is None:
+        first = n_layers // n
+    first = max(1, min(int(first), n_layers - (n - 1)))
+    left, m = n_layers - first, n - 1
+    out, lo = [(0, first)], first
+    for i in range(m):
+        size = left // m + (1 if i < left % m else 0)
+        out.append((lo, lo + size))
+        lo += size
+    return out
+
+
+def compute_pieces(w, st, b, R: int, n: int, *, npb: int | None = None) -> list:
+    """``forward.compute(w, st, b, R, npb=npb)`` (logits on, no head_rows, capturable) as ``n`` callables over
+    consecutive layer ranges: the first also embeds, the last also takes the final stream mean, norm and head. Each
+    piece ends with ``forward._join`` (the prefetch side stream joined: a capture cannot end with an open fork; a
+    wait only). Called in order they launch exactly ``_compute``'s kernels in its order."""
+
+    from . import forward, glue, profile, qmm
+
+    c = w.cfg
+    layers = list(w.layers)
+    bounds = split_bounds(len(layers), n, first=_first_env(len(layers), n))
+
+    def piece(lo: int, hi: int, is_first: bool, is_last: bool):
+        def run():
+            if is_first:
+                glue.embed(b.ids[:R], w.embed, c.hidden, c.streams, b.x[:R])
+                if profile.ON:
+                    profile.lap("embed")
+            for layer in layers[lo:hi]:
+                forward.layer_forward(layer, w, st, b, R, None, None, npb)
+                for slot in b.tap_at.get(layer.index, ()):
+                    glue.stream_mean(b.x[:R], b.taps[slot][:R])
+            if is_last:
+                glue.stream_mean(b.x[:R], b.hidden[:R])
+                if profile.ON:
+                    profile.lap("hc")
+                glue.rmsnorm(b.hidden[:R], w.norm, c.eps, b.fnormed[:R], b.fxs[:R])
+                qmm.matmul(b.fnormed[:R], w.head, b.fxs[:R], out=b.logits[:R], part=b.sk)
+                if profile.ON:
+                    profile.lap("head")
+            forward._join(w)
+        return run
+
+    return [piece(lo, hi, i == 0, i == len(bounds) - 1) for i, (lo, hi) in enumerate(bounds)]
+
+
+def _first_env(n_layers: int, n: int) -> int | None:
+    """GLM53_TF_VERIFY_SPLIT_FIRST=L: the first piece's layer count (default: an even share)."""
+
+    raw = os.environ.get("GLM53_TF_VERIFY_SPLIT_FIRST", "").strip()
+    return int(raw) if raw else None
+
+
+# -- the probe -----------------------------------------------------------------------------------------------------
+_stamp_kernel = None
+
+
+def _stamp_fn():
+    global _stamp_kernel
+    if _stamp_kernel is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit
+        def _stamp(OUT, IDX):
+            # the asm of triton.language.extra.cuda.globaltimer()
+            t = tl.inline_asm_elementwise("mov.u64 $0, %globaltimer;", "=l", [], dtype=tl.int64, is_pure=False,
+                                          pack=1)
+            tl.store(OUT + IDX, t)
+
+        _stamp_kernel = _stamp
+    return _stamp_kernel
+
+
+def delays_us(pre_ns, node0_ns, gap_ns) -> list[float]:
+    """First-node delays (us): node 0's stamp - the eager stamp - the host time between the eager stamp's launch
+    returning and the first ``replay()`` call (the stream was idle, so what is left is the launch's exposure)."""
+
+    return [((n0 - p) - g) / 1e3 for p, n0, g in zip(pre_ns, node0_ns, gap_ns)]
+
+
+def pct(xs, q: float) -> float:
+    s = sorted(xs)
+    if not s:
+        return float("nan")
+    k = min(len(s) - 1, max(0, int(round(q * (len(s) - 1)))))
+    return s[k]
+
+
+class Probe:
+    """Ring of (eager stamp, node-0 stamp) pairs on the device + host times; ``report`` every ``every`` replays."""
+
+    RING = 4096
+
+    def __init__(self, every: int, device, rank: int = 0) -> None:
+        self.every = max(1, int(every))
+        self.rank = rank
+        self.node0 = torch.zeros((1,), dtype=torch.int64, device=device)       # node 0's stamp (a static address)
+        self.ring = torch.zeros((self.RING, 2), dtype=torch.int64, device=device)
+        self.rows: dict = {}                    # key -> [ (i, gap_ns, [piece host ns]) ]
+        self.n = 0
+
+    def stamp_node(self) -> None:
+        """At capture, as the first piece's node 0."""
+
+        _stamp_fn()[(1,)](self.node0, 0, num_warps=1)
+
+    def replay(self, key, graphs) -> None:
+        i = self.n % self.RING
+        self.n += 1
+        _stamp_fn()[(1,)](self.ring[i], 0, num_warps=1)
+        t0 = time.perf_counter_ns()             # the eager stamp's launch has returned
+        host, gap = [], 0
+        for j, g in enumerate(graphs):
+            a = time.perf_counter_ns()
+            if j == 0:
+                gap = a - t0
+            g.replay()
+            host.append(time.perf_counter_ns() - a)
+        self.ring[i, 1].copy_(self.node0[0])    # node 0's stamp of this replay, before the next overwrites it
+        self.rows.setdefault(key, []).append((i, gap, host))
+        if self.n % self.every == 0 or self.n % self.RING == 0:
+            self.report()
+
+    def report(self) -> None:
+        if not self.rows:
+            return
+        torch.cuda.synchronize()
+        ring = self.ring.cpu().tolist()
+        for key, items in sorted(self.rows.items(), key=lambda kv: str(kv[0])):
+            d = delays_us([ring[i][0] for i, _, _ in items], [ring[i][1] for i, _, _ in items],
+                          [gap for _, gap, _ in items])
+            tot = [sum(h) / 1e3 for _, _, h in items]
+            first = [h[0] / 1e3 for _, _, h in items]
+            print(f"[tensorfold] graph probe (patches/0510) r{self.rank} {key} pieces={len(items[0][2])} "
+                  f"n={len(items)}: replay host us p50 {pct(tot, .5):.0f} p90 {pct(tot, .9):.0f} (first piece p50 "
+                  f"{pct(first, .5):.0f}); first node +us p50 {pct(d, .5):.0f} p10 {pct(d, .1):.0f} "
+                  f"p90 {pct(d, .9):.0f}", file=sys.stderr, flush=True)
+        self.rows = {}
+
+
+class Split:
+    """A main graph as pieces (or one graph with the probe's stamp): ``replay`` runs them in order."""
+
+    def __init__(self, graphs, key=None, probe: Probe | None = None) -> None:
+        self.graphs = list(graphs)
+        self.key = key
+        self.probe = probe
+
+    def replay(self) -> None:
+        if self.probe is not None:
+            self.probe.replay(self.key, self.graphs)
+            return
+        for g in self.graphs:
+            g.replay()
+
+
+def capture(fns, pool, *, key=None, probe: Probe | None = None, error_mode: str | None = None) -> Split:
+    """Each callable in ``fns`` captured as its own graph (the probe's stamp first in the first one)."""
+
+    graphs = []
+    for i, f in enumerate(fns):
+        if i:
+            torch.cuda.synchronize()            # every capture starts after a device sync (roce._order's rule)
+        g = torch.cuda.CUDAGraph()
+        kw = {"pool": pool}
+        if error_mode:
+            kw["capture_error_mode"] = error_mode
+        with torch.cuda.graph(g, **kw):
+            if i == 0 and probe is not None:
+                probe.stamp_node()
+            f()
+        graphs.append(g)
+    return Split(graphs, key, probe)
+
+
+def describe(n: int, probe_every: int) -> str:
+    parts = []
+    if n > 1:
+        parts.append(f"lone verify graphs in {n} pieces (GLM53_TF_VERIFY_SPLIT)")
+    if probe_every:
+        parts.append(f"graph launch probe every {probe_every} replays (GLM53_TF_GRAPH_PROBE)")
+    return "; ".join(parts)
