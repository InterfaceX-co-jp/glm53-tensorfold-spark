diff --git c/src/tensorfold/families/glm5_next/cuda/decode_stream.py i/src/tensorfold/families/glm5_next/cuda/decode_stream.py
new file mode 100644
index 0000000..35ebb45
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/decode_stream.py
@@ -0,0 +1,367 @@
+"""Streaming decode kernels for GLM-5.3-Flash (patches/0440): the two bandwidth kernels of a decode / verify / MTP
+window -- the EXL3 routed experts (``exl3_mm.routed``) and the 4-bit dense matmuls (``qmm.matmul``) -- as persistent
+kernels that keep several k steps of weights in flight per warp across work items, with the bits of the kernels they
+replace for every row count.
+
+Knobs (every one off by default; each rank reads its own, and ranks may differ without changing a bit):
+
+``GLM53_TF_DEC_EXPERTS=1``         windows whose expert member table has <= 64 columns (every decode, verify and MTP
+                                   window, 4-slot batched windows included) run ``exl3_stream.cu``: exl3.cu's rot_in,
+                                   then one persistent kernel for gate and up (+ the gate/up epilogue, run by the last
+                                   item of each (expert, 128-column block)) and one for down (+ its epilogue).
+``GLM53_TF_DEC_EXPERTS_CFG``       "nt_gu,stages_gu,nt_dn,stages_dn" (default "4,4,4,4"): column tiles an item and
+                                   ring stages a warp, for gate/up and down. Place work only.
+``GLM53_TF_DEC_QMM=1``             4-bit matmuls of 1-64 rows (with the forward's partial buffer when K is split) run
+                                   ``q4_stream.cu``: one persistent kernel, the K slices reduced in the same launch.
+                                   Only under a Triton that fuses ``_qmm``'s epilogue everywhere (3.7.x, the image's;
+                                   ``qmm_reference_fused``); ``force`` skips that check (measurements only).
+``GLM53_TF_DEC_QMM_CFG``           "groups_a_stage,stages" for 1-16 rows (default "1,4"). Places work only.
+``GLM53_TF_DEC_QMM_SERIAL``        auto (default): a work item is a whole 64-column tile (its K slices one after the
+                                   other, added in registers) when the matrix has >= 96 tiles, a (tile, K slice)
+                                   otherwise (the slices added by the last one to finish); 1 / 0 force either. The
+                                   same sum in the same order either way (``_reduce``'s), so it places work only.
+``GLM53_TF_DEC_CTAS``              0 (default): one CTA every resident slot; N: at most N CTAs (the overlap stream).
+``GLM53_TF_DEC_PDL=1``             launch both as programmatic dependents (sm_90+): each CTA prefetches its first
+                                   item's weights into L2, then waits for the previous kernel (griddepcontrol.wait).
+
+Exactness: every output element keeps its instruction sequence (docs/DECODE-KERNELS.md section 3):
+
+- experts: exl3.cu's work item (16 member rows x one K split x NT column tiles; warp w runs the split's k tiles
+  w * PW .. w * PW + PW - 1 in order, one mma.m16n8k16 a k tile and n8 half, from +0.0), the warps added in order
+  0-3, Z stored per (matrix, split, row), and the epilogues' code (splits summed in order from 0.f). exl3_mm's
+  warps (4) and K splits (GATEUP_CFG / DOWN_CFG) are the arithmetic; column tiles and stages place work.
+- dense: ``_qmm``'s chain as Triton compiles it -- per 64-input group, four chained mma.m16n8k16 (bf16) from +0.0,
+  then acc = fma(xs, b, fma(p, s, acc)) -- over qmm.split_k's K slices, the slices added in order (``_reduce``),
+  rounded once (cvt.rn) to bf16 or kept fp32.
+
+So a decode row, a verify row, an MTP row and a row of an exact prefill chunk give the bits they give today, and
+drafted == serial, batched == alone and resumed == fresh hold as before. Not used by fast-prefill chunks (their
+kernels are exl3_fast.cu / fast_qmm.py) or windows past 64 rows.
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from . import exl3_mm, qmm
+
+ENV_EXPERTS = "GLM53_TF_DEC_EXPERTS"
+ENV_QMM = "GLM53_TF_DEC_QMM"
+MAX_MEMBERS = 64                         # member table columns (4 member tiles)
+MAX_EXTRA = 1024                         # exl3_stream.cu: live (member tile >= 1, expert) pairs it can list
+QMM_ROWS = 64                            # q4_stream.cu: up to 4 row tiles
+COUNTER_SLOTS = 8192                     # q4_stream.cu tickets (one a 64-column tile)
+
+EXPERTS_NT = (2, 4, 8)
+EXPERTS_STAGES = {2: (4, 6, 8), 4: (4, 6), 8: (3,)}
+QMM_CFGS = ((1, 4), (1, 6), (1, 8), (2, 4))          # (groups a stage, stages) for 1-16 rows
+
+
+def _env(name: str, default: str) -> str:
+    return os.environ.get(name, default).strip().lower()
+
+
+def _on(v: str) -> bool:
+    return v not in ("", "0", "false", "no", "off")
+
+
+def _ints(name: str, default: str, n: int) -> tuple[int, ...]:
+    raw = _env(name, default)
+    try:
+        vals = tuple(int(v) for v in raw.split(","))
+    except ValueError:
+        vals = ()
+    if len(vals) != n:
+        raise ValueError(f"{name}={os.environ.get(name)!r}: expected {n} comma-separated integers")
+    return vals
+
+
+def qmm_reference_fused() -> bool:
+    """Whether this Triton compiles ``qmm._qmm``'s epilogue as q4_stream.cu computes it (two fmas an element and group,
+    every shape and row bucket): true for the image's 3.7.x (tests/test_decode_kernels_compile.py checks it). Triton
+    3.8's LLVM leaves a quarter of the accumulator slots unfused (mul + add) for some shapes, so there the dense kernel
+    would not keep ``_qmm``'s bits and stays off (GLM53_TF_DEC_QMM=force overrides, for measurements only)."""
+
+    try:
+        import triton
+    except ImportError:
+        return False
+    return triton.__version__.startswith("3.7.")
+
+
+def parse() -> dict:
+    """The knobs, validated (a bad value refuses to start rather than silently running something else)."""
+
+    ecfg = _ints("GLM53_TF_DEC_EXPERTS_CFG", "4,4,4,4", 4)
+    for nt, st in ((ecfg[0], ecfg[1]), (ecfg[2], ecfg[3])):
+        if nt not in EXPERTS_NT or st not in EXPERTS_STAGES[nt]:
+            raise ValueError(f"GLM53_TF_DEC_EXPERTS_CFG={os.environ.get('GLM53_TF_DEC_EXPERTS_CFG')!r}: "
+                             f"(column tiles, stages) must be one of "
+                             f"{sorted((n, s) for n in EXPERTS_NT for s in EXPERTS_STAGES[n])}")
+    qcfg = _ints("GLM53_TF_DEC_QMM_CFG", "1,4", 2)
+    if qcfg not in QMM_CFGS:
+        raise ValueError(f"GLM53_TF_DEC_QMM_CFG={os.environ.get('GLM53_TF_DEC_QMM_CFG')!r}: one of {QMM_CFGS}")
+    serial = _env("GLM53_TF_DEC_QMM_SERIAL", "auto")
+    if serial not in ("auto", "0", "1"):
+        raise ValueError("GLM53_TF_DEC_QMM_SERIAL must be auto, 0 or 1")
+    ctas = int(_env("GLM53_TF_DEC_CTAS", "0"))
+    if ctas < 0:
+        raise ValueError("GLM53_TF_DEC_CTAS must be >= 0")
+    q = _env(ENV_QMM, "0")
+    if _on(q) and q != "force" and not qmm_reference_fused():
+        import sys
+
+        print(f"[tensorfold] {ENV_QMM}: this Triton does not compile qmm._qmm with fused epilogues on every shape; "
+              "the streaming dense kernel would change bits, so it stays off", file=sys.stderr, flush=True)
+        q = "0"
+    return {"experts": _on(_env(ENV_EXPERTS, "0")), "qmm": _on(q),
+            "pdl": _on(_env("GLM53_TF_DEC_PDL", "0")), "experts_cfg": ecfg, "qmm_cfg": qcfg, "ctas": ctas,
+            "qmm_serial": serial}
+
+
+CFG = parse()
+
+
+def pdl_supported() -> bool:
+    return torch.cuda.is_available() and torch.cuda.get_device_capability()[0] >= 9
+
+
+def _build(name: str, stem: str):
+    """Built for this GPU's architecture only (cp.async with a source size and griddepcontrol need sm_80 / sm_90;
+    the base image's TORCH_CUDA_ARCH_LIST also lists compute_80, where PDL does not exist)."""
+
+    from torch.utils.cpp_extension import load
+
+    here = Path(__file__).parent
+    major, minor = torch.cuda.get_device_capability()
+    saved = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = f"{major}.{minor}"
+    try:
+        return load(name=name, sources=[str(here / f"{stem}.cpp"), str(here / f"{stem}.cu")],
+                    extra_cuda_cflags=["-O3"], verbose=False)
+    finally:
+        if saved is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = saved
+
+
+@lru_cache(maxsize=1)
+def _experts_ext():
+    return _build("tensorfold_glm_exl3_stream_v1", "exl3_stream")
+
+
+@lru_cache(maxsize=1)
+def _qmm_ext():
+    return _build("tensorfold_glm_q4_stream_v1", "q4_stream")
+
+
+def _scratch(owner, name: str, n: int, device) -> torch.Tensor:
+    """Zeroed int32 tickets kept on ``owner`` (an EXL3 Scratch, or keyed by a partial buffer), allocated once on the
+    first (eager) use, before any graph capture. Every launch leaves them at zero."""
+
+    t = getattr(owner, name, None)
+    if t is None or t.numel() < n:
+        t = torch.zeros((n,), dtype=torch.int32, device=device)
+        setattr(owner, name, t)
+    return t
+
+
+# -- E1: routed experts ------------------------------------------------------------------------------------------
+def experts_ok(group, ex, s) -> bool:
+    """Whether ``routed`` takes this window (the shapes, the member table and the scratch)."""
+
+    if getattr(s, "z", None) is None:                       # lean prefill scratch (fused kernels only)
+        return False
+    gnt, gw, gsk = exl3_mm.GATEUP_CFG
+    dnt, dw, dsk = exl3_mm.DOWN_CFG
+    D, NI = ex.dims, ex.width
+    ntg, _, ntd, _ = CFG["experts_cfg"]
+    if gw != 4 or dw != 4 or D % 128 or NI % 128 or NI % (16 * ntg) or D % (16 * ntd):
+        return False
+    if D % (16 * gsk * gw) or NI % (16 * dsk * dw):
+        return False
+    if any(t.data_ptr() % 16 for t in (ex.gt, ex.ut, ex.dt, s.xg, s.xu, s.xd)):
+        return False
+    maxu, maxm = group.ids.shape[0], group.members.shape[1]
+    mt = -(-maxm // 16)
+    return 0 < maxm <= MAX_MEMBERS and maxu <= 1024 and (mt - 1) * maxu <= MAX_EXTRA
+
+
+def routed(x: torch.Tensor, pick: torch.Tensor, group, ex, s, y: torch.Tensor, R: int, limit: float) -> bool:
+    """``exl3_mm.routed`` (not fast) through exl3_stream.cu: rot_in, gate/up (+ epilogue), down (+ epilogue), the
+    same bits. False: not taken (the caller runs exl3.cu)."""
+
+    if not CFG["experts"] or not experts_ok(group, ex, s):
+        return False
+    return run_experts(x, pick, group, ex, s, y, R, limit)
+
+
+def run_experts(x, pick, group, ex, s, y, R, limit, *, cfg=None, pdl=None, ctas=None, probe=0) -> bool:
+    ntg, stg, ntd, std = cfg or CFG["experts_cfg"]
+    pdl = CFG["pdl"] if pdl is None else pdl
+    pdl = bool(pdl) and pdl_supported()
+    ctas = CFG["ctas"] if ctas is None else ctas
+    ext = _experts_ext()
+    base = exl3_mm._ext()
+    slots, P = s.slots, s.rows * s.slots
+    D, NI = ex.dims, ex.width
+    gsk, dsk = exl3_mm.GATEUP_CFG[2], exl3_mm.DOWN_CFG[2]
+    maxu = group.ids.shape[0]
+    mt = -(-group.members.shape[1] // 16)
+    ng, nd = mt * maxu * (NI // 128), mt * maxu * (D // 128)
+    cnt = _scratch(s, "_dec_cnt", 4 * (ex.count + 1) * (NI // 128 + D // 128), x.device)
+    if ng + nd > cnt.numel():
+        return False
+    base.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, D, slots)
+    ext.gateup(s.xg, s.xu, ex.gt, ex.ut, group.ids, group.count, group.members, s.z, ex.svh_g, ex.svh_u, ex.suh_d,
+               s.xd, cnt[:ng], D, NI, P, gsk, slots, ntg, stg, ctas, float(limit), pdl, probe)
+    ext.down(s.xd, ex.dt, group.ids, group.count, group.members, s.z, ex.svh_d, y, cnt[ng:ng + nd], NI, D, P, dsk,
+             slots, ntd, std, ctas, pdl, probe)
+    return True
+
+
+# -- E2: 4-bit dense matmuls -------------------------------------------------------------------------------------
+_COUNTERS: dict[tuple, torch.Tensor] = {}
+_DUMMIES: dict[int, tuple[torch.Tensor, torch.Tensor]] = {}
+
+
+def _dummies(device) -> tuple[torch.Tensor, torch.Tensor]:
+    """A partial buffer and tickets for unsplit matmuls (never read or written; allocated on the first eager use)."""
+
+    d = torch.device(device).index or 0
+    t = _DUMMIES.get(d)
+    if t is None:
+        t = (torch.zeros((1,), dtype=torch.float32, device=device), torch.zeros((1,), dtype=torch.int32, device=device))
+        _DUMMIES[d] = t
+    return t
+
+
+def counters(part: torch.Tensor) -> torch.Tensor:
+    """Tickets owned by the partial buffer ``part`` (one set a buffer, so two windows that run concurrently on
+    different buffers never share one)."""
+
+    k = (part.device.index, part.data_ptr())
+    c = _COUNTERS.get(k)
+    if c is None:
+        c = torch.zeros((COUNTER_SLOTS,), dtype=torch.int32, device=part.device)
+        _COUNTERS[k] = c
+    return c
+
+
+def qmm_ok(x: torch.Tensor, q, xs, out, part, f32: bool = False) -> bool:
+    if not isinstance(q, qmm.Q4):
+        return False
+    m, k = x.shape
+    if not 0 < m <= QMM_ROWS or k != q.k or k % qmm.GS or q.n % 8 or x.dtype != torch.bfloat16:
+        return False
+    if x.stride(1) != 1 or x.stride(0) % 8 or x.data_ptr() % 16:
+        return False
+    if any(t.data_ptr() % 16 or not t.is_contiguous() for t in (q.weight, q.scales, q.biases)):
+        return False
+    if xs is not None and (xs.stride(1) != 1 or xs.dtype != torch.float32):
+        return False
+    if out is not None and (out.shape != (m, q.n) or out.stride(1) != 1
+                            or out.dtype != (torch.float32 if f32 else torch.bfloat16)):
+        return False                     # (qmm would round to bf16 and widen into an fp32 out: not this kernel's)
+    sk = qmm.split_k(q.n, q.k)
+    if sk > 1 and not serial_for(q.n, sk) and (part is None or part.numel() < sk * m * q.n
+                                               or -(-q.n // qmm.BN) > COUNTER_SLOTS):
+        return False
+    return True
+
+
+def matmul(x: torch.Tensor, q, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+           f32: bool = False, part: torch.Tensor | None = None) -> torch.Tensor | None:
+    """``qmm.matmul`` for 4-bit weights and <= 64 rows through q4_stream.cu, the same bits. None: not taken."""
+
+    if not CFG["qmm"] or not qmm_ok(x, q, xs, out, part, f32):
+        return None
+    return run_qmm(x, q, xs, out=out, f32=f32, part=part)
+
+
+SERIAL_MIN_TILES = 96                   # auto: whole-tile items when every SM gets two
+
+
+def serial_for(n: int, sk: int, mode: str | None = None) -> bool:
+    mode = CFG["qmm_serial"] if mode is None else mode
+    if sk == 1 or mode == "1":
+        return True
+    if mode == "0":
+        return False
+    return -(-n // qmm.BN) >= SERIAL_MIN_TILES
+
+
+def run_qmm(x, q, xs=None, *, out=None, f32=False, part=None, cfg=None, pdl=None, ctas=None, serial=None):
+    gps, stages = cfg or CFG["qmm_cfg"]
+    pdl = CFG["pdl"] if pdl is None else pdl
+    pdl = bool(pdl) and pdl_supported()
+    ctas = CFG["ctas"] if ctas is None else ctas
+    m, k = x.shape
+    if xs is None:
+        xs = qmm.group_sums(x)
+    if out is None:
+        out = torch.empty((m, q.n), dtype=torch.float32 if f32 else torch.bfloat16, device=x.device)
+    elif (out.dtype == torch.float32) != bool(f32):
+        raise ValueError("matmul: out dtype does not match f32")
+    sk = qmm.split_k(q.n, q.k)
+    per = (k // qmm.GS) // sk
+    if per % gps:
+        gps = 1
+    if m > 16:                                   # 2-4 row tiles: one group a stage, 4 stages (fits 3 / 2 CTAs an SM)
+        gps, stages = 1, 4
+    serial = serial_for(q.n, sk) if serial is None else (bool(serial) or sk == 1)
+    if serial:
+        part_t, cnt = _dummies(x.device)
+    else:
+        part_t, cnt = part, counters(part)
+    _qmm_ext().q4_stream(x, xs, q.weight, q.scales, q.biases, out, part_t, cnt, q.n, q.k, sk, gps, stages, ctas, pdl,
+                         serial)
+    return out
+
+
+# -- installation --------------------------------------------------------------------------------------------------
+def configure(experts: bool | None = None, qmm_on: bool | None = None, *, pdl: bool | None = None,
+              experts_cfg: tuple | None = None, qmm_cfg: tuple | None = None) -> dict:
+    """Install the hooks as the knobs (or the arguments) say. CUDA graphs keep the kernels they captured."""
+
+    import sys
+
+    if experts is not None:
+        CFG["experts"] = bool(experts)
+    if qmm_on is not None:
+        CFG["qmm"] = bool(qmm_on)
+    if pdl is not None:
+        CFG["pdl"] = bool(pdl)
+    if experts_cfg is not None:
+        CFG["experts_cfg"] = tuple(experts_cfg)
+    if qmm_cfg is not None:
+        CFG["qmm_cfg"] = tuple(qmm_cfg)
+    me = sys.modules[__name__]
+    exl3_mm.STREAM = me if CFG["experts"] else None
+    qmm.STREAM = me if CFG["qmm"] else None
+    return dict(CFG)
+
+
+class using:
+    """Tests / benches: run with these settings (eager kernels; captured graphs keep theirs), then restore."""
+
+    def __init__(self, **kw) -> None:
+        self.kw, self.saved = kw, None
+
+    def __enter__(self):
+        self.saved = dict(CFG)
+        return configure(**self.kw)
+
+    def __exit__(self, *exc):
+        CFG.clear()
+        CFG.update(self.saved)
+        configure()
+        return False
+
+
+configure()
