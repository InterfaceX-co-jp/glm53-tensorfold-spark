+def bucket_mask(spec: str, most: int) -> int:
+    """patches/0280: GLM53_TF_BATCH_BUCKETS ("4,8"; "" / "0": off) as a bit mask of window sizes, as ``pad_mask``."""
+
+    try:
+        return pad_mask(spec, most)
+    except ValueError:
+        raise ValueError(f"GLM53_TF_BATCH_BUCKETS={spec!r}: window sizes are 1..{most}") from None
+
+
+def bucket_rows(Rs: Sequence[int], mask: int) -> int:
+    """patches/0280: the rows every window of a round is padded to: the smallest listed size >= the round's longest
+    window (that window's length when none is)."""
+
+    return padded(max(Rs), mask) if Rs else 0
+
+
+def route_sources(real: Sequence[int], ran: Sequence[int]) -> list[int]:
+    """patches/0280: for a round whose window i has real[i] rows and ran[i] >= real[i] rows in the forward (back to
+    back), the row each forward row takes its router logits from: itself for a real row, its window's last real row
+    for a padded one."""
+
+    src, off = [], 0
+    for R, n in zip(real, ran):
+        if not 1 <= R <= n:
+            raise ValueError(f"route_sources: a window of {R} real rows ran {n}")
+        src.extend(range(off, off + R))
+        src.extend([off + R - 1] * (n - R))
+        off += n
+    return src
+
+
