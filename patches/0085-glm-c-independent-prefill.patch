index 0000000..d5eebd5
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/pfgrid.py
@@ -0,0 +1,217 @@
+"""Chunk plans, snapshot positions and snapshot tags of GLM-5.3-Flash prefills (patches/0085).
+
+Why a fast prefill's state does not depend on its chunk size
+------------------------------------------------------------
+patches/0080 kept resumed == fresh for fast (not row-invariant) prefills by putting chunks and snapshots on an
+absolute grid of the chunk size C: a request resumed only from a snapshot of its own C, and re-prefilled up to C - 1
+tokens of the old prompt on every turn. patches/0085 removes the need for that: every kernel a fast chunk runs is
+ROW-INDEPENDENT (a row's bits never depend on which other rows share the call, nor on how many there are) and the
+one kernel that couples rows, the chunked KDA scan, couples them only inside 64-row blocks at ABSOLUTE multiples of
+``ALIGN`` = 64:
+
+- ``fast_qmm.matmul_fast`` / ``matmul_fp8`` / ``hc_partial``, the latent ``absorb_tc`` / ``expand_tc``: tiles fixed
+  by the weight's shape, one accumulator walking K in a fixed order, per-row FP8 scales, no split-K, no atomics; and
+  (patches/0085) every call of a fast chunk runs them whatever its row count (``fastpf.chunk``: the < 64-row qmm
+  fallback, which gave a chunk's short tail other bits than the same rows inside a longer chunk, is gone; the head,
+  one row in every schedule, keeps qmm);
+- ``exl3_fast.cu``: a routed pair's gate/up/down is one warp's ascending mma chain over all of K; the expert's other
+  members only decide which warp and pass hold the pair; the Hadamard / SwiGLU epilogue is per element;
+- attention, the indexer's selection (patches/0065 row blocks select exactly), glue, hyper-connections, the router,
+  the bf16 gathers: the row-invariant kernels, or per-row arithmetic;
+- ``fast_kda``: 64-row blocks at absolute multiples of 64 (``off = pos % 64``); a block's bits depend only on its
+  rows and the fp32 state entering it, and a state handed between two calls is the fp32 value the one-call scan
+  keeps in registers. Every fast call starts at a multiple of 64 (chunk starts, cuts, marks, resume points, lean
+  sub-blocks), so the only partial block is the prompt's last one, the same in every schedule.
+
+Hence the committed state after a fast prefill of tokens t[0:n] (KDA states and conv windows, attention / indexer /
+MTP / DFlash2 caches, the first token) is a function of t[0:n] alone: the chunk size C is a speed choice, a chunk may
+be cut at any multiple of 64, and the state at any multiple of 64 is what every fast prefill of a prompt extending
+it holds there (the rows below it never read a later row).
+
+The rules (``plan``, ``decode._prefill``, ``engine._run``)
+---------------------------------------------------------
+1. Chunks: from the resume point (a multiple of 64), chunks of up to C rows (``chunk_rows``: the request's
+   ``prefill_rows`` rounded down to a multiple of 64, or ``auto``), also cut at the session store's marks and at
+   the snapshot point.
+2. Snapshots (fast): one per prefill, at S = the prompt's last multiple of ``snapshot_grid()`` G (default 64,
+   ``GLM53_TF_SNAPSHOT_GRID``): after the prefill when S = n, else before the chunk that starts at S, the prefill
+   cutting a chunk there when needed. Exception (``snapshot_tail()``, ``GLM53_TF_SNAPSHOT_TAIL``, default 256):
+   when the schedule's last chunk already starts within that many rows before S, the snapshot is taken there
+   instead (no extra chunk of fewer than G rows now; a next turn re-prefills at most tail + G - 1 more rows).
+   Positions past the prompt's last grid point are never kept, and neither is the reply (its rows were written by
+   the row-invariant decode kernels, not the fast chunks, so they are not what a fast prefill of the next prompt
+   holds): a next turn re-prefills the old prompt's last < G tokens (or < tail + G), the reply and its new tokens.
+3. Tags: exact snapshots 0, fast ones G, FP8 fast ones G + 1 (``tag``) -- by mode, never by C. A fast request
+   resumes from any snapshot with its tag at a multiple of 64 (``resumable``), whatever C made it.
+
+Claim: a fast prefill of p resumed from a snapshot at B (tag match, B a multiple of 64, p[:B] = its ids) ends in the
+fresh fast prefill's state. The snapshot holds the state of some fast prefill of a prompt q with q[:B] = p[:B] at B
+(by induction over the prefills that made it: each resumed one ended, at every position, in its fresh state); that is
+the fresh prefill of p's state at B (the rows below B depend on p[:B] only); from B on, the chunks may differ from the
+fresh prefill's, which does not change a bit. With patches/0080's argument for the caches (a request writes them only
+from its resume point on) this gives resumed == fresh; drafted == serial holds because the prefill is deterministic.
+
+With GLM53_TF_SNAPSHOT_GRID = C and a fixed C the snapshots, tags and chunks are exactly patches/0080's grid rule.
+
+Nothing here imports torch (the session store and host tests use it).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from typing import Sequence
+
+ALIGN = 64                      # fast_kda's block: fast calls, cuts and fast snapshots sit on multiples of it
+AUTO = 0                        # prefill_rows "auto": the chunk size chosen per request (``chunk_rows``)
+FP8 = 1                         # added to the grid in an FP8 fast prefill's tag (fp8pf.TAG)
+GRID_ENV = "GLM53_TF_SNAPSHOT_GRID"
+TAIL_ENV = "GLM53_TF_SNAPSHOT_TAIL"
+DEFAULT_GRID = 64
+DEFAULT_TAIL = 256
+
+
+def snapshot_grid() -> int:
+    """GLM53_TF_SNAPSHOT_GRID (default 64, a multiple of 64): a fast prefill's snapshot sits at the prompt's last
+    multiple of it. Both ranks must agree (``settings``)."""
+
+    raw = os.environ.get(GRID_ENV, "").strip()
+    v = int(raw) if raw else DEFAULT_GRID
+    if v < ALIGN or v % ALIGN:
+        raise ValueError(f"{GRID_ENV}={raw}: expected a multiple of {ALIGN}")
+    return v
+
+
+def snapshot_tail() -> int:
+    """GLM53_TF_SNAPSHOT_TAIL (default 256, rows, >= 0): skip the cut at the snapshot point when the last chunk
+    already starts within this many rows before it (0: always cut)."""
+
+    raw = os.environ.get(TAIL_ENV, "").strip()
+    v = int(raw) if raw else DEFAULT_TAIL
+    if v < 0:
+        raise ValueError(f"{TAIL_ENV}={raw}: expected 0 or more rows")
+    return v
+
+
+def settings() -> list[int]:
+    """What both ranks must agree on (they decide the chunks, hence the collectives)."""
+
+    return [snapshot_grid(), snapshot_tail()]
+
+
+# -- tags -----------------------------------------------------------------------------------------------------------
+def tag(fast: bool, fp8: bool = False, grid: int | None = None) -> int:
+    """A prefill's snapshot tag: 0 (exact), G (fast), G + 1 (FP8 fast). Not the chunk size."""
+
+    if not fast:
+        return 0
+    g = snapshot_grid() if grid is None else int(grid)
+    return g + FP8 if fp8 else g
+
+
+def grid_of(t: int) -> int:
+    """The snapshot grid G of a tag (0 for exact snapshots): fast rows below a snapshot depend on the tokens up to the
+    end of their G-block at most (their 64-block, in fact)."""
+
+    return t - t % ALIGN
+
+
+def is_fp8(t: int) -> bool:
+    return bool(t) and t % ALIGN == FP8
+
+
+def resumable(snap_tag: int, req_tag: int, pos: int) -> bool:
+    """A snapshot of ``snap_tag`` at ``pos`` may resume a prefill of ``req_tag``: same mode, and a fast one sits on a
+    multiple of 64 (any chunk size resumes from it)."""
+
+    return snap_tag == req_tag and (not req_tag or pos % ALIGN == 0)
+
+
+# -- the chunk size -------------------------------------------------------------------------------------------------
+def parse_rows(v) -> int:
+    """GLM53_TF_PREFILL_ROWS / ``tf_knobs.prefill_rows``: a row count (>= 1), or "auto" (``AUTO``)."""
+
+    if isinstance(v, str):
+        s = v.strip().lower()
+        if s == "auto":
+            return AUTO
+        v = int(s)
+    if isinstance(v, bool) or not isinstance(v, int) or v < 1:
+        raise ValueError(f"prefill rows {v!r}: expected a positive integer or \"auto\"")
+    return v
+
+
+def show_rows(rows: int):
+    """The knob's value as a request writes it: an int, or "auto"."""
+
+    return "auto" if rows == AUTO else int(rows)
+
+
+def chunk_rows(rows: int, todo: int, cap: int, fast: bool) -> int:
+    """The chunk size C of a prefill of ``todo`` tokens: ``rows`` (a count, or ``AUTO``) on buffers of ``cap`` rows.
+    Fast: a multiple of 64 (rows rounded down, at least 64); auto = the rows to prefill rounded up to 64, at most cap
+    rounded down to 64 (bigger chunks are never slower: each reads the weights once; the snapshot rule, not C, bounds
+    what a next turn re-prefills). Exact: rows capped at the buffers (auto: all of them); any C gives the same bits."""
+
+    if not fast:
+        return max(1, min(cap, todo if rows == AUTO else rows))
+    most = cap // ALIGN * ALIGN
+    if most < ALIGN:
+        raise ValueError(f"fast prefill: chunks are multiples of {ALIGN} rows, the buffers hold {cap}")
+    if rows == AUTO:
+        return max(ALIGN, min(most, -(-todo // ALIGN) * ALIGN))
+    c = max(ALIGN, rows // ALIGN * ALIGN)
+    if c > most:
+        raise ValueError(f"fast prefill: {c}-row chunks, the buffers hold {cap} rows")
+    return c
+
+
+# -- the plan -------------------------------------------------------------------------------------------------------
+@dataclass
+class Plan:
+    """A prefill of positions [begin, n): its chunks, where its snapshot is taken (``snap``: begin = the resume
+    snapshot, or none when begin = 0; begin < snap < n: before the chunk starting there; n: after the prefill;
+    -1: none, exact prefills) and the marks it snapshots too (each the start of a chunk)."""
+
+    spans: list[tuple[int, int]]
+    snap: int
+    marks: list[int] = field(default_factory=list)
+    cut: bool = False                    # a chunk was cut at the snapshot point
+
+
+def spans(begin: int, n: int, step: int, cuts: Sequence[int] = ()) -> list[tuple[int, int]]:
+    """Chunks [start, stop) of up to ``step`` rows from ``begin``, also cut at every position in ``cuts``."""
+
+    out: list[tuple[int, int]] = []
+    start = begin
+    for q in sorted({c for c in cuts if begin < c < n}) + [n]:
+        while start < q:
+            stop = min(start + step, q)
+            out.append((start, stop))
+            start = stop
+    return out
+
+
+def plan(begin: int, n: int, step: int, *, fast: bool, marks: Sequence[int] = (), grid: int | None = None,
+         tail: int | None = None) -> Plan:
+    """The chunks and snapshot of a prefill of positions [begin, n) in chunks of ``step`` rows (``chunk_rows``),
+    also snapshotting at ``marks`` (the session store's: exact anywhere, fast on multiples of 64)."""
+
+    if not 0 <= begin < n or step < 1:
+        raise ValueError(f"prefill plan: positions {begin}..{n}, {step}-row chunks")
+    if not fast:
+        m = sorted({q for q in marks if begin < q < n})
+        return Plan(spans(begin, n, step, m), -1, m)
+    if begin % ALIGN or step % ALIGN:
+        raise ValueError(f"fast prefill plan: resume point {begin} and chunk size {step} must be multiples of {ALIGN}")
+    g = snapshot_grid() if grid is None else int(grid)
+    t = snapshot_tail() if tail is None else int(tail)
+    m = sorted({q for q in marks if begin < q < n and q % ALIGN == 0})
+    base = spans(begin, n, step, m)
+    if n % g == 0:
+        return Plan(base, n, m)
+    s = n // g * g
+    last = base[-1][0]
+    if last >= s or s - last <= t:
+        return Plan(base, last, [q for q in m if q != last])
+    return Plan(spans(begin, n, step, m + [s]), s, [q for q in m if q != s], cut=True)
