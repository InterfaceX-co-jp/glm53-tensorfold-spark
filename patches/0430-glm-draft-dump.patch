diff --git c/src/tensorfold/families/glm5_next/cuda/mtpw.py w/src/tensorfold/families/glm5_next/cuda/mtpw.py
new file mode 100644
index 0000000..93e70e5
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/mtpw.py
@@ -0,0 +1,87 @@
+"""patches/0430, GLM53_TF_MTP_WEIGHTS=<dir>: serve a distilled MTP head (``train/mtp_distill.py``'s export) in place of
+the checkpoint's own. Off (unset / empty / 0): ``weights.load`` exactly as before.
+
+The folder holds full, unsplit BF16 tensors under the checkpoint's own names (``*.safetensors``), only for the MTP
+layer (``model.language_model.layers.<num_hidden_layers>.*``: attention, eh_proj, norms, router, shared expert). Each
+replaces the checkpoint's tensor of that name; this rank's part is sliced by the checkpoint's own split rules
+(``split.rule``) and stored the way the engine stores the checkpoint's (GLM53_TF_NONEXPERT: q4mse in production), so
+the exported BF16 weights go through the same quantization at load that training emulated. The routed experts stay
+the checkpoint's (EXL3).
+
+It lives outside ``weights.py`` so the prepared folders of patches/0140 (keyed by a digest of ``weights.py``) stay
+valid when the knob is off; with the knob on, the folder's files join the prepared tree's key (another head is
+another tree)."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+
+def mtp_weights_dir() -> str:
+    v = os.environ.get("GLM53_TF_MTP_WEIGHTS", "").strip()
+    return "" if v.lower() in ("", "0", "off") else v
+
+
+class _Overlay:
+    """A ``split.RankReader`` whose MTP-layer tensors come from the override folder when it has them."""
+
+    def __init__(self, base, over, prefix: str) -> None:
+        self.base, self.over, self.prefix = base, over, prefix
+        self.names = set(over.index)
+        bad = sorted(n for n in self.names if not n.startswith(prefix))
+        if bad:
+            raise ValueError(f"GLM53_TF_MTP_WEIGHTS may only replace MTP-layer tensors ({prefix}*); found {bad[:3]}")
+        self.used: set[str] = set()
+
+    def get(self, name: str):
+        if name in self.names:
+            self.used.add(name)
+            return self.over.get(name)
+        return self.base.get(name)
+
+    def __getattr__(self, name):
+        return getattr(self.base, name)
+
+
+def load(model_dir, *, rank: int, device: str = "cuda"):
+    """``weights.load`` with the MTP layer's tensors replaced from GLM53_TF_MTP_WEIGHTS (when set)."""
+
+    from . import fastboot, split, weights
+
+    where = mtp_weights_dir()
+    if not where:
+        return weights.load(model_dir, rank=rank, device=device)
+
+    def build():
+        cfg = weights.Config.read(model_dir)
+        if not cfg.mtp_layers:
+            raise ValueError("GLM53_TF_MTP_WEIGHTS: this checkpoint has no MTP layer")
+        prefix = weights.PREFIX + f"layers.{cfg.layers}."
+        orig = split.RankReader
+        made: list[_Overlay] = []
+
+        def reader(d, r):
+            o = _Overlay(orig(d, r), orig(where, r), prefix)
+            made.append(o)
+            return o
+
+        split.RankReader = reader            # ``load_checkpoint`` imports it at call time
+        try:
+            w = weights.load_checkpoint(model_dir, rank=rank, device=device)
+        finally:
+            split.RankReader = orig
+        ov = made[0]
+        missing = sorted(ov.names - ov.used)
+        if missing:
+            raise ValueError(f"GLM53_TF_MTP_WEIGHTS: tensors the engine does not read: {missing[:5]}")
+        if rank == 0:
+            print(f"[tensorfold] MTP head (patches/0430): {len(ov.used)} tensors from {where}", flush=True)
+        w.meta["mtp_weights"] = str(where)
+        return w
+
+    if fastboot.prepared_root() is None:
+        return build()
+    extra = {"mtp_weights": [str(Path(where).resolve()), fastboot.files_ident(where)]}
+    return fastboot.cached_tree("weights", fastboot.weights_key(model_dir, rank, device=device, extra=extra), build,
+                                device)
