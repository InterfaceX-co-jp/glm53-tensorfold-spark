+if SCRATCH not in ("grow", "max", "off"):
+    raise ValueError(f"GLM53_TF_SELECT_SCRATCH must be grow, max or off, not {SCRATCH!r}")
+_SCRATCH: dict = {}
+SCRATCH_STATS = {"grown": 0, "fallback": 0}
+
+
+def _scratch_key(device) -> tuple:
+    dev = torch.device(device)
+    if dev.type == "cuda":
+        return (str(dev), torch.cuda.current_stream(dev).cuda_stream)
+    return (str(dev), 0)
+
+
+def _capturing(device) -> bool:
+    return torch.device(device).type == "cuda" and torch.cuda.is_current_stream_capturing()
+
+
+def scratch_bytes(device=None) -> int:
+    """Bytes the selection scratch of ``device``'s current stream holds (all of them when ``device`` is None)."""
+
+    if device is None:
+        return sum(t.numel() * 4 for t in _SCRATCH.values())
+    t = _SCRATCH.get(_scratch_key(device))
+    return 0 if t is None else t.numel() * 4
