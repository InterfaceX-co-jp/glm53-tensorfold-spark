+    if new <= have:
+        return have
+    if cur is not None:
+        del _SCRATCH[key]
+        del cur
+        if empty and torch.device(device).type == "cuda":
+            torch.cuda.synchronize(device)
+            torch.cuda.empty_cache()
+    _SCRATCH[key] = torch.empty((new // 4,), dtype=torch.int32, device=device)
+    SCRATCH_STATS["grown"] += 1
+    return new
+
+
+def reserve_for_prefill(p0: int, p1: int, R: int, pk, device) -> int:
+    """``reserve_scratch`` for the key blocks of a prefill of positions p0 .. p1 - 1 in calls of up to ``R`` rows
+    against the pool-key cache ``pk`` (patches/0050's bound as ``latent._attend`` applies it)."""
+
+    from . import memsafe
