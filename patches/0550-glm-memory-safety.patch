+
+def reserve_scratch(nbytes: int, device, *, empty: bool = True) -> int:
+    """Grow the current stream's selection scratch to hold key blocks of ``nbytes`` (``memsafe.scratch_grow_to``;
+    ``max``: GLM53_TF_SELECT_MB at once). Host side, before a forward: when it replaces a smaller buffer the cache is
+    emptied (``empty``), so the old buffer goes back to the device. -> bytes it holds (0: off / capturing)."""
+
+    from . import memsafe
