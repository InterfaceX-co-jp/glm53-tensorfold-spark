--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/memsafe.py
@@ -0,0 +1,469 @@
+"""Memory safety for GLM-5.3-Flash on GB10 (patches/0550): the prefill selection's context-sized scratch, the caching
+allocator's growth, and admission / store decisions that count reclaimable page cache.
+
+Why (W15, docs/MEMORY-SAFETY.md)
+--------------------------------
+1. The needle dip. During a lone ~300k prefill MemAvailable fell by 3-4.5 GiB (to 6.4 GiB after the stress + MMLU)
+   and came back at once when the prefill ended. The cause is patches/0065's blocked selection
+   (``sparse.select_pools_blocked``): every DSA call (11 layers, one a 512-row sub-block of a fast chunk) allocates
+   its int32 key block ``[n, npc]`` with npc = the block's complete pools, about 512 B x position: 67 MB at 131k,
+   161 MB at 314k, 256 MiB (``GLM53_TF_SELECT_MB``) from 524k on. The size grows a little every sub-block, so every
+   ~4,096 tokens the next one no longer fits the freed block of the previous one (torch's caching allocator keeps
+   segments whole and returns nothing to the system on its own): it takes a new segment of the new size and keeps
+   the old one cached. The reserved memory grows by the sum of all sizes, quadratically in the context (bound:
+   ``keys_growth``: ~5.8 GiB from 0 to 314k, ~16 GiB to 1M), and is handed back only by ``torch.cuda.empty_cache()``,
+   which ``torch.cuda.graph`` calls before every capture: the first MTP draft after the prompt meets a new pool
+   bucket (patches/0050's long graphs), captures, and MemFree jumps up. W15's trace fits it: the slope steepens with
+   the position (0.6 -> 1.9-2.5 GiB/min), the drop is ~75% of the no-reuse bound, and the release is the capture.
+2. Page cache. On GB10 ``cudaMemGetInfo`` free is the kernel's MemFree: reclaimable page cache counts as used, so
+   while a 36 GB file was copied (MemFree 2.1 GiB, 16.8 GiB of cache) admission (free - store headroom >=
+   ``GLM53_TF_BATCH_ADMIT_GB``) let C4 requests in one at a time.
+
+What this module holds (no torch at import; host-tested)
+--------------------------------------------------------
+- ``/proc/meminfo`` and the admission measure: ``usable`` = CUDA free + the allocator's cached bytes + the page cache
+  credit, the credit = MemAvailable - MemFree - Dirty - Writeback - max(Mapped, ``GLM53_TF_ADMIT_CACHE_KEEP_GB``)
+  (dirty pages need writeback before they can go, mapped pages are other programs' and our libraries' working set).
+  ``GLM53_TF_ADMIT_MEM=available`` (default) or ``free`` (the old measure). A request is also held while the
+  immediately free memory (CUDA free + allocator cache) is under ``GLM53_TF_ADMIT_FREE_FLOOR_GB`` (1).
+- ``AdmitLog``: one line when admission starts waiting for memory (and every 30 s while it does), one when it ends.
+- ``Trimmer`` (``GLM53_TF_ALLOC_TRIM_GB``, default 2; 0 off): before a prefill piece, when the allocator holds more
+  than that many GiB it does not use, ``torch.cuda.empty_cache()``, at most once every ``GLM53_TF_ALLOC_TRIM_S`` (10)
+  seconds; if a trim frees little (graph pools), the trigger moves up (hysteresis), so it cannot run every piece.
+- The selection's size model: ``select_blocks`` (what one DSA call allocates, as ``sparse`` computes it),
+  ``keys_growth`` (the caching allocator's reserved growth over a prefill without the scratch, an upper bound: no
+  reuse by other allocations), ``scratch_bytes`` / ``scratch_grow_to`` (what ``sparse``'s scratch holds after a
+  prefill to a position: its largest block rounded up to 16 MiB, at most GLM53_TF_SELECT_MB), ``scratch_growth``
+  (admission's reservation for a prompt).
+- ``drop_file_cache``: fdatasync + POSIX_FADV_DONTNEED for our own buffered writes (the session tier's fallback).
+
+Same bits: the scratch (``sparse``) gives each call the same shapes, strides, alignment and values; a trim or a
+different admission changes addresses and scheduling only (``torch.cuda.graph`` already empties the cache at every
+capture; batched == alone). See docs/MEMORY-SAFETY.md for the proofs and the GPU plan.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+from dataclasses import dataclass, field
+
+KiB = 1 << 10
+MiB = 1 << 20
+GiB = 1 << 30
+
+POOL = 4                 # sparse.POOL
+TOPK_POOLS = 512         # sparse.TOPK_POOLS
+BRB = 16                 # sparse.BRB
+MIN_BUCKET = 1024        # sparse.MIN_BUCKET
+SEGMENT_ROUND = 2 * MiB  # torch's caching allocator: large segments rounded up to 2 MiB (kRoundLarge)
+LARGE_MIN = 10 * MiB     # below this a large request takes a 20 MiB segment (kMinLargeAlloc / kLargeBuffer)
+LARGE_BUFFER = 20 * MiB
+SMALL_MAX = 1 * MiB      # kSmallSize: requests up to this share 2 MiB small segments
+
+
+def _env_float(name: str, default: float, least: float = 0.0) -> float:
+    raw = os.environ.get(name, "").strip()
+    try:
+        v = float(raw) if raw else float(default)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+    if v < least:
+        raise ValueError(f"{name}={v:g}: expected >= {least:g}")
+    return v
+
+
+# -- settings ---------------------------------------------------------------------------------------------------------
+ADMIT_POLICIES = ("available", "free")
+
+
+def admit_policy() -> str:
+    """GLM53_TF_ADMIT_MEM: ``available`` (default: reclaimable page cache counts, with the margins below) or ``free``
+    (CUDA free + allocator cache only: the rule before 0550)."""
+
+    v = os.environ.get("GLM53_TF_ADMIT_MEM", "").strip().lower() or "available"
+    if v not in ADMIT_POLICIES:
+        raise ValueError(f"GLM53_TF_ADMIT_MEM={v!r}: expected available or free")
+    return v
+
+
+def cache_keep_bytes() -> int:
+    """GLM53_TF_ADMIT_CACHE_KEEP_GB (default 2): page cache never counted as available (at least Mapped is kept)."""
+
+    return int(_env_float("GLM53_TF_ADMIT_CACHE_KEEP_GB", 2.0) * GiB)
+
+
+def free_floor_bytes() -> int:
+    """GLM53_TF_ADMIT_FREE_FLOOR_GB (default 1): least immediately free memory (CUDA free + allocator cache) for an
+    admission beside running requests, whatever the page cache (the first chunk's buffers are allocated at once)."""
+
+    return int(_env_float("GLM53_TF_ADMIT_FREE_FLOOR_GB", 1.0) * GiB)
+
+
+def trim_bytes() -> int:
+    """GLM53_TF_ALLOC_TRIM_GB (default 2; 0 off): the allocator's unused cache that triggers ``empty_cache`` after a
+    prefill piece."""
+
+    return int(_env_float("GLM53_TF_ALLOC_TRIM_GB", 2.0) * GiB)
+
+
+def drop_own_cache() -> bool:
+    """GLM53_TF_DROP_OWN_CACHE (default 1): our own buffered file writes leave no page cache behind."""
+
+    return os.environ.get("GLM53_TF_DROP_OWN_CACHE", "1").strip().lower() not in ("0", "off", "no", "false")
+
+
+# -- /proc/meminfo ------------------------------------------------------------------------------------------------------
+MEMINFO_KEYS = ("MemTotal", "MemFree", "MemAvailable", "Cached", "Dirty", "Writeback", "Mapped", "Shmem",
+                "AnonPages")
+
+
+def parse_meminfo(text: str) -> dict[str, int]:
+    """``/proc/meminfo`` text -> bytes for the keys this module reads (kB lines; others ignored)."""
+
+    out: dict[str, int] = {}
+    for line in text.splitlines():
+        k, sep, v = line.partition(":")
+        if not sep or k not in MEMINFO_KEYS:
+            continue
+        parts = v.split()
+        if not parts:
+            continue
+        n = int(parts[0])
+        out[k] = n * KiB if len(parts) > 1 and parts[1] == "kB" else n
+    return out
+
+
+def read_meminfo(path: str = "/proc/meminfo") -> dict[str, int]:
+    try:
+        with open(path) as f:
+            return parse_meminfo(f.read())
+    except OSError:
+        return {}
+
+
+def page_cache_credit(mi: dict[str, int], keep: int | None = None) -> int:
+    """Page cache the kernel can hand to a device allocation now: MemAvailable - MemFree (clean file pages and
+    reclaimable slab the kernel counts as available) less what cannot go at once (Dirty, Writeback) and less the
+    working set we never count (max(Mapped, ``keep``)). 0 without meminfo."""
+
+    if "MemAvailable" not in mi or "MemFree" not in mi:
+        return 0
+    keep = cache_keep_bytes() if keep is None else int(keep)
+    extra = mi["MemAvailable"] - mi["MemFree"]
+    extra -= mi.get("Dirty", 0) + mi.get("Writeback", 0)
+    extra -= max(mi.get("Mapped", 0), keep)
+    return max(0, int(extra))
+
+
+@dataclass
+class MemView:
+    """One reading: CUDA free (``cudaMemGetInfo``), the allocator's cached-but-unused bytes, the page cache credit."""
+
+    cuda_free: int
+    cached: int
+    credit: int
+    policy: str = "available"
+    meminfo: dict = field(default_factory=dict)
+
+    @property
+    def now(self) -> int:
+        """Allocatable without reclaiming anything."""
+
+        return int(self.cuda_free) + int(self.cached)
+
+    @property
+    def usable(self) -> int:
+        return self.now + (int(self.credit) if self.policy == "available" else 0)
+
+    def describe(self) -> str:
+        s = f"free {self.cuda_free / GiB:.2f} + allocator cache {self.cached / GiB:.2f}"
+        if self.policy == "available":
+            s += f" + page cache credit {self.credit / GiB:.2f}"
+            mi = self.meminfo
+            if mi:
+                s += (f" (MemAvailable {mi.get('MemAvailable', 0) / GiB:.2f}, MemFree {mi.get('MemFree', 0) / GiB:.2f}, "
+                      f"Dirty+Writeback {(mi.get('Dirty', 0) + mi.get('Writeback', 0)) / GiB:.2f}, Mapped "
+                      f"{mi.get('Mapped', 0) / GiB:.2f})")
+        return s + f" = {self.usable / GiB:.2f} GiB"
+
+
+def view(cuda_free: int, cached: int, policy: str | None = None, mi: dict | None = None,
+         keep: int | None = None) -> MemView:
+    policy = admit_policy() if policy is None else policy
+    if policy == "available":
+        mi = read_meminfo() if mi is None else mi
+        credit = page_cache_credit(mi, keep)
+    else:
+        mi, credit = mi or {}, 0
+    return MemView(int(cuda_free), max(0, int(cached)), credit, policy, mi)
+
+
+def admit_ok(v: MemView, headroom: int, need: int, floor: int | None = None) -> bool:
+    """Admission beside running requests: what may be used, less the session store's unused budget, covers ``need``
+    (``GLM53_TF_BATCH_ADMIT_GB`` + the prompt's predicted scratch growth), and something is free right now."""
+
+    floor = free_floor_bytes() if floor is None else int(floor)
+    if v.policy == "free":
+        floor = 0                                # the old rule exactly
+    return v.usable - max(0, int(headroom)) >= int(need) and v.now >= floor
+
+
+class AdmitLog:
+    """Rank 0: a line when admission starts waiting for memory (then every ``every`` s while it waits), one when a
+    request is admitted again; counts the waits."""
+
+    def __init__(self, every: float = 30.0, out=None) -> None:
+        self.every = every
+        self.out = out
+        self.since: float | None = None
+        self.last = 0.0
+        self.waits = 0
+        self.episodes = 0
+
+    def _print(self, msg: str) -> None:
+        print(msg, file=self.out or sys.stdout, flush=True)
+
+    def waiting(self, v: MemView, headroom: int, need: int, queued: int, now: float | None = None) -> None:
+        now = time.monotonic() if now is None else now
+        self.waits += 1
+        if self.since is None or now - self.last >= self.every:
+            if self.since is None:
+                self.since = now
+                self.episodes += 1
+            self.last = now
+            self._print(f"[tensorfold] admission waits for memory ({queued} queued): usable {v.describe()}, less the "
+                        f"session store's unused {max(0, headroom) / GiB:.2f} GiB, is under {need / GiB:.2f} GiB "
+                        f"(GLM53_TF_BATCH_ADMIT_GB + scratch), or free now {v.now / GiB:.2f} GiB is under the floor"
+                        + (f"; waiting {now - self.since:.0f} s" if now > self.since else ""))
+
+    def admitted(self, now: float | None = None) -> None:
+        if self.since is None:
+            return
+        now = time.monotonic() if now is None else now
+        self._print(f"[tensorfold] admission resumed after {now - self.since:.1f} s waiting for memory")
+        self.since = None
+
+
+# -- the allocator's unused cache ------------------------------------------------------------------------------------
+class Trimmer:
+    """``empty_cache`` when the allocator holds more than ``limit`` bytes it does not use, at most once every
+    ``interval`` seconds (``GLM53_TF_ALLOC_TRIM_S``, default 10: re-allocating a piece's buffers after a trim costs
+    milliseconds, so a trim cannot cost more than a fraction of a percent). A trim that frees under ``min_gain``
+    (memory of live graph pools cannot be freed) raises the trigger to what stayed + ``limit``; a later trim that frees
+    enough brings it back down. Local to a rank (no collective)."""
+
+    def __init__(self, limit: int | None = None, min_gain: int = 256 * MiB, interval: float | None = None) -> None:
+        self.limit = trim_bytes() if limit is None else int(limit)
+        self.min_gain = int(min_gain)
+        self.interval = _env_float("GLM53_TF_ALLOC_TRIM_S", 10.0) if interval is None else float(interval)
+        self.trigger = self.limit
+        self.trims = 0
+        self.freed = 0
+        self.last = float("-inf")
+
+    def maybe(self, reserved: int, allocated: int, empty_cache, after=None, now: float | None = None) -> int:
+        """-> bytes freed (0 when nothing was done). ``after()`` -> (reserved, allocated) after the trim."""
+
+        if self.limit <= 0:
+            return 0
+        unused = int(reserved) - int(allocated)
+        if unused <= self.trigger:
+            return 0
+        now = time.monotonic() if now is None else now
+        if now - self.last < self.interval:
+            return 0
+        self.last = now
+        empty_cache()
+        r2, a2 = after() if after is not None else (allocated, allocated)
+        gain = max(0, int(reserved) - int(r2))
+        left = max(0, int(r2) - int(a2))
+        self.trims += 1
+        self.freed += gain
+        self.trigger = self.limit if gain >= self.min_gain else max(self.limit, left + self.limit)
+        return gain
+
+
+def trim_torch(trimmer: "Trimmer | None") -> int:
+    """``Trimmer.maybe`` on the current CUDA device (0 without CUDA or while a graph is being captured)."""
+
+    if trimmer is None or trimmer.limit <= 0:
+        return 0
+    import torch
+
+    if not torch.cuda.is_available() or torch.cuda.is_current_stream_capturing():
+        return 0
+    return trimmer.maybe(torch.cuda.memory_reserved(), torch.cuda.memory_allocated(), torch.cuda.empty_cache,
+                         lambda: (torch.cuda.memory_reserved(), torch.cuda.memory_allocated()))
+
+
+# -- the selection's sizes (patches/0065 blocked selection, patches/0050 pool buckets) ------------------------------
+def pool_bucket(end: int, cap_pools: int) -> int:
+    """``sparse.pool_bucket``."""
+
+    need = end // POOL
+    if need > cap_pools:
+        raise ValueError(f"pool_bucket: {need} pools past the cache's {cap_pools}")
+    b = MIN_BUCKET
+    while b < need:
+        b *= 2
+    return min(b, cap_pools)
+
+
+def block_rows(R: int, np_max: int, select_mb: int = 256) -> int:
+    """``sparse.block_rows``."""
+
+    rows = (select_mb << 20) // (4 * max(np_max, 1))
+    return max(BRB, min(R, rows) // BRB * BRB)
+
+
+def select_blocks(pos: int, R: int, cap_pools: int, select_mb: int = 256, bound: bool = True) -> list[int]:
+    """Bytes of each int32 key block one blocked selection of rows pos .. pos + R - 1 allocates, in order
+    (``sparse.select_pools_blocked`` with ``np_max`` as ``latent._attend`` passes it: the pool bucket with
+    patches/0050's bound, else the cache's pools)."""
+
+    np_max = pool_bucket(pos + R, cap_pools) if bound else cap_pools
+    step = block_rows(R, np_max, select_mb)
+    out = []
+    for r0 in range(0, R, step):
+        n = min(step, R - r0)
+        need_np = (pos + r0 + n) // POOL
+        npc = min(np_max, max(TOPK_POOLS, -(-need_np // 64) * 64))
+        out.append(n * npc * 4)
+    return out
+
+
+def _round512(n: int) -> int:
+    return max(512, -(-int(n) // 512) * 512)
+
+
+def segment_size(n: int) -> int:
+    """The segment torch's caching allocator makes for a request of ``n`` bytes it cannot place in its cache."""
+
+    n = _round512(n)
+    if n <= SMALL_MAX:
+        return 2 * MiB
+    if n < LARGE_MIN:
+        return LARGE_BUFFER
+    return -(-n // SEGMENT_ROUND) * SEGMENT_ROUND
+
+
+def keys_growth(p0: int, p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256,
+                dense_limit: int = 2051, cached: tuple[int, ...] = ()) -> tuple[int, int]:
+    """The caching allocator's reserved growth from the key blocks of a prefill of positions p0 .. p1 - 1 in calls of
+    ``R`` rows (a fast chunk's sub-blocks; every DSA layer allocates the same sizes, so one layer stands for all), and
+    the largest block. Upper bound: a request reuses a cached free segment of at least its size (the smallest one;
+    freed blocks merge back into their segment) and otherwise takes a new segment, which stays cached; other
+    allocations never take these segments. ``cached``: free segment sizes already in the cache when it starts.
+    Rows before ``dense_limit`` select nothing. -> (bytes of new segments, largest block)."""
+
+    free = sorted(int(c) for c in cached)
+    grown = peak = 0
+    for s in _blocks(p0, p1, R, cap_pools, select_mb, dense_limit):
+        peak = max(peak, s)
+        if not free or free[-1] < _round512(s):       # no cached segment holds it: a new one, kept afterwards
+            seg = segment_size(s)
+            grown += seg
+            free.append(seg)
+            free.sort()
+    return grown, peak
+
+
+def _blocks(p0: int, p1: int, R: int, cap_pools: int, select_mb: int, dense_limit: int = 2051):
+    """Every key block (bytes) of a prefill of positions p0 .. p1 - 1 in calls of ``R`` rows, in order."""
+
+    p = p0
+    while p < p1:
+        r = min(R, p1 - p)
+        if p + r - 1 >= dense_limit:
+            yield from select_blocks(p, r, cap_pools, select_mb)
+        p += r
+
+
+def select_peak_scan(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, p0: int = 0) -> int:
+    """``select_peak`` by visiting every call (tests)."""
+
+    return max(_blocks(p0, p1, R, cap_pools, select_mb), default=0)
+
+
+def select_peak(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, p0: int = 0,
+                dense_limit: int = 2051) -> int:
+    """The largest key block a prefill of positions p0 .. p1 - 1 in calls of ``R`` rows allocates (<= ``select_mb``
+    MiB). Within one pool bucket a call's row blocks keep their rows and their pools only grow with the position, so
+    the largest block is in the last call of a bucket: only those (at most ~10) and the prefill's last call are sized
+    (admission runs this every round a long prompt waits)."""
+
+    if p1 <= p0:
+        return 0
+    starts = {p0 + (p1 - p0 - 1) // R * R}                      # the last call (maybe partial) ...
+    if p1 - p0 >= R:
+        starts.add(p0 + ((p1 - p0) // R - 1) * R)               # ... and the last full one
+    b = MIN_BUCKET
+    while True:
+        e = p0 + (4 * b + 3 - p0) // R * R                       # the last full call ending at or before 4b + 3
+        if p0 < e <= p1:
+            starts.add(e - R)
+        if b >= cap_pools or 4 * b > p1:
+            break
+        b *= 2
+    peak = 0
+    for p in starts:
+        r = min(R, p1 - p)
+        if p + r - 1 >= dense_limit:
+            peak = max(peak, *select_blocks(p, r, cap_pools, select_mb))
+    return peak
+
+
+SCRATCH_MIN = 16 * MiB      # the scratch's least size (a 16-row verify window's block at a 1M cache fits)
+SCRATCH_STEP = 16 * MiB     # it grows to the need rounded up to this (at most 16 growths to 256 MiB)
+
+
+def scratch_grow_to(need: int, have: int, most: int) -> int:
+    """``sparse``'s grow policy: the scratch's new size (bytes) for blocks of up to ``need`` bytes when it holds
+    ``have``: ``need`` rounded up to ``SCRATCH_STEP``, at least ``SCRATCH_MIN``, at most ``most`` rounded up (never
+    below ``need``); unchanged when it already holds ``need``. The old buffer is released when it grows (and the
+    allocator's cache emptied), so growing in steps leaves nothing behind."""
+
+    if need <= have:
+        return have
+    new = max(-(-need // SCRATCH_STEP) * SCRATCH_STEP, SCRATCH_MIN)
+    top = max(-(-most // SEGMENT_ROUND) * SEGMENT_ROUND, -(-need // SEGMENT_ROUND) * SEGMENT_ROUND)
+    return max(have, min(new, top))
+
+
+def scratch_bytes(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, have: int = 0,
+                  mode: str = "grow", p0: int = 0) -> int:
+    """What the scratch holds after a prefill of positions p0 .. p1 - 1 that reserved for itself first (``have``
+    before it): ``grow`` holds its largest block rounded up (``scratch_grow_to``), ``max`` ``select_mb`` from the
+    first use, ``off`` nothing."""
+
+    if mode == "off":
+        return 0
+    need = select_peak(p1, R, cap_pools, select_mb, p0)
+    if need <= have:
+        return have
+    most = select_mb << 20
+    return scratch_grow_to(max(need, most) if mode == "max" else need, have, most)
+
+
+def scratch_growth(p1: int, have: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256,
+                   mode: str = "grow") -> int:
+    """Admission's reservation for the scratch: how much it still grows for a prompt of ``p1`` tokens."""
+
+    return max(0, scratch_bytes(p1, R, cap_pools, select_mb, have, mode) - have)
+
+
+# -- our own files ------------------------------------------------------------------------------------------------------
+def drop_file_cache(fd: int, off: int = 0, length: int = 0, sync: bool = True) -> bool:
+    """Our buffered writes out of the page cache (written back first: DONTNEED leaves dirty pages). -> done."""
+
+    if not drop_own_cache() or not hasattr(os, "posix_fadvise"):
+        return False
+    try:
+        if sync:
+            os.fdatasync(fd)
+        os.posix_fadvise(fd, off, length, os.POSIX_FADV_DONTNEED)
+        return True
+    except OSError:
+        return False
