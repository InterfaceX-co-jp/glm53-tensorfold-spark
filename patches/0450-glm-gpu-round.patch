@@ -60,8 +65,42 @@ void replay_layers(const at::Tensor& state_in, int64_t state_stride, const at::T
                            rows, state_out);
 }
 
+// patches/0450: every slot's replay in one launch (keeps on the device); a KDA layer's chains of several slots in one
+// launch with the previous window's commit folded in (``kda.chain_slots``)
+void replay_slots(const at::Tensor& tab, const at::Tensor& keep, const at::Tensor& run, int64_t layers, int64_t heads,
+                  int64_t state_stride, int64_t skip_full) {
+    check(tab, at::kLong, "slot table");
+    check(keep, at::kInt, "keeps");
+    check(run, at::kInt, "rows run");
+    TORCH_CHECK(tab.is_contiguous() && tab.numel() == keep.numel() * 8 && run.numel() == keep.numel(),
+                "replay_slots: a table of 8 int64 a slot, a keep and a row count a slot");
+    c10::cuda::CUDAGuard guard(tab.device());
+    kda_replay_slots_cuda(tab, keep, run, layers, heads, state_stride, skip_full);
+}
+
+void chain_slots(const at::Tensor& tab, const at::Tensor& state, int64_t ni, const at::Tensor& slot_ids,
+                 int64_t col_pre, int64_t col_real, int64_t heads, int64_t b_off, const at::Tensor& cw,
+                 const at::Tensor& a_log, const at::Tensor& dt_bias, const at::Tensor& norm_w, double eps,
+                 double lower) {
+    check(tab, at::kLong, "slot table");
+    check(state, at::kInt, "slot counters");
+    check(slot_ids, at::kInt, "slot ids");
+    check(cw, at::kBFloat16, "conv weight");
+    check(a_log, at::kFloat, "A_log");
+    check(dt_bias, at::kFloat, "dt_bias");
+    check(norm_w, at::kBFloat16, "norm");
+    TORCH_CHECK(tab.is_contiguous() && tab.numel() == slot_ids.numel() * 24 && state.is_contiguous(),
+                "chain_slots: a table of 24 int64 a slot, contiguous counters");
+    TORCH_CHECK(a_log.numel() == heads && cw.is_contiguous(), "chain_slots: heads / conv weight");
+    c10::cuda::CUDAGuard guard(tab.device());
+    kda_chain_slots_cuda(tab, state, ni, slot_ids, col_pre, col_real, heads, b_off, cw, a_log, dt_bias, norm_w, eps,
+                         lower);
+}
+
 PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
     m.def("chain", &chain);
     m.def("replay", &replay);
     m.def("replay_layers", &replay_layers);
+    m.def("replay_slots", &replay_slots);        // patches/0450
+    m.def("chain_slots", &chain_slots);          // patches/0450
 }
diff --git c/src/tensorfold/families/glm5_next/cuda/kda.cu i/src/tensorfold/families/glm5_next/cuda/kda.cu
index bd90938..a91d2a2 100644
--- c/src/tensorfold/families/glm5_next/cuda/kda.cu
+++ i/src/tensorfold/families/glm5_next/cuda/kda.cu
@@ -215,6 +215,201 @@ __global__ void __launch_bounds__(1024) replay_layers_kernel(
         for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
 }
 
+
+// patches/0450 (GLM53_TF_GPU_ROUND): several slots in one launch, rows read on the device.
+//
+// replay_slots_kernel: block (layer * H + head, slot). A slot's row of ``tab`` (int64 x 8): state in, state out, k, v,
+// g, b saves (addresses), the saves' per-layer strides (k / v / g, b). keep[slot] rows are replayed; a slot whose keep
+// equals run[slot] is skipped when ``skip_full`` (the chain already wrote the state after its whole window). keep 0
+// copies the state (a finished slot's round that commits nothing). The update routine and row order are
+// ``replay_layers_kernel``'s, so the bits are.
+__global__ void __launch_bounds__(1024) replay_slots_kernel(
+        int H, const long long* __restrict__ tab, const int* __restrict__ keep, const int* __restrict__ run,
+        size_t state_stride, int skip_full) {
+    const int slot = blockIdx.y;
+    const int layer = blockIdx.x / H, h = blockIdx.x % H;
+    const int rows = keep[slot];
+    if (skip_full && rows == run[slot]) return;
+    const long long* e = tab + (size_t)slot * 8;
+    const size_t kv_stride = (size_t)e[6], b_stride = (size_t)e[7];
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const float* sin = reinterpret_cast<const float*>(e[0]) + layer * state_stride;
+    float* sout = reinterpret_cast<float*>(e[1]) + layer * state_stride;
+    const float* ks = reinterpret_cast<const float*>(e[2]) + layer * kv_stride;
+    const __nv_bfloat16* vsv = reinterpret_cast<const __nv_bfloat16*>(e[3]) + layer * kv_stride;
+    const float* gsv = reinterpret_cast<const float*>(e[4]) + layer * kv_stride;
+    const float* bsv = reinterpret_cast<const float*>(e[5]) + layer * b_stride;
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = sin[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(vsv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[base + lane * 4 + i]; gg[i] = gsv[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, bsv[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// chain_slots_kernel: ``chain_kernel`` for one KDA layer of several slots (block (head, slot)) with the previous
+// window's commit folded in. A slot's row of ``tab`` (int64 x 24):
+//   0 P rows, 1 p_stride, 2 A rows, 3 a_stride, 4 G rows, 5 g_stride, 6 conv state, 7 state in, 8 state out,
+//   9 out rows, 10 k save, 11 v save, 12 g save, 13 b save, 14 rows, 15 prev k save, 16 prev v save, 17 prev g save,
+//   18 prev b save, 19 proj rows (the window rows the conv shift reads), 20 proj row stride, 21-23 unused.
+// The slot's counters are read on the device (``state`` int32 [slots, ni], row ``slot_ids[slot]``): the first
+// state[col_pre] rows of the previous window are replayed from its saves (``replay_kernel``'s loop: the committed
+// state), which is written to ``state out``; then the window's first min(rows, 1 + state[col_real]) rows (its real
+// rows: padded rows are not run) as ``chain_kernel`` runs them (the same statements), saving what the next window's
+// prologue (or a replay) needs, and each row's conv channels are stored to the proj rows. The state after the window
+// is not written: the next window's prologue makes it.
+__global__ void __launch_bounds__(1024) chain_slots_kernel(
+        int H, int b_off, const long long* __restrict__ tab, const int* __restrict__ state, int ni,
+        const int* __restrict__ slot_ids, int col_pre, int col_real,
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, float lower) {
+    const int slot = blockIdx.y;
+    const long long* e = tab + (size_t)slot * 24;
+    const int* __restrict__ sc = state + (size_t)slot_ids[slot] * ni;
+    const __nv_bfloat16* __restrict__ P = reinterpret_cast<const __nv_bfloat16*>(e[0]);
+    const int p_stride = (int)e[1];
+    const __nv_bfloat16* __restrict__ A = reinterpret_cast<const __nv_bfloat16*>(e[2]);
+    const int a_stride = (int)e[3];
+    const __nv_bfloat16* __restrict__ G = reinterpret_cast<const __nv_bfloat16*>(e[4]);
+    const int g_stride = (int)e[5];
+    const __nv_bfloat16* __restrict__ cs = reinterpret_cast<const __nv_bfloat16*>(e[6]);
+    const float* __restrict__ state_in = reinterpret_cast<const float*>(e[7]);
+    float* __restrict__ state_out = reinterpret_cast<float*>(e[8]);
+    __nv_bfloat16* __restrict__ out = reinterpret_cast<__nv_bfloat16*>(e[9]);
+    float* __restrict__ k_save = reinterpret_cast<float*>(e[10]);
+    __nv_bfloat16* __restrict__ v_save = reinterpret_cast<__nv_bfloat16*>(e[11]);
+    float* __restrict__ g_save = reinterpret_cast<float*>(e[12]);
+    float* __restrict__ b_save = reinterpret_cast<float*>(e[13]);
+    const int rows = min((int)e[14], 1 + sc[col_real]);
+    const float* __restrict__ pk = reinterpret_cast<const float*>(e[15]);
+    const __nv_bfloat16* __restrict__ pv = reinterpret_cast<const __nv_bfloat16*>(e[16]);
+    const float* __restrict__ pg = reinterpret_cast<const float*>(e[17]);
+    const float* __restrict__ pb = reinterpret_cast<const float*>(e[18]);
+    __nv_bfloat16* __restrict__ proj = reinterpret_cast<__nv_bfloat16*>(e[19]);
+    const size_t proj_stride = (size_t)e[20];
+    const int C = 3 * H * DK;                         // conv channels: q | k | v
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK], vs[DV], ys[DV], gs[DK];
+    __shared__ float beta_s, rinv;
+    int c = -1;
+    if (t < 3 * DK) c = (t / DK) * H * DK + h * DK + (t % DK);
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    // the previous window's kept rows (``replay_kernel``)
+    const int npre = sc[col_pre];
+    for (int r = 0; r < npre; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(pv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = pk[base + lane * 4 + i]; gg[i] = pg[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, pb[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+    // the window (``chain_kernel``)
+    const float decay_rate = expf(a_log[h]);
+    for (int r = 0; r < rows; ++r) {
+        if (c >= 0) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int tap = 0; tap < TAPS; ++tap) {
+                const int at = r + tap;
+                const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                              : __bfloat162float(P[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+                acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+            }
+            const float act = bf(acc / (1.0f + expf(-acc)));
+            if (t < DK) qs[t] = act;
+            else if (t < 2 * DK) ks[t - DK] = act;
+            else vs[t - 2 * DK] = act;
+            proj[(size_t)r * proj_stride + c] = P[(size_t)r * p_stride + c];
+        } else if (t >= 512 && t < 512 + DK) {
+            const int i = t - 512;
+            const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+            gs[i] = expf(lower * sigmoidf_(decay_rate * a));
+        } else if (t == 1023) {
+            beta_s = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+        }
+        __syncthreads();
+        if (warp < 2) {
+            float* x = warp == 0 ? qs : ks;
+            float v4[4], ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+            ss = warp_sum(ss);
+            float inv = 1.0f / sqrtf(ss + 1e-6f);
+            __syncwarp();
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                float y = v4[i] * inv;
+                if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+                x[lane * 4 + i] = y;
+            }
+        }
+        __syncthreads();
+        const float beta = beta_s;
+        float kk[4], qq[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[lane * 4 + i]; qq[i] = qs[lane * 4 + i]; gg[i] = gs[lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, beta);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+            o = warp_sum(o);
+            if (lane == 0) ys[warp * 4 + j] = bf(o);
+        }
+        {
+            const size_t base = ((size_t)r * H + h) * DK;
+            if (t < DK) { k_save[base + t] = ks[t]; g_save[base + t] = gs[t]; }
+            if (t >= DK && t < DK + DV) v_save[base + t - DK] = __float2bfloat16_rn(vs[t - DK]);
+            if (t == 0) b_save[r * H + h] = beta;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { const float y = ys[lane * 4 + i]; ss = ss + y * y; }
+            ss = warp_sum(ss);
+            if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+        }
+        __syncthreads();
+        if (t < DV) {
+            const float yn = ys[t] * rinv;
+            const float yw = __bfloat162float(norm_w[t]) * yn;
+            const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+            out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+        }
+        __syncthreads();
+    }
+}
+
 }  // namespace
 
 template <typename T>
@@ -256,3 +451,25 @@ void kda_replay_layers_cuda(const at::Tensor& state_in, int64_t state_stride, co
         ptr<float>(g_save), ptr<float>(b_save), (size_t)kv_stride, (size_t)b_stride, (int)rows, ptr<float>(state_out));
     C10_CUDA_KERNEL_LAUNCH_CHECK();
 }
+
+void kda_replay_slots_cuda(const at::Tensor& tab, const at::Tensor& keep, const at::Tensor& run, int64_t layers,
+                           int64_t heads, int64_t state_stride, int64_t skip_full) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int slots = (int)keep.numel();
+    replay_slots_kernel<<<dim3((unsigned)(layers * heads), (unsigned)slots), 1024, 0, stream>>>(
+        (int)heads, ptr<long long>(tab), ptr<int>(keep), ptr<int>(run), (size_t)state_stride, (int)skip_full);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_chain_slots_cuda(const at::Tensor& tab, const at::Tensor& state, int64_t ni, const at::Tensor& slot_ids,
+                          int64_t col_pre, int64_t col_real, int64_t heads, int64_t b_off, const at::Tensor& cw,
+                          const at::Tensor& a_log, const at::Tensor& dt_bias, const at::Tensor& norm_w, double eps,
+                          double lower) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int slots = (int)slot_ids.numel();
+    chain_slots_kernel<<<dim3((unsigned)heads, (unsigned)slots), 1024, 0, stream>>>(
+        (int)heads, (int)b_off, ptr<long long>(tab), ptr<int>(state), (int)ni, ptr<int>(slot_ids), (int)col_pre,
+        (int)col_real, ptr<__nv_bfloat16>(cw), ptr<float>(a_log), ptr<float>(dt_bias), ptr<__nv_bfloat16>(norm_w),
+        (float)eps, (float)lower);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
