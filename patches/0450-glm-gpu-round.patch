+    c2 = chain * q
+    take_opt = (j == 0) | (c2 >= lam * tl.load(par + 66 + tl.minimum(j + 1, 16)))
+    conf = tl.load(par + 84)
+    take_conf = (j == 0) | (conf <= 0.0) | (chain * p >= conf)
+    take = tl.where(mode == 1, take_opt, take_conf) & live & (j < count)
+    gain = c2 * 0.5 * (tl.load(par + 32 + tl.minimum(j + 1, 15)) + q)
+    more_opt = (gain >= lam * (tl.load(par + 83) + tl.load(par + 66 + tl.minimum(j + 2, 16)))) & \
+        (j + 2 <= tl.load(par + 86).to(tl.int32))
+    c3 = tl.where(mode == 1, c2, tl.where(conf > 0.0, chain * p, chain))
+    more_conf = (conf <= 0.0) | (c3 >= conf)
+    more = tl.where(mode == 1, more_opt, more_conf) & (j + 1 < count) & take
+    n = tl.load(b + 14)
+    tl.store(NEXT + s * MAXD_ + tl.minimum(n, MAXD_ - 1), d, mask=take)
+    tl.store(NPROB + s * MAXD_ + tl.minimum(n, MAXD_ - 1), p, mask=take)
+    tl.store(b + 14, n + take.to(tl.int32))
+    tl.store(F + s * NF_ + 0, tl.where(take, c3, chain))
+    tl.store(b + 15, more.to(tl.int32))
+    tl.store(b + 16, tl.load(b + 16) + more.to(tl.int32))
