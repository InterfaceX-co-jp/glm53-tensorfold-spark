index 60eb8cd..2499739 100644
--- c/src/tensorfold/families/glm5_next/cuda/kda.py
+++ i/src/tensorfold/families/glm5_next/cuda/kda.py
@@ -78,3 +78,35 @@ def chain(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_st
 
 def replay(state_in: torch.Tensor, scratch: KDAScratch, rows: int, state_out: torch.Tensor) -> None:
     _ext().replay(state_in, scratch.k, scratch.v, scratch.g, scratch.b, int(rows), state_out)
+
+
+# -- patches/0450 (GLM53_TF_GPU_ROUND ``kda``): several slots a launch, commits folded into the next chain -------------
+class SlotTables:
+    """``chain_slots``' per-layer tables for one round key (slots, their rows in the round, their KDA parities): per
+    slot the window's projection / gate rows in the batch buffers, its conv window, state in (``rec[cur]``, the state
+    before the previous window's kept rows) / out (``rec[1 - cur]``: the committed state it writes), its output rows,
+    this parity's saves and the previous window's, and its proj rows (the conv shift reads them). Built once; a CUDA
+    graph of the round holds these addresses."""
+
+    def __init__(self, sts, saves, prev, b, offs, Rs, state, slot_ids, ni: int, col_pre: int, col_real: int = 5):
+        self.state, self.slot_ids, self.ni, self.col_pre, self.col_real = state, slot_ids, ni, col_pre, col_real
+        n_layers = len(sts[0].cur)
+        dev = sts[0].rec.device
+        rows = []
+        for li in range(n_layers):
+            layer_rows = []
+            for st, sv, pv, o, R in zip(sts, saves, prev, offs, Rs):
+                cur = st.cur[li]
+                a, pa = sv.views[li], pv.views[li]
+                layer_rows.append([b.bproj[o].data_ptr(), b.bproj.stride(0), b.ka[o].data_ptr(), b.ka.stride(0),
+                                   b.kg[o].data_ptr(), b.kg.stride(0), st.conv[li].data_ptr(),
+                                   st.rec[cur, li].data_ptr(), st.rec[1 - cur, li].data_ptr(),
+                                   b.bkout[o].data_ptr(), a.k.data_ptr(), a.v.data_ptr(), a.g.data_ptr(),
+                                   a.b.data_ptr(), int(R), pa.k.data_ptr(), pa.v.data_ptr(), pa.g.data_ptr(),
+                                   pa.b.data_ptr(), st.proj[li].data_ptr(), st.proj.stride(1), 0, 0, 0])
+            rows.append(layer_rows)
+        self.tab = torch.tensor(rows, dtype=torch.int64, device=dev)       # [layers, slots, 24]
+
+    def chain(self, li: int, k, heads: int, eps: float, lower: float) -> None:
+        _ext().chain_slots(self.tab[li], self.state, self.ni, self.slot_ids, self.col_pre, self.col_real, heads,
+                           int(k.b_off), k.conv, k.a_log, k.dt_bias, k.norm, float(eps), float(lower))
diff --git c/src/tensorfold/families/glm5_next/cuda/resident.py i/src/tensorfold/families/glm5_next/cuda/resident.py
new file mode 100644
index 0000000..2f6f959
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/resident.py
@@ -0,0 +1,1177 @@
+"""patches/0450 (GLM53_TF_GPU_ROUND ``resident``): GPU-resident decode rounds inside ``Batcher`` (docs/GPU-ROUND.md).
+
+A resident round is the batch round (``Batcher._verify`` + ``Stepper.propose``) with every step that read the device
+from the host moved onto the device, and the host one round behind:
+
+    stage   the window's ids from the device state (pending token, drafts; padded rows repeat the last real token and
+            route as it, patches/0280's tie, so they read no experts of their own), the sampler rows' positions
+    forward ``compute_multi`` (capturable code; CUDA graphs per key under the batcher's graph policy)
+    sample  every slot's top-k, one all-gather (rank 0's drain flag rides on it), ``gpusample``: the host's bits
+    accept  ``Stepper.accept``'s rule, counters, the MTP token backlog, the round's record (``gpuround._accept_kernel``)
+    commit  KDA replay of every slot in one launch (keeps on the device; the ``kda`` part folds it into the next
+            chain), conv windows, positions
+    backlog the kept rows' MTP input rows and DFlash2 taps into the slots' backlogs
+    draft   the next window: MTP chains (every m-slot's backlog in one head pass, then one pass a chained step,
+            device-sampled drafts fed to the next step, ``DepthOptimizer.mtp_next`` on the device) and DFlash2 blocks
+            (taps with a device count, the block pass, the chain and ``f_depth`` on the device)
+    record  one pinned copy of the round's record; an event
+
+The host launches round k, then waits for round k - 1's event and does that round's bookkeeping (``Stepper`` records,
+emits, depth calibration). Its decisions for a window (drafter, depth bound, rows) are one round stale; the device
+decides the drafts themselves. Exactness does not depend on any of that: the accept rule, the sampler bits and the
+commit are the serial ones, and drafts only propose.
+
+Rounds run while the batch is steady. Anything else drains them (the round in flight is processed, the host state is
+materialized: positions, KDA state, index tails, the steppers' next drafts and backlogs) and the normal path takes over
+with the same state: a finished request, rank 0's drain flag (a queued request, a cancel, stopping), a lookup match, a
+window whose context mode is not certain (crossing 2,051 or a pool bucket), the cache's end. Every such check is made
+before a round is launched, so a round is never cut half-way.
+"""
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass, field
+from typing import Any, Sequence
+
+import numpy as np
+import torch
+import triton
+
+from tensorfold.engine.exact_sampling import MARGIN
+
+from . import gpuround as gr, gpusample
+
+RING = 4                                # pinned staging / record slots (at most 2 rounds in flight)
+
+
+def _tracks_m(stp) -> bool:
+    """Whether the request keeps an MTP backlog (``Stepper.accept``: drafting requests with the MTP head)."""
+
+    return stp.policy is not None and stp.use_mtp
+
+
+def _tracks_f(stp) -> bool:
+    return stp.policy is not None and stp.drafter is not None
+
+
+@dataclass
+class Window:
+    """One slot's window: drafted in round k - 1, verified in round k."""
+
+    arm: str = "s"                      # "s" serial, "m" MTP, "f" DFlash2
+    rows: int = 1                       # rows run (1 + the drafts' bound)
+    steps: int = 0                      # MTP head passes (absorb + chained)
+    backlog: int = 0                    # rows the drafter took before drafting it (the cost model's catch-up)
+
+
+@dataclass
+class Plan:
+    """What the host decided for the round it launches."""
+
+    nxt: dict[int, Window]              # the next windows (drafted in this round)
+    modes: list                         # the verified windows' context modes
+    flush_m: list[int]                  # slots whose MTP backlog is taken although they draft otherwise
+    flush_f: list[int]
+    n_hi_m: dict[int, int]              # head rows an absorb runs (a bound of the backlog; the device counts)
+    n_hi_f: dict[int, int]
+    m_modes: dict[int, list]            # per m-slot: the absorb's mode, then each chained step's
+
+
+@dataclass
+class Launched:
+    k: int
+    active: list[int]
+    windows: dict[int, Window]
+    nxt: dict[int, Window]
+    ring: int
+    event: Any = None
+    t0: float = 0.0
+
+
+@dataclass
+class SlotHost:
+    """The host's view of a slot during resident rounds (one round late)."""
+
+    pos: int = 0                        # committed length after the last processed round
+    count: int = 0
+    mcount: int = 0                     # MTP backlog after the last processed round's drafting
+    fcount: int = 0
+    mbase: int = 0                      # the MTP head's committed length after it
+    probs: list = field(default_factory=list)   # the pending window's drafts' probabilities
+    m_depths: list = field(default_factory=list)
+    f_depths: list = field(default_factory=list)
+
+
+class ResidentState:
+    """The device side: counters, drafts, backlogs, staging and the record ring (both ranks alike)."""
+
+    def __init__(self, n: int, rows: int, backlog: int, device, eos: Sequence[int]) -> None:
+        dev = torch.device(device)
+        pin = dev.type == "cuda"
+        self.n, self.rows, self.backlog = n, rows, backlog
+        self.I = torch.zeros((n, gr.NI), dtype=torch.int32, device=dev)
+        self.H = torch.zeros((n, gr.NH), dtype=torch.int32, device=dev)
+        self.F = torch.ones((n, gr.NF), dtype=torch.float64, device=dev)
+        self.P = torch.zeros((n, gr.NP), dtype=torch.float64, device=dev)
+        self.DRAFT = torch.zeros((n, gr.MAXD), dtype=torch.int32, device=dev)
+        self.DPROB = torch.zeros((n, gr.MAXD), dtype=torch.float64, device=dev)
+        self.NEXT = torch.zeros((n, gr.MAXD), dtype=torch.int32, device=dev)
+        self.NPROB = torch.zeros((n, gr.MAXD), dtype=torch.float64, device=dev)
+        self.MTOK = torch.zeros((n, backlog + 1), dtype=torch.int32, device=dev)
+        self.EOS = torch.tensor(list(eos) or [-1], dtype=torch.int32, device=dev)
+        self.n_eos = len(eos)
+        self.KEEPV = torch.zeros((n,), dtype=torch.int32, device=dev)
+        self.RUNV = torch.zeros((n,), dtype=torch.int32, device=dev)
+        self.TOK = torch.zeros((rows,), dtype=torch.int32, device=dev)
+        self.SRC = torch.arange(rows, dtype=torch.int64, device=dev)
+        self.ROWS = torch.zeros((2, rows), dtype=torch.int32, device=dev)     # each round row's slot and window row
+        self.MAXR = rows
+        self.rec_w = gr.REC_HEAD + rows + gr.MAXD
+        self.REC = torch.zeros((n + 1, self.rec_w), dtype=torch.int32, device=dev)     # + rank 0's rider row
+        self.RECF = torch.zeros((n, gr.MAXD), dtype=torch.float64, device=dev)
+
+        def host(t: torch.Tensor) -> torch.Tensor:
+            h = torch.zeros(t.shape, dtype=t.dtype)
+            return h.pin_memory() if pin else h
+
+        self.h_rec = [host(self.REC) for _ in range(RING)]
+        self.h_recf = [host(self.RECF) for _ in range(RING)]
+        self.h_H = [host(self.H) for _ in range(RING)]
+        self.h_P = [host(self.P) for _ in range(RING)]
+        self.h_rows = [host(self.ROWS) for _ in range(RING)]
+        self.h_I = host(self.I)
+        self.h_draft = host(self.DRAFT)
+        self.h_mtok = host(self.MTOK)
+        self.h_rider: list[torch.Tensor] = []          # the rider's staging, a slot per round in flight
+        self.SEL = torch.zeros((rows,), dtype=torch.int64, device=dev)   # the head passes' selected rows
+        self.h_peek = host(self.I)                     # GLM53_TF_GPU_ROUND_PEEK: the counters, read at a decision
+
+
+class Resident:
+    """A batcher's resident rounds (both ranks). ``ops``: a factory of the model side, called with this object
+    (``RealOps``; the tests' fake)."""
+
+    def __init__(self, bat, ops=None) -> None:
+        from .batch import BACKLOG
+
+        self.bat = bat
+        self.settings = gr.env()
+        self.kda = self.settings.kda
+        self.peek = gr.peek()
+        self.steps_run: dict[int, int] = {}      # peek: the MTP head passes this round's chains ran, per slot
+        self.peeks = 0                           # peek: device records read at a decision
+        self.ops = (ops or RealOps)(self)
+        n = bat.n
+        rows = min(self.ops.max_rows(), n * gr.MAXD)
+        self.st = ResidentState(n, rows, BACKLOG, self.ops.device(), bat.eos)
+        if bat.rider_n:                         # the rider's staging, a pinned slot per round in flight
+            pin = torch.device(self.ops.device()).type == "cuda"
+            self.st.h_rider = [torch.zeros((bat.rider_n,), dtype=torch.int32) for _ in range(RING)]
+            if pin:
+                self.st.h_rider = [t.pin_memory() for t in self.st.h_rider]
+        self.k = 0
+        self.rounds = 0
+        self.entries = 0
+        self.drains: dict[str, int] = {}
+        self.host: dict[int, SlotHost] = {}
+        self.flight: dict[int, int] = {}    # rows of each slot's window in the launched, unprocessed round
+        self.took: dict[int, tuple[bool, bool]] = {}    # did that round's drafting take the MTP / taps backlog
+        self.windows: dict[int, Window] = {}
+
+    # -- when -------------------------------------------------------------------------------------------------------
+    def eligible(self, active: list[int]) -> str | None:
+        """Why the batch cannot go resident after this round (None: it can). Deterministic on both ranks."""
+
+        bat = self.bat
+        if not active:
+            return "idle"
+        if not gr.sample_on(bat.g.w):
+            return "sampler"
+        from . import dump as dump_mod
+
+        if dump_mod.DUMP is not None:
+            return "dump"
+        world = 1 if bat.g.w.comm is None else bat.g.w.world
+        for s in active:
+            q = bat.seqs[s]
+            if q is None or q.stepper is None:
+                return "prefill"
+            stp = q.stepper
+            if stp.done(bat.eos):
+                return "done"
+            if stp.arm not in ("s", "m", "f"):
+                return f"arm {stp.arm}"
+            sp = stp.job.sampling
+            k = int(sp.top_k) + MARGIN if sp is not None and sp.temperature > 0 else 20 + MARGIN
+            if not gpusample.fits(k, world, sp, True):
+                return "top_k"
+            st = bat.states[s]
+            if _tracks_m(stp) and st.mtp_len - st.mtp_drafted <= 0:
+                return "mtp start"
+            if len(stp.drafts) >= gr.MAXD:
+                return "window"
+            rows = 1 + len(stp.drafts)          # the first round's commit appends up to its rows to the backlogs
+            if (_tracks_m(stp) and len(stp.m_next) + rows > self.st.backlog) or \
+                    (_tracks_f(stp) and stp.n_f + rows > self.st.backlog):
+                return "backlog"
+            if self.ops.mode(s, st.pos, st.pos, 1 + len(stp.drafts)) is None:
+                return "context mode"
+        return None
+
+    # -- the loop ----------------------------------------------------------------------------------------------------
+    def run(self, active: list[int]) -> str:
+        """Resident rounds over ``active`` until something drains them; then the batcher's state is the normal path's
+        and every finished request is finished. Both ranks call this at the same point with the same slots. -> why it
+        drained."""
+
+        bat = self.bat
+        self.entries += 1
+        self._enter(active)
+        inflight: Launched | None = None
+        reason = None
+        try:
+            while True:
+                plan = self._decide(active)
+                if isinstance(plan, str):
+                    reason = plan
+                    break
+                h, reason = self._launch(active, plan, inflight)      # processes the round in flight on the way
+                inflight = h
+                if reason is not None:
+                    break
+        finally:
+            if inflight is not None:
+                reason = self._process(inflight) or reason
+            self._exit(active)
+        reason = reason or "?"
+        self.drains[reason] = self.drains.get(reason, 0) + 1
+        for s in active:
+            q = bat.seqs[s]
+            if q is not None and q.stepper is not None and q.stepper.done(bat.eos):
+                bat._finish(s)
+        return reason
+
+    # -- entering: the normal path's state onto the device -------------------------------------------------------------
+    def _enter(self, active: list[int]) -> None:
+        bat, S = self.bat, self.st
+        I = S.h_I.numpy()
+        I[:] = 0
+        dr = S.h_draft.numpy()
+        dr[:] = 0
+        mt = S.h_mtok.numpy()
+        mt[:] = 0
+        self.host = {}
+        self.windows = {}
+        for s in active:
+            stp = bat.seqs[s].stepper
+            st = bat.states[s]
+            I[s, gr.PEND] = stp.out[-1]
+            I[s, gr.COUNT] = len(stp.out)
+            I[s, gr.MAXTOK] = stp.job.max_tokens
+            I[s, gr.STOPEOS] = int(stp.job.stop_eos)
+            I[s, gr.NREAL] = len(stp.drafts)
+            mc = len(stp.m_next) if _tracks_m(stp) else 0
+            fc = stp.n_f if _tracks_f(stp) else 0
+            I[s, gr.MCOUNT] = mc
+            I[s, gr.FCOUNT] = fc
+            I[s, gr.POS] = st.pos
+            mbase = st.mtp_len - st.mtp_drafted
+            I[s, gr.MBASE] = mbase
+            dr[s, :len(stp.drafts)] = stp.drafts
+            if mc:
+                mt[s, :mc] = stp.m_next         # (the device appends to every slot's; only these are read)
+            used = list(getattr(stp.opt, "used", []) or []) if stp.opt is not None else []
+            self.host[s] = SlotHost(pos=st.pos, count=len(stp.out), mcount=mc, fcount=fc, mbase=mbase, probs=used)
+            self.windows[s] = Window(arm=stp.arm, rows=1 + len(stp.drafts), steps=stp.steps, backlog=stp.backlog)
+            if st.mtp_drafted:               # ``decode.absorb``: the chained entries go at the next absorb
+                st.set_mtp_len(mbase)
+                st.mtp_drafted = 0
+        S.I.copy_(S.h_I, non_blocking=True)
+        S.DRAFT.copy_(S.h_draft, non_blocking=True)
+        S.MTOK.copy_(S.h_mtok, non_blocking=True)
+        S.F.fill_(1.0)
+        self.ops.enter(active)
+        self.k = 0
+        self.flight = {}
+        self.took = {}
+
+    # -- the host's decisions for the round it launches (one round stale) --------------------------------------------
+    def _decide(self, active: list[int]) -> Plan | str:
+        """This round verifies ``self.windows`` and drafts the next ones: per slot the drafter, its bound and rows,
+        every context mode the round meets, the backlog flushes. -> the plan, or why the rounds must drain."""
+
+        bat, S = self.bat, self.st
+        nxt: dict[int, Window] = {}
+        modes = []
+        for s in active:
+            stp = bat.seqs[s].stepper
+            hs = self.host[s]
+            st = bat.states[s]
+            win = self.windows[s]
+            lo, hi = hs.pos, hs.pos + self._inflight_rows(s)   # the window starts somewhere in [lo, hi]
+            m = self.ops.mode(s, lo, hi, win.rows)
+            if m is None:
+                return "context mode"
+            modes.append(m)
+            if hi + win.rows + 2 * gr.MAXD + 2 > st.capacity:
+                return "capacity"
+            try:                                # patches/0290: map the pages the window may write (host only)
+                self.ops.room(s, hi + win.rows)
+            except Exception:  # noqa: BLE001 - short of pool pages: the normal path decides
+                return "pool"
+            room = stp.job.max_tokens - (hs.count + self._inflight_rows(s))
+            arm, bound = self._arm(s, stp, hs, room)
+            if arm is None:
+                return "lookup"
+            rows = 1 + bound if arm in ("m", "f") else 1
+            nxt[s] = Window(arm=arm, rows=rows, steps=bound if arm == "m" else 0)
+        # backlogs: the absorb / taps pass takes at most this many rows; one that could overflow at the next commit is
+        # taken now (``Stepper.accept``'s early absorb)
+        flush_m, flush_f, n_hi_m, n_hi_f, m_modes = [], [], {}, {}, {}
+        for s in active:
+            stp = bat.seqs[s].stepper
+            win, w2 = self.windows[s], nxt[s]
+            m_hi = self._m_hi(s) + win.rows
+            f_hi = self._f_hi(s) + win.rows
+            if _tracks_m(stp) and (w2.arm == "m" or m_hi + w2.rows > S.backlog):
+                if w2.arm != "m":
+                    flush_m.append(s)
+                n = min(S.backlog, m_hi)
+                n_hi_m[s] = n
+                w2.backlog = n if w2.arm == "m" else w2.backlog
+                hs = self.host[s]
+                mm = [self.ops.mode_mtp(s, hs.mbase, hs.mbase + self._m_hi(s) + win.rows, n)]
+                if w2.arm == "m":
+                    mm += [self.ops.mode_mtp(s, hs.mbase + j, hs.mbase + m_hi + j, 1) for j in range(w2.steps - 1)]
+                if any(x is None for x in mm):
+                    return "MTP context mode"
+                m_modes[s] = mm
+            if _tracks_f(stp) and (w2.arm == "f" or f_hi + w2.rows > S.backlog):
+                if w2.arm != "f":
+                    flush_f.append(s)
+                n_hi_f[s] = min(S.backlog, f_hi)
+                if w2.arm == "f":
+                    w2.backlog = n_hi_f[s]
+        return Plan(nxt, modes, flush_m, flush_f, n_hi_m, n_hi_f, m_modes)
+
+    def _inflight_rows(self, s: int) -> int:
+        """Rows a slot may still commit in the round launched but not processed (0 before the first)."""
+
+        return self.flight.get(s, 0)
+
+    def _m_hi(self, s: int) -> int:
+        """A bound of the slot's MTP backlog at the end of the launched, unprocessed round: 0 when its drafting took
+        the backlog (the head absorbed it), else the last processed count plus the rows that round may have kept."""
+
+        if self.took.get(s, (False, False))[0]:
+            return 0
+        return self.host[s].mcount + self._inflight_rows(s)
+
+    def _f_hi(self, s: int) -> int:
+        if self.took.get(s, (False, False))[1]:
+            return 0
+        return self.host[s].fcount + self._inflight_rows(s)
+
+    def _arm(self, s: int, stp, hs: SlotHost, room: int) -> tuple[str | None, int]:
+        """``Stepper.propose``'s choices with the host's (stale) records: the drafter and the window's bound.
+        (None, 0): a lookup match (the normal path drafts it)."""
+
+        from . import adapt as adapt_mod
+
+        if stp.policy is None or room <= 1:
+            return "s", 0
+        if stp.lookup is not None:
+            stp.lookup.sync(stp.out)
+            most = min(stp.lookup.most, room)
+            drafts = stp.lookup.index.propose(most, stp.lookup.min_match)[0] if most > 0 else []
+            if drafts:
+                return None, 0
+        if stp.adapt is not None:
+            arm = stp.adapt.pick(self.bat.round_costs.rate())
+        else:
+            arm = stp.choice.pick() if stp.choice is not None else "m"
+        if arm == adapt_mod.SERIAL or (arm == "f" and stp.drafter is None):
+            return "s", 0
+        if arm == "m":
+            depth = max(1, min(stp.m_policy.next(*stp.last["m"]) if stp.opt is None else stp.opt.most_m, room))
+            if self.peek:                       # the device stops the chain; the host runs exactly its steps
+                return "m", max(1, min(depth, gr.MAXD - 1))
+            recent = hs.m_depths[-4:]
+            guess = (max(recent) + 1) if recent else 2           # the chain the device ran lately, one more
+            return "m", max(1, min(depth, guess, gr.MAXD - 1))
+        most = stp.opt.most_f if stp.opt is not None else stp.f_policy.next(*stp.last["f"])
+        depth = max(1, min(most, room, stp.drafter.block - 1))
+        if self.peek:                           # the next window's rows are read after the block
+            return "f", max(1, min(depth, gr.MAXD - 1))
+        recent = hs.f_depths[-4:]
+        guess = (max(recent) + 2) if recent else depth
+        return "f", max(1, min(depth, guess, gr.MAXD - 1))
+
+    # -- launching a round ---------------------------------------------------------------------------------------------
+    def peek_state(self) -> np.ndarray:
+        """GLM53_TF_GPU_ROUND_PEEK: the device counters as the stream has them now (a small pinned copy and its event:
+        no stream synchronization, nothing else waited for)."""
+
+        S = self.st
+        self.peeks += 1
+        S.h_peek.copy_(S.I, non_blocking=True)
+        self.ops.wait(self.ops.event())
+        return S.h_peek.numpy()
+
+    def _launch(self, active: list[int], plan: Plan, prev: Launched | None) -> tuple[Launched, str | None]:
+        """Round k: its front (the verify window through the commit and backlogs), then (peek) the previous round's
+        bookkeeping while the front runs, then the draft stage. -> (the round, a drain reason from the previous one)."""
+
+        bat, S, ops = self.bat, self.st, self.ops
+        reason = None
+        ring = self.k % RING
+        wins, nxt = self.windows, plan.nxt
+        Rs = [wins[s].rows for s in active]
+        T = sum(Rs)
+        H = S.h_H[ring].numpy()
+        H[:] = 0
+        P = S.h_P[ring].numpy()
+        P[:] = 0.0
+        rows = S.h_rows[ring].numpy()
+        o = 0
+        for s, R in zip(active, Rs):
+            H[s, gr.RUN] = R
+            H[s, gr.OFF] = o
+            w = nxt[s]
+            H[s, gr.BOUND] = w.rows - 1 if w.arm in ("m", "f") else 0
+            H[s, gr.ARMN] = {"s": gr.ARM_S, "m": gr.ARM_M, "f": gr.ARM_F}[w.arm]
+            stp = bat.seqs[s].stepper
+            if stp.opt is not None:         # batch-aware depths: this request's rows come after the others'
+                stp.opt.verify = bat.round_costs.table(sum(nxt[x].rows for x in active if x != s))
+            self._params(P[s], stp, w.arm)
+            rows[0, o:o + R] = s
+            rows[1, o:o + R] = np.arange(R)
+            o += R
+        S.H.copy_(S.h_H[ring], non_blocking=True)
+        S.P.copy_(S.h_P[ring], non_blocking=True)
+        S.ROWS[:, :T].copy_(S.h_rows[ring][:, :T], non_blocking=True)
+        ints, flts, width = self._sampler_rows(active, Rs)
+        ops.stage(T, ints)
+        logits = ops.forward(active, Rs, plan.modes)
+        if bat.overlap.emit:                    # patches/0370: the GPU is busy; the HTTP threads may run
+            bat._flush()
+        rider = self._rider(ring)
+        buf, P_len, at = ops.gather_candidates(logits, active, Rs, rider)
+        gpusample.launch(buf, P_len, ops.world(), ints, flts, S.TOK, None, ops.scratch(T, width), width)
+        n = len(active)
+        slots_t = ops.slots_tensor(active)
+        gr._accept_kernel[(n,)](S.I, S.H, S.F, S.DRAFT, S.TOK, S.EOS, S.n_eos, S.KEEPV, S.MTOK, S.REC, slots_t,
+                                BACKLOG_=S.backlog, NI_=gr.NI, NH_=gr.NH, NF_=gr.NF, MAXD_=gr.MAXD, REC_W=S.rec_w,
+                                MAXR=S.MAXR, num_warps=1)
+        ops.commit(active, Rs)
+        ops.backlogs(active, slots_t, max(Rs))
+        if self.peek and prev is not None:      # the host's work for round k - 1 while this round's forward runs
+            reason = self._process(prev)
+            prev = None
+        self.steps_run = {}
+        ms = [s for s in active if nxt[s].arm == "m"]
+        fs = [s for s in active if nxt[s].arm == "f"]
+        if ms or plan.flush_m:
+            ops.mtp(ms, plan.flush_m, nxt, plan.n_hi_m, plan.m_modes)
+        if fs or plan.flush_f:
+            ops.dflash(fs, plan.flush_f, nxt, plan.n_hi_f)
+        gr._finish_kernel[(n,)](S.I, S.NEXT, S.NPROB, S.DRAFT, S.DPROB, S.REC, S.RECF, slots_t, NI_=gr.NI,
+                                MAXD_=gr.MAXD, REC_W=S.rec_w, RECF_W=gr.MAXD, MAXR=S.MAXR, num_warps=1)
+        if rider is not None:
+            S.REC[n, :rider.numel()].copy_(buf[at:at + rider.numel()].view(torch.int32))
+        S.h_rec[ring][:n + 1].copy_(S.REC[:n + 1], non_blocking=True)
+        S.h_recf[ring][:n].copy_(S.RECF[:n], non_blocking=True)
+        ev = ops.event()
+        if self.peek:                           # the next windows' rows and the MTP passes, as the device decided them
+            I = self.peek_state()
+            for s in active:
+                w = nxt[s]
+                if w.arm in ("m", "f"):
+                    w.rows = 1 + int(I[s, gr.NREAL])
+                if w.arm == "m":
+                    w.steps = self.steps_run.get(s, w.steps)
+        h = Launched(self.k, list(active), dict(wins), dict(nxt), ring, ev, time.perf_counter())
+        ops.after_launch(active)
+        self.flight = {s: wins[s].rows for s in active}
+        self.took = {s: (s in plan.n_hi_m, s in plan.n_hi_f) for s in active}
+        self.windows = nxt
+        self.k += 1
+        self.rounds += 1
+        bat.round += 1
+        if prev is not None:                    # the host a whole round ahead: round k - 1 now
+            reason = self._process(prev)
+        return h, reason
+
+    def _params(self, P: np.ndarray, stp, arm: str) -> None:
+        pol = stp.m_policy if arm == "m" else stp.f_policy
+        depth_params(P, stp.opt, float(getattr(pol, "confidence", 0.0) or 0.0))
+
+    def _sampler_rows(self, active: list[int], Rs: list[int]):
+        """The verify rows' sampler table (the stage fills the positions on the device)."""
+
+        bat = self.bat
+        world = self.ops.world()
+        ints, flts, at, width = [], [], 0, 1
+        for s, R in zip(active, Rs):
+            sampling = bat.seqs[s].stepper.job.sampling
+            greedy = sampling is None or sampling.temperature <= 0
+            k = min(1 if greedy else int(sampling.top_k) + MARGIN, self.ops.vocab_part())
+            for r in range(R):
+                a, b = gpusample.row_entry(at + r * 2 * k, k, world, 0, sampling)
+                ints.append(a)
+                flts.append(b)
+            at += R * 2 * k
+            width = max(width, world * k)
+        return self.ops.upload(ints, torch.int64), self.ops.upload(flts, torch.float64), width
+
+    def _rider(self, ring: int):
+        """Rank 0's drain flag (a queued request, a cancel, stopping) on the round's exchange: [1] drain, [2] go on
+        (rank 1 sends zeros); both ranks read rank 0's words with the round's record. Staged in the round's own
+        pinned slot: the host is a round ahead of the copy."""
+
+        bat, S = self.bat, self.st
+        if bat.rider_n == 0:
+            return None
+        words = [0] * bat.rider_n
+        if not bat.following:
+            with bat.cv:
+                drain = bool(bat.queue) or bat.stopping or any(q is not None and q.job.cancel for q in bat.seqs)
+            words[0] = 1 if drain else 2
+        S.h_rider[ring].numpy()[:] = words
+        bat.rider_dev.copy_(S.h_rider[ring], non_blocking=True)
+        return bat.rider_dev
+
+    # -- a processed round: the host catches up ------------------------------------------------------------------------
+    def _process(self, h: Launched) -> str | None:
+        """Round ``h``'s record: every slot's tokens and counters into its ``Stepper`` (records, emits), the next
+        window's drafts' probabilities into the host's view. -> a drain reason, or None."""
+
+        from . import comm as comm_mod
+
+        bat, S = self.bat, self.st
+        self.ops.wait(h.event)
+        comm_mod.check(bat.g.w.comm)           # a failed RoCE exchange raises before any of its tokens is used
+        rec = S.h_rec[h.ring].numpy()
+        recf = S.h_recf[h.ring].numpy()
+        reason = None
+        n = len(h.active)
+        if bat.rider_n and int(rec[n, 0]) == 1:
+            reason = "rank 0"
+        parts, tokens = [], 0
+        shared = n > 1
+        for i, s in enumerate(h.active):
+            r = rec[i]
+            keep, count, done, pos, R, nd = (int(x) for x in r[:6])
+            toks = [int(t) for t in r[gr.REC_HEAD:gr.REC_HEAD + max(keep, 0)]]
+            win = h.windows[s]
+            hs = self.host[s]
+            q = bat.seqs[s]
+            stp = q.stepper
+            pad = max(0, R - 1 - nd)            # rows run past the drafts (a stale bound: lag mode only)
+            q.kinds["pad_rows"] += pad
+            bat.counts["pad_rows"] += pad
+            if keep > 0:
+                self._accepted(s, stp, win, hs, nd, keep, toks, shared)
+                tokens += keep
+                parts.append((win.arm, 1 + nd, win.steps, win.backlog))
+                bat._emit(q, toks[:max(0, stp.job.max_tokens - (len(stp.out) - keep))])
+            hs.pos, hs.count = pos, count
+            nn = int(r[8])
+            hs.probs = [float(p) for p in recf[i, :nn]]
+            hs.mcount, hs.fcount, hs.mbase = int(r[9]), int(r[10]), int(r[11])
+            nw = h.nxt[s]
+            if nw.arm == "m":
+                hs.m_depths.append(nn)
+            elif nw.arm == "f":
+                hs.f_depths.append(nn)
+            bat.states[s].pos = pos             # the host's mirror (the device's is authoritative)
+            q.kinds["resident"] += 1
+            q.kinds["verify_ms"] += (time.perf_counter() - h.t0) * 1e3
+            if done:
+                reason = reason or "done"
+        if parts:
+            bat.round_costs.record(parts, tokens)
+        return reason
+
+    def _accepted(self, s: int, stp, win: Window, hs: SlotHost, nd: int, keep: int, toks: list[int],
+                  shared: bool) -> None:
+        """``Stepper.accept``'s bookkeeping for a window the device committed."""
+
+        from . import adapt as adapt_mod, draftvocab
+
+        arm = win.arm
+        R = 1 + nd
+        if stp.policy is not None:
+            if stp.use_mtp:                     # patches/0420: the fallback rule's window (a round late)
+                draftvocab.track(self.bat.g.w, self.bat.states[s], toks)
+            a = arm if arm in ("m", "f") else adapt_mod.SERIAL
+            if stp.opt is not None:
+                stp.opt.used = list(hs.probs[:nd]) if a in ("m", "f") else []
+            if stp.adapt is not None:
+                stp.adapt.record(a, R, win.steps, win.backlog, keep, stp.opt.verify, shared)
+            elif stp.choice is not None and a in ("m", "f"):
+                stp.choice.record(a, R, win.steps, win.backlog, keep)
+            if stp.lookup is not None and a != adapt_mod.SERIAL:
+                stp.lookup.record(a, R, win.steps, win.backlog, keep)
+            if stp.opt is not None:
+                stp.opt.record(a, R, win.steps, win.backlog, keep)
+            if a in stp.last:
+                stp.last[a] = (nd, keep - 1)
+        stp.rounds += 1
+        stp.shared += int(shared)
+        stp.drafted += nd
+        stp.accepted += keep - 1
+        stp.depths.append(nd)
+        stp.keeps.append(keep)
+        stp.arms.append(arm)
+        stp.out.extend(toks)
+
+    # -- leaving: the device state back into the normal path's ---------------------------------------------------------
+    def _exit(self, active: list[int]) -> None:
+        bat, S = self.bat, self.st
+        self.ops.exit(active)
+        I = S.I.cpu().numpy()
+        mtok = S.MTOK.cpu().numpy()
+        drafts = S.DRAFT.cpu().numpy()
+        dprob = S.DPROB.cpu().numpy()
+        for s in active:
+            stp = bat.seqs[s].stepper
+            st = bat.states[s]
+            st.set_pos(int(I[s, gr.POS]), committed=True)
+            if getattr(st, "index_ring", 0):
+                st.save_index_tail()           # patches/0065: resident commits skip it; the tail of this position
+            win = self.windows[s]
+            nd = int(I[s, gr.NREAL])
+            stp.drafts = [int(t) for t in drafts[s, :nd]]
+            stp.arm = win.arm
+            stp.steps, stp.backlog = win.steps, win.backlog
+            if stp.opt is not None:
+                stp.opt.used = [float(p) for p in dprob[s, :nd]]
+            if _tracks_m(stp):
+                mc = int(I[s, gr.MCOUNT])
+                stp.m_next = [int(t) for t in mtok[s, :mc]]
+                chained = win.steps - 1 if win.arm == "m" else 0     # the head steps the device ran after the absorb
+                st.set_mtp_len(int(I[s, gr.MBASE]) + chained)
+                st.mtp_drafted = chained
+            if _tracks_f(stp):
+                stp.n_f = int(I[s, gr.FCOUNT])
+                self.ops.drafter_end(s, int(I[s, gr.POS]) - stp.n_f)
+
+
+def depth_params(P: np.ndarray, opt, confidence: float) -> None:
+    """A window's depth parameters for the device (``gpuround.P_*``): a ``DepthOptimizer``'s calibration factors,
+    look-ahead, rate and verify table as it would use them now (cost-derived depths), or the confidence threshold."""
+
+    if opt is not None:
+        from .depth import MAX_DRAFTS
+
+        cal = opt.cal
+        for j in range(16):
+            jj = min(j, MAX_DRAFTS - 1)
+            P[gr.P_FM + j] = cal.factor("m", jj)
+            P[gr.P_FF + j] = cal.factor("f", jj)
+            P[gr.P_AHEAD + j] = cal.ahead("m", jj)
+        P[gr.P_RATE] = opt.rate()
+        v = list(opt.verify)
+        for j in range(17):
+            P[gr.P_VERIFY + j] = v[min(j, len(v) - 1)]
+            P[gr.P_DV + j] = opt._dv(j) if j >= 1 else 0.0
+        P[gr.P_STEP] = opt.costs.get("mtp_step", 0.0)
+        P[gr.P_MODE] = gr.MODE_OPT
+        P[gr.P_MODE + 1] = len(v) - 1
+    else:
+        P[gr.P_CONF] = confidence
+        P[gr.P_MODE] = gr.MODE_CONF
+        P[gr.P_MODE + 1] = 16
+
+
+# -- the model side ----------------------------------------------------------------------------------------------------
+class RealOps:
+    """The engine's kernels for resident rounds (GPU)."""
+
+    def __init__(self, res: Resident) -> None:
+        self.res = res
+        self.bat = res.bat
+        g = self.bat.g
+        self.w = g.w
+        self.e = g.e
+        self._scratch = None
+        self._slots: dict[tuple, torch.Tensor] = {}
+        self._tabs: dict[tuple, Any] = {}
+        self._alt: dict[int, Any] = {}      # ``kda``: each slot's second scratch set
+        self.pred = self.succ = None
+
+    # -- small things
+    def device(self):
+        return self.w.device
+
+    def max_rows(self) -> int:
+        return self.e.buf.rows
+
+    def world(self) -> int:
+        return 1 if self.w.comm is None else self.w.world
+
+    def vocab_part(self) -> int:
+        return self.w.head.n
+
+    def upload(self, values: list, dtype) -> torch.Tensor:
+        return torch.tensor(values, dtype=dtype, pin_memory=True).to(self.w.device, non_blocking=True)
+
+    def event(self):
+        ev = torch.cuda.Event()
+        ev.record()
+        return ev
+
+    @staticmethod
+    def wait(ev) -> None:
+        ev.synchronize()
+
+    def slots_tensor(self, active: list[int]) -> torch.Tensor:
+        key = tuple(active)
+        t = self._slots.get(key)
+        if t is None:
+            t = torch.tensor(active, dtype=torch.int32, device=self.w.device)
+            self._slots[key] = t
+        return t
+
+    def scratch(self, rows: int, width: int) -> torch.Tensor:
+        need = max(1, rows) * 2 * gpusample.block_for(width)
+        if self._scratch is None or self._scratch.numel() < need:
+            self._scratch = torch.empty((max(need, 1 << 14),), dtype=torch.float64, device=self.w.device)
+        return self._scratch
+
+    def mode(self, s: int, lo: int, hi: int, R: int):
+        """The window's context mode if it is the same wherever in [lo, hi] it starts (0 dense, else patches/0050's
+        pool bucket), else None."""
+
+        st = self.bat.states[s]
+        a, b = self.bat._mode_at(st, lo, R), self.bat._mode_at(st, hi, R)
+        return a if a is not None and a == b else None
+
+    def mode_mtp(self, s: int, lo: int, hi: int, n: int):
+        return self.mode(s, lo, hi, n)
+
+    def room(self, s: int, end: int) -> None:
+        st = self.bat.states[s]
+        if getattr(st, "pages", None) is not None:      # patches/0290: map every page a window may write
+            st.pages.ensure(min(st.capacity, end))
+
+    def enter(self, active: list[int]) -> None:
+        d0 = self.bat.g.drafter
+        if d0 is not None and self.pred is None:
+            self.pred = torch.from_numpy(np.ascontiguousarray(d0.pred, dtype=np.float32)).to(self.w.device)
+            self.succ = torch.from_numpy(np.ascontiguousarray(d0.succ, dtype=np.float32)).to(self.w.device)
+
+    def after_launch(self, active: list[int]) -> None:
+        for s in active:                    # the KDA state parity flips every round (``forward.commit``)
+            st = self.bat.states[s]
+            if st.cur:
+                st.cur = [1 - st.cur[0]] * len(st.cur)
+
+    def drafter_end(self, s: int, end: int) -> None:
+        d = self.bat.drafters[s]
+        if d is not None:
+            d.resident_end(end)
+
+    # -- stage / forward
+    def stage(self, T: int, ints: torch.Tensor) -> None:
+        S = self.res.st
+        gr._stage_kernel[(T,)](S.I, S.H, S.DRAFT, S.ROWS[0], S.ROWS[1], self.e.buf.ids, S.SRC, ints, NI_=gr.NI,
+                               NH_=gr.NH, MAXD_=gr.MAXD, num_warps=1)
+
+    def forward(self, active: list[int], Rs: list[int], modes: list) -> torch.Tensor:
+        """``compute_multi`` over the windows (resident keys under the batcher's graph policy; padded rows route as
+        their window's last real row)."""
+
+        from .batch import compute_multi
+
+        bat = self.bat
+        w, e, b = self.w, self.e, self.e.buf
+        e.rows_from = None
+        sts = [bat.states[s] for s in active]
+        T = sum(Rs)
+        bat.last_rows = list(Rs)
+        key = ("resident", tuple(active), tuple(Rs), tuple(modes), tuple(st.cur[0] if st.cur else 0 for st in sts),
+               self.res.kda)
+        tables = self._kda_tables(active, Rs) if self.res.kda else None
+
+        def run() -> None:
+            b.route_src = self.res.st.SRC
+            b.kda_slots = tables
+            try:
+                compute_multi(w, sts, b, Rs, npbs=modes)
+            finally:
+                b.route_src = None
+                b.kda_slots = None
+
+        g = bat.multi.get(key)
+        if g is not None:
+            bat.counts["graph"] += 1
+            g.replay()
+            return b.logits[:T]
+        run()
+        bat.counts["eager"] += 1
+        if bat.use_graphs and len(bat.multi) < bat.max_graphs and bat.sightings.capture(key):
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            try:
+                with torch.cuda.graph(graph, pool=bat.pool, capture_error_mode="thread_local"):
+                    run()
+            except Exception as exc:  # noqa: BLE001 - eager from here on
+                bat.use_graphs = False
+                print(f"[tensorfold] resident round CUDA graph capture failed ({type(exc).__name__}: {exc}); eager",
+                      flush=True)
+                torch.cuda.synchronize()
+            else:
+                bat.multi[key] = graph
+                bat.counts["capture"] += 1
+        return b.logits[:T]
+
+    def gather_candidates(self, logits: torch.Tensor, active: list[int], Rs: list[int], rider):
+        """Every row's top candidates (``sample_multi``'s) and the rider in one exchange. -> (the gathered buffer, a
+        rank's part, the rider's offset in rank 0's part)."""
+
+        from . import comm as comm_mod
+
+        bat = self.bat
+        parts, off = [], 0
+        for s, R in zip(active, Rs):
+            sampling = bat.seqs[s].stepper.job.sampling
+            greedy = sampling is None or sampling.temperature <= 0
+            k = 1 if greedy else min(logits.shape[1], int(sampling.top_k) + MARGIN)
+            vals, ids = torch.topk(logits[off:off + R].float(), k, dim=-1)
+            ids = (ids + self.w.vocab_offset).to(torch.int32)
+            parts.append(torch.cat([vals, ids.view(torch.float32)], dim=1).reshape(-1))
+            off += R
+        at = sum(p.numel() for p in parts)
+        if rider is not None:
+            parts.append(rider.view(torch.float32))
+        flat = torch.cat(parts).contiguous()
+        if self.w.comm is None:
+            return flat, flat.numel(), at
+        buf = torch.empty((self.w.world * flat.numel(),), dtype=torch.float32, device=flat.device)
+        comm_mod.fast_gather(self.w.comm, flat, buf)            # patches/0230
+        return buf, flat.numel(), at
+
+    # -- commit
+    def commit(self, active: list[int], Rs: list[int]) -> None:
+        """KDA: every slot's replay in one launch (``kda.replay_slots``: keeps on the device, a slot that kept every row
+        run skipped), or nothing with ``kda`` (the next chain folds it); conv windows; positions."""
+
+        from . import kda as kda_mod
+
+        bat, S = self.bat, self.res.st
+        n = len(active)
+        sts = [bat.states[s] for s in active]
+        if sts[0].cur and not self.res.kda:
+            S.RUNV[:n].copy_(self.upload(Rs, torch.int32))
+            tab = self._replay_table(active, sts, fold=False)
+            ss = sts[0].scratch_set
+            kda_mod._ext().replay_slots(tab, S.KEEPV[:n], S.RUNV[:n], ss.layers, ss.heads, sts[0].rec[0, 0].numel(), 1)
+        for s, st in zip(active, sts):
+            if st.cur:
+                C = st.conv.shape[2]
+                gr._conv_shift_dev[(len(st.cur), triton.cdiv(C, 1024))](
+                    st.conv, st.proj, S.I, s, st.conv.stride(0), st.proj.stride(0), st.proj.stride(1), C=C, TAPS=3,
+                    NI_=gr.NI, BLOCK=1024, num_warps=4)
+            st.pos_dev.copy_(S.I[s, gr.POS:gr.POS + 1])
+
+    def _replay_table(self, active: list[int], sts, *, fold: bool) -> torch.Tensor:
+        """Per slot: the state in / out of this parity and the saves the replay reads (``fold``: the last chain's)."""
+
+        key = ("replay", tuple(active), tuple(st.cur[0] for st in sts), fold)
+        t = self._tabs.get(key)
+        if t is None:
+            rows = []
+            for s, st in zip(active, sts):
+                cur = st.cur[0]
+                ss = self._saves(s, st, 1 - cur) if fold else st.scratch_set
+                rows.append([st.rec[cur].data_ptr(), st.rec[1 - cur].data_ptr(), ss.k.data_ptr(), ss.v.data_ptr(),
+                             ss.g.data_ptr(), ss.b.data_ptr(), ss.k.stride(0), ss.b.stride(0)])
+            t = torch.tensor(rows, dtype=torch.int64, device=self.w.device)
+            self._tabs[key] = t
+        return t
+
+    def _saves(self, s: int, st, parity: int):
+        """``kda``: the scratch set a chain run at KDA parity ``parity`` saves into (0: the State's, 1: the second)."""
+
+        if parity == 0:
+            return st.scratch_set
+        a = self._alt.get(s)
+        if a is None:
+            from . import kda as kda_mod
+            from .engine import MAX_ROWS
+
+            ss = st.scratch_set
+            a = kda_mod.KDAScratchSet(ss.layers, min(MAX_ROWS, ss.rows), ss.heads, st.rec.device)
+            self._alt[s] = a
+        return a
+
+    def _kda_tables(self, active: list[int], Rs: list[int]):
+        """``kda``: ``kda.chain_slots``' tables of this key's layers (built once; its graph holds their addresses)."""
+
+        from . import kda as kda_mod
+
+        bat, S, b = self.bat, self.res.st, self.e.buf
+        sts = [bat.states[s] for s in active]
+        key = ("chain", tuple(active), tuple(Rs), tuple(st.cur[0] for st in sts))
+        t = self._tabs.get(key)
+        if t is None:
+            offs, o = [], 0
+            for R in Rs:
+                offs.append(o)
+                o += R
+            saves = [self._saves(s, st, st.cur[0]) for s, st in zip(active, sts)]
+            prev = [self._saves(s, st, 1 - st.cur[0]) for s, st in zip(active, sts)]
+            t = kda_mod.SlotTables(sts, saves, prev, b, offs, Rs, S.I, self.slots_tensor(active), gr.NI, gr.PREKEEP)
+            self._tabs[key] = t
+        return t
+
+    def backlogs(self, active: list[int], slots_t: torch.Tensor, rmax: int) -> None:
+        """The kept rows' MTP input rows (final-normed) and DFlash2 taps into every slot's backlog."""
+
+        bat, S, b = self.bat, self.res.st, self.e.buf
+        n = len(active)
+        D = self.w.cfg.hidden
+        m_all = bat.m_all
+        if m_all is not None:
+            gr._backlog_kernel[(n, rmax, triton.cdiv(D, 1024))](
+                b.fnormed, b.fnormed.stride(0), m_all, m_all.stride(0), m_all.stride(1), S.I, S.H, slots_t, D, 0,
+                S.backlog, NI_=gr.NI, NH_=gr.NH, WHICH=0, BLOCK=1024, num_warps=4)
+        f_all = bat.f_all
+        if f_all is not None:
+            for ti, tap in enumerate(b.taps):
+                gr._backlog_kernel[(n, rmax, triton.cdiv(D, 1024))](
+                    tap, tap.stride(0), f_all, f_all.stride(0), f_all.stride(1), S.I, S.H, slots_t, D, ti * D,
+                    S.backlog, NI_=gr.NI, NH_=gr.NH, WHICH=1, BLOCK=1024, num_warps=4)
+
+    # -- drafting: MTP chains
+    def mtp(self, ms: list[int], flush: list[int], nxt: dict, n_hi: dict, m_modes: dict) -> None:
+        """Every m-slot's MTP chain, and the backlog of the slots that flush it: one head pass absorbs every backlog
+        (``batch.mtp_multi`` on device-staged rows, each slot's last real row selected on the device), then one pass
+        a chained step; drafts sampled and chosen on the device (``_mtp_next_kernel``)."""
+
+        from . import draftvocab
+
+        bat, S, w = self.bat, self.res.st, self.w
+        b = self.e.mbuf
+        items = ms + flush
+        sts = [bat.states[s] for s in items]
+        full = any(draftvocab.full(w, st, "mtp") for st in sts)
+        ns = [n_hi[s] for s in items]
+        offs, o = [], 0
+        for n in ns:
+            offs.append(o)
+            o += n
+        for s, st, off, n in zip(items, sts, offs, ns):
+            b.ids[off:off + n].copy_(S.MTOK[s, :n])
+            b.hin[off:off + n].copy_(bat.m_rows[s][:n])
+            st.mtp_pos_dev.copy_(S.I[s, gr.MBASE:gr.MBASE + 1])
+        sel = self._sel(items, offs, gr.MCOUNT)
+        logits = self._pass(items, sts, ns, offs, o, sel, full, [m_modes[s][0] for s in items])
+        for s, st in zip(items, sts):         # MBASE += MCOUNT, MCOUNT = 0; the head's length after the absorb
+            S.I[s, gr.MBASE].add_(S.I[s, gr.MCOUNT])
+            S.I[s, gr.MCOUNT].zero_()
+            st.mtp_pos_dev.copy_(S.I[s, gr.MBASE:gr.MBASE + 1])
+        if not ms:
+            return
+        slots_m = self.slots_tensor(ms)
+        m_sts = sts[:len(ms)]
+        D = max(nxt[s].steps for s in ms)
+        passes = 1
+        for j in range(D):
+            tok, prob = self._draw(logits[:len(ms)], ms, j)
+            gr._mtp_next_kernel[(len(ms),)](S.I, S.F, S.P, S.NEXT, S.NPROB, tok, prob, slots_m, j, NI_=gr.NI,
+                                            NF_=gr.NF, NP_=gr.NP, MAXD_=gr.MAXD, QMAX=gr.Q_MAX, num_warps=1)
+            if j + 1 >= D:
+                break
+            if self.res.peek and not any(int(self.res.peek_state()[s, gr.LIVE]) for s in ms):
+                break                           # every chain stopped here: no step runs for nothing
+            passes += 1
+            b.hin[:len(ms)].copy_(b.fnormed[:len(ms)])             # ``Engine.draft_hidden``: the head's output rows
+            b.ids[:len(ms)].copy_(tok)
+            idx = self._arange(len(ms))
+            modes = [m_modes[s][1 + j] if 1 + j < len(m_modes[s]) else m_modes[s][-1] for s in ms]
+            logits = self._pass(ms, m_sts, [1] * len(ms), list(range(len(ms))), len(ms), idx, full, modes)
+            for st in m_sts:
+                st.mtp_pos_dev.add_(1)
+        for s in ms:
+            self.res.steps_run[s] = passes
+
+    def _sel(self, items: list[int], offs: list[int], col: int) -> torch.Tensor:
+        """Each item's last real row in the pass: its offset + its count - 1 (the count read on the device), in the
+        persistent ``SEL`` (a captured head pass reads it there)."""
+
+        S = self.res.st
+        key = ("offs", tuple(offs))
+        base = self._tabs.get(key)
+        if base is None:
+            base = torch.tensor(offs, dtype=torch.int64, device=self.w.device)
+            self._tabs[key] = base
+        cnt = S.I.index_select(0, self.slots_tensor(items).long())[:, col].long()
+        n = len(items)
+        S.SEL[:n].copy_(base + (cnt - 1).clamp(min=0))
+        return S.SEL[:n]
+
+    def _arange(self, n: int) -> torch.Tensor:
+        key = ("arange", n)
+        t = self._tabs.get(key)
+        if t is None:
+            t = torch.arange(n, dtype=torch.int64, device=self.w.device)
+            self._tabs[key] = t
+        return t
+
+    def _pass(self, items, sts, ns, offs, T, sel, full, modes) -> torch.Tensor:
+        """A head pass, as a CUDA graph per (items, rows, modes, head) under the batcher's graph policy (its inputs
+        are the head's buffers, the slots' head positions and ``SEL``: the same addresses every time)."""
+
+        bat = self.bat
+        key = ("mtp", tuple(items), tuple(ns), tuple(modes), bool(full))
+        g = bat.multi.get(key)
+        if g is not None:
+            from . import draftvocab
+
+            g.replay()
+            return self.e.mbuf.logits[:len(sts), :draftvocab.head_for(self.w, "mtp", full).n]
+        out = self._head_pass(sts, ns, offs, T, sel, full, modes)
+        if bat.use_graphs and len(bat.multi) < bat.max_graphs and bat.sightings.capture(key):
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            try:
+                with torch.cuda.graph(graph, pool=bat.pool, capture_error_mode="thread_local"):
+                    self._head_pass(sts, ns, offs, T, sel, full, modes)
+            except Exception:  # noqa: BLE001 - eager from here on
+                bat.use_graphs = False
+                torch.cuda.synchronize()
+            else:
+                bat.multi[key] = graph
+        return out
+
+    def _head_pass(self, sts, ns, offs, T, sel, full, modes) -> torch.Tensor:
+        """``batch.mtp_multi`` on rows already in the head's buffers: the capturable attention (device positions),
+        each item's selected row through the final norm and the head. -> logits [items, draft columns]."""
+
+        from . import draftvocab, glue, qmm
+        from .batch import _dsa
+        from .forward import _join, moe_block
+
+        w, b = self.w, self.e.mbuf
+        c = w.cfg
+        m = w.mtp
+        D = c.hidden
+        N = len(sts)
+        glue.embed(b.ids[:T], w.embed, D, 1, b.me[:T])
+        glue.rmsnorm(b.me[:T], m.enorm, c.eps, b.mcat[:T, :D])
+        glue.rmsnorm(b.hin[:T], m.hnorm, c.eps, b.mcat[:T, D:])
+        qmm.matmul(b.mcat[:T], m.eh, qmm.group_sums(b.mcat[:T], b.mxs[:T]), out=b.mx[:T], part=b.sk)
+        layer = m.layer
+        glue.rmsnorm(b.mx[:T], layer.in_norm, c.eps, b.normed[:T], b.xs[:T])
+        b.site = ("mtp", "a")
+        caches = [(st.mtp_kc, st.mtp_vc, st.mtp_pos_dev, st.index[-1] if st.index is not None else None)
+                  for st in sts]
+        g = _dsa(layer, w, sts, b, ns, offs, T, None, None, modes, caches=caches)
+        glue.residual_add(b.mx[:T], b.mx[:T], g)
+        glue.rmsnorm(b.mx[:T], layer.post_norm, c.eps, b.normed[:T], b.xs[:T])
+        b.site = ("mtp", "f")
+        g = moe_block(layer, w, b, T)
+        glue.residual_add(b.mx[:T], b.mx[:T], g)
+        rows = b.mx[:T].index_select(0, sel)
+        glue.rmsnorm(rows, m.norm, c.eps, b.fnormed[:N], b.fxs[:N])
+        head = draftvocab.head_for(w, "mtp", full)
+        out = qmm.matmul(b.fnormed[:N], head, b.fxs[:N], out=b.logits[:N, :head.n], part=b.sk)
+        _join(w)
+        return out
+
+    def _draw(self, rows: torch.Tensor, items: list[int], j: int):
+        """Each item's draft j from its logits row (``sample_drafts``: the same candidates, draw and probability,
+        positions from the device)."""
+
+        from . import comm as comm_mod, draftvocab
+
+        bat, S, w = self.bat, self.res.st, self.w
+        V = rows.shape[1]
+        parts, ints, flts, at, width = [], [], [], 0, 1
+        world = self.world()
+        for i, s in enumerate(items):
+            sampling = bat.seqs[s].stepper.job.sampling
+            greedy = sampling is None or sampling.temperature <= 0
+            k = min(V, 20 + MARGIN) if greedy else min(V, int(sampling.top_k) + MARGIN)
+            vals, ids = torch.topk(rows[i:i + 1].float(), k, dim=-1)
+            ids = draftvocab.ids_of(w, ids, V)
+            parts.append(torch.cat([vals, ids.view(torch.float32)], dim=1).reshape(-1))
+            a, bb = gpusample.row_entry(at, k, world, 0, sampling, True)
+            ints.append(a)
+            flts.append(bb)
+            at += 2 * k
+            width = max(width, world * k)
+        flat = torch.cat(parts).contiguous()
+        if w.comm is None:
+            buf = flat
+        else:
+            buf = torch.empty((w.world * flat.numel(),), dtype=torch.float32, device=flat.device)
+            comm_mod.fast_gather(w.comm, flat, buf)
+        it = self.upload(ints, torch.int64)
+        ft = self.upload(flts, torch.float64)
+        draft_positions(S.I, self.slots_tensor(items), it, j)
+        tok = torch.empty((len(items),), dtype=torch.int32, device=w.device)
+        prob = torch.empty((len(items),), dtype=torch.float64, device=w.device)
+        gpusample.launch(buf, flat.numel(), world, it, ft, tok, prob, self.scratch(len(items), width), width)
+        return tok, prob
+
+    # -- drafting: DFlash2 blocks
+    def dflash(self, fs: list[int], flush: list[int], nxt: dict, n_hi: dict) -> None:
+        """Every f-slot's DFlash2 block: its taps backlog (a device count), the block pass, the chain and the depth on
+        the device; the slots that flush take their taps only."""
+
+        from . import dflash2, draftvocab
+
+        bat, S = self.bat, self.res.st
+        for s in fs + flush:
+            d = bat.drafters[s]
+            d.add_taps_dev(bat.f_taps[s][:n_hi[s]], S.I[s, gr.FCOUNT:gr.FCOUNT + 1], n_hi[s],
+                           self.res.host[s].pos + self.res._inflight_rows(s))
+            S.I[s, gr.FCOUNT].zero_()
+        for s in fs:
+            d = bat.drafters[s]
+            d.ids[:1].copy_(S.I[s, gr.PEND:gr.PEND + 1])
+            d.dv_full = draftvocab.full(self.w, d.dv_st, "dflash")
+            graph = d.block_graph_full if d.dv_full else d.block_graph
+            if graph is not None:
+                graph.replay()
+            else:
+                d._block_compute()
+            sampling = bat.seqs[s].stepper.job.sampling
+            dflash2.chain_dev(d, self.pred, self.succ, S.I, S.NEXT, S.NPROB, s, sampling,
+                              min(nxt[s].rows - 1, d.block - 1), gr.NI, gr.MAXD)
+        if fs:
+            gr._f_depth_kernel[(len(fs),)](S.I, S.P, S.NPROB, self.slots_tensor(fs), NI_=gr.NI, NP_=gr.NP,
+                                           MAXD_=gr.MAXD, QMAX=gr.Q_MAX, num_warps=1)
+
+    # -- leaving
+    def exit(self, active: list[int]) -> None:
+        """``kda``: the last window's commit, folded into a chain that never ran, is replayed now: the State's KDA state
+        is the committed one again (``replay_slots`` from the last chain's saves)."""
+
+        if not self.res.kda:
+            return
+        from . import kda as kda_mod
+
+        bat, S = self.bat, self.res.st
+        sts = [bat.states[s] for s in active]
+        if not sts or not sts[0].cur:
+            return
+        n = len(active)
+        tab = self._replay_table(active, sts, fold=True)
+        keep = S.I.index_select(0, self.slots_tensor(active).long())[:, gr.PREKEEP].contiguous()
+        S.RUNV[:n].fill_(-1)
+        ss = sts[0].scratch_set
+        kda_mod._ext().replay_slots(tab, keep, S.RUNV[:n], ss.layers, ss.heads, sts[0].rec[0, 0].numel(), 0)
+        for st in sts:
+            st.cur = [1 - st.cur[0]] * len(st.cur)
+
+
+def draft_positions(I: torch.Tensor, slots: torch.Tensor, ints: torch.Tensor, j: int) -> None:
+    """Draft j's sampler rows: the slot's committed length + 1 + j (``decode.draft``'s ``position + j``)."""
+
+    ints[:, 3].copy_(I.index_select(0, slots.long())[:, gr.POS].long() + 1 + j)
