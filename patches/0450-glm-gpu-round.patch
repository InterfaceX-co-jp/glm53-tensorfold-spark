+def _f64(u: int) -> float:
+    return struct.unpack("<d", struct.pack("<Q", u))[0]
+
+
+def _i64(u: int) -> int:
+    return u - (1 << 64) if u >> 63 else u
+
+
+# CONST (float64): 0 ln2hi, 1 ln2lo, 2..6 A[0..4], 7..17 B[0..10], 18 invln2N, 19 negln2hiN, 20 negln2loN,
+# 21..24 C2..C5, 25 2^27, 26 1.0, 27 -1.0, 28 2^1009, 29 2^-1022, 30 2^-53, 31 2^-54. (A float literal in a Triton
+# kernel is a float32 constant: every float64 constant comes from this table.)
+_CONST = tuple(_f64(u) for u in _LOG_HEAD) + (_f64(_EXP_HEAD[0]),) + tuple(_f64(u) for u in _EXP_HEAD[2:8]) + (
+    2.0 ** 27, 1.0, -1.0, 2.0 ** 1009, 2.0 ** -1022, 2.0 ** -53, 2.0 ** -54)
+
+
+@lru_cache(maxsize=8)
+def tables(device: str) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """(CONST f64 [32], LOGT f64 [256]: (invc, logc) pairs, EXPT int64 [256]) on ``device``."""
+
+    const = torch.tensor(_CONST, dtype=torch.float64)
+    logt = torch.tensor([_f64(u) for u in _LOG_TAB], dtype=torch.float64)
+    expt = torch.tensor([_i64(u) for u in _EXP_TAB], dtype=torch.int64)
+    return const.to(device), logt.to(device), expt.to(device)
+
+
+# -- the libm port (float64, elementwise; tensors of any shape) -----------------------------------------------------
+@triton.jit
+def _c(CONST, i: tl.constexpr):
+    return tl.load(CONST + i)
+
+
+@triton.jit
+def _log(x, CONST, LOGT):
+    """glibc 2.39 aarch64 ``__log`` for positive normal x and +-0 (-inf): both paths computed, the one glibc takes
+    selected."""
+
+    ix = x.to(tl.uint64, bitcast=True)
+    near = (ix - 0x3FEE000000000000) <= 0x308FFFFFFFFFF          # 1 - 2^-4 <= x < 1 + 0x1.09p-4
+    one = ix == 0x3FF0000000000000
+    # -- close to 1 (poly1, B) --
+    r = x - _c(CONST, 26)
+    d1 = tl.fma(r, _c(CONST, 25), r)
+    r2 = r * r
+    d4 = tl.fma(_c(CONST, 15), r, _c(CONST, 14))
+    rhi = tl.fma(-r, _c(CONST, 25), d1)
+    r3 = r * r2
+    d4 = tl.fma(_c(CONST, 16), r2, d4)
+    d3 = tl.fma(_c(CONST, 12), r, _c(CONST, 11))
+    d4 = tl.fma(_c(CONST, 17), r3, d4)
+    hh = rhi * rhi
+    d3 = tl.fma(_c(CONST, 13), r2, d3)
+    hi = tl.fma(hh, _c(CONST, 7), r)
+    d2 = tl.fma(_c(CONST, 9), r, _c(CONST, 8))
+    d3 = tl.fma(d4, r3, d3)
+    rlo = r - rhi
+    rs = r + rhi
+    d2 = tl.fma(_c(CONST, 10), r2, d2)
+    b0rlo = _c(CONST, 7) * rlo
+    lo = r - hi
+    lo = tl.fma(hh, _c(CONST, 7), lo)
+    d2 = tl.fma(d3, r3, d2)
+    lo = tl.fma(b0rlo, rs, lo)
+    lo = tl.fma(d2, r3, lo)
+    y_near = hi + lo
+    # -- the table path (poly, A) --
+    tmp = ix - 0x3FE6000000000000
+    i = ((tmp >> 45) & 127).to(tl.int32)
+    k = tmp.to(tl.int64, bitcast=True) >> 52
+    iz = ix - (tmp & 0xFFF0000000000000)
+    kd = k.to(tl.int32).to(tl.float64)
+    invc = tl.load(LOGT + 2 * i)
+    logc = tl.load(LOGT + 2 * i + 1)
+    z = iz.to(tl.float64, bitcast=True)
+    w = tl.fma(_c(CONST, 0), kd, logc)
+    r = tl.fma(invc, z, _c(CONST, 27))
+    hi = r + w
+    p34 = tl.fma(_c(CONST, 6), r, _c(CONST, 5))
+    p12 = tl.fma(_c(CONST, 4), r, _c(CONST, 3))
+    r2 = r * r
+    t = w - hi
+    r3 = r * r2
+    t = t + r
+    p = tl.fma(p34, r2, p12)
+    t = tl.fma(_c(CONST, 1), kd, t)
+    t = tl.fma(_c(CONST, 2), r2, t)
+    t = tl.fma(r3, p, t)
+    y_main = t + hi
+    y = tl.where(near, y_near, y_main)
+    y = tl.where(one, 0.0, y)
+    # log(+-0) = -inf (glibc's __math_divzero): -log(u) is -0.0 when u rounds to 1.0 (x >> 11 == 2^53 - 1)
+    return tl.where((ix << 1) == 0, float("-inf"), y)
+
+
+@triton.jit
+def _round_away(z):
+    """round(z) half away from zero (``frinta`` / ``fcvtas``), as int64; |z| < 2^52."""
+
+    t = z.to(tl.int64)
+    f = z - t.to(tl.float64)
+    return t + (f >= 0.5).to(tl.int64) - (f <= -0.5).to(tl.int64)
+
+
+@triton.jit
+def _exp(x, CONST, EXPT):
+    """glibc 2.39 aarch64 ``__exp`` (every input but NaN payloads), branch-free."""
+
+    ix = x.to(tl.uint64, bitcast=True)
+    abstop = ((ix >> 52) & 0x7FF).to(tl.int32)
+    tiny = abstop < 0x3C9
+    huge = abstop >= 0x409
+    special = abstop == 0x408
+    xc = tl.where(huge | tiny, 0.0, x)
+    z = xc * _c(CONST, 18)
+    ki = _round_away(z)
+    kd = ki.to(tl.float64)
+    d0 = tl.fma(_c(CONST, 19), kd, xc)
+    r = tl.fma(_c(CONST, 20), kd, d0)
+    idx = 2 * (ki & 127)
+    tail = tl.load(EXPT + idx).to(tl.float64, bitcast=True)
+    tbits = tl.load(EXPT + idx + 1).to(tl.uint64, bitcast=True)
+    p23 = tl.fma(_c(CONST, 22), r, _c(CONST, 21))
+    p45 = tl.fma(_c(CONST, 24), r, _c(CONST, 23))
+    r2 = r * r
+    d1 = r + tail
+    sbits = tbits + (ki.to(tl.uint64, bitcast=True) << 45)
+    r4 = r2 * r2
+    d1 = tl.fma(p23, r2, d1)
+    tmp = tl.fma(r4, p45, d1)
+    s = sbits.to(tl.float64, bitcast=True)
+    y_main = tl.fma(tmp, s, s)
+    # specialcase, k > 0 (overflowing scale)
+    sp = (sbits - 0x3F10000000000000).to(tl.float64, bitcast=True)
+    y_pos = tl.fma(tmp, sp, sp) * _c(CONST, 28)                      # * 2^1009
+    # specialcase, k < 0 (subnormal range)
+    sn = (sbits + 0x3FE0000000000000).to(tl.float64, bitcast=True)
+    st = tmp * sn
+    yn = sn + st
+    one = _c(CONST, 26)
+    hi = yn + one
+    a = sn - yn
+    b = one - hi
+    lo = a + st
+    a = b + yn
+    lo = a + lo
+    ysub = (lo + hi) - one
+    ysub = tl.where(ysub == 0.0, 0.0, ysub)
+    yn = tl.where(yn < one, ysub, yn)
+    y_neg = yn * _c(CONST, 29)                                        # * 2^-1022
+    neg_k = (ki & 0x80000000) != 0
+    y_sp = tl.where(neg_k, y_neg, y_pos)
+    y = tl.where(special, y_sp, y_main)
+    # the inputs glibc answers before the reduction
+    y = tl.where(tiny, one + x, y)
+    isinf_neg = ix == 0xFFF0000000000000
+    nanin = abstop == 0x7FF
+    sign = (ix >> 63) != 0
+    y_huge = tl.where(nanin, one + x, tl.where(sign, 0.0, float("inf")))
+    y_huge = tl.where(isinf_neg, 0.0, y_huge)
+    return tl.where(huge, y_huge, y)
+
+
+# -- the keyed uniform ------------------------------------------------------------------------------------------------
+@triton.jit
+def _mix(x):
+    x = x ^ (x >> 30)
+    x = x * 0xBF58476D1CE4E5B9
+    x = x ^ (x >> 27)
+    x = x * 0x94D049BB133111EB
+    return x ^ (x >> 31)
+
+
+@triton.jit
+def _uniform(seed, pos, ids, CONST):
+    """``exact_sampling.uniform``: (0, 1) doubles from splitmix64 of (seed, position, token id)."""
+
+    x = _mix(seed.to(tl.int64).to(tl.uint64, bitcast=True) + 0x9E3779B97F4A7C15)
+    x = _mix(x ^ (pos.to(tl.int64).to(tl.uint64, bitcast=True) * 0xD1B54A32D192ED03))
+    x = _mix(x ^ ids.to(tl.int64).to(tl.uint64, bitcast=True))
+    return (x >> 11).to(tl.float64) * _c(CONST, 30) + _c(CONST, 31)
+
+
+@triton.jit
+def _pw_sum(S, n, div):
+    """numpy's pairwise sum of S[0:n] / div (n <= 128; ``div`` 1.0: the elements as they are)."""
+
+    res = tl.load(S) * 0.0 - 0.0                     # -0.0 (float64)
+    if n < 8:
+        for i in range(0, n):
+            res = res + tl.load(S + i) / div
+    else:
+        r0 = tl.load(S + 0) / div
+        r1 = tl.load(S + 1) / div
+        r2 = tl.load(S + 2) / div
+        r3 = tl.load(S + 3) / div
+        r4 = tl.load(S + 4) / div
+        r5 = tl.load(S + 5) / div
+        r6 = tl.load(S + 6) / div
+        r7 = tl.load(S + 7) / div
+        n8 = n - n % 8
+        for i in range(8, n8, 8):
+            r0 = r0 + tl.load(S + i + 0) / div
+            r1 = r1 + tl.load(S + i + 1) / div
+            r2 = r2 + tl.load(S + i + 2) / div
+            r3 = r3 + tl.load(S + i + 3) / div
+            r4 = r4 + tl.load(S + i + 4) / div
+            r5 = r5 + tl.load(S + i + 5) / div
+            r6 = r6 + tl.load(S + i + 6) / div
+            r7 = r7 + tl.load(S + i + 7) / div
+        res = ((r0 + r1) + (r2 + r3)) + ((r4 + r5) + (r6 + r7))
+        for i in range(n8, n):
+            res = res + tl.load(S + i) / div
+    return res
+
+
+@triton.jit
+def _below(S, n, div, top):
+    """#(cumsum(S[0:n] / div) < top), the cumulative sum in order (numpy's ``cumsum``)."""
+
+    cs = tl.load(S) * 0.0
+    cnt = n * 0
+    for i in range(0, n):
+        cs = cs + tl.load(S + i) / div
+        cnt += (cs < top).to(cnt.dtype)
+    return cnt
+
+
+# -- the draw ---------------------------------------------------------------------------------------------------------
+@triton.jit
+def _choose_kernel(G, GI, P, INT, FLT, TOK, PROB, SCR, CONST, LOGT, EXPT,
+                   WORLD: tl.constexpr, BLOCK: tl.constexpr, CH: tl.constexpr, WANT: tl.constexpr):
+    """One row: its WORLD x k gathered candidates (rank r's values at G[r * P + off .. + k], ids as int32 bits right
+    after) -> TOK[row] (and PROB[row] with WANT). INT[row] = (off, k, seed, position, kept for the draw, mode: bit 0
+    sampled / bit 1 probability, kept for the probability, -), FLT[row] = (max(T, 1e-6), top_p, T or 1, top_p or 1)."""
+
+    row = tl.program_id(0)
+    ib = INT + row * 8
+    off = tl.load(ib + 0)
+    k = tl.load(ib + 1)
+    seed = tl.load(ib + 2)
+    pos = tl.load(ib + 3)
+    kk = tl.load(ib + 4)
+    mode = tl.load(ib + 5)
+    kkp = tl.load(ib + 6)
+    W = WORLD * k
+    j = tl.arange(0, BLOCK).to(tl.int64)
+    ok = j < W
+    rk = j // k
+    addr = rk * P + off + (j - rk * k)
+    v = tl.load(G + addr, mask=ok, other=float("-inf"))
+    ids = tl.load(GI + addr + k, mask=ok, other=0)
+    # the order (value desc, id asc) as ranks
+    rank = tl.zeros([BLOCK], dtype=tl.int32)
+    for c0 in tl.static_range(0, BLOCK, CH):
+        i = c0 + tl.arange(0, CH).to(tl.int64)
+        oki = i < W
+        rki = i // k
+        ai = rki * P + off + (i - rki * k)
+        vi = tl.load(G + ai, mask=oki, other=float("-inf"))
+        di = tl.load(GI + ai + k, mask=oki, other=0)
+        before = (vi[None, :] > v[:, None]) | ((vi[None, :] == v[:, None]) & (di[None, :] < ids[:, None]))
+        rank += tl.sum((before & oki[None, :]).to(tl.int32), axis=1)
+    rank = tl.where(ok, rank, BLOCK + 1)
+    tok = tl.sum(tl.where(rank == 0, ids, 0))                   # greedy: the first of the order
+    chosen = rank * 0                                            # the chosen candidate's rank (greedy: 0)
+    base = SCR + row * (2 * BLOCK)
+    if (mode & 1) != 0:
+        tm = tl.load(FLT + row * 4 + 0)
+        tp = tl.load(FLT + row * 4 + 1)
+        keep = rank < kk
+        sc = v.to(tl.float64) / tm
+        u = _uniform(seed, pos, ids, CONST)
+        score = sc - _log(-_log(u, CONST, LOGT), CONST, LOGT)
+        n_keep = kk
+        if (tp > 0.0) & (tp < 1.0):
+            m = tl.max(tl.where(keep, sc, float("-inf")))
+            e = _exp(sc - m, CONST, EXPT)
+            tl.store(base + rank, e, mask=keep)
+            tl.debug_barrier()
+            s1 = _pw_sum(base, kk, tl.load(CONST + 26))
+            n_keep = _below(base, kk, s1, tp) + 1
+            tl.debug_barrier()
+        score = tl.where(keep & (rank < n_keep), score, float("-inf"))
+        best = tl.max(score)
+        rmin = tl.min(tl.where(score == best, rank, BLOCK + 1))
+        tok = tl.sum(tl.where(rank == rmin, ids, 0))
+        chosen = rank * 0 + rmin
+    tl.store(TOK + row, tok)
+    if WANT:
+        prob = tl.load(CONST + 26) * 0.0
+        if (mode & 2) != 0:
+            pt = tl.load(FLT + row * 4 + 2)
+            pp = tl.load(FLT + row * 4 + 3)
+            keepp = rank < kkp
+            vv = v.to(tl.float64) / pt
+            m2 = tl.max(tl.where(keepp, vv, float("-inf")))
+            e2 = _exp(vv - m2, CONST, EXPT)
+            b2 = base + BLOCK
+            tl.store(b2 + rank, e2, mask=keepp)
+            tl.debug_barrier()
+            s = _pw_sum(b2, kkp, tl.load(CONST + 26))
+            rc = tl.max(chosen)
+            if (pp > 0.0) & (pp < 1.0):
+                keep2 = tl.minimum(_below(b2, kkp, s, pp) + 1, kkp)
+                s2 = _pw_sum(b2, keep2, s)
+                hit = tl.load(b2 + tl.minimum(rc, keep2 - 1)) / s / s2
+                prob = tl.where(rc < keep2, hit, prob)
+            else:
+                hit = tl.load(b2 + tl.minimum(rc, kkp - 1)) / s
+                prob = tl.where(rc < kkp, hit, prob)
+        tl.store(PROB + row, prob)
+
+
+# -- host side --------------------------------------------------------------------------------------------------------
+def kept(sampling: Any, width: int) -> int:
+    """The candidates the draw keeps (``choose_rows``' k)."""
+
+    return max(1, min(int(sampling.top_k) if sampling.top_k else width, width))
+
+
+def fits(k: int, world: int, sampling: Any, want: bool = False) -> bool:
+    """Whether a row of ``k`` candidates a rank can be drawn by the kernel (else the host draws it)."""
+
+    width = world * k
+    if width > MAX_GATHERED:
+        return False
+    if sampling is not None and sampling.temperature > 0 and kept(sampling, width) > MAX_KEEP:
+        return False
+    if want:
+        tk = sampling.top_k if sampling is not None and sampling.top_k else width
+        if min(int(tk), width) > MAX_KEEP:
+            return False
+    return True
+
+
+def row_entry(off: int, k: int, world: int, position: int, sampling: Any, want: bool = False) -> tuple[list, list]:
+    """(INT row, FLT row) for one row: the host sampler's parameters, as ``_choose_kernel`` reads them."""
+
+    width = world * k
+    greedy = sampling is None or sampling.temperature <= 0
+    mode = 0 if greedy else 1
+    seed = kk = 0
+    tm = tp = 1.0
+    if not greedy:
+        seed = _i64(int(sampling.seed) & 0xFFFFFFFFFFFFFFFF)
+        kk = kept(sampling, width)
+        tm = max(float(sampling.temperature), 1e-6)
+        tp = float(sampling.top_p)
+    kkp, pt, pp = 0, 1.0, 1.0
+    if want:
+        mode |= 2
+        pt = float(sampling.temperature) if sampling is not None and sampling.temperature > 0 else 1.0
+        pp = float(sampling.top_p) if sampling is not None else 1.0
+        tk = sampling.top_k if sampling is not None and sampling.top_k else width
+        kkp = min(int(tk), width)
+    return [int(off), int(k), seed, int(position), kk, mode, kkp, 0], [tm, tp, pt, pp]
+
+
+def block_for(width: int) -> int:
+    return max(16, triton.next_power_of_2(int(width)))
+
+
+def launch(got: torch.Tensor, P: int, world: int, ints: torch.Tensor, flts: torch.Tensor, tok: torch.Tensor,
+           prob: torch.Tensor | None, scratch: torch.Tensor, width: int) -> None:
+    """``_choose_kernel`` over ``ints.shape[0]`` rows (capturable: every argument a device tensor or a constant).
+    ``got``: float32 [world * P] (the all-gather's output); ``width``: the largest world x k of the rows; ``scratch``:
+    float64 of at least rows x 2 x ``block_for(width)``."""
+
+    const, logt, expt = tables(str(got.device))
+    B = block_for(width)
+    n = ints.shape[0]
+    want = prob is not None
+    _choose_kernel[(n,)](got, got.view(torch.int32), int(P), ints, flts, tok, prob if want else tok, scratch,
+                         const, logt, expt, WORLD=int(world), BLOCK=B, CH=min(32, B), WANT=want, num_warps=4,
+                         enable_fp_fusion=False)
+
+
+def choose(got: torch.Tensor, P: int, world: int, rows: Sequence[tuple[int, int, int, Any, bool]],
+           want: bool = False) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Rows (off, k, position, sampling, want probability) of ``got`` (see ``launch``) -> (tokens int32 [n], the
+    probabilities float64 [n] or None), on ``got``'s device, without a host sync."""
+
+    ints, flts = [], []
+    width = 1
+    for off, k, position, sampling, w_ in rows:
+        a, b = row_entry(off, k, world, position, sampling, w_)
+        ints.append(a)
+        flts.append(b)
+        width = max(width, world * k)
+    dev = got.device
+    pin = dev.type == "cuda"
+    it = torch.tensor(ints, dtype=torch.int64, pin_memory=pin).to(dev, non_blocking=True)
+    ft = torch.tensor(flts, dtype=torch.float64, pin_memory=pin).to(dev, non_blocking=True)
+    n = len(rows)
+    tok = torch.empty((n,), dtype=torch.int32, device=dev)
+    prob = torch.empty((n,), dtype=torch.float64, device=dev) if want else None
+    scratch = torch.empty((n, 2 * block_for(width)), dtype=torch.float64, device=dev)
+    launch(got, P, world, it, ft, tok, prob, scratch, width)
+    return tok, prob
+
+
+# -- elementwise entry points (tests, the load check) ------------------------------------------------------------------
+@triton.jit
+def _libm_kernel(X, Y, n, CONST, LOGT, EXPT, WHICH: tl.constexpr, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = i < n
+    x = tl.load(X + i, mask=m, other=1.0)
+    if WHICH == 0:
+        y = _log(x, CONST, LOGT)
+    elif WHICH == 1:
+        y = _exp(x, CONST, EXPT)
+    else:
+        y = _log(-_log(x, CONST, LOGT), CONST, LOGT)
+    tl.store(Y + i, y, mask=m)
+
+
+def libm(x: torch.Tensor, which: str) -> torch.Tensor:
+    """float64 ``log`` / ``exp`` / ``gumbel`` (log(-log(x))) of every element through the kernels' port."""
+
+    const, logt, expt = tables(str(x.device))
+    x = x.contiguous().to(torch.float64)
+    y = torch.empty_like(x)
+    n = x.numel()
+    _libm_kernel[(triton.cdiv(n, 256),)](x, y, n, const, logt, expt, WHICH={"log": 0, "exp": 1, "gumbel": 2}[which],
+                                         BLOCK=256, num_warps=4, enable_fp_fusion=False)
+    return y
+
+
+def self_check(device, rows: int = 4096, seed: int = 450) -> str | None:
+    """The kernels against the host's own numpy on this machine (``GLM53_TF_GPU_ROUND``'s load check): libm on
+    uniforms, their -log and exp's range, then draws of random rows. -> None, or what differed."""
+
+    rng = np.random.default_rng(seed)
+    u = (rng.integers(0, 1 << 53, size=rows * 8, dtype=np.int64).astype(np.float64) * 2.0 ** -53 + 2.0 ** -54)
+    e = -np.abs(rng.standard_normal(rows * 8) * rng.choice([0.01, 1.0, 30.0, 800.0], size=rows * 8))
+    checks = (("log", u, np.log(u)), ("log", -np.log(u), np.log(-np.log(u))), ("exp", e, np.exp(e)))
+    for which, x, want in checks:
+        got = libm(torch.from_numpy(x).to(device), which).cpu().numpy()
+        bad = np.nonzero(got.view(np.int64) != want.view(np.int64))[0]
+        if len(bad):
+            i = int(bad[0])
+            return f"{which}({x[i]!r}) = {got[i]!r} on the GPU, {want[i]!r} in numpy ({len(bad)} of {len(x)} differ)"
+    from tensorfold.engine.exact_sampling import Sampling, choose_rows
+
+    world, k = 2, 28
+    vals = (rng.standard_normal((rows, world * k)) * 3).astype(np.float32)
+    vals[:, 1::7] = vals[:, ::7][:, :vals[:, 1::7].shape[1]]         # ties
+    ids = np.stack([rng.permutation(1000)[:world * k] for _ in range(rows)]).astype(np.int64)
+    got = np.zeros((world, rows * 2 * k), dtype=np.float32)
+    for r in range(world):
+        seg = np.concatenate([vals[:, r * k:(r + 1) * k], ids[:, r * k:(r + 1) * k].astype(np.int32).view(np.float32)],
+                             axis=1)
+        got[r] = seg.reshape(-1)
+    gt = torch.from_numpy(got.reshape(-1)).to(device)
+    s = Sampling(seed=int(rng.integers(1 << 62)), temperature=0.7, top_k=20, top_p=0.9)
+    pos = [int(p) for p in rng.integers(0, 1 << 20, size=rows)]
+    tok, _ = choose(gt, rows * 2 * k, world, [(r * 2 * k, k, pos[r], s, False) for r in range(rows)])
+    host = choose_rows(vals.astype(np.float32), ids, pos, s)
+    dev = tok.cpu().tolist()
+    if dev != host:
+        i = next(i for i, (a, b) in enumerate(zip(dev, host)) if a != b)
+        return f"row {i}: the GPU drew {dev[i]}, the host {host[i]}"
+    return None
diff --git c/src/tensorfold/families/glm5_next/cuda/kda.cpp i/src/tensorfold/families/glm5_next/cuda/kda.cpp
