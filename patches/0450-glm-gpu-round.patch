+@triton.jit
+def _f_depth_kernel(I, P, NPROB, SLOTS, NI_: tl.constexpr, NP_: tl.constexpr, MAXD_: tl.constexpr,
+                    QMAX: tl.constexpr):
+    """A DFlash2 block's picks (NNEXT of them, with their probabilities) cut to the window's depth:
+    ``DepthOptimizer.f_depth`` (P_MODE 1: argmax over k of E(k) - rate x verify[k], ties to the smaller k, at least 1)
+    or the confidence chain (2: stop once the product falls below it, the first pick always kept), within CAP."""
+
+    i = tl.program_id(0)
+    s = tl.load(SLOTS + i)
+    b = I + s * NI_
+    par = P + s * NP_
+    n = tl.load(b + 14)
+    cap = tl.minimum(n, tl.load(b + 17))
+    mode = tl.load(par + 85).to(tl.int32)
+    lam = tl.load(par + 48)
+    conf = tl.load(par + 84)
+    top = tl.load(par + 86).to(tl.int32)                # len(verify) - 1
+    e = tl.load(par + 48) * 0.0 + 1.0
+    run = e
+    best = n * 0
+    best_s = e * 0.0 - float("inf")
+    chain = e
+    k_conf = n * 0
+    alive = cap > 0
+    for k in range(0, 16):
+        ok = (k < cap) & (k < top)
+        p = tl.load(NPROB + s * MAXD_ + k)
+        q = tl.minimum(tl.maximum(p, 0.0) * tl.load(par + 16 + k), QMAX)
+        run = tl.where(ok, run * q, run)
+        e = tl.where(ok, e + run, e)
+        sur = e - lam * tl.load(par + 49 + k + 1)
+        better = ok & (sur > best_s + 1e-12)
+        best = tl.where(better, k + 1, best)
+        best_s = tl.where(better, sur, best_s)
+        chain = tl.where(ok, chain * p, chain)
+        alive = alive & (k < cap) & ((k == 0) | (conf <= 0.0) | (chain >= conf))
+        k_conf += alive.to(tl.int32)
+    k_opt = tl.minimum(tl.maximum(best, 1), cap)
+    k = tl.where(mode == 1, k_opt, k_conf)
+    tl.store(b + 14, tl.where(cap > 0, k, 0))
