+            di = tl.load(PACKED_I + ai + K, mask=oki, other=0)
+            bef = (vi[None, :] > v[:, None]) | ((vi[None, :] == v[:, None]) & (di[None, :] < ids[:, None]))
+            rank += tl.sum((bef & oki[None, :]).to(tl.int32), axis=1)
+        keep = ok & (rank < K)
+        pv = tl.load(PRED + prev.to(tl.int64) * cb + r, mask=okr, other=0.0).to(tl.float64) * \
+            tl.load(PROJ + d * pr + r, mask=okr, other=0.0).to(tl.float64)
+        sv = tl.load(SUCC + ids.to(tl.int64)[:, None] * cb + r[None, :], mask=keep[:, None] & okr[None, :],
+                     other=0.0)
+        edge = tl.sum(sv.to(tl.float64) * pv[None, :], axis=1)
+        score = (v.to(tl.float64) + edge_w * edge) / temp
+        pick = score
+        if sampled != 0:
+            u = _uniform(seed, (first + d).to(tl.int64), ids, CONST)
+            pick = score + noise_w * (-_log(-_log(u, CONST, LOGT), CONST, LOGT))
+        pick = tl.where(keep, pick, float("-inf"))
+        best = tl.max(pick)
+        rmin = tl.min(tl.where(pick == best, rank, BLOCK + 1))
+        tok = tl.sum(tl.where(rank == rmin, ids, 0))
+        sm = tl.max(tl.where(keep, score, float("-inf")))
+        e = tl.where(keep, _exp(score - sm, CONST, EXPT), 0.0)
+        p = tl.sum(tl.where(rank == rmin, e, 0.0)) / tl.sum(e)
+        tl.store(NEXT + slot * MAXD_ + d, tok)
+        tl.store(NPROB + slot * MAXD_ + d, p)
+        prev = tok
+    tl.store(b + 14, tl.maximum(cap, 0))
+
+
+def chain_dev(d, pred: torch.Tensor, succ: torch.Tensor, I: torch.Tensor, NEXT: torch.Tensor, NPROB: torch.Tensor,
+              slot: int, sampling, depth: int, ni: int, maxd: int) -> None:
+    """patches/0450: ``_chain_kernel`` for ``d``'s last block pass (``packed`` / ``proj`` on the device)."""
+
+    from . import gpusample
+
+    sampled = sampling is not None and sampling.temperature > 0
+    temp = float(sampling.temperature) if sampled else 1.0
+    const, logt, expt = gpusample.tables(str(d.dev))
+    dc = getattr(d, "_dc", None)
+    if dc is None or getattr(d, "_dc_temp", None) != temp:     # EDGE, NOISE, the temperature (float64 on the device)
+        dc = torch.tensor([EDGE, NOISE, temp], dtype=torch.float64, device=d.dev)
+        d._dc, d._dc_temp = dc, temp
+    world = d.packed.shape[0]
+    K = d.top_k
+    seed = gpusample._i64(int(sampling.seed) & 0xFFFFFFFFFFFFFFFF) if sampled else 0
+    rsel = int(pred.shape[1])
+    _chain_kernel[(1,)](d.packed, d.packed.view(torch.int32), d.packed.stride(0), d.proj, d.proj.stride(0), pred, succ,
+                        pred.stride(0), I, NEXT, NPROB, int(slot), seed, int(sampled), int(depth), dc, const, logt,
+                        expt, K=K, WORLD=world, BLOCK=max(32, triton.next_power_of_2(world * K)), RSEL=rsel,
+                        RB=triton.next_power_of_2(rsel), NI_=ni, MAXD_=maxd, num_warps=4, enable_fp_fusion=False)
