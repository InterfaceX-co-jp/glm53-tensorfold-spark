new file mode 100644
index 0000000..0dcd9b1
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/gpuround.py
@@ -0,0 +1,382 @@
+"""patches/0450: a GPU-resident decode round (GLM53_TF_GPU_ROUND, off by default; docs/GPU-ROUND.md).
+
+Parts (``1`` = all; a comma list picks some):
+
+- ``sample``: the keyed sampler, the greedy pick and the drafts' probabilities run on the GPU (``gpusample``) with
+  the host's bits, in ``decode.sample_rows``, ``batch.sample_multi`` and ``batch.sample_drafts``. The host reads the
+  tokens (and probabilities) instead of every row's gathered candidates, and runs no numpy draw. Rows the kernel does
+  not take (``gpusample.fits``: more than 128 kept candidates) are drawn on the host as before.
+- ``resident``: steady batched decode runs as GPU-resident rounds (``Resident``): the verify window is staged, sampled,
+  accepted and committed on the device, the drafters' backlogs advance on the device, and the next window's drafts are
+  drafted on the device (MTP chains and DFlash2 blocks, depths decided there from the host's calibration one round
+  stale); the host launches round k + 1 before it reads round k's tokens (a pinned ring), so no host readback sits on
+  the round's critical path. Anything else (an arrival, a cancel, a finished request, a prefill piece, a lookup match,
+  a window crossing the 2,051-token dense limit) drains the rounds and the normal path (``Batcher._plan`` /
+  ``_execute``) takes over with the same state. Needs ``sample`` and GLM53_TF_DECODE_OVERLAP's ``plan`` part (the
+  drain flag rides the sampler exchange as 0370's plan does).
+- ``kda``: inside resident rounds, KDA commits are folded into the next window's chain (``kda.chain_slots``: the
+  previous window's kept rows are replayed in the chain's prologue, all slots in one launch per layer) instead of a
+  separate replay pass per slot.
+
+Exactness: the device draw is the host's float64 arithmetic op for op (``gpusample``), the accept rule is
+``Stepper.accept``'s, commits keep the chain / replay update routine and row order, and drafts only propose; so every
+token, every committed state and every reply equals today's (drafted == serial, batched == alone, resumed == fresh).
+Both ranks run the same kernels on the same gathered data, the same host decisions from the same read-back data one
+round late, and the same collectives in the same order.
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+from dataclasses import dataclass
+
+import triton
+import triton.language as tl
+
+PARTS = ("sample", "resident", "kda")
+
+
+@dataclass(frozen=True)
+class Settings:
+    sample: bool = False
+    resident: bool = False
+    kda: bool = False
+
+    @property
+    def on(self) -> bool:
+        return self.sample or self.resident or self.kda
+
+    def code(self) -> int:
+        return sum(1 << i for i, p in enumerate(PARTS) if getattr(self, p))
+
+    def describe(self) -> str:
+        return ",".join(p for p in PARTS if getattr(self, p)) or "off"
+
+
+def parse(spec: str | None) -> Settings:
+    """GLM53_TF_GPU_ROUND: ``0`` / empty (off), ``1`` (every part), or a comma list of ``sample``, ``resident``,
+    ``kda``. ``resident`` implies ``sample``; ``kda`` needs ``resident``."""
+
+    s = str(spec or "").strip().lower()
+    if s in ("", "0", "off", "false", "no"):
+        return Settings()
+    if s in ("1", "on", "true", "yes", "all"):
+        parts = set(PARTS)
+    else:
+        parts = {p.strip() for p in s.replace(";", ",").split(",") if p.strip()}
+        bad = parts - set(PARTS)
+        if bad:
+            raise ValueError(f"GLM53_TF_GPU_ROUND={spec!r}: unknown part(s) {sorted(bad)}; expected 0, 1 or a comma "
+                             f"list of {', '.join(PARTS)}")
+    if "kda" in parts and "resident" not in parts:
+        raise ValueError(f"GLM53_TF_GPU_ROUND={spec!r}: 'kda' folds commits into resident rounds; add 'resident'")
+    if "resident" in parts:
+        parts.add("sample")
+    return Settings(**{p: p in parts for p in PARTS})
+
+
+@functools.lru_cache(maxsize=1)
+def env() -> Settings:
+    """The process's setting (read once)."""
+
+    return parse(os.environ.get("GLM53_TF_GPU_ROUND"))
+
+
+@functools.lru_cache(maxsize=1)
+def peek() -> bool:
+    """GLM53_TF_GPU_ROUND_PEEK (default 1): resident rounds wait for the device's draft decisions (an MTP chain's next
+    step, the next window's rows) on a small pinned record and an event, so chains run exactly the steps they need and
+    windows carry no padding; the host processes round k - 1 while round k's forward runs. 0: the host stays a whole
+    round ahead (the drafts' bounds one round stale: MTP steps past a chain's end run for nothing, windows are padded
+    to the bound). Both ranks must agree (checked at load with the knob)."""
+
+    v = os.environ.get("GLM53_TF_GPU_ROUND_PEEK", "1").strip().lower()
+    if v not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_GPU_ROUND_PEEK={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+def sample_on(w) -> bool:
+    """Whether the samplers of this engine draw on the GPU (the knob, and the load check passed: ``w.meta``)."""
+
+    meta = getattr(w, "meta", None)
+    if isinstance(meta, dict) and "gpu_sample" in meta:
+        return bool(meta["gpu_sample"])
+    return env().sample
+
+
+# -- resident rounds: per-slot device state ----------------------------------------------------------------------------
+# ResidentState.I (int32 [slots, NI]): device-owned (the host writes it once, when resident rounds start)
+PEND, COUNT, MAXTOK, STOPEOS, DONE, NREAL, KEEP, MCOUNT, FCOUNT, POS, MBASE, MOFF, FOFF, PREKEEP, NNEXT, LIVE, \
+    CHAINED, CAP = range(18)
+NI = 20
+# ResidentState.H (int32 [slots, NH]): what the host decides for the round it launches (uploaded with the round)
+RUN, OFF, BOUND, ARMN = range(4)
+NH = 8
+ARM_S, ARM_M, ARM_F = 0, 1, 2
+# ResidentState.F (float64 [slots, NF]): device-owned floats (the running product of a chain)
+CHAIN = 0
+NF = 4
+# ResidentState.P (float64 [slots, NP]): the next window's depth parameters (the host's calibration one round stale):
+# MTP factors / DFlash2 factors / MTP look-ahead per draft position (16 each), the rate, verify[0..16], the marginal
+# verify ms of draft j (``_dv``, j = 0..16), mtp_step, the confidence, the mode
+P_FM, P_FF, P_AHEAD, P_RATE, P_VERIFY, P_DV, P_STEP, P_CONF, P_MODE = 0, 16, 32, 48, 49, 66, 83, 84, 85
+NP = 88
+MODE_OPT, MODE_CONF = 1, 2               # cost-derived depths (patches/0071) / a confidence threshold (c3:0.35, ...)
+Q_MAX = 0.995                            # depth.Q_MAX
+MAXD = 16                                # drafts a window holds at most (patches/0380: 15)
+REC_HEAD = 16                            # a slot's record: 16 ints, then the run rows' samples, then the next drafts
+
+
+@triton.jit
+def _stage_kernel(I, H, DRAFT, ROWSLOT, ROWIDX, IDS, SRC, INT, NI_: tl.constexpr, NH_: tl.constexpr,
+                  MAXD_: tl.constexpr):
+    """Row t of the round (slot ROWSLOT[t], row ROWIDX[t] of its window): its token (the pending token, then the
+    drafts; a padded row repeats the last real one), the row it routes as (patches/0280's tie: the last real row), and
+    its position in the sampler's row table (INT[t, 3]: the committed length + 1 + r)."""
+
+    t = tl.program_id(0)
+    s = tl.load(ROWSLOT + t)
+    r = tl.load(ROWIDX + t)
+    n = tl.load(I + s * NI_ + 5)
+    src = tl.minimum(r, n)
+    pend = tl.load(I + s * NI_ + 0)
+    d = tl.load(DRAFT + s * MAXD_ + tl.maximum(src - 1, 0))
+    tl.store(IDS + t, tl.where(src == 0, pend, d))
+    off = tl.load(H + s * NH_ + 1)
+    tl.store(SRC + t, (off + src).to(tl.int64))
+    pos = tl.load(I + s * NI_ + 9)
+    tl.store(INT + t * 8 + 3, (pos + 1 + r).to(tl.int64))
+
+
+@triton.jit
+def _accept_kernel(I, H, F, DRAFT, TOK, EOS, n_eos, KEEPV, MTOK, REC, SLOTS, BACKLOG_: tl.constexpr,
+                   NI_: tl.constexpr, NH_: tl.constexpr, NF_: tl.constexpr, MAXD_: tl.constexpr,
+                   REC_W: tl.constexpr, MAXR: tl.constexpr):
+    """Program i: slot SLOTS[i] of the round. ``Stepper.accept``'s rule on the device: keep the pending token's row and
+    the drafts up to the first whose row sampled another token (or an end token, with stop-at-EOS); a finished slot
+    keeps nothing. Advances the slot's counters, appends the kept tokens to its MTP token backlog, writes the round's
+    record (keep, count, done, position, rows run, drafts, the run rows' samples) and readies the next window's
+    drafting (CAP: its length bound within the room; an empty chain)."""
+
+    i = tl.program_id(0)
+    s = tl.load(SLOTS + i)
+    b = I + s * NI_
+    h = H + s * NH_
+    o = tl.load(h + 1)
+    R = tl.load(h + 0)
+    n = tl.load(b + 5)
+    done = tl.load(b + 4)
+    stop = tl.load(b + 3)
+    count = tl.load(b + 1)
+    going = done == 0
+    keep = going.to(tl.int32)
+    for j in range(0, n):
+        t = tl.load(TOK + o + j)
+        d = tl.load(DRAFT + s * MAXD_ + j)
+        eos = t < 0
+        for e in range(0, n_eos):
+            eos = eos | (t == tl.load(EOS + e))
+        going = going & (t == d) & ((stop == 0) | (eos == 0))
+        keep += going.to(tl.int32)
+    last = tl.load(TOK + o + tl.maximum(keep - 1, 0))
+    leos = last < 0
+    for e in range(0, n_eos):
+        leos = leos | (last == tl.load(EOS + e))
+    count2 = count + keep
+    pend = tl.where(keep > 0, last, tl.load(b + 0))
+    maxtok = tl.load(b + 2)
+    done2 = (done != 0) | (count2 >= maxtok) | ((stop != 0) & (keep > 0) & leos)
+    mcount = tl.load(b + 7)
+    fcount = tl.load(b + 8)
+    for j in range(0, keep):
+        tl.store(MTOK + s * (BACKLOG_ + 1) + tl.minimum(mcount + j, BACKLOG_), tl.load(TOK + o + j))
+    pos = tl.load(b + 9)
+    tl.store(b + 11, mcount)                            # MOFF / FOFF: where this round's kept rows go
+    tl.store(b + 12, fcount)
+    tl.store(b + 7, tl.minimum(mcount + keep, BACKLOG_))
+    tl.store(b + 8, tl.minimum(fcount + keep, BACKLOG_))
+    tl.store(b + 6, keep)
+    tl.store(b + 1, count2)
+    tl.store(b + 4, done2.to(tl.int32))
+    tl.store(b + 0, pend)
+    tl.store(b + 9, pos + keep)
+    tl.store(b + 13, keep)                              # PREKEEP: the next chain's prologue (``kda``)
+    tl.store(KEEPV + i, keep)
+    # the next window: its drafts' bound within the room (``max(1, min(depth, room))``), none for a finished slot
+    bound = tl.load(h + 2)
+    cap = tl.maximum(tl.minimum(bound, maxtok - count2), 1)
+    arm = tl.load(h + 3)
+    cap = tl.where(done2 | (arm == 0), 0, cap)
+    tl.store(b + 17, cap)
+    tl.store(b + 14, 0)                                 # NNEXT
+    tl.store(b + 15, (cap > 0).to(tl.int32))            # LIVE
+    tl.store(b + 16, 0)                                 # CHAINED
+    tl.store(F + s * NF_ + 0, tl.load(F + s * NF_ + 0) * 0.0 + 1.0)
+    rec = REC + i * REC_W
+    tl.store(rec + 0, keep)
+    tl.store(rec + 1, count2)
+    tl.store(rec + 2, done2.to(tl.int32))
+    tl.store(rec + 3, pos + keep)
+    tl.store(rec + 4, R)
+    tl.store(rec + 5, n)
+    tl.store(rec + 6, mcount)
+    tl.store(rec + 7, fcount)
+    for j in range(0, R):
+        tl.store(rec + 16 + j, tl.load(TOK + o + j))
+
+
+@triton.jit
+def _finish_kernel(I, NEXT, NPROB, DRAFT, DPROB, REC, RECF, SLOTS, NI_: tl.constexpr, MAXD_: tl.constexpr,
+                   REC_W: tl.constexpr, RECF_W: tl.constexpr, MAXR: tl.constexpr):
+    """After the drafting: the next window's drafts become the window's (NEXT -> DRAFT, NNEXT -> NREAL) and go to the
+    round's record with their probabilities and the drafters' counters."""
+
+    i = tl.program_id(0)
+    s = tl.load(SLOTS + i)
+    b = I + s * NI_
+    n = tl.load(b + 14)
+    tl.store(b + 5, n)
+    rec = REC + i * REC_W
+    recf = RECF + i * RECF_W
+    for j in range(0, n):
+        d = tl.load(NEXT + s * MAXD_ + j)
+        p = tl.load(NPROB + s * MAXD_ + j)
+        tl.store(DRAFT + s * MAXD_ + j, d)
+        tl.store(DPROB + s * MAXD_ + j, p)
+        tl.store(rec + 16 + MAXR + j, d)
+        tl.store(recf + j, p)
+    tl.store(rec + 8, n)
+    tl.store(rec + 9, tl.load(b + 7))                   # MCOUNT, FCOUNT after the drafting took its backlog
+    tl.store(rec + 10, tl.load(b + 8))
+    tl.store(rec + 11, tl.load(b + 10))                 # MBASE
+    tl.store(rec + 12, tl.load(b + 16))                 # CHAINED
+
+
+@triton.jit
+def _backlog_kernel(SRC, src_row, DST, dst_slot, dst_row, I, H, SLOTS, width, col, backlog, NI_: tl.constexpr,
+                    NH_: tl.constexpr, WHICH: tl.constexpr, BLOCK: tl.constexpr):
+    """Program (i, r, column block): row r of slot SLOTS[i]'s window, when kept, into its backlog row MOFF + r (WHICH
+    0: the MTP rows) or FOFF + r (1: the DFlash2 taps), from column ``col`` (a tap's place in the row). A row past the
+    backlog goes to its last row (``backlog``: kept free; the host never lets a backlog get there)."""
+
+    i = tl.program_id(0)
+    r = tl.program_id(1)
+    cb = tl.program_id(2)
+    s = tl.load(SLOTS + i)
+    keep = tl.load(I + s * NI_ + 6)
+    base = tl.load(I + s * NI_ + 11 + WHICH)
+    o = tl.load(H + s * NH_ + 1)
+    c = cb * BLOCK + tl.arange(0, BLOCK)
+    m = (c < width) & (r < keep)
+    v = tl.load(SRC + (o + r).to(tl.int64) * src_row + c, mask=m)
+    tl.store(DST + s.to(tl.int64) * dst_slot + tl.minimum(base + r, backlog).to(tl.int64) * dst_row + col + c, v,
+             mask=m)
+
+
+@triton.jit
+def _row_dev(CONV, PROJ, l, src, c, conv_layer, proj_layer, proj_row, C: tl.constexpr, TAPS: tl.constexpr):
+    old = tl.load(CONV + l * conv_layer + src * C + c, mask=(src < TAPS) & (c < C), other=0.0)
+    new = tl.load(PROJ + l * proj_layer + (src - TAPS) * proj_row + c, mask=(src >= TAPS) & (c < C), other=0.0)
+    return tl.where(src < TAPS, old, new)
+
+
+@triton.jit
+def _conv_shift_dev(CONV, PROJ, I, slot, conv_layer, proj_layer, proj_row, C: tl.constexpr, TAPS: tl.constexpr,
+                    NI_: tl.constexpr, BLOCK: tl.constexpr):
+    """``forward._conv_shift`` with the slot's keep read on the device (0: the windows stay)."""
+
+    keep = tl.load(I + slot * NI_ + 6)
+    l = tl.program_id(0).to(tl.int64)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    v0 = _row_dev(CONV, PROJ, l, keep, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    v1 = _row_dev(CONV, PROJ, l, keep + 1, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    v2 = _row_dev(CONV, PROJ, l, keep + 2, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    tl.store(CONV + l * conv_layer + c, v0, mask=c < C)
+    tl.store(CONV + l * conv_layer + C + c, v1, mask=c < C)
+    tl.store(CONV + l * conv_layer + 2 * C + c, v2, mask=c < C)
+
+
+# -- the drafts' depth on the device (patches/0071's rules with the host's calibration, one round stale) ---------------
+@triton.jit
+def _mtp_next_kernel(I, F, P, NEXT, NPROB, TOKS, PROBS, SLOTS, j, NI_: tl.constexpr, NF_: tl.constexpr,
+                     NP_: tl.constexpr, MAXD_: tl.constexpr, QMAX: tl.constexpr):
+    """MTP draft j of slot SLOTS[i] (``decode.draft``), sampled as TOKS[i] with probability PROBS[i]:
+    ``DepthOptimizer.mtp_next`` (P_MODE 1) or the confidence chain (2) decides whether it joins the window and whether
+    the chain goes on (LIVE); once a chain stops, its later steps' drafts are ignored (the host launched them: a
+    stale bound). CHAINED counts the head steps whose drafts the chain went on to."""
+
+    i = tl.program_id(0)
+    s = tl.load(SLOTS + i)
+    b = I + s * NI_
+    live = tl.load(b + 15) != 0
+    d = tl.load(TOKS + i)
+    p = tl.load(PROBS + i)
+    par = P + s * NP_
+    mode = tl.load(par + 85).to(tl.int32)
+    count = tl.load(b + 17)
+    chain = tl.load(F + s * NF_ + 0)
+    f = tl.load(par + 0 + tl.minimum(j, 15))
+    q = tl.minimum(tl.maximum(p, 0.0) * f, QMAX)
