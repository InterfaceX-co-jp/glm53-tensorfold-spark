+def _num(value: float) -> str:
+    """patches/0660: upstream's number rendering for a ratio (an integer loses the fraction, a float keeps it)."""
+
+    value = float(value)
+    if value == int(value):
+        return str(int(value))
+    return f"{value:.6f}".rstrip("0").rstrip(".")
+
+
+def _edge(value: float) -> str:
+    """patches/0660: a bucket's ``le`` as upstream writes it (``0.01``, ``0.25``, ``1``, ``2.5``)."""
+
+    return f"{value:.4f}".rstrip("0").rstrip(".")
+
