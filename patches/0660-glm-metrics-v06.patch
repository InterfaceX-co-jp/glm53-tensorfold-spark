+def _engine_view(app, inflight: int) -> tuple[list[tuple[str, float]], int, int]:
+    """patches/0660: ``app``'s (pool ratios, running, waiting), read without a lock and only as sizes and positions.
+
+    ``App`` and ``Batcher`` are the engine's; this runs on an HTTP scrape thread, so a shape it does not expect (or
+    an engine that is not a batch engine at all) falls back to the 0150 view: the HTTP requests are running, nothing
+    is waiting, one idle pool. A scrape must not be able to block a round, and it must not be able to fail one."""
+
+    try:
+        return _pools(app), _running(app, inflight), _waiting(app)
+    except Exception:
+        return [("0", 0.0)], inflight, 0
+
+
+def _batch(app):
+    """patches/0660: the app's batch engine, or None when it is not one (or not built yet)."""
+
+    return getattr(getattr(app, "engine", None), "batch", None)
+
+
+def _slots(app) -> list:
+    """patches/0660: the batch engine's ``seqs`` as a list, ``None`` holes kept: an index in it is a slot number."""
+
+    seqs = getattr(_batch(app), "seqs", None)
+    if not seqs:
+        return []
+    return list(seqs)
+
+
+def _running(app, inflight: int) -> int:
+    """patches/0660: slots the engine is working on (upstream's ``requests_running``). The HTTP request count is the
+    fallback for a server that is not a batch engine: 0150 alone could only see those."""
+
+    slots = [s for s in _slots(app) if s is not None]
+    return len(slots) if slots else inflight
+
+
+def _waiting(app) -> int:
+    """patches/0660: jobs the batch engine is holding for a free slot (upstream's ``requests_waiting``)."""
+
+    queue = getattr(_batch(app), "queue", None)
+    return len(queue) if queue is not None else 0
+
+
+def _window(app) -> int:
+    """patches/0660: the engine's context window in tokens (0: not readable)."""
+
+    for owner, name in ((getattr(app, "engine", None), "limit"), (app, "context_window")):
+        value = getattr(owner, name, None) if owner is not None else None
+        if isinstance(value, int) and not isinstance(value, bool) and value > 0:
+            return value
+    return 0
+
+
+def _lengths(app) -> list[int]:
+    """patches/0660: the tokens in each live slot's cache, oldest slot first. The engine's own position when it has
+    one (``Batcher`` keeps every slot's state in ``states[slot].pos``, so ``seqs``' ``None`` holes are not skipped
+    here), else the prompt prefilled plus the tokens emitted."""
+
+    slots = _slots(app)
+    states = getattr(_batch(app), "states", None)
+    out = []
+    for i, slot in enumerate(slots):
+        if slot is None:
+            continue
+        state = states[i] if states is not None and i < len(states) else None
+        pos = getattr(state, "pos", None)
+        if isinstance(pos, int) and not isinstance(pos, bool):
+            out.append(max(0, pos))
+            continue
+        done, emitted = getattr(slot, "done", 0), getattr(slot, "emitted", 0)
+        if isinstance(done, int) and isinstance(emitted, int):
+            out.append(max(0, done + emitted))
+    return out
+
+
+def _pools(app) -> list[tuple[str, float]]:
+    """patches/0660: one ratio per live slot: the tokens in its cache over the engine's context window. An idle
+    server (or one whose engine is not readable) publishes pool 0 at 0, as upstream does, so the series always
+    exists."""
+
+    lengths = _lengths(app)
+    if not lengths:
+        return [("0", 0.0)]
+    limit = _window(app)
+    if limit <= 0:
+        return [(str(i), 0.0) for i in range(len(lengths))]
+    return [(str(i), min(1.0, n / limit)) for i, n in enumerate(lengths)]
 
 
