+def _histogram(out: list[str], name: str, doc: str, hist: Histogram, label: str) -> None:
+    """patches/0660: one histogram family: cumulative buckets, ``_sum`` and ``_count``, the model label kept."""
+
+    out += [f"# HELP {name} {doc}", f"# TYPE {name} histogram"]
+    cumulative = 0
+    for edge, count in zip(BUCKETS, hist.counts):
+        cumulative += count
+        out.append(f'{name}_bucket{{le="{_edge(edge)}",{label}}} {cumulative}')
+    out.append(f'{name}_bucket{{le="+Inf",{label}}} {cumulative + hist.counts[-1]}')
+    out.append(f"{name}_sum{{{label}}} {_num(hist.total)}")
+    out.append(f"{name}_count{{{label}}} {hist.n}")
+
+
+def _pool_lines(out: list[str], ratios: list[tuple[str, float]]) -> None:
+    """patches/0660: ``tensorfold_kv_cache_usage_ratio``, one series per live slot (``pool="0" 0`` when idle)."""
+
+    out += ["# HELP tensorfold_kv_cache_usage_ratio Tokens in a stream cache divided by that stream's context window.",
+            "# TYPE tensorfold_kv_cache_usage_ratio gauge"]
+    out += [f'tensorfold_kv_cache_usage_ratio{{pool="{pool}"}} {_num(ratio)}' for pool, ratio in ratios]
+
