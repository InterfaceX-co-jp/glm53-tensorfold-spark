+def _param_prop(tools: list[dict[str, Any]], name: str | None, key: str) -> Any:
+    """patches/0650: the schema property of ``key`` in tool ``name``, as ``_glm_call`` looks it up."""
+
+    for t in tools or []:
+        if _tool_name(t).lower() == str(name or "").lower():
+            fn = t.get("function") if isinstance(t.get("function"), dict) else t
+            return ((fn.get("parameters") or {}).get("properties") or {}).get(key) if isinstance(fn, dict) else None
+    return None
+
+
+def _param_types(tools: list[dict[str, Any]], name: str | None, key: str) -> Any:
+    """patches/0650: the JSON types the parameter allows, or None when it types none."""
+
+    return schema_types(_param_prop(tools, name, key))
+
+
+def _param_value(tools: list[dict[str, Any]], name: str | None, key: str, raw: str) -> Any:
+    """patches/0650: the value ``_glm_call`` builds for this parameter -- the same rule, so the streamed
+    deltas concatenate to the end-of-reply parser's JSON."""
+
+    by_schema = "args" in tool_fixes()                      # patches/0620
+    prop = _param_prop(tools, name, key)
+    if by_schema:
+        return typed_value(raw, prop)
+    kind = prop.get("type") if isinstance(prop, dict) else None
+    if kind == "string":
+        return raw
+    try:
+        return json.loads(raw)
+    except (json.JSONDecodeError, ValueError):
+        return _closed_value(raw, kind)
