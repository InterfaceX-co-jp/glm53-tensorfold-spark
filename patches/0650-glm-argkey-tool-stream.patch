+    def _is_text(self, key: str) -> bool:
+        """patches/0650: True when the tool's schema types this parameter as a string (or allows one), so the
+        ``<arg_value>`` text is the value as written and can stream. An untyped schema buffers instead."""
+
+        types = self.types_of(self.name, key) if self.types_of is not None else None
+        return bool(types) and "string" in types
+
+    def _typed_json(self, raw: str) -> str:
+        """patches/0650: the buffered ``<arg_value>`` as the JSON the end-of-reply parser would build
+        (``parse_tool_calls`` dumps with ``separators=(",", ":")``, so this must too)."""
+
+        import json
+
+        value = self.typed(self.name, self.key, raw) if self.typed is not None else raw
+        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+
 
