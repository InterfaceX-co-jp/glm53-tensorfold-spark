+    strictly before its end (0: at the end when it ends on the grid, as patches/0085)."""
+
+    raw = os.environ.get(BEFORE_ENV, "").strip()
+    if raw not in ("", "0", "1"):
+        raise ValueError(f"{BEFORE_ENV}={raw}: expected 0 or 1")
+    return raw != "0"
+
+
