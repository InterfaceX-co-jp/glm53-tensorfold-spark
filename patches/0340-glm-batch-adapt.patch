@@ -0,0 +1,158 @@
+"""patches/0340 (GLM53_TF_BATCH_ADAPT=1, off by default): each slot's drafter in SHARED batched rounds chosen by
+what its drafts are worth to the whole round, with a serial round (no drafter pass, one row) as a third choice.
+
+Why. In a round shared by several sequences (``batch.py``) the weights are read once for everyone; what one slot
+adds is its rows (~6.5 ms each past the verify table, mostly the routed experts a row reads: rows of different
+sequences share few of 288) and its drafter pass (a DFlash2 block per slot, or its share of the batched MTP chain).
+Today each slot's drafter is picked by ``decode.DrafterChoice`` from its tokens per LONE-model ms (a whole verify
+window with its ~30 ms of weight reads, which a shared round pays once), so the two drafters look alike and the
+choice flips (W1/W5 logs: ~half the rounds each for the slow streams), and a slot always drafts. Priced at the
+margin, a slow stream's drafted round (~2.2 tokens for ~2-3 rows plus a drafter pass) and a serial row (1 token for
+~6.5 ms) are worth about the same, while a fast stream's 8-row DFlash2 round is worth far more than anything else.
+
+The rule. The round's aggregate rate lambda (``batchplan.RoundCosts.rate``: committed tokens per model ms of the last
+shared rounds, the rate ``BatchDepth`` already prices rows with) values a drafted round of arm a by its SURPLUS over
+a serial round
+
+    s_a = (keep - 1) - lambda x extra_ms
+
+where ``extra_ms`` is what the round cost beyond a serial row: its rows 2..R at the slot's table past the other
+slots' rows (``RoundCosts.table``, i.e. ``GLM53_TF_BATCH_ROW_MS``) plus its drafter pass (``lookup.round_ms``'s
+drafter terms: MTP steps and catch-up rows, or the DFlash2 block and its taps). Each arm keeps the realized surplus
+of its last ``WINDOW`` shared rounds, re-priced at the current lambda (the rows' ms are stored, not the surplus).
+A slot runs the arm with the highest mean surplus, serial when none is positive; every ``EVERY`` rounds the arm it
+has not run for longest runs once so its evidence stays current (the probe also keeps ``depth.Calibration`` fed).
+Within a drafted round nothing changes: ``BatchDepth`` still picks the depth draft by draft.
+
+Alone (one decoding slot), and for requests without cost-derived depths, the slot's own ``DrafterChoice`` decides
+exactly as before (single-stream decoding is unchanged). Every input is the same on both ranks (committed tokens,
+the load-time cost table, the windows of the round): nothing here reads a clock.
+
+Exactness. The choice only decides which drafts a window carries (none for a serial round); the keyed sampler and
+the accept rule decide every token from the slot's own logit rows, which never depend on their window-mates or on
+the window's length (row-independent kernels, ``forward.py``). So replies stay byte-identical to serial decoding
+and to the request served alone, whatever the choices.
+
+No torch here: the unit tests and ``bench/draftsim.py`` run anywhere.
+"""
+
+from __future__ import annotations
+
+import collections
+import os
+from typing import Sequence
+
+WINDOW = 8                # shared rounds of an arm in its running surplus
+EVERY = 8                 # a drafting arm not run for this many shared rounds runs once (probe)
+SERIAL = "s"
+
+
+def env_on() -> bool:
+    """GLM53_TF_BATCH_ADAPT: 1 = on (both ranks must agree: ``batch.Batcher`` compares it at load)."""
+
+    v = os.environ.get("GLM53_TF_BATCH_ADAPT", "0").strip() or "0"
+    if v not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_BATCH_ADAPT={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+def env_serial() -> bool:
+    """GLM53_TF_BATCH_ADAPT_SERIAL=1: a serial round (no drafts) is a choice too (default 0: see
+    docs/ADAPTIVE-DRAFT.md, it lowers the concurrent bench's aggregate and the slow streams' speed)."""
+
+    return (os.environ.get("GLM53_TF_BATCH_ADAPT_SERIAL", "0").strip() or "0") == "1"
+
+
+def env_every() -> int:
+    return max(0, int(os.environ.get("GLM53_TF_BATCH_ADAPT_EVERY", "") or EVERY))
+
+
+def env_window() -> int:
+    return max(1, int(os.environ.get("GLM53_TF_BATCH_ADAPT_WINDOW", "") or WINDOW))
+
+
+def drafter_ms(costs: dict, arm: str, rows: int, steps: int, backlog: int) -> float:
+    """Model ms of a round's drafter work (``lookup.round_ms`` less its verify window): 0 for serial / lookup."""
+
+    if arm == "m":
+        return (costs.get("mtp", 0.0) + costs.get("mtp_step", 0.0) * max(steps - 1, 0)
+                + costs.get("mtp_row", 0.0) * max(backlog - 1, 0))
+    if arm == "f":
+        return costs.get("block", 0.0) + costs.get("taps_row", 0.0) * backlog
+    return 0.0
+
+
+def extra_ms(costs: dict, table: Sequence[float], arm: str, rows: int, steps: int, backlog: int) -> float:
+    """What a round of ``rows`` rows of ``arm`` costs beyond a serial row: rows 2..R on ``table`` (the slot's window
+    costs past the other slots' rows) plus the drafter's work."""
+
+    table = list(table)
+    r = max(1, min(int(rows), len(table)))
+    return float(table[r - 1] - table[0]) + drafter_ms(costs, arm, rows, steps, backlog)
+
+
+class SlotChoice:
+    """One slot's arm (``"m"``, ``"f"`` or serial ``"s"``) in shared rounds; ``base`` (a ``decode.DrafterChoice``, a
+    ``batch.Always`` or None) decides alone. ``arms``: the drafting arms the request may use ("mf", "m" or "f")."""
+
+    def __init__(self, costs: dict, arms: str, base=None, *, every: int = EVERY, window: int = WINDOW,
+                 serial: bool = True, margin: float = 0.0) -> None:
+        self.costs = costs
+        self.allow_serial = bool(serial)
+        self.margin = float(margin)
+        self.arms = "".join(a for a in "mf" if a in arms)
+        self.base = base
+        self.every, self.window = int(every), max(1, int(window))
+        self.hist = {a: collections.deque(maxlen=self.window) for a in self.arms}   # (keep - 1, extra ms)
+        self.since = {a: 0 for a in self.arms}          # shared rounds since the arm last ran
+        self.serial = self.probes = 0                   # stats: serial rounds, probe rounds
+
+    # -- the choice ----------------------------------------------------------------------------------------------
+    def surplus(self, arm: str, rate: float) -> float | None:
+        """The arm's mean surplus over a serial round at ``rate`` (None: no shared round of it yet)."""
+
+        h = self.hist.get(arm)
+        if not h:
+            return None
+        return sum(g for g, _ in h) / len(h) - rate * sum(ms for _, ms in h) / len(h)
+
+    def pick(self, rate: float | None) -> str:
+        """The next round's arm. ``rate``: the shared rounds' aggregate rate, None when the slot decodes alone (the
+        base choice decides, as without this patch)."""
+
+        if rate is None or not self.arms:
+            return self.base.pick() if self.base is not None else (self.arms[:1] or "m")
+        vals = {a: self.surplus(a, rate) for a in self.arms}
+        unseen = [a for a in self.arms if vals[a] is None]
+        if unseen:                                      # every arm runs once before it can be judged
+            return unseen[0]
+        best, best_v = (SERIAL, -self.margin) if self.allow_serial else (self.arms[0], vals[self.arms[0]])
+        for a in self.arms:
+            if vals[a] > best_v + 1e-12:
+                best, best_v = a, vals[a]
+        if self.every:
+            stale = [a for a in self.arms if a != best and self.since[a] >= self.every]
+            if stale:
+                self.probes += 1
+                return max(stale, key=lambda a: (self.since[a], a == "f"))
+        return best
+
+    def record(self, arm: str, rows: int, steps: int, backlog: int, keep: int, table: Sequence[float] | None,
+               shared: bool) -> None:
+        """After a verified round: ``table`` the window costs the slot's depths were priced with (its row costs
+        past the other slots' rows). Only shared rounds build the surplus; the base choice records drafted rounds
+        as before (its rates stay current for when the slot decodes alone)."""
+
+        if arm in ("m", "f") and self.base is not None:
+            self.base.record(arm, rows, steps, backlog, keep)
+        if not shared:
+            return
+        for a in self.arms:
+            self.since[a] += 1
+        if arm == SERIAL:
+            self.serial += 1
+            return
+        if arm in self.hist:
+            self.since[arm] = 0
+            if table is not None:
+                self.hist[arm].append((keep - 1, extra_ms(self.costs, table, arm, rows, steps, backlog)))
