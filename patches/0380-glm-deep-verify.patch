diff --git c/src/tensorfold/families/glm5_next/cuda/deep.py i/src/tensorfold/families/glm5_next/cuda/deep.py
new file mode 100644
index 0000000..8f69713
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/deep.py
@@ -0,0 +1,84 @@
+"""Deeper verify windows (patches/0380): ``GLM53_TF_MAX_DRAFT_ROWS`` (load-time, both ranks equal, default 8).
+
+A round verifies the pending token and up to ``MAX_DRAFT_ROWS - 1`` drafts as one window. Upstream (and every patch
+before this one) fixes that at 8 rows (``engine.MAX_ROWS``). This knob raises the cap to at most 16. Which rows a
+round actually verifies is still decided by the existing rules: patches/0071's cost-derived depths (a draft joins
+the window only while its expected token beats the request's rate times its row's marginal ms, from the drafter's
+own probability corrected per position) and the lookup gate of patches/0020. So a deeper cap only adds rows to
+rounds whose drafts are confident enough to pay for them.
+
+What can fill rows past the 8th:
+
+- prompt-lookup drafts (patches/0020): a copy of an earlier span, up to ``MAX_DRAFT_ROWS - 1`` tokens, priced per
+  match-length band;
+- MTP chains: the head chains one draft a step, so a chain can run to ``MAX_DRAFT_ROWS - 1`` drafts when each step
+  pays;
+- DFlash2: one block pass proposes ``block_size - 1`` positions (7 for the published drafter, block 8). Past that,
+  only with ``GLM53_TF_DFLASH_BLOCK`` (below).
+
+``GLM53_TF_DFLASH_BLOCK=N`` (load-time, both ranks equal; default: the checkpoint's ``block_size``): run the drafter's
+block pass over N rows (``[pending, mask x (N - 1)]``). The published drafter was trained with blocks of 8, so masks
+past the 7th are out of distribution (DBloom, arXiv 2608.30427: naive widening at inference does not work), and the
+wider bidirectional block can also change the first 7 picks. Drafts only propose, so replies are unchanged; it is an
+experiment for the GPU window, where the per-position acceptance decides (``depth.Calibration`` prices positions
+past 7 from their own evidence). ``GLM53_TF_AUTO_FDRAFTS`` must be raised with it for ``auto`` to verify them.
+
+Exactness: every decode, verify and MTP kernel is row-independent for any window of 1 to 512 rows (the same code runs
+exact prefill chunks of up to ``GLM53_TF_PREFILL_ROWS`` rows; ``qmm.bucket`` puts 1-16 rows in one tile size), the
+accept rule keeps rows up to the first draft that differs from the keyed sample, and ``forward.commit`` replays the
+kept prefix. A deeper window changes how many positions a round confirms, never which token a position gets.
+
+Sizes that follow the cap, per rank on GLM-5.3-Flash at a 1M-token capacity, 16 rows against 8 (about +115 MB):
+patches/0050's ``sparse.LongScratch`` of the main and MTP buffer sets (scores and keys of every pool for each row: +25
+MB each), ``latent.SPARSE_ROWS`` (preallocated sparse partials, +2.6 MB each), the batch slots' window-sized KDA
+projection / replay rows (0120: +20 MB a slot other than slot 0, whose rows are the prefill buffers'), 0120's batched
+KDA rows (tiny); the long-context graph keys (rows 1..N, captured lazily as before, ``GLM53_TF_LONGCTX_MAX_GRAPHS``
+still caps them) and the batch graph keys (``GLM53_TF_BATCH_GRAPH_ROWS`` defaults to the cap); the calibration (windows
+of 1..N rows timed at load; ``calib.window_costs`` keeps the 1..8 table an 8-row calibration fits from the same times
+and extends it on its own line).
+
+No torch here.
+"""
+
+from __future__ import annotations
+
+import os
+
+DEFAULT = 8               # upstream's widest verify window (the pending token and 7 drafts)
+LIMIT = 16                # the widest window this patch sizes for
+ENV = "GLM53_TF_MAX_DRAFT_ROWS"
+BLOCK_ENV = "GLM53_TF_DFLASH_BLOCK"
+
+
+def max_rows(value: str | None = None) -> int:
+    """GLM53_TF_MAX_DRAFT_ROWS (or ``value``): the widest verify window, 8 to 16 rows (default 8)."""
+
+    raw = (os.environ.get(ENV, "") if value is None else str(value)).strip()
+    try:
+        n = int(raw) if raw else DEFAULT
+    except ValueError:
+        raise ValueError(f"{ENV}={raw!r}: expected an integer from {DEFAULT} to {LIMIT}") from None
+    if not DEFAULT <= n <= LIMIT:
+        raise ValueError(f"{ENV}={n}: expected {DEFAULT} to {LIMIT} rows (a pending token and up to {LIMIT - 1} "
+                         "drafts)")
+    return n
+
+
+def dflash_block(rows: int | None = None, value: str | None = None) -> int:
+    """GLM53_TF_DFLASH_BLOCK (or ``value``): the DFlash2 block pass's rows, 0 = the checkpoint's ``block_size``. At
+    most the widest window (``rows``, default ``max_rows()``)."""
+
+    raw = (os.environ.get(BLOCK_ENV, "") if value is None else str(value)).strip()
+    most = max_rows() if rows is None else int(rows)
+    try:
+        n = int(raw) if raw else 0
+    except ValueError:
+        raise ValueError(f"{BLOCK_ENV}={raw!r}: expected 0 (the checkpoint's block) or 2 to {most}") from None
+    if n and not 2 <= n <= most:
+        raise ValueError(f"{BLOCK_ENV}={n}: expected 0 (the checkpoint's block) or 2 to {most} "
+                         f"({ENV}={most} is the widest verify window)")
+    return n
+
+
+ROWS = max_rows()         # read once at import, like every load-time knob (both ranks compare it at load)
+DRAFTS = ROWS - 1         # the most drafts a window holds
