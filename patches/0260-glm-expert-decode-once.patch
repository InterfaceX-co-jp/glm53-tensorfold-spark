 }  // namespace fat
 
+// -- once (patches/0260, GLM53_TF_FAST_EXPERTS=once): fat with TWO work items a CTA that share their trellis decode --
+// How often fat decodes a weight tile: an item is (distinct expert u, pass of BM members, 128-column block nb), and
+// each warp decodes its own MTL column tiles of the item into registers once, for the item's BM members (the decoded
+// fragment is the mma A operand of all NG n8 groups). So a tile is decoded ceil(n_u / BM) times a chunk: gate/up
+// BM = 64, down BM = 64 (128 from 4096 rows). With top-8 of 288 experts, n_u ~ 8 C / 288: C = 1024 decodes every tile
+// once already; 2048 1.15x (uniform) / 1.44x (skewed); 4096 1.75 / 1.96x; 8192 3.34 / 3.44x (gate/up 4.0, down 2.0).
+// A CTA cannot hold more members' accumulators than fat's two CTAs an SM already do (gate/up: 2 x 64 members x 256
+// fp32 columns = 128 KB of registers, half the register file; the chain over K must stay whole for fat's bits), so
+// the decode is shared ACROSS the two items an SM holds instead:
+//
+//   * a CTA is two fat CTAs ("halves", 2 x 8 warps for gate/up, 2 x 4 for down) that claim one unit;
+//   * a PAIR unit is passes 2q and 2q + 1 of the same (u, nb): the halves multiply the same weight tiles by different
+//     members, so warp (h, mat, slice) decodes only the column tiles l = 2i + h of its MTL, hands them to its partner
+//     warp (1 - h, mat, slice) through a 2 x 512 B shared buffer, and takes the partner's (one 64-thread named barrier a
+//     k tile). The words are loaded once for both halves;
+//   * a SPLIT unit is one pass and two adjacent column blocks nb, nb + 1 (an expert's last odd pass, or every pass with
+//     GLM53_TF_ONCE_PAIR=0): each half decodes its own tiles as fat does, and the halves share the member rows of the
+//     stage (loaded once instead of twice);
+//   * units come from a plan kernel (per expert: P / 2 pair passes x NBLK units, then the odd pass as ceil(NBLK / 2)
+//     split units) and are claimed by ticket; nb is fastest, so the units of a pass run together (rows from L2).
+//
+// Decodes a tile a chunk: ceil(P / 2) instead of P (8192 rows: gate/up 4.0 -> 2.0, down 2.0 -> 1.0; see the table
+// in PATCHES 0260). Shared memory: 3 stages of max(2 row sets + 1 word set, 1 row set + 2 word sets) + the exchange
+// buffer: gate/up (shared input) 3 x 24 + 16 = 88 KB, down 68 / 62 KB, one CTA of 16 / 8 warps an SM (fat: two of
+// 8 / 4). The epilogue (both halves' fp32 rows) reuses the ring.
+//
+// Exactness: fat == fast2 == v1 BIT FOR BIT carries over. Every output element is the same chain of m16n8k16 mma over
+// ascending k tiles with the same A fragment (decode_tile of the same word is a pure function: the partner's decode is
+// the value this warp would have computed) and the same B values (the row stage holds the same fp16 rows), then fat's
+// transforms and epilogue code. Which unit kind covers an item, which half, which CTA, and the ticket order only move
+// data. Row-independent (patches/0085): a pair's outputs depend only on its own row; the member counts decide only
+// how items are grouped into units and which B columns are zero-filled. Deterministic: no atomics on data.
+namespace once {
+
+template <int MATS, int MTL, int NG, int KS, int NSA, int NGR, bool SHX>
+struct Cfg {
+    static constexpr int BM = NG * 8, WPM = NB / MTL, HW = MATS * WPM, W = 2 * HW, THREADS = W * 32;
+    static constexpr int XM = SHX ? 1 : MATS;                       // matrices of member rows in a stage
+    static constexpr int CPR = KS * 2, LDA = KS * 16;               // fat's swizzled rows
+    static constexpr int LDE = 132, ER = NGR * 8, ROUNDS = NG / NGR;
+    static constexpr int XF = MTL / 2;                              // fragments a warp decodes for its partner
+    static constexpr size_t ROWS = (size_t)XM * BM * LDA * sizeof(half);            // one pass's rows of a stage
+    static constexpr size_t WSET = (size_t)MATS * KS * NB * 32 * sizeof(uint32_t);  // one column block's words
+    static constexpr size_t STAGE = 2 * ROWS + WSET > ROWS + 2 * WSET ? 2 * ROWS + WSET : ROWS + 2 * WSET;
+    static constexpr size_t RING = (size_t)NSA * STAGE;
+    static constexpr size_t XBUF = (size_t)2 * W * XF * 32 * sizeof(uint4);       // [k tile parity][warp][XF][lane]
+    static constexpr size_t EPI_H = (size_t)MATS * ER * LDE * sizeof(float);      // one half's epilogue rows
+    static constexpr size_t SMEM = RING + XBUF > 2 * EPI_H ? RING + XBUF : 2 * EPI_H;
+    static_assert(MTL % 2 == 0, "a pair splits each warp's column tiles in two");
+    static_assert(ROWS % 16 == 0 && WSET % 16 == 0 && STAGE % 16 == 0 && EPI_H % 16 == 0, "16-byte alignment");
+    static_assert(HW <= 15, "named barriers 1 .. HW (0 is __syncthreads)");
+};
+
+__device__ __forceinline__ void pair_sync(int id) { asm volatile("bar.sync %0, 64;\n" ::"r"(id) : "memory"); }
+
+// plan[0] = units in all; plan[1 + u] = the first unit of distinct expert u (plan[1 + maxu] = plan[0]);
+// plan[2 + maxu + u] = u's passes of BM members; plan[2 + 2 maxu] = the ticket counter (zeroed by the host).
+// Units of u: pair units (passes 2q, 2q + 1; one column block) q < P / 2, nb fastest; then split units (one pass, column
+// blocks 2c and 2c + 1) for the odd last pass, or for every pass when pair == 0.
+__global__ void plan_kernel(const int* __restrict__ uids, const int* __restrict__ ucount,
+                            const int* __restrict__ members, int maxu, int maxm, int E, int BM, int nblk, int pair,
+                            int* __restrict__ plan) {
+    __shared__ int sc[fast2::MAXU];
+    const int u = threadIdx.x;
+    int passes = 0;
+    if (u < maxu && u < ucount[0] && uids[u] < E) {
+        const int* m = members + (size_t)u * maxm;
+        int lo = 0, hi = maxm;                     // members come first: the count is the first -1
+        while (lo < hi) {
+            const int mid = (lo + hi) >> 1;
+            if (m[mid] >= 0) lo = mid + 1; else hi = mid;
+        }
+        passes = (lo + BM - 1) / BM;
+    }
+    const int pairs = pair ? passes / 2 : 0;
+    sc[u] = pairs * nblk + (passes - 2 * pairs) * ((nblk + 1) / 2);
+    if (u < maxu) plan[2 + maxu + u] = passes;
+    __syncthreads();
+    for (int d = 1; d < fast2::MAXU; d <<= 1) {
+        const int v = u >= d ? sc[u - d] : 0;
+        __syncthreads();
+        sc[u] += v;
+        __syncthreads();
+    }
+    if (u < maxu) plan[2 + u] = sc[u];
+    if (u == 0) {
+        plan[1] = 0;
+        plan[0] = sc[maxu - 1];
+    }
+}
+
+// PROBE (timing only, never used for outputs): 1 = no trellis decode (the raw word as the A fragment), 2 = no mma
+template <int MATS, int MTL, int NG, int KS, int NSA, int NGR, bool SHX, int PROBE>
+__global__ void __launch_bounds__(Cfg<MATS, MTL, NG, KS, NSA, NGR, SHX>::THREADS, 1) expert_kernel(
+    const half* __restrict__ X0, const half* __restrict__ X1, const uint32_t* __restrict__ T0,
+    const uint32_t* __restrict__ T1, const int* __restrict__ uids, const int* __restrict__ members,
+    const int* __restrict__ plan, int* __restrict__ ticket, int K, int N, int maxm, int slots, int maxu, int pair,
+    const half* __restrict__ sv0, const half* __restrict__ sv1, const half* __restrict__ sd, half* __restrict__ xd,
+    float* __restrict__ y, float limit) {
+    using C = Cfg<MATS, MTL, NG, KS, NSA, NGR, SHX>;
+    constexpr int W = C::W, HW = C::HW, THREADS = C::THREADS, BM = C::BM, LDA = C::LDA, LDE = C::LDE, ER = C::ER,
+                  CPR = C::CPR, XF = C::XF;
+    static_assert(NG % 2 == 0 && NG % NGR == 0 && NGR % 2 == 0, "n groups in pairs");
+    extern __shared__ __align__(16) unsigned char smem[];
+    uint4* xbuf = reinterpret_cast<uint4*>(smem + C::RING);
+    __shared__ int rows_sh[2 * BM];                          // [half][BM] pair rows (-1: none)
+    __shared__ int item_sh, u_sh, cnt_sh[2];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int h = warp / HW, hw = warp % HW;                 // half, warp within the half (fat's warp index)
+    const int mat = hw / C::WPM, slice = hw % C::WPM;        // columns slice * 16 MTL .. + 16 MTL of the item
+    const int xmat = SHX ? 0 : mat;
+    const int partner = (1 - h) * HW + hw;                   // the other half's warp with the same columns
+    const int g = lane >> 2, t = lane & 3;
+    const int KT = K >> 4, NTILES = N >> 4, S = KT / KS, NBLK = N / 128, HB = (NBLK + 1) / 2;
+    const int total = plan[0];
+    const int lr = (lane & 7) + ((lane >> 4) << 3);
+    const int lc = (lane >> 3) & 1;
+
+    int u = 0;                                               // thread 0: the distinct expert of the last unit
+    int next = blockIdx.x;
+    for (;;) {
+        __syncthreads();                                     // the previous unit is done with rows_sh / smem
+        if (threadIdx.x == 0) {
+            const int it = ticket ? atomicAdd(ticket, 1) : next;
+            item_sh = it;
+            if (it < total) {
+                while (u + 1 < maxu && __ldg(plan + 2 + u) <= it) ++u;     // units ascend per CTA
+                u_sh = u;
+            }
+            cnt_sh[0] = cnt_sh[1] = 0;
+        }
+        next += gridDim.x;
+        __syncthreads();
+        const int item = item_sh;
+        if (item >= total) break;
+        const int uu = u_sh, e = uids[uu], P = plan[2 + maxu + uu];
+        const int j = item - plan[1 + uu];
+        const int pairs = pair ? P / 2 : 0;
+        const bool paired = j < pairs * NBLK;                // CTA-uniform
+        int pass0, pass1, nb0, nb1;
+        if (paired) {
+            pass0 = 2 * (j / NBLK);
+            pass1 = pass0 + 1;
+            nb0 = nb1 = j % NBLK;
+        } else {
+            const int j2 = j - pairs * NBLK;
+            pass0 = pass1 = 2 * pairs + j2 / HB;
+            nb0 = 2 * (j2 % HB);
+            nb1 = nb0 + 1;
+        }
+        const bool valid1 = nb1 < NBLK;                      // an odd NBLK's last split unit has one column block
+        if (!valid1) nb1 = nb0;                              // (loads stay in range; half 1 has no members)
+        for (int i = threadIdx.x; i < 2 * BM; i += THREADS) {
+            const int hh = i >= BM, r = i - hh * BM;
+            const int m = (hh ? pass1 : pass0) * BM + r;
+            const int code = m < maxm ? members[(size_t)uu * maxm + m] : -1;
+            rows_sh[i] = code >= 0 ? (code >> 5) * slots + (code & 31) : -1;
+            if (code >= 0) atomicMax(&cnt_sh[hh], r + 1);
+        }
+        __syncthreads();
+        const int cnt = (h == 0 || valid1) ? cnt_sh[h] : 0;  // this half's members (they come first)
+        const int nb = h ? nb1 : nb0;
+        const int nrs = paired ? 2 : 1;                      // row sets in a stage (split: the halves share pass0's)
+        const size_t rows_bytes = (size_t)nrs * C::ROWS;
+
+        // stage s: the member rows' k range (both passes of a pair, or the one pass of a split unit), zero-filled past
+        // the last member, then the trellis words of k tiles s KS .. s KS + KS - 1 (one column block, or two)
+        auto load_stage = [&](int s) {
+            unsigned char* st = smem + (size_t)(s % NSA) * C::STAGE;
+            half* ra = reinterpret_cast<half*>(st);
+            const int k0 = s * KS * 16, RR = nrs * BM;
+            for (int i = threadIdx.x; i < C::XM * RR * CPR; i += THREADS) {
+                const int m = i / (RR * CPR), r = (i / CPR) % RR, c = i % CPR;
+                const int row = rows_sh[r];
+                const half* src = (m ? X1 : X0) + (size_t)(row < 0 ? 0 : row) * K + k0 + c * 8;
+                fast2::cp_async16(ra + ((size_t)m * RR + r) * LDA + fat::swz<CPR>(r, c) * 8, src, row >= 0);
+            }
+            uint32_t* rw = reinterpret_cast<uint32_t*>(st + rows_bytes);
+            const int wch = (3 - nrs) * MATS * KS * NB * 8;  // 16-byte chunks: 8 a 16 x 16 tile
+            for (int i = threadIdx.x; i < wch; i += THREADS) {
+                const int q = i & 7, n = (i >> 3) % NB, kk = (i / (8 * NB)) % KS, m = (i / (8 * NB * KS)) % MATS;
+                const int js = i / (8 * NB * KS * MATS);
+                const uint32_t* src = (m ? T1 : T0) +
+                                      (((size_t)e * KT + s * KS + kk) * NTILES + (js ? nb1 : nb0) * NB + n) * 32 + q * 4;
+                fast2::cp_async16(rw + (((js * MATS + m) * KS + kk) * NB + n) * 32 + q * 4, src, true);
+            }
+        };
+
+        float acc[MTL][NG][4];
+#pragma unroll
+        for (int l = 0; l < MTL; ++l)
+#pragma unroll
+            for (int n = 0; n < NG; ++n)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[l][n][c] = 0.f;
+
+#pragma unroll
+        for (int s = 0; s < NSA - 1; ++s) {
+            if (s < S) load_stage(s);
+            fast2::cp_commit();
+        }
+        fast2::cp_wait<NSA - 2>();
+        __syncthreads();
+        const size_t a_off = (size_t)(xmat * nrs * BM + (paired ? h * BM : 0)) * LDA;
+        const size_t w_off = (size_t)((paired ? 0 : h) * MATS + mat) * KS * NB * 32 + slice * MTL * 32 + lane;
+        for (int s = 0; s < S; ++s) {
+            if (s + NSA - 1 < S) load_stage(s + NSA - 1);
+            fast2::cp_commit();
+            const unsigned char* st = smem + (size_t)(s % NSA) * C::STAGE;
+            const half* A = reinterpret_cast<const half*>(st) + a_off;
+            const uint32_t* Wd = reinterpret_cast<const uint32_t*>(st + rows_bytes) + w_off;
+#pragma unroll
+            for (int kk = 0; kk < KS; ++kk) {
+                uint32_t af[MTL][4];
+                if (paired) {
+                    // decode column tiles 2i + h, hand them over, take the partner's 2i + 1 - h
+                    uint4* xb = xbuf + (size_t)((s * KS + kk) & 1) * W * XF * 32;
+                    uint32_t mine[XF][4], theirs[XF][4];
+#pragma unroll
+                    for (int i = 0; i < XF; ++i) {
+                        uint32_t b0[2], b1[2];
+                        const uint32_t w = Wd[(kk * NB + 2 * i + h) * 32];
+                        if (PROBE == 1) {
+                            b0[0] = b0[1] = b1[0] = b1[1] = w;
+                        } else {
+                            decode_tile(w, lane, b0, b1);
+                        }
+                        mine[i][0] = b0[0]; mine[i][1] = b1[0]; mine[i][2] = b0[1]; mine[i][3] = b1[1];
+                        xb[(warp * XF + i) * 32 + lane] = make_uint4(mine[i][0], mine[i][1], mine[i][2], mine[i][3]);
+                    }
+                    pair_sync(1 + hw);
+#pragma unroll
+                    for (int i = 0; i < XF; ++i) {
+                        const uint4 f = xb[(partner * XF + i) * 32 + lane];
+                        theirs[i][0] = f.x; theirs[i][1] = f.y; theirs[i][2] = f.z; theirs[i][3] = f.w;
+                    }
+#pragma unroll
+                    for (int i = 0; i < XF; ++i)
+#pragma unroll
+                        for (int c = 0; c < 4; ++c) {
+                            af[2 * i][c] = h ? theirs[i][c] : mine[i][c];
+                            af[2 * i + 1][c] = h ? mine[i][c] : theirs[i][c];
+                        }
+                } else {
+#pragma unroll
+                    for (int l = 0; l < MTL; ++l) {
+                        uint32_t b0[2], b1[2];
+                        const uint32_t w = Wd[(kk * NB + l) * 32];
+                        if (PROBE == 1) {
+                            b0[0] = b0[1] = b1[0] = b1[1] = w;
+                        } else {
+                            decode_tile(w, lane, b0, b1);
+                        }
+                        af[l][0] = b0[0]; af[l][1] = b1[0]; af[l][2] = b0[1]; af[l][3] = b1[1];
+                    }
+                }
+                const int chunk = fat::swz<CPR>(lr, kk * 2 + lc);
+#pragma unroll
+                for (int np = 0; np < NG / 2; ++np) {
+                    if (PROBE != 2 && 16 * np < cnt) {           // warp-uniform
+                        uint32_t b[4];
+                        fast2::ldsm4(b, A + (16 * np + lr) * LDA + chunk * 8);
+#pragma unroll
+                        for (int l = 0; l < MTL; ++l) {
+                            mma16816(acc[l][2 * np], af[l], b[0], b[1]);
+                            mma16816(acc[l][2 * np + 1], af[l], b[2], b[3]);
+                        }
+                    }
+                }
+                if (PROBE == 2) {                                // keep the decode alive
+#pragma unroll
+                    for (int l = 0; l < MTL; ++l) acc[l][0][0] += __uint_as_float(af[l][0] ^ af[l][1] ^ af[l][2] ^ af[l][3]);
+                }
+            }
+            fast2::cp_wait<NSA - 2>();
+            __syncthreads();
+        }
+
+        // epilogue: fat's, per half (its own fp32 rows in smem; ER rows a round, one warp of the half a row)
+        float* ep = reinterpret_cast<float*>(smem + h * C::EPI_H);
+        const int* rows_h = rows_sh + h * BM;                // split units: both halves hold pass0's rows
+#pragma unroll
+        for (int rd = 0; rd < C::ROUNDS; ++rd) {
+            if (rd) __syncthreads();
+            if (ER * rd < cnt) {
+#pragma unroll
+                for (int n = 0; n < NGR; ++n) {
+                    const int ng = rd * NGR + n;
+                    float* E = ep + ((size_t)mat * ER + 8 * n + 2 * t) * LDE + slice * 16 * MTL + g;
+#pragma unroll
+                    for (int l = 0; l < MTL; ++l) {
+                        E[l * 16] = acc[l][ng][0];
+                        E[LDE + l * 16] = acc[l][ng][1];
+                        E[l * 16 + 8] = acc[l][ng][2];
+                        E[LDE + l * 16 + 8] = acc[l][ng][3];
+                    }
+                }
+            }
+            __syncthreads();
+            for (int r = hw; r < ER && ER * rd + r < cnt; r += HW) {
+                const int row = rows_h[ER * rd + r];
+                const int c0 = 4 * lane;
+                float v[4];
+                *reinterpret_cast<float4*>(v) = *reinterpret_cast<const float4*>(ep + (size_t)r * LDE + c0);
+                fast2::fwht_row(v, lane);
+                if constexpr (MATS == 2) {
+                    float w[4];
+                    *reinterpret_cast<float4*>(w) = *reinterpret_cast<const float4*>(ep + ((size_t)ER + r) * LDE + c0);
+                    fast2::fwht_row(w, lane);
+                    const half* sg = sv0 + (size_t)e * N + nb * 128 + c0;
+                    const half* su = sv1 + (size_t)e * N + nb * 128 + c0;
+                    const half* sdd = sd + (size_t)e * N + nb * 128 + c0;
+#pragma unroll
+                    for (int jj = 0; jj < 4; ++jj) {
+                        const float gg = fminf(bf16r(v[jj] * HAD_SCALE * __half2float(sg[jj])), limit);
+                        const float uu2 = fminf(fmaxf(bf16r(w[jj] * HAD_SCALE * __half2float(su[jj])), -limit), limit);
+                        const float a = bf16r(bf16r(gg / (1.f + expf(-gg))) * uu2);
+                        v[jj] = a * __half2float(sdd[jj]);
+                    }
+                    fast2::fwht_row(v, lane);
+                    half2* o = reinterpret_cast<half2*>(xd + (size_t)row * N + nb * 128 + c0);
+                    o[0] = __halves2half2(__float2half_rn(v[0] * HAD_SCALE), __float2half_rn(v[1] * HAD_SCALE));
+                    o[1] = __halves2half2(__float2half_rn(v[2] * HAD_SCALE), __float2half_rn(v[3] * HAD_SCALE));
+                } else {
+                    const half* sv = sv0 + (size_t)e * N + nb * 128 + c0;
+                    float4 o;
+                    o.x = v[0] * HAD_SCALE * __half2float(sv[0]);
+                    o.y = v[1] * HAD_SCALE * __half2float(sv[1]);
+                    o.z = v[2] * HAD_SCALE * __half2float(sv[2]);
+                    o.w = v[3] * HAD_SCALE * __half2float(sv[3]);
+                    *reinterpret_cast<float4*>(y + (size_t)row * N + nb * 128 + c0) = o;
+                }
+            }
+        }
+    }
+}
+
+template <int MATS, int MTL, int NG, int KS, int NSA, int NGR, bool SHX, int PROBE>
+void launch(const at::Tensor& X0, const at::Tensor& X1, const at::Tensor& T0, const at::Tensor& T1,
+            const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, const half* sv0,
+            const half* sv1, const half* sd, half* xd, float* y, int K, int N, int slots, float limit, bool ticket,
+            bool pair) {
+    using C = Cfg<MATS, MTL, NG, KS, NSA, NGR, SHX>;
+    auto kern = expert_kernel<MATS, MTL, NG, KS, NSA, NGR, SHX, PROBE>;
+    static int per_sm = 0;
+    if (per_sm == 0) {
+        C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)C::SMEM));
+        C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, kern, C::THREADS, C::SMEM));
+        TORCH_CHECK(per_sm > 0, "once experts: the configuration does not fit an SM");
+    }
+    const int maxu = (int)uids.size(0), maxm = (int)members.size(1);
+    TORCH_CHECK(maxu <= fast2::MAXU, "too many distinct experts");
+    TORCH_CHECK((K / 16) % KS == 0 && N % 128 == 0, "once experts: K % (16 KS), N % 128");
+    auto stream = at::cuda::getCurrentCUDAStream();
+    at::Tensor plan = at::zeros({2 * maxu + 3}, uids.options());
+    plan_kernel<<<1, fast2::MAXU, 0, stream>>>(uids.data_ptr<int>(), ucount.data_ptr<int>(), members.data_ptr<int>(),
+                                               maxu, maxm, (int)T0.size(0), C::BM, N / 128, pair ? 1 : 0,
+                                               plan.data_ptr<int>());
+    const int sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+    kern<<<sms * per_sm, C::THREADS, C::SMEM, stream>>>(
+        reinterpret_cast<const half*>(X0.data_ptr()), reinterpret_cast<const half*>(X1.data_ptr()),
+        reinterpret_cast<const uint32_t*>(T0.data_ptr()), reinterpret_cast<const uint32_t*>(T1.data_ptr()),
+        uids.data_ptr<int>(), members.data_ptr<int>(), plan.data_ptr<int>(),
+        ticket ? plan.data_ptr<int>() + 2 * maxu + 2 : nullptr, K, N, maxm, slots, maxu, pair ? 1 : 0, sv0, sv1, sd, xd,
+        y, limit);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// (MTL, NG, KS, NSA, NGR) a half: fat's tilings (the same bits whatever the choice). Gate/up with its own up input
+// takes 2-k-tile stages (two row matrices a stage would not fit with 4).
+#define ONCE_GU_SHX 2, 8, 4, 3, 4
+#define ONCE_GU_OWN 2, 8, 2, 3, 4
+#define ONCE_DN 2, 8, 4, 3, 8
+#define ONCE_DN_LARGE 2, 16, 2, 3, 8
+
+}  // namespace once
+
 constexpr int GATEUP_KS = 2;     // 2 matrices x 2 k tiles x 8 n tiles a slab (one row a warp): 16 KB a buffer
 constexpr int DOWN_KS = 4;       // 1 matrix x 4 k tiles x 8 n tiles (one row a warp): 16 KB a buffer
 
@@ -1105,3 +1482,50 @@ void exl3_rot_in1_cuda(const at::Tensor& x, int64_t x_stride, const at::Tensor&
         (int)items);
     C10_CUDA_KERNEL_LAUNCH_CHECK();
 }
+
+// patches/0260: the once variant of exl3_fat_gateup_cuda / exl3_fat_down_cuda (same arguments and outputs, same bits;
+// ``pair``: two passes of an expert share a decode (0: every unit is two column blocks of one pass); ``probe``: timing
+// only, 1 = no trellis decode, 2 = no mma -- the outputs are then garbage).
+void exl3_once_gateup_cuda(const at::Tensor& XG, const at::Tensor& XU, const at::Tensor& TG, const at::Tensor& TU,
+                           const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members,
+                           const at::Tensor& svh_g, const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor& xd,
+                           int64_t K, int64_t N, int64_t slots, double limit, bool shared_x, bool ticket, bool pair,
+                           int64_t probe) {
+    TORCH_CHECK(N % 128 == 0 && K % 64 == 0, "once gate/up: N % 128, K % 64");
+    TORCH_CHECK(probe >= 0 && probe <= 2 && (probe == 0 || shared_x), "once gate/up: probe 0-2 (with the shared input)");
+    const half* sg = reinterpret_cast<const half*>(svh_g.data_ptr());
+    const half* su = reinterpret_cast<const half*>(svh_u.data_ptr());
+    const half* sd = reinterpret_cast<const half*>(suh_d.data_ptr());
+    half* o = reinterpret_cast<half*>(xd.data_ptr());
+#define ONCE_GU_LAUNCH(CFG, SHX, PROBE)                                                                             \
+    once::launch<2, CFG, SHX, PROBE>(XG, SHX ? XG : XU, TG, TU, uids, ucount, members, sg, su, sd, o, nullptr,      \
+                                     (int)K, (int)N, (int)slots, (float)limit, ticket, pair)
+    if (!shared_x) ONCE_GU_LAUNCH(ONCE_GU_OWN, false, 0);
+    else if (probe == 1) ONCE_GU_LAUNCH(ONCE_GU_SHX, true, 1);
+    else if (probe == 2) ONCE_GU_LAUNCH(ONCE_GU_SHX, true, 2);
+    else ONCE_GU_LAUNCH(ONCE_GU_SHX, true, 0);
+#undef ONCE_GU_LAUNCH
+}
+
+void exl3_once_down_cuda(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+                         const at::Tensor& members, const at::Tensor& svh_d, at::Tensor& y, int64_t K, int64_t N,
+                         int64_t slots, bool ticket, bool pair, int64_t probe) {
+    TORCH_CHECK(N % 128 == 0 && K % 64 == 0, "once down: N % 128, K % 64");
+    TORCH_CHECK(probe >= 0 && probe <= 2, "once down: probe 0-2");
+    const half* sv = reinterpret_cast<const half*>(svh_d.data_ptr());
+    float* out = y.data_ptr<float>();
+    const bool large = members.size(1) >= 4096;       // fast2's switch (same bits either way)
+#define ONCE_DN_LAUNCH(CFG, PROBE)                                                                                  \
+    once::launch<1, CFG, false, PROBE>(XD, XD, TD, TD, uids, ucount, members, sv, sv, sv, nullptr, out, (int)K,     \
+                                       (int)N, (int)slots, 0.f, ticket, pair)
+    if (large) {
+        if (probe == 1) ONCE_DN_LAUNCH(ONCE_DN_LARGE, 1);
+        else if (probe == 2) ONCE_DN_LAUNCH(ONCE_DN_LARGE, 2);
+        else ONCE_DN_LAUNCH(ONCE_DN_LARGE, 0);
+    } else {
+        if (probe == 1) ONCE_DN_LAUNCH(ONCE_DN, 1);
+        else if (probe == 2) ONCE_DN_LAUNCH(ONCE_DN, 2);
+        else ONCE_DN_LAUNCH(ONCE_DN, 0);
+    }
+#undef ONCE_DN_LAUNCH
+}
