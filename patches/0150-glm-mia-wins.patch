+patches/0150: GLM53_TF_EFFORT_FIELD=1 honours OpenAI's top-level ``reasoning_effort`` (``none`` / ``minimal``: thinking
+off; ``low``: the template's Low effort; ``medium`` / ``high``: High; ``max`` / ``xhigh``: the template default, Max) by
+filling ``chat_template_kwargs`` where the request left them unset, and GLM53_TF_DEFAULT_EFFORT (``low`` | ``high`` |
+``max``) is the effort of a thinking request that names none. For structured output (long tables, JSON with many
+numbers), thinking on at ``low`` effort is the reliable setting: the MiaAI-Lab kit measured 0/6 garbled and 791/792
+numbers right against 5-6/6 garbled with thinking off (their PR #279).
+
 With thinking off, a chat renders the way GLM-5.3's thinking-off template does: the checkpoint's template always
 opens a think block, so it gets an empty ``<think></think>`` and no reasoning-effort line.
 """
 
 from __future__ import annotations
 
+import os
 from typing import Any, Callable
 
 from tensorfold.cuda.server import App
 
+# patches/0150: OpenAI ``reasoning_effort`` -> (enable_thinking, the template's reasoning_effort or None: its default)
+EFFORTS: dict[str, tuple[bool, str | None]] = {
+    "none": (False, None), "minimal": (False, None), "low": (True, "low"), "medium": (True, "high"),
+    "high": (True, "high"), "xhigh": (True, None), "max": (True, None)}
+
+
+def effort_env() -> tuple[bool, str | None]:
+    """(GLM53_TF_EFFORT_FIELD on, GLM53_TF_DEFAULT_EFFORT or None), validated."""
+
+    field = os.environ.get("GLM53_TF_EFFORT_FIELD", "0").strip() or "0"
+    if field not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_EFFORT_FIELD={field!r}: expected 0 or 1")
+    default = os.environ.get("GLM53_TF_DEFAULT_EFFORT", "").strip().lower() or None
+    if default not in (None, "low", "high", "max"):
+        raise ValueError(f"GLM53_TF_DEFAULT_EFFORT={default!r}: expected low, high or max")
+    return field == "1", (None if default == "max" else default)
+
+
+def apply_effort(body: dict[str, Any], *, field: bool, default: str | None, default_thinking: bool) -> str | None:
+    """Fill ``body["chat_template_kwargs"]`` from ``reasoning_effort`` (with ``field``) and ``default``; keys the
+    request set itself win. Idempotent (``check`` and ``run`` both call it). Returns an error message, or None."""
+
+    kwargs = body.get("chat_template_kwargs")
+    if kwargs is not None and not isinstance(kwargs, dict):
+        return None                                     # left for the template to reject as before
+    kwargs = dict(kwargs or {})
+    asked = body.get("reasoning_effort") if field else None
+    if asked is not None:
+        key = str(asked).strip().lower()
+        if key not in EFFORTS:
+            return f"reasoning_effort must be one of {', '.join(EFFORTS)} (got {asked!r})"
+        thinking, effort = EFFORTS[key]
+        kwargs.setdefault("enable_thinking", thinking)
+        if thinking and effort is not None:
+            kwargs.setdefault("reasoning_effort", effort)
+    elif default is not None and bool(kwargs.get("enable_thinking", default_thinking)):
+        kwargs.setdefault("reasoning_effort", default)
+    if kwargs or "chat_template_kwargs" in body:
+        body["chat_template_kwargs"] = kwargs
+    return None
+
 
 class ThinkingOffTemplate:
     """The checkpoint's chat template, rendered as GLM-5.3's thinking-off template renders it when thinking is off."""
