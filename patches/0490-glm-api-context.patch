+def pool_tokens(tokens: int, page: int, capacity: int, limit: int | None = None) -> int:
+    """patches/0490: the pool's size in tokens. A pool set to hold a whole request (``tokens`` >= the context limit)
+    grows to the slot capacity rounded up to a page (limit + the verify window's rows: the most ``need_tokens`` asks
+    for), so every request the context check lets through is admissible on an otherwise free pool; before, one within
+    64 tokens of CONTEXT was refused as "more than the whole pool". One page more at most; which page holds a row never
+    changes a bit. A smaller pool (``tokens`` < limit) stays as set."""
+
+    if tokens and limit is not None and tokens >= limit:
+        return max(int(tokens), pages_for(capacity, page) * page)
+    return int(tokens)
