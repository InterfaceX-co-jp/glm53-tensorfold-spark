+          else "per-head K/V (GLM53_TF_LATENT_KV=0, ~390 KB a token a rank)")
+    batch = getattr(engine, "batch", None)
+    slots = int(getattr(batch, "n", 1) or 1) if batch is not None else 1
+    pool = getattr(batch, "kvp", None) if batch is not None else None
+    line = (f"context: {limit} tokens a request (max_model_len; set by CONTEXT / --context); KV cache: {kv}; "
+            f"{slots} request slot(s)")
+    if pool is not None:
+        line += f"; KV pool: {pool.npages * pool.page} tokens shared by the slots"
+    if isinstance(limit, int) and limit <= 65536:
+        line += (f". Requests past {limit} tokens (prompt + max_tokens) get HTTP 400 context_length_exceeded; for "
+                 "long context start with a long-context config (config/prod.env.example: CONTEXT=1048576)")
+    return line
