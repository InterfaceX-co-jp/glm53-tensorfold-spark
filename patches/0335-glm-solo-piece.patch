diff --git a/src/tensorfold/families/glm5_next/cuda/batchplan.py b/src/tensorfold/families/glm5_next/cuda/batchplan.py
index 4187b53..16e1aa8 100644
--- a/src/tensorfold/families/glm5_next/cuda/batchplan.py
+++ b/src/tensorfold/families/glm5_next/cuda/batchplan.py
@@ -127,6 +127,16 @@ def piece_end(done: int, n: int, piece: int, grid: int) -> int:
     return n if n - done <= step else done + step
 
 
+def solo_piece(solo: int, piece: int, grid: int, others: Sequence[int]) -> int:
+    """patches/0335 (GLM53_TF_SOLO_PIECE): the piece size for a prompt's next piece: ``solo`` when it is set, the
+    prefill is fast (``grid`` > 0) and no other slot holds a request (``others``: those slots), else ``piece``
+    (GLM53_TF_BATCH_PIECE). Decided when the piece is cut, from the slots both ranks hold alike, so a request admitted
+    in this round's plan makes its neighbours' next pieces normal ones. Any cut gives the same bits (pieces end on the
+    snapshot grid; resumed == fresh)."""
+
+    return solo if solo and grid and not others else piece
+
+
 def piece_grid(chunk: int, snap_grid: int) -> int:
     """patches/0180: the bound fast pieces end on: a multiple of the chunk grid C and of the snapshot grid G (a piece
     must end where its prefill takes the snapshot the next piece resumes from). G = 64 (default): C itself."""
