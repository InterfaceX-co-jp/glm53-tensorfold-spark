index 0000000..11421e4
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/b12xpf.py
@@ -0,0 +1,110 @@
+"""b12x-derived fast-prefill kernels for GLM-5.3-Flash (patches/0240): the switch, its snapshot tag bits, its load checks.
+
+Three kernels ported from the ideas of b12x (https://github.com/local-inference-lab/b12x, Apache License 2.0,
+Copyright Luke Alonso and the b12x contributors; see NOTICE), each re-implemented in Triton for this engine and each
+behind one bit of ``tf_knobs.b12x`` (default: GLM53_TF_B12X, 0 = off):
+
+    bit 1  ``b12x_mhc``   hyper-connections: the next hc_pre's 24 mixing dots and square sums split by column blocks
+                          of all four streams, on tensor cores, and in patches/0084's slabs fused with hc_post (one
+                          launch and one read of the new streams less a site)
+    bit 2  ``b12x_kda``   KDA: 16-row tiles, the tile preparation and the recurrence in one program per (head, block
+                          of value rows), fp32 state on chip, no workspace (``fast_kda`` writes and re-reads ~94 MB of
+                          fp32 scratch a 1,024-row call)
+    bit 4  ``b12x_attn``  sparse latent attention: one online softmax over a row's whole token list (no 512-token
+                          chunk partials, no merge); latent KV engines only
+
+Every bit is NEW ARITHMETIC for fast chunks only (decode, verify, the MTP head, DFlash2 and exact prefill never run
+them), deterministic and row-independent (patches/0085's rules: fixed shapes and reduction orders, no atomics, the KDA
+tiles at absolute multiples of 16 inside the 64-aligned fast calls), so drafted == serial and resumed == fresh hold
+within each setting. A fast prefill's snapshot tag gets 4 x (the effective bits) (``pfgrid.tag``), so a request only
+resumes snapshots made with the same kernels; fast requests with other bits, exact requests, FP8 and
+GLM53_TF_LATENT_TC snapshots never mix with them.
+
+Per request through patches/0090's header (``tf_knobs.b12x``, both ranks set it from rank 0's header). What decides the
+kernels' bits beyond the bits themselves (``b12x_kda.PREC`` / ``BV`` / ``WARPS``: GLM53_TF_B12X_KDA_PREC, _BV, _WARPS) is
+load-time and checked equal on both ranks (``load_settings``). Nothing here imports torch.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+ENV = "GLM53_TF_B12X"
+MHC, KDA, ATTN = 1, 2, 4
+ALL = MHC | KDA | ATTN
+
+# what the next prefill runs (engine._set_knobs switches it per request)
+BITS = 0
+
+
+def default() -> int:
+    raw = os.environ.get(ENV, "").strip()
+    if not raw:
+        return 0
+    try:
+        v = int(raw)
+    except ValueError:
+        raise ValueError(f"{ENV}={raw!r}: expected 0 to {ALL}") from None
+    if not 0 <= v <= ALL:
+        raise ValueError(f"{ENV}={raw!r}: expected 0 to {ALL} (1 hyper-connections, 2 KDA, 4 sparse attention)")
+    return v
+
+
+def _mod(name: str):
+    return sys.modules.get(f"{__package__}.{name}") if __package__ else None
+
+
+def set_bits(v: int) -> None:
+    """Switch the kernels for the next prefills (both ranks do it from the header's value)."""
+
+    global BITS
+    v = int(v)
+    if not 0 <= v <= ALL:
+        raise ValueError(f"tf_knobs.b12x={v}: expected 0 to {ALL}")
+    BITS = v
+    for name, attr, bit in (("glue", "MHC", MHC), ("latent", "SPARSE_ONE", ATTN)):
+        mod = _mod(name)
+        if mod is None and v & bit:
+            try:
+                import importlib
+
+                mod = importlib.import_module(f"{__package__}.{name}")
+            except Exception:            # noqa: BLE001 - host fakes without torch / triton: nothing to switch
+                mod = None
+        if mod is not None:
+            setattr(mod, attr, bool(v & bit))
+
+
+def kda_on() -> bool:
+    return bool(BITS & KDA)
+
+
+def effective(bits: int, w=None) -> int:
+    """The bits that change a fast prefill on this engine: the sparse kernel only runs on the latent cache (host
+    fakes without ``w.meta`` keep every bit)."""
+
+    meta = getattr(w, "meta", None)
+    if isinstance(meta, dict) and not meta.get("latent_kv"):
+        bits &= ~ATTN
+    return bits & ALL
+
+
+def tag_bits(w=None, bits: int | None = None) -> int:
+    return effective(BITS if bits is None else int(bits), w)
+
+
+def load_settings() -> list[int]:
+    """What both ranks must agree on at load (the KDA kernel's precision and value block decide its bits)."""
+
+    try:
+        from . import b12x_kda
+    except Exception:                    # noqa: BLE001 - host fakes without torch / triton
+        return [-1, -1, -1]
+    return b12x_kda.settings()
+
+
+def describe(v: int | None = None) -> str:
+    v = BITS if v is None else v
+    parts = [n for b, n in ((MHC, "hc"), (KDA, "kda"), (ATTN, "sparse")) if v & b]
+    return ",".join(parts) or "off"
