diff --git c/src/tensorfold/families/glm5_next/cuda/b12x_attn.py i/src/tensorfold/families/glm5_next/cuda/b12x_attn.py
new file mode 100644
index 0000000..b1fa1fb
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/b12x_attn.py
@@ -0,0 +1,92 @@
+"""One-pass sparse latent attention for fast-prefill chunks (patches/0240, ``tf_knobs.b12x`` bit 4).
+
+The structure follows b12x's sparse MLA prefill (https://github.com/local-inference-lab/b12x,
+``b12x/attention/sparse_mla``, Apache License 2.0, Copyright Luke Alonso and the b12x contributors): one program per
+query row holding all of the row's local heads, one online softmax over the row's whole selected-token list in list
+order, the normalized latent written directly -- no split of the ~2,051 selected tokens into 512-token chunks, so no
+fp32 chunk partials ([5, R, H, 512], ~335 MB written and read back a 1,024-row call) and no merge kernel. Re-implemented
+in Triton on this engine's latent tiles (``latent._lrows`` / ``latent._ltile``: bf16 or FP8 rows dequantized exactly,
+bf16 tensor-core scores and weighted sums, fp32 online softmax); b12x's FP8 query quantization and FP8 P.V are NOT
+taken (they change the arithmetic much more).
+
+Arithmetic: ``latent.sparse_latent``'s tile steps in the same list order, the same scale and masks, the running
+(m, l, o) carried across what were chunk boundaries instead of being merged at the end: the result differs from the
+chunked kernel's in the last fp32 bits of u (the merge's exp(m_c - m) rescaling is gone). Deterministic, one program
+per (row, head tile) whatever the call's rows (row-independent); fast chunks only (decode, verify, the MTP head and
+exact prefill keep the chunked kernels); new arithmetic, so its fast snapshots carry their own tag (``b12xpf``).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from .latent import CHUNK, KT, SCALE_AT, _lrows, _ltile, _views
+
+BM = 32           # (row, head) queries a program: all 32 local heads of a row (one gather of its latent rows)
+STAGES = 1        # software pipelining of the key loop (no effect on bits); 2 needs ~64 KB more shared memory
+WARPS = 8
+
+
+@triton.jit
+def _lsparse_one(QA, LC, LCS, TOK, CNT, OUT, W: tl.constexpr, H: tl.constexpr, L: tl.constexpr, KTS: tl.constexpr,
+                 SCALE: tl.constexpr, BMQ: tl.constexpr, FP8: tl.constexpr = False, RB: tl.constexpr = 0,
+                 SB: tl.constexpr = 0, SA: tl.constexpr = 0):
+    """Program (row r, head tile): the row's n selected tokens in list order, one online softmax, OUT = o / l."""
+
+    r = tl.program_id(0)
+    hb = tl.program_id(1)
+    n = tl.load(CNT + r)
+    if n > 0:
+        h = hb * BMQ + tl.arange(0, BMQ)
+        hok = h < H
+        d = tl.arange(0, L)
+        m = tl.full((BMQ,), float("-inf"), tl.float32)
+        l = tl.zeros((BMQ,), tl.float32)
+        o = tl.zeros((BMQ, L), tl.float32)
+        q = tl.load(QA + (r * H + h[:, None]) * L + d[None, :], mask=hok[:, None], other=0).to(tl.bfloat16)
+        for t in range(0, tl.cdiv(n, KTS)):
+            idx = t * KTS + tl.arange(0, KTS)
+            ok = idx < n
+            tok = tl.load(TOK + r * W + idx, mask=ok, other=0).to(tl.int64)
+            kv = _lrows(LC, LCS, tok, ok, d, FP8, RB, SB, SA)
+            valid = ok[None, :] & hok[:, None]
+            m, l, o = _ltile(q, kv, m, l, o, valid, SCALE)
+        tl.store(OUT + (r * H + h[:, None]).to(tl.int64) * L + d[None, :], o / l[:, None], mask=hok[:, None])
+
+
+def sparse_latent_one(qa: torch.Tensor, lc: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor,
+                      out: torch.Tensor, scale: float, *, bm: int | None = None, stages: int | None = None) -> None:
+    """``latent.sparse_latent``'s contract (rows with counts > 0 written into ``out`` [R, H, L] fp32, other rows
+    untouched), in one pass a row."""
+
+    R, H, L = qa.shape
+    if R == 0:
+        return
+    W = tokens.shape[1]
+    if not qa.is_contiguous() or not tokens.is_contiguous() or out.shape != (R, H, L) or not out.is_contiguous():
+        raise ValueError("sparse_latent_one: contiguous qa [R, H, L], tokens [R, W] and out [R, H, L] expected")
+    bm = (BM if H >= BM else 16) if bm is None else int(bm)
+    lcv, lcs, f8, rb, sb = _views(lc, L)
+    _lsparse_one[(R, triton.cdiv(H, bm))](qa, lcv, lcs, tokens, counts, out, W=W, H=H, L=L, KTS=KT, SCALE=scale,
+                                          BMQ=bm, FP8=f8, RB=rb, SB=sb, SA=SCALE_AT // 4, num_warps=WARPS,
+                                          num_stages=STAGES if stages is None else int(stages))
+
+
+def reference(qa: torch.Tensor, lat: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor, scale: float):
+    """float64 softmax attention of every (row, head) over its selected latent rows (tests): [R, H, L]."""
+
+    R, H, L = qa.shape
+    out = torch.zeros((R, H, L), dtype=torch.float64, device=qa.device)
+    for r in range(R):
+        n = int(counts[r])
+        if n == 0:
+            continue
+        kv = lat[tokens[r, :n].long()].double()
+        s = qa[r].double() @ kv.T * scale
+        out[r] = torch.softmax(s, dim=-1) @ kv
+    return out
+
+
+assert CHUNK % KT == 0
diff --git c/src/tensorfold/families/glm5_next/cuda/b12x_kda.py i/src/tensorfold/families/glm5_next/cuda/b12x_kda.py
new file mode 100644
index 0000000..048dcde
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/b12x_kda.py
@@ -0,0 +1,261 @@
+"""KDA prefill in 16-row tiles, one fused program per (head, block of value rows) (patches/0240, ``tf_knobs.b12x`` bit 2).
+
+Derived from the chunked lower-bounded KDA prefill of b12x (https://github.com/local-inference-lab/b12x,
+``b12x/sequence/kda_prefill`` and ``b12x/sequence/_shared/delta_prefill``, Apache License 2.0, Copyright Luke Alonso
+and the b12x contributors): its 16-token chunk, its per-tile operands (q~ = q e^G, k~ = k e^G, k_inv = k e^-G,
+k_r = k e^(G_C - G), lambda_C = e^G_C, the strictly lower L = beta k~ k_inv^T, the Neumann-product inverse (I + L)^-1
+and the causal q~ k_inv^T) and its recurrence with the fp32 state held on chip while a program walks its tiles.
+Re-implemented in Triton for this engine (no b12x code is used): the prologue (conv + SiLU, L2 norms, decay, beta) is
+this engine's (``fast_kda``), the tile preparation runs inside the recurrence program (no workspace, no second
+kernel, no window pipeline), the operands of the large products are fp32 at tf32 precision by default (b12x rounds
+them and a shadow of the state to bf16; ``PREC`` = "bf16" does that), and tiles sit at ABSOLUTE multiples of 16.
+
+Per tile of 16 rows at absolute positions T .. T + 15 (rows past the call's end are identity steps: k = q = v = 0,
+beta = 0, decay 1), per head, with G the in-tile cumulative log decay (per key channel; G_t <= 0, > 16 lower):
+
+    L    = strict_lower(beta_t k~_t . k_inv_s)                    [16, 16]   (fp32 FMA dots, "ieee")
+    Minv = (I - L)(I + L^2)(I + L^4)(I + L^8) = (I + L)^-1        (L is nilpotent of index <= 16)
+    Mqk  = lower_incl(q~_t . k_inv_s)                             [16, 16]
+    V'   = beta (V - k~ S^T)                                      [16, BV]   (S: [BV value rows, 128 keys], fp32)
+    U    = Minv V'                                                [16, BV]
+    O    = q~ S^T + Mqk U  -> bf16 (then the gated RMSNorm, ``fast_kda._kda_norm``)
+    S   <- S diag(lambda_C) + U^T k_r
+
+which is the delta rule S'_t = S_{t-1} diag(e^{gl_t}), e_t = beta_t (v_t - S'_t k_t), S_t = S'_t + e_t k_t^T,
+o_t = S_t q_t unrolled over the tile (``fast_kda``'s derivation with a 16-row chunk; U is its E).
+
+Magnitudes: k_inv carries e^{-G} <= e^{16 |lower|}, so the tile is safe in fp32 / tf32 / bf16 exponents for
+|lower| <= ``MAX_ABS_LOWER`` (GLM-5.3: 5.0, e^80 ~ 5.5e34 and every product of the dots stays below e^75); other
+models fall back to ``fast_kda``.
+
+Exactness rules (patches/0085): deterministic (fixed shapes, fixed reduction orders, no atomics); a row's bits depend
+only on its 16-row tile's rows and the fp32 state entering the tile (the triangular structure: a valid row t reads
+rows <= t of its tile, and padded rows contribute exact zeros), and every fast call starts at a multiple of 64, so
+the only partial tile is a prompt's last one, the same in every schedule; the state handed between calls is the
+fp32 value the program keeps. NOT bit-identical to ``fast_kda`` (64-row blocks, other factorization) nor to the
+serial chain: new arithmetic, so its fast snapshots carry their own tag (``b12xpf``).
+
+Cost model (per 1024 rows x 32 heads, estimated, not measured): no workspace (``fast_kda`` writes and re-reads ~94 MB
+of fp32 scratch a call, which is what bounds it at ~1.8 ms); the inputs (~48 KB a row) are read once from DRAM and
+re-read from L2 by the 128 / BV value blocks of a head; 64 sequential tile steps a program.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from .fast_kda import _conv_act, _kda_norm
+
+DK = DV = 128
+TILE = 16
+MAX_ABS_LOWER = 5.3                   # e^{16 |lower|} stays < 2^127 with the 128-term dot sums (see the docstring)
+PREC = os.environ.get("GLM53_TF_B12X_KDA_PREC", "tf32").strip().lower() or "tf32"   # "tf32" | "tf32x3" | "ieee" | "bf16"
+BV = int(os.environ.get("GLM53_TF_B12X_KDA_BV", "64") or 64)      # value rows of the state a program holds
+WARPS = int(os.environ.get("GLM53_TF_B12X_KDA_WARPS", "4") or 4)    # 255 registers: 2 programs an SM at 4 warps
+STAGES = int(os.environ.get("GLM53_TF_B12X_KDA_STAGES", "1") or 1)
+
+
+def settings() -> list[int]:
+    """What decides this kernel's bits, for the load-time check that both ranks agree (``b12xpf.load_settings``): the
+    precision, the value block and the warps (Triton's layouts, hence the order of the norms' and the scan's sums,
+    follow the shapes and the warp count)."""
+
+    return [("tf32", "tf32x3", "ieee", "bf16").index(PREC) if PREC in ("tf32", "tf32x3", "ieee", "bf16") else -1, BV,
+            WARPS]
+
+
+@triton.jit
+def _k16(P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, S_IN, S_OUT, OUT, lower, R, off, NT,
+         H: tl.constexpr, BV: tl.constexpr, PREC: tl.constexpr, B16: tl.constexpr):
+    """Program (head h, value block jb): the call's 16-row tiles in order, state rows j = jb BV .. + BV - 1 on chip."""
+
+    h = tl.program_id(0)
+    jb = tl.program_id(1)
+    C: tl.constexpr = 3 * H * 128
+    l = tl.arange(0, 16)
+    i = tl.arange(0, 128)
+    j = jb * BV + tl.arange(0, BV)
+    decay_rate = tl.exp(tl.load(A_LOG + h))
+    dtb = tl.load(DT_BIAS + h * 128 + i)
+    sptr = h.to(tl.int64) * (128 * 128) + j[:, None] * 128 + i[None, :]
+    s = tl.load(S_IN + sptr)                                             # [BV, 128] fp32: s[h, value j, key i]
+    strict = l[None, :] < l[:, None]                                     # [t, s]: s < t
+    incl = l[None, :] <= l[:, None]
+    eye = tl.where(l[:, None] == l[None, :], 1.0, 0.0)
+    last = l == 15
+    for t in range(NT):
+        row = t * 16 - off + l
+        valid = (row >= 0) & (row < R)
+        rowc = tl.where(valid, row, 0).to(tl.int64)
+        # -- the rows' inputs (``fast_kda._kda_prep``'s prologue: the chain kernel's arithmetic) -------------------
+        qa = _conv_act(P, p_stride, CS, CW, row, valid, h * 128 + i, C)
+        ka = _conv_act(P, p_stride, CS, CW, row, valid, H * 128 + h * 128 + i, C)
+        va = _conv_act(P, p_stride, CS, CW, row, valid, 2 * H * 128 + h * 128 + j, C)     # this block's values only
+        qinv = 1.0 / tl.sqrt(tl.sum(qa * qa, axis=1) + 1e-6)
+        kinv = 1.0 / tl.sqrt(tl.sum(ka * ka, axis=1) + 1e-6)
+        q = tl.where(valid[:, None], (qa * qinv[:, None]) * (1.0 / tl.sqrt(128.0)), 0.0)
+        k = tl.where(valid[:, None], ka * kinv[:, None], 0.0)
+        v = tl.where(valid[:, None], va, 0.0)
+        araw = tl.load(A + rowc[:, None] * a_stride + h * 128 + i[None, :], mask=valid[:, None], other=0.0)
+        z = decay_rate * (araw.to(tl.float32) + dtb[None, :])
+        gl = tl.where(valid[:, None], lower * (1.0 / (1.0 + tl.exp(-z))), 0.0)
+        braw = tl.load(P + rowc * p_stride + b_off + h, mask=valid, other=0.0).to(tl.float32)
+        beta = tl.where(valid, (1.0 / (1.0 + tl.exp(-braw))).to(tl.bfloat16).to(tl.float32), 0.0)
+        # -- the tile's operands (b12x's preparation) ----------------------------------------------------------------
+        g = tl.cumsum(gl, axis=0)                                        # [16, 128], G_t (<= 0)
+        gc = tl.sum(tl.where(last[:, None], g, 0.0), axis=0)             # G_C (the tile's last row; padding adds 0)
+        kt = k * tl.exp(g)                                               # k~
+        kv = k * tl.exp(-g)                                              # k_inv
+        qt = q * tl.exp(g)                                               # q~ (the 128^-0.5 is in q)
+        kr = k * tl.exp(gc[None, :] - g)                                 # k_r
+        lam = tl.exp(gc)                                                 # lambda_C
+        lm = tl.dot(kt, tl.trans(kv), input_precision="ieee")
+        lm = tl.where(strict, lm * beta[:, None], 0.0)
+        mqk = tl.dot(qt, tl.trans(kv), input_precision="ieee")
+        mqk = tl.where(incl, mqk, 0.0)
+        minv = eye - lm
+        pw = tl.dot(lm, lm, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        pw = tl.dot(pw, pw, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        pw = tl.dot(pw, pw, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        # -- the recurrence ------------------------------------------------------------------------------------------
+        if B16:                                                          # b12x's policy: bf16 operands, fp32 master
+            sb = s.to(tl.bfloat16)
+            ks = tl.dot(kt.to(tl.bfloat16), tl.trans(sb))
+            vp = (v - ks) * beta[:, None]
+            u = tl.dot(minv.to(tl.bfloat16), vp.to(tl.bfloat16))
+            ub = u.to(tl.bfloat16)
+            o = tl.dot(qt.to(tl.bfloat16), tl.trans(sb)) + tl.dot(mqk.to(tl.bfloat16), ub)
+            upd = tl.dot(tl.trans(ub), kr.to(tl.bfloat16))
+        else:
+            ks = tl.dot(kt, tl.trans(s), input_precision=PREC)
+            vp = (v - ks) * beta[:, None]
+            u = tl.dot(minv, vp, input_precision="ieee")
+            o = tl.dot(qt, tl.trans(s), input_precision=PREC) + tl.dot(mqk, u, input_precision="ieee")
+            upd = tl.dot(tl.trans(u), kr, input_precision=PREC)
+        tl.store(OUT + rowc[:, None] * (H * 128) + h * 128 + j[None, :], o.to(tl.bfloat16), mask=valid[:, None])
+        s = s * lam[None, :] + upd
+    tl.store(S_OUT + sptr, s)
+
+
+def supported(lower: float, heads: int | None = None) -> bool:
+    """The 16-row tile is safe in fp32 for this lower bound (GLM-5.3: -5.0) and the value blocks divide 128."""
+
+    return math.isfinite(lower) and abs(lower) <= MAX_ABS_LOWER and DV % BV == 0 and BV >= 16
+
+
+def kda_prefill16(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_state: torch.Tensor,
+                  conv_w: torch.Tensor, state_in: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor,
+                  norm_w: torch.Tensor, eps: float, lower: float, rows: int, scratch=None,
+                  state_out: torch.Tensor | None = None, *, pos: int, out: torch.Tensor | None = None,
+                  bv: int | None = None, prec: str | None = None, num_warps: int | None = None,
+                  num_stages: int | None = None) -> torch.Tensor:
+    """``kda.chain``'s contract (``fast_kda.kda_prefill_chunked``'s arguments), 16-row tiles at absolute multiples of 16
+    of ``pos``. Writes the gated-RMSNorm rows (``scratch.out[:rows]``, ``out`` or a new [rows, H*128] bf16 tensor) and
+    the fp32 state after the last row into ``state_out`` (required; may be ``state_in``). The conv state is not
+    advanced (``forward.commit`` does it, as for ``kda.chain``); no replay inputs are written (a fast prefill keeps
+    every row). ``bv`` / ``prec`` / warps / stages: tests and the micro-benchmark (the defaults decide the bits)."""
+
+    H = int(a_log.numel())
+    bv = BV if bv is None else int(bv)
+    prec = PREC if prec is None else prec
+    if state_out is None:
+        raise ValueError("kda_prefill16: state_out is required")
+    if not (math.isfinite(lower) and abs(lower) <= MAX_ABS_LOWER):
+        raise ValueError(f"kda_prefill16: |lower| = {abs(lower)} > {MAX_ABS_LOWER} (use fast_kda)")
+    if bv not in (16, 32, 64, 128):
+        raise ValueError("kda_prefill16: bv must be 16, 32, 64 or 128")
+    if prec not in ("tf32", "tf32x3", "ieee", "bf16"):
+        raise ValueError(f"kda_prefill16: precision {prec!r}")
+    if rows < 1 or p.shape[0] < rows or a.shape[0] < rows or g.shape[0] < rows:
+        raise ValueError("kda_prefill16: rows")
+    if p.stride(1) != 1 or a.stride(1) != 1 or g.stride(1) != 1:
+        raise ValueError("kda_prefill16: unit column strides expected")
+    if p.dtype != torch.bfloat16 or a.dtype != torch.bfloat16 or g.dtype != torch.bfloat16:
+        raise ValueError("kda_prefill16: bf16 projection/gate rows expected")
+    if not (conv_state.is_contiguous() and conv_w.is_contiguous() and state_in.is_contiguous()
+            and state_out.is_contiguous()):
+        raise ValueError("kda_prefill16: conv state, conv weight and states must be contiguous")
+    if state_in.numel() != H * DK * DV or state_out.numel() != H * DK * DV or state_in.dtype != torch.float32:
+        raise ValueError("kda_prefill16: states must be fp32 [H, 128, 128]")
+    if conv_w.shape[0] != 3 * H * DK or conv_w.shape[1] != 4:
+        raise ValueError("kda_prefill16: conv weight [3*H*128, 4] expected")
+    if scratch is not None:
+        o = scratch.out[:rows]
+    elif out is not None:
+        o = out[:rows]
+    else:
+        o = torch.empty((rows, H * DV), dtype=torch.bfloat16, device=p.device)
+    if o.shape != (rows, H * DV) or not o.is_contiguous():
+        raise ValueError("kda_prefill16: out must be a contiguous [rows, H*128] bf16")
+    off = int(pos) % TILE
+    nt = -(-(off + rows) // TILE)
+    b16 = prec == "bf16"
+    _k16[(H, DV // bv)](p, p.stride(0), int(b_off), a, a.stride(0), conv_state, conv_w, a_log, dt_bias, state_in,
+                        state_out, o, float(lower), int(rows), off, nt, H=H, BV=bv,
+                        PREC="tf32" if b16 else prec, B16=b16,
+                        num_warps=WARPS if num_warps is None else num_warps,
+                        num_stages=STAGES if num_stages is None else num_stages)
+    _kda_norm[(triton.cdiv(rows, 32), H)](o, g, g.stride(0), norm_w, float(eps), int(rows), H=H, BR=32, num_warps=4)
+    return o
+
+
+# -- reference (tests): the tile algorithm in torch fp64 / fp32 -----------------------------------------------------
+def tile_reference(p, b_off, a, g, conv_state, conv_w, state_in, a_log, dt_bias, norm_w, eps, lower, rows, pos,
+                   dtype=torch.float64):
+    """The same 16-row tile algorithm in torch (``dtype`` math, the kernel's bf16 roundings of conv activations, beta
+    and the raw outputs kept): returns (out [rows, H*128] bf16, state [H, 128, 128] fp32). A host-side model of
+    ``_k16`` for the tests (the float64 variant bounds the kernel's rounding)."""
+
+    H = int(a_log.numel())
+    C = 3 * H * DK
+    f = dtype
+    dev = p.device
+    x = torch.cat([conv_state.to(torch.float32), p[:rows, :C].to(torch.float32)], 0)
+    w = conv_w.to(torch.float32)
+    acc = sum(w[:, tap] * x[tap:tap + rows] for tap in range(4))
+    act = (acc / (1.0 + torch.exp(-acc))).to(torch.bfloat16).to(f)
+    qa = act[:, :H * DK].view(rows, H, DK)
+    ka = act[:, H * DK:2 * H * DK].view(rows, H, DK)
+    va = act[:, 2 * H * DK:].view(rows, H, DV)
+    q = qa / torch.sqrt((qa * qa).sum(-1, keepdim=True) + 1e-6) * (1.0 / math.sqrt(DK))
+    k = ka / torch.sqrt((ka * ka).sum(-1, keepdim=True) + 1e-6)
+    rate = torch.exp(a_log.to(f))[None, :, None]
+    z = rate * (a[:rows, :H * DK].to(f).view(rows, H, DK) + dt_bias.to(f).view(1, H, DK))
+    gl = lower * torch.sigmoid(z)
+    beta = torch.sigmoid(p[:rows, b_off:b_off + H].to(torch.float32)).to(torch.bfloat16).to(f)
+    s = state_in.to(f).clone().view(H, DV, DK)
+    raw = torch.empty((rows, H, DV), dtype=torch.bfloat16, device=dev)
+    off = pos % TILE
+    starts = [0] + list(range(TILE - off if off else TILE, rows, TILE))
+    for t0 in starts:
+        t1 = min(rows, t0 + (TILE - off if t0 == 0 and off else TILE))
+        n = t1 - t0
+        G = torch.cumsum(gl[t0:t1], 0)                                   # [n, H, K]
+        GC = G[-1]
+        kt = k[t0:t1] * torch.exp(G)
+        kv = k[t0:t1] * torch.exp(-G)
+        qt = q[t0:t1] * torch.exp(G)
+        kr = k[t0:t1] * torch.exp(GC[None] - G)
+        bt = beta[t0:t1]                                                 # [n, H]
+        for h in range(H):
+            L = torch.tril((kt[:, h] @ kv[:, h].T) * bt[:, h, None], -1)
+            Minv = torch.linalg.inv(torch.eye(n, dtype=f, device=dev) + L)
+            Mqk = torch.tril(qt[:, h] @ kv[:, h].T)
+            Vp = (va[t0:t1, h] - kt[:, h] @ s[h].T) * bt[:, h, None]
+            U = Minv @ Vp
+            O = qt[:, h] @ s[h].T + Mqk @ U
+            raw[t0:t1, h] = O.to(torch.bfloat16)
+            s[h] = s[h] * torch.exp(GC[h])[None, :] + U.T @ kr[:, h]
+    o = raw.to(torch.float32)
+    rinv = 1.0 / torch.sqrt((o * o).mean(-1, keepdim=True) + eps)
+    gate = g[:rows, :H * DV].to(torch.float32).view(rows, H, DV)
+    out = ((norm_w.to(torch.float32) * (o * rinv)) * torch.sigmoid(gate)).reshape(rows, -1).to(torch.bfloat16)
+    return out, s.to(torch.float32)
diff --git c/src/tensorfold/families/glm5_next/cuda/b12x_mhc.py i/src/tensorfold/families/glm5_next/cuda/b12x_mhc.py
new file mode 100644
index 0000000..d9e07ca
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/b12x_mhc.py
@@ -0,0 +1,205 @@
+"""Hyper-connection mixing dots for fast-prefill chunks, fused with hc_post (patches/0240, ``tf_knobs.b12x`` bit 1).
+
+The idea comes from b12x's fused mHC (https://github.com/local-inference-lab/b12x, ``b12x/norm/mhc``, Apache License
+2.0, Copyright Luke Alonso and the b12x contributors): hc_post's new streams X' feed the next hc_pre's 24 mixing dots
+and square sums from registers, one launch per site instead of two, and the K split of those dots is laid out over
+column blocks of ALL FOUR streams (a program owns columns [c CB, (c + 1) CB) of every stream, which is exactly the
+data hc_post needs for them), so the fused kernel has as many programs as the unfused one. Re-implemented in Triton
+for this engine; the model math is GLM-5.3's (``glue``'s docstring), not b12x's variant of it (b12x rounds the collapse
+once and takes its square sum from a Gram matrix; here nothing but the K split changes):
+
+- X'_s = bf16(post_s * branch + (((c0s X0 + c1s X1) + c2s X2) + c3s X3)), ``glue._hc_post``'s expression, element for
+  element (the same bits as ``glue.hc_post``);
+- partial block c (c = 0 .. NB - 1): for the column steps t of the block, for s = 0 .. 3: the 24 dots of X'_s's
+  bf16 tile with fn's tile of stream s and the square sums, both on tensor cores into fp32 accumulators (the square
+  sums as the diagonal of X'_s X'_s^T, so their bits do not depend on how Triton lays a row over threads: every
+  number here is an mma chain fixed by the column order, hence the same for any row tile, warp count or step width);
+- the finish (mixes = the NB partials summed in order, Sinkhorn, collapse, RMSNorm) is ``glue._hc_finish_u``
+  unchanged.
+
+Against the current fast path (``fast_qmm.hc_partial``: 16 blocks of 1,024 contiguous flattened columns, i.e. a
+quarter of ONE stream a block, and square sums reduced in a Triton layout) only the summation order of the 24 mixes
+and the square sum changes: mixes differ in the last fp32 bits, so pre / post / comb and everything after them do too.
+New arithmetic for fast chunks (own snapshot tag, ``b12xpf``); deterministic; row-independent (each row is one row of
+the mma tiles; masked rows are zeros). ``partial`` (a site whose streams are already written: the first hc_pre after
+the embedding, and the unpipelined lean / non-lean chunks, which run ``glue.hc_post`` first) and ``post_partial`` (the
+pipelined slabs of patches/0084) give the same bits, by the construction above (tested on the GPU).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+BM = 32          # rows a program (no effect on bits)
+BK = 64          # columns a dot step (no effect on bits: the mma chains run in column order whatever the step)
+BKP = 16         # columns a step of the fused kernel's hc_post phase (no effect on bits: elementwise)
+WARPS = 4
+STAGES = 2
+_BROKEN = ""     # set when the fused kernel cannot launch here: ``post_partial`` then runs the two kernels (same bits)
+
+
+@triton.jit
+def _mhc_step(vb, FN, fcol, m, acc, sq, WIDE: tl.constexpr):
+    """One stream tile's contribution: acc += vb fn_tile^T (the 24 mixes), sq += vb vb^T (its diagonal: the squares)."""
+
+    w = tl.load(FN + m[:, None] * WIDE + fcol[None, :], mask=m[:, None] < 24, other=0.0)
+    acc = tl.dot(vb, tl.trans(w), acc)
+    sq = tl.dot(vb, tl.trans(vb), sq)
+    return acc, sq
+
+
+@triton.jit
+def _mhc_part(X, XOUT, G, POST, COMB, FN, PART, RS, R, D: tl.constexpr, WORLD: tl.constexpr, NB: tl.constexpr,
+              BM: tl.constexpr, BK: tl.constexpr, BKP: tl.constexpr, POST_ON: tl.constexpr):
+    """Program (row tile, column block c): columns [c CB, (c + 1) CB) of the four streams (CB = D / NB). POST_ON: first
+    the new streams from X and the gathered partials G (``glue._hc_post``'s expression, BKP columns a step), stored to
+    XOUT; then (both variants, the same code) the block's 24 mixes and square sum from XOUT's bf16 values, stream by
+    stream, BK columns a step, every product an mma into fp32 accumulators in column order (so neither BM, BK nor BKP
+    changes a bit). PART[r, c, 0:24] the mixes, PART[r, c, 24] the square sum."""
+
+    pid = tl.program_id(0)
+    c = tl.program_id(1)
+    WIDE: tl.constexpr = 4 * D
+    CB: tl.constexpr = D // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    off = rr[:, None] * WIDE
+    if POST_ON:
+        kp = tl.arange(0, BKP)
+        cb = COMB + rr * 16
+        c00 = tl.load(cb + 0, mask=ok, other=0.0)
+        c10 = tl.load(cb + 4, mask=ok, other=0.0)
+        c20 = tl.load(cb + 8, mask=ok, other=0.0)
+        c30 = tl.load(cb + 12, mask=ok, other=0.0)
+        c01 = tl.load(cb + 1, mask=ok, other=0.0)
+        c11 = tl.load(cb + 5, mask=ok, other=0.0)
+        c21 = tl.load(cb + 9, mask=ok, other=0.0)
+        c31 = tl.load(cb + 13, mask=ok, other=0.0)
+        c02 = tl.load(cb + 2, mask=ok, other=0.0)
+        c12 = tl.load(cb + 6, mask=ok, other=0.0)
+        c22 = tl.load(cb + 10, mask=ok, other=0.0)
+        c32 = tl.load(cb + 14, mask=ok, other=0.0)
+        c03 = tl.load(cb + 3, mask=ok, other=0.0)
+        c13 = tl.load(cb + 7, mask=ok, other=0.0)
+        c23 = tl.load(cb + 11, mask=ok, other=0.0)
+        c33 = tl.load(cb + 15, mask=ok, other=0.0)
+        p0 = tl.load(POST + rr * 4 + 0, mask=ok, other=0.0)
+        p1 = tl.load(POST + rr * 4 + 1, mask=ok, other=0.0)
+        p2 = tl.load(POST + rr * 4 + 2, mask=ok, other=0.0)
+        p3 = tl.load(POST + rr * 4 + 3, mask=ok, other=0.0)
+        for t in range(CB // BKP):
+            d = c * CB + t * BKP + kp
+            gv = tl.load(G + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            for kk in tl.static_range(1, WORLD):
+                gv = gv + tl.load(G + kk * RS + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            branch = gv.to(tl.bfloat16).to(tl.float32)
+            x0 = tl.load(X + off + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x1 = tl.load(X + off + D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x2 = tl.load(X + off + 2 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x3 = tl.load(X + off + 3 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            # glue._hc_post's expression, operand for operand
+            v0 = p0[:, None] * branch + (((c00[:, None] * x0 + c10[:, None] * x1) + c20[:, None] * x2) + c30[:, None] * x3)
+            v1 = p1[:, None] * branch + (((c01[:, None] * x0 + c11[:, None] * x1) + c21[:, None] * x2) + c31[:, None] * x3)
+            v2 = p2[:, None] * branch + (((c02[:, None] * x0 + c12[:, None] * x1) + c22[:, None] * x2) + c32[:, None] * x3)
+            v3 = p3[:, None] * branch + (((c03[:, None] * x0 + c13[:, None] * x1) + c23[:, None] * x2) + c33[:, None] * x3)
+            tl.store(XOUT + off + d[None, :], v0.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + D + d[None, :], v1.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + 2 * D + d[None, :], v2.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + 3 * D + d[None, :], v3.to(tl.bfloat16), mask=ok[:, None])
+        # the dots read the block back (this CTA's own stores, L1 / L2, visible after the barrier) rather than taking it
+        # from registers: the unfused kernel's code from here on (hence its bits), and Triton does not re-materialize the
+        # post in each consumer's layout (that took 255 registers and spilled)
+        tl.debug_barrier()
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BM, 32), dtype=tl.float32)
+    sq = tl.zeros((BM, BM), dtype=tl.float32)
+    for s in tl.static_range(4):
+        for t in range(CB // BK):
+            d = c * CB + t * BK + k
+            u = tl.load(XOUT + off + s * D + d[None, :], mask=ok[:, None], other=0.0)
+            acc, sq = _mhc_step(u, FN, s * D + d, m, acc, sq, WIDE)
+    i = tl.arange(0, BM)
+    ss = tl.sum(tl.where(i[:, None] == i[None, :], sq, 0.0), axis=1)       # the diagonal (one term a row: exact)
+    pm = ok[:, None] & (m[None, :] < 24)
+    tl.store(PART + (rr[:, None] * NB + c) * 32 + m[None, :], acc, mask=pm)
+    tl.store(PART + (rr * NB + c) * 32 + 24, ss, mask=ok)
+
+
+def step(d: int, nb: int, bk: int | None = None) -> int:
+    """Columns a step: ``BK`` (or ``bk``), or the whole block when it is narrower (any width gives the same bits)."""
+
+    return min(BK if bk is None else bk, d // nb)
+
+
+def fits(d: int, nb: int) -> bool:
+    """The kernel's shape rule: D splits into NB column blocks of a multiple of 16 columns."""
+
+    cb = d // nb
+    return d % nb == 0 and cb % 16 == 0 and cb % step(d, nb) == 0 and cb % step(d, nb, BKP) == 0
+
+
+def _check(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> tuple[int, int]:
+    rows, wide = x.shape
+    d = wide // 4
+    if wide != 4 * d or x.stride(1) != 1 or x.stride(0) != wide or not fn.is_contiguous() or fn.shape[1] != wide:
+        raise ValueError("b12x_mhc: contiguous [R, 4 D] streams and fn [24, 4 D] expected")
+    if not fits(d, nb) or part.shape[0] < rows or part.shape[1] != nb or part.shape[2] < 25:
+        raise ValueError("b12x_mhc: D / NB must be a multiple of 16 columns, part [R, NB, 32]")
+    return rows, d
+
+
+def partial(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> None:
+    """The mixes' partials of streams already in ``x`` [R, 4 D] bf16 (``fast_qmm.hc_partial``'s contract, this
+    module's K split)."""
+
+    rows, d = _check(x, fn, part, nb)
+    if rows == 0:
+        return
+    _mhc_part[(triton.cdiv(rows, BM), nb)](x, x, x, x, x, fn, part, 0, rows, D=d, WORLD=1, NB=nb, BM=BM,
+                                            BK=step(d, nb), BKP=step(d, nb, BKP), POST_ON=False, num_warps=WARPS, num_stages=STAGES)
+
+
+def post_partial(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, post: torch.Tensor, comb: torch.Tensor,
+                 fn: torch.Tensor, part: torch.Tensor, nb: int) -> bool:
+    """``glue.hc_post(x, xout, gathered, post, comb)`` then ``partial(xout, fn, part, nb)`` in one pass. False
+    (nothing written) when the kernel cannot launch here; the caller then runs the two (same bits)."""
+
+    global _BROKEN
+    rows, d = _check(xout, fn, part, nb)
+    world = gathered.shape[0]
+    if gathered.stride(2) != 1 or gathered.stride(1) != d or gathered.shape[1] < rows:
+        raise ValueError("b12x_mhc: the gathered partials' rows must be contiguous")
+    if _BROKEN:
+        return False
+    if rows == 0:
+        return True
+    try:
+        _mhc_part[(triton.cdiv(rows, BM), nb)](x, xout, gathered, post, comb, fn, part, gathered.stride(0), rows, D=d,
+                                                WORLD=world, NB=nb, BM=BM, BK=step(d, nb), BKP=step(d, nb, BKP), POST_ON=True, num_warps=WARPS,
+                                                num_stages=STAGES)
+        return True
+    except Exception as exc:                            # noqa: BLE001 - triton.runtime.errors.OutOfResources et al.
+        if type(exc).__name__ not in ("OutOfResources", "CompilationError"):
+            raise
+        _BROKEN = f"{type(exc).__name__}: {exc}"
+        print(f"[tensorfold] b12x mhc: the fused kernel cannot run here ({_BROKEN}); post + partial kernels",
+              flush=True)
+        return False
+
+
+# -- reference (tests) ------------------------------------------------------------------------------------------------
+def partial_reference(x: torch.Tensor, fn: torch.Tensor, nb: int) -> torch.Tensor:
+    """float64 partials of this module's K split: [R, nb, 25] (24 mixes, the square sum)."""
+
+    rows, wide = x.shape
+    d = wide // 4
+    cb = d // nb
+    xs = x.double().view(rows, 4, nb, cb)
+    f = fn.double().view(24, 4, nb, cb)
+    mix = torch.einsum("rsbk,msbk->rbm", xs, f)
+    sq = (xs * xs).sum(dim=(1, 3))
+    return torch.cat([mix, sq[:, :, None]], 2)
diff --git c/src/tensorfold/families/glm5_next/cuda/b12xpf.py i/src/tensorfold/families/glm5_next/cuda/b12xpf.py
