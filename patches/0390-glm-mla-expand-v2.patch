+# -- patches/0390: absorb / expand retiled, v1's bits (GLM53_TF_MLA_EXPAND=v2) -----------------------------------------
+# (rows up to, rows a program, k a dot step, warps) by launch rows, per kernel. Any entry gives the same bits (every
+# output element is one FMA chain over k in order, independent of its tile-mates and of how k is cut into dot
+# steps), so this table only picks speed. Offline picks (ptxas for sm_121, Triton 3.7.1 = the image's: no spills,
+# <= 128 registers where 2 programs of 8 warps fit an SM; Triton 3.7 needs k >= 16 a dot); tests/cuda/bench_mla_expand.py
+# sweeps it on the GPU. 16-row programs for decode / verify / MTP windows (as many programs as v1), 64-128 rows for
+# prefill (4-8 x fewer dequantizations of kv_b than v1's 16).
+V2_TILES = {
+    "expand": ((16, 16, 16, 4), (32, 32, 16, 4), (1 << 62, 64, 16, 4)),              # W10 GPU sweep: 4 warps
+    "absorb": ((16, 16, 32, 4), (32, 32, 32, 4), (64, 64, 32, 4), (1 << 62, 64, 32, 4)),  # (bench_mla_expand --sweep)
+}
+V2_BN = 64               # expand's output rows a program (divides the head's DV)
+
+
+def v2_tiles(R: int, kind: str) -> tuple[int, int, int]:
+    """(rows a program, k a dot step, warps) of ``kind`` (expand / absorb) for a launch of R rows."""
+
+    for top, bm, bk, warps in V2_TILES[kind]:
+        if R <= top:
+            return bm, bk, warps
+    raise AssertionError(R)
+
+
+@triton.jit
+def _wcols(W, S, B, n0, g, c0, N: tl.constexpr, K: tl.constexpr, IS_Q4: tl.constexpr, BN: tl.constexpr,
+           BK: tl.constexpr):
+    """Rows n0 .. n0 + BN - 1, columns g 64 + c0 .. + BK - 1 (inside group g) of an [N, K] weight as fp32, each
+    element ``_wtile``'s value (s * q + b, or the BF16 value)."""
+
+    n = n0 + tl.arange(0, BN)
+    if IS_Q4:
+        KG: tl.constexpr = K // 64
+        rw = tl.arange(0, BK // 8)
+        words = tl.load(W + ((n // 64) * (KG * 512) + g * 512 + (n % 64) * 8 + c0 // 8)[:, None] + rw[None, :])
+        shifts = tl.arange(0, 8) * 4
+        q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+        q = tl.reshape(q, (BN, BK)).to(tl.float32)
+        s = tl.load(S + g * N + n).to(tl.float32)
+        b = tl.load(B + g * N + n).to(tl.float32)
+        return q * s[:, None] + b[:, None]
+    else:
+        j = tl.arange(0, BK)
+        return tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c0 + j)[None, :]).to(tl.float32)
+
+
+@triton.jit
+def _wrows(W, S, B, n0, g, N: tl.constexpr, K: tl.constexpr, IS_Q4: tl.constexpr, BK: tl.constexpr):
+    """Rows n0 .. n0 + BK - 1 (inside one 64-row block), columns g 64 .. g 64 + 63 of an [N, K] weight as fp32, each
+    element ``_wtile``'s value."""
+
+    n = n0 + tl.arange(0, BK)
+    c = tl.arange(0, 64)
+    if IS_Q4:
+        KG: tl.constexpr = K // 64
+        rw = tl.arange(0, 8)
+        words = tl.load(W + ((n // 64) * (KG * 512) + g * 512 + (n % 64) * 8)[:, None] + rw[None, :])
+        shifts = tl.arange(0, 8) * 4
+        q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+        q = tl.reshape(q, (BK, 64)).to(tl.float32)
+        s = tl.load(S + g * N + n).to(tl.float32)
+        b = tl.load(B + g * N + n).to(tl.float32)
+        return q * s[:, None] + b[:, None]
+    else:
+        return tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c)[None, :]).to(tl.float32)
+
+
+@triton.jit
+def _absorb2(Q, W, S, B, QA, M, H: tl.constexpr, DQ: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+             IS_Q4: tl.constexpr, BMR: tl.constexpr, BK: tl.constexpr):
+    """``_absorb`` retiled. Program (head h and latent group g = program_id(0), row tile): QA[r, h, g 64 ..] =
+    bf16(sum_i q[r, h, i] W[h DQ + i, g 64 ..]), one fp32 FMA chain an element over i = 0 .. DQ - 1 in order (BK a
+    dot step); the 8 groups of a head are adjacent programs (they read the same q rows)."""
+
+    GL: tl.constexpr = L // 64
+    h = tl.program_id(0) // GL
+    g = tl.program_id(0) % GL
+    rm = tl.program_id(1) * BMR + tl.arange(0, BMR)
+    ok = rm < M
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for it in range(DQ // 64):
+        for kk in tl.static_range(64 // BK):
+            x = tl.load(Q + (rm[:, None] * H + h) * DQ + it * 64 + kk * BK + k[None, :], mask=ok[:, None], other=0.0)
+            wt = _wrows(W, S, B, h * DQ + it * 64 + kk * BK, g, N, L, IS_Q4, BK)      # [BK inputs i, 64 latent j]
+            acc = tl.dot(x.to(tl.float32), wt, acc, input_precision="ieee")
+    j = tl.arange(0, 64)
+    tl.store(QA + (rm[:, None] * H + h) * L + g * 64 + j[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+@triton.jit
+def _expand2(U, W, S, B, OUT, M, H: tl.constexpr, DV: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+             IS_Q4: tl.constexpr, BMR: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    """``_expand`` retiled. Program (BN output rows n of head h = n // DV, row tile): OUT[r, n] = bf16(sum_j u[r, h, j]
+    W[n, j]), one fp32 FMA chain an element over j = 0 .. L - 1 in order (BK a dot step); the DV / BN programs of a
+    head are adjacent (they read the same u rows)."""
+
+    n0 = tl.program_id(0) * BN
+    h = n0 // DV
+    rm = tl.program_id(1) * BMR + tl.arange(0, BMR)
+    ok = rm < M
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BMR, BN), dtype=tl.float32)
+    for g in range(L // 64):
+        for kk in tl.static_range(64 // BK):
+            x = tl.load(U + (rm[:, None] * H + h) * L + g * 64 + kk * BK + k[None, :], mask=ok[:, None], other=0.0)
+            wt = _wcols(W, S, B, n0, g, kk * BK, N, L, IS_Q4, BN, BK)                 # [BN outputs n, BK latent j]
+            acc = tl.dot(x, tl.trans(wt), acc, input_precision="ieee")
+    o = tl.arange(0, BN)
+    tl.store(OUT + rm[:, None] * N + n0 + o[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
