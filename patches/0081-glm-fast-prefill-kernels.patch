--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/fast_qmm.py
@@ -0,0 +1,323 @@
+"""Prefill-shaped 4-bit / BF16 matmuls for GLM-5.3-Flash (patches/0081), for M in 256..2048 rows.
+
+``matmul_prefill`` has the signature and semantics of ``qmm.matmul`` (``qmm.Q4``: MLX affine 4-bit in groups of 64
+along K; ``qmm.B16``: plain BF16) and is meant for the fast-prefill path (patches/0080, ``GLM53_TF_FAST_PREFILL``).
+
+What changes against ``qmm._qmm`` / ``qmm._bmm`` (tuned for 1-16 row decode steps):
+
+- One program owns a BM x BN output tile (BM 128, 64 under 512 rows; BN 128, or 64 when the shape has several
+  K slices, see ``CONFIG``) over the WHOLE K range: no split-K partial buffer, no
+  second reduce kernel. At M = 1024 on the KDA projection (12576 x 4096, 4 K slices) ``qmm`` writes and re-reads
+  4 x 1024 x 12576 fp32 partials = 206 MB each way; here nothing leaves the registers but the output.
+- A 64 x BN weight group is unpacked once per program and feeds a BM-row tensor-core dot, and the M tiles of one
+  column block are consecutive program ids (M fastest), so the concurrently running programs share each weight
+  tile in L2 and the weights stream from DRAM about once per call.
+- The arithmetic is qmm's, operation for operation. For weight group g (64 inputs):
+
+      P[m, n, g] = x[m, g-block] . q[n, g-block]          tl.dot, bf16 x integer-valued bf16 -> fp32
+      acc[m, n] += P[m, n, g] * s[n, g] + xs[m, g] * b[n, g]
+
+  and qmm's K split (``qmm.split_k`` / ``qmm.b16_split_k``, fixed by the weight's shape) is kept as an ORDER of
+  summation: the program walks the SK slices in turn, sums each slice from zero exactly as qmm's slice program
+  does, and adds the slice sums in slice order exactly as ``qmm._reduce`` does. A row's value therefore does not
+  depend on the row tile, the column tile or the other rows, and is meant to equal ``qmm.matmul`` bit for bit
+  (``tests/cuda/test_fastk_patches.py::test_fast_qmm_bitwise`` checks it on hardware). ``exact=False`` drops the
+  slice order (one accumulator, lower register pressure); still deterministic and row-invariant, not qmm's bits.
+
+``matmul_fast`` (what fast-prefill chunks run): ``exact=False``, one accumulator over K and a 128 x 64 tile at 4
+warps (``LOOSE``), 1.1-1.7x faster than the exact tiles; deterministic and row-independent, not qmm's bits.
+
+``hc_partial``: ``glue.hc_pre``'s 24 mixing dots for fast chunks, 64 rows a program sharing each fn tile (bf16
+tensor-core dots, fp32 sums; not ``glue``'s bits, row-independent).
+
+Deterministic: no atomics, fixed reduction order, no autotuning (``CONFIG`` below is a fixed table by (N, K) and
+the row bucket; no entry changes bits).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from . import qmm
+from .qmm import B16, GS, Q4
+
+# Per rank of GLM-5.3-Flash at TP=2 (N x K):
+#   KDA  [q|k|v|f_a|g_a|b] 12576x4096, f_b/g_b 4096x128, o_proj 4096x4096
+#   DSA  q_a|kv_a 2048x4096, q_b 8192x1536, kv_b (k, v) 8192x512 each, o_proj 4096x8192
+#   dense MLP gate|up 12288x4096, down 4096x6144; EXL3 shared expert gate|up 2048x4096, down 4096x1024
+#   indexer k|w 160x4096, q_b 4096x1536; MTP eh_proj 4096x8192; head 77440x4096
+# Value: (BM for M >= 512, BM for M < 512, warps, stages, groups per unrolled step). Columns per program: 128 when
+# the shape has one K slice, 64 when it has several: the exact variant then keeps two BM x BN fp32 accumulators
+# (slice sum and total) plus the dot result live, 3 x 128 x 64 / 256 threads = 96 registers at 8 warps, where
+# 128 x 128 would need 192 and spill. K slices per shape (qmm.split_k): 12576x4096 4, 4096x4096 2, 2048x4096 4,
+# 8192x1536 4, 8192x512 4, 4096x8192 8, 4096x6144 4, 4096x1024 2, 4096x1536 2, 160x4096 8; one slice: 12288x4096,
+# 4096x128, the head. No entry changes bits. Used for row counts and shapes ``TUNED`` does not cover.
+CONFIG: dict[str, tuple[int, int, int, int, int]] = {
+    "4096x128": (128, 64, 8, 2, 2),
+    "160x4096": (64, 64, 4, 3, 1),
+}
+DEFAULT = (128, 64, 8, 3, 1)
+BN_ONE, BN_SPLIT = 128, 64          # columns per program with one K slice / with several (exact variant)
+BN_STORED = qmm.BN                  # columns of one stored weight tile (64)
+MIN_ROWS = 64                       # fewer rows go to qmm.matmul (tuned for 1-128 rows)
+
+# Measured on GB10 (tests/cuda/test_fastk_patches.py::test_fast_qmm_timing; every tile config gives qmm's bits, so
+# the choice is free): per (N x K) and row bucket, (BM, BN, warps, stages) of the fastest config, or None where qmm's
+# split-K kernels were faster (they then run, with the caller's ``part`` buffer). Buckets: 512 for 512..1535 rows
+# (measured at 1024), 1536 for 1536+ rows (measured at 2048). ms at 1024 rows qmm -> this entry: 12576x4096
+# 3.29 -> 2.54, 4096x4096 0.80 -> 0.80, 2048x4096 0.51 -> 0.42, 8192x1536 1.52 -> 0.67, 8192x512 1.36 -> 0.23,
+# 4096x6144 1.35 -> 1.30, 4096x1024 0.39 -> 0.21, 4096x1536 0.45 -> 0.31; qmm kept: 4096x8192 2.04 (tiles 2.30),
+# 12288x4096 1.82 (1.83), 4096x128 0.028 (0.033), 160x4096 0.045 (0.060).
+TUNED: dict[str, dict[int, tuple[int, int, int, int] | None]] = {
+    "12576x4096": {512: (64, 64, 4, 3), 1536: (64, 64, 4, 3)},
+    "4096x4096": {512: (128, 64, 4, 3), 1536: (128, 64, 4, 3)},
+    "2048x4096": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 3)},
+    "8192x1536": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 2)},
+    "8192x512": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 3)},
+    "4096x8192": {512: None, 1536: None},
+    "12288x4096": {512: None, 1536: (128, 64, 4, 3)},
+    "4096x6144": {512: (64, 64, 4, 2), 1536: None},
+    "4096x1024": {512: (128, 64, 4, 2), 1536: (128, 64, 4, 2)},
+    "4096x128": {512: None, 1536: (64, 64, 4, 2)},
+    "160x4096": {512: None, 1536: None},
+    "4096x1536": {512: (64, 64, 4, 2), 1536: (128, 64, 4, 3)},
+}
+USE_QMM = "qmm"
+
+# ``exact=False`` (what fast-prefill chunks run, ``matmul_fast``): one accumulator over all of K, so the tile is free
+# of qmm's slice order and a 128 x 64 tile at 4 warps wins everywhere it was measured (M 400 / 1024 / 2048 on GB10):
+# ms at 1024 rows, exact tiles -> one accumulator: 12576x4096 2.64 -> 1.82, 4096x4096 0.80 -> 0.61, 2048x4096
+# 0.42 -> 0.34, 8192x1536 0.67 -> 0.46, 8192x512 0.24 -> 0.17, 4096x8192 2.12 (qmm) -> 1.24, 12288x4096 1.86 -> 1.81,
+# 4096x6144 1.31 -> 0.94, 4096x1024 0.21 -> 0.16, 4096x1536 0.31 -> 0.23. The two tiny shapes keep their own tile
+# (qmm is up to 0.01 ms faster on them below 1536 rows, but a shape that switched kernels by row count would give a
+# row other bits in a short call than in a long one).
+LOOSE = (128, 64, 4, 3)
+LOOSE_TUNED: dict[str, tuple[int, int, int, int]] = {"4096x128": (64, 64, 4, 2), "160x4096": (128, 64, 8, 3)}
+
+
+def config(n: int, k: int, m: int, sk: int, *, tuned: bool = True, loose: bool = False):
+    """(BM, BN, warps, stages, gpi) for an (n, k) weight at m rows summed in ``sk`` K slices, or ``USE_QMM`` where
+    ``qmm.matmul`` is faster (``TUNED``, measured for 4-bit weights; ``tuned=False``: the fixed table only;
+    ``loose``: the one-accumulator variant, ``LOOSE``)."""
+
+    if tuned and sk == 1 and loose:
+        bm, bn, warps, stages = LOOSE_TUNED.get(f"{n}x{k}", LOOSE)
+        return bm, bn, warps, stages, 1
+    row = TUNED.get(f"{n}x{k}") if tuned else None
+    if row is not None and m >= 512:
+        entry = row[1536 if m >= 1536 else 512]
+        if entry is None:
+            return USE_QMM
+        bm, bn, warps, stages = entry
+        return bm, bn, warps, stages, 1
+    bm_big, bm_small, warps, stages, gpi = CONFIG.get(f"{n}x{k}", DEFAULT)
+    bm = bm_big if m >= 512 else bm_small
+    return bm, (BN_ONE if sk == 1 else BN_SPLIT), warps, stages, gpi
+
+
+# Program order (``_tile``): M tiles fastest within groups of GROUP_M row tiles, the groups one after another, so a
+# group's rows (GROUP_M * BM x K bf16, 16 MB at 2048 x 4096) stay in L2 while every column block streams past them
+# once. Up to GROUP_M row tiles this is the plain M-fastest order; past it (lean 4096-8192-row chunks) the plain
+# order re-read the whole x from DRAM for every column block (12576x4096 at 8192 rows: 43 ms, 20 TF/s). The order
+# changes no bits (each tile's arithmetic is its own).
+GROUP_M = tl.constexpr(16)
+
+
+@triton.jit
+def _tile(pid, M, N, BM: tl.constexpr, BN: tl.constexpr, GM: tl.constexpr):
+    num_m = tl.cdiv(M, BM)
+    per_group = GM * tl.cdiv(N, BN)
+    first = (pid // per_group) * GM
+    size = tl.minimum(num_m - first, GM)
+    return first + (pid % per_group) % size, (pid % per_group) // size
+
+
+@triton.jit
+def _fq4(X, XS, W, S, B, OUT, M, x_stride,
+         N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+         TN: tl.constexpr, GPI: tl.constexpr, F32: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] over all K, qmm's per-group arithmetic, qmm's K slices
+    summed in slice order."""
+
+    KG: tl.constexpr = K // 64
+    PER: tl.constexpr = KG // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    rw = tl.arange(0, 8)
+    shifts = tl.arange(0, 8) * 4
+    m_ok = rm < M
+    n_ok = rn < N
+    # stored tiles: words [N/64][K/64][64][8]; column n lives in tile n // 64 at local row n % 64
+    wrow = (rn // TN).to(tl.int64) * (KG * TN * 8) + (rn % TN) * 8
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    for sl in tl.static_range(SK):
+        acc = tl.zeros((BM, BN), dtype=tl.float32)
+        for i in range(PER // GPI):
+            for j in tl.static_range(GPI):
+                g = sl * PER + i * GPI + j
+                words = tl.load(W + wrow[:, None] + g * (TN * 8) + rw[None, :], mask=n_ok[:, None], other=0)
+                x = tl.load(X + rm[:, None] * x_stride + (g * 64 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+                q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+                q = tl.reshape(q, (BN, 64)).to(tl.bfloat16)
+                p = tl.dot(x, tl.trans(q))
+                s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+                b = tl.load(B + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+                xs = tl.load(XS + rm * KG + g, mask=m_ok, other=0.0)
+                acc = acc + p * s[None, :] + xs[:, None] * b[None, :]
+        if sl == 0:
+            total = acc
+        else:
+            total = total + acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+@triton.jit
+def _fb16(X, W, OUT, M, x_stride, N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr,
+          BN: tl.constexpr, BK: tl.constexpr, F32: tl.constexpr):
+    """BF16 weights: qmm._bmm's arithmetic (K in BK steps, fp32 sums), its K slices summed in slice order."""
+
+    PER: tl.constexpr = K // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    n_ok = rn < N
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    for sl in tl.static_range(SK):
+        acc = tl.zeros((BM, BN), dtype=tl.float32)
+        for k0 in range(sl * PER, sl * PER + PER, BK):
+            x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+            w = tl.load(W + rn[:, None].to(tl.int64) * K + (k0 + rk)[None, :], mask=n_ok[:, None], other=0.0)
+            acc = acc + tl.dot(x, tl.trans(w))
+        if sl == 0:
+            total = acc
+        else:
+            total = total + acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+def _out(x: torch.Tensor, n: int, out: torch.Tensor | None, f32: bool) -> torch.Tensor:
+    m = x.shape[0]
+    if out is None:
+        return torch.empty((m, n), dtype=torch.float32 if f32 else torch.bfloat16, device=x.device)
+    if out.shape != (m, n) or not out.is_contiguous():
+        raise ValueError(f"matmul_prefill: out {tuple(out.shape)} must be a contiguous ({m}, {n})")
+    if out.dtype != (torch.float32 if f32 else torch.bfloat16):
+        raise ValueError(f"matmul_prefill: out dtype {out.dtype} does not match f32={f32}")
+    return out
+
+
+def matmul_prefill(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+                   f32: bool = False, part: torch.Tensor | None = None, exact: bool = True) -> torch.Tensor:
+    """``qmm.matmul`` for prefill-sized M: x (M, K) bf16 (rows may be strided, unit column stride) @ q.T ->
+    (M, N) bf16, or the unrounded fp32 sums with ``f32``. ``xs``: x's fp32 64-input group sums (Q4 only; computed
+    when None). ``part`` is only used below ``MIN_ROWS`` rows, where ``qmm.matmul`` runs (no split-K partials
+    here). ``exact``: keep qmm's K-slice summation order (qmm's bits); False sums all of K in one accumulator."""
+
+    m, k = x.shape
+    if m < MIN_ROWS:                     # decode-sized (e.g. the last row's logits): qmm's kernels, the same bits
+        return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+    if k != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_prefill: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    out = _out(x, q.n, out, f32)
+    if m == 0:
+        return out
+    if isinstance(q, B16):
+        if k % qmm.B16_BK:
+            raise ValueError(f"matmul_prefill: K={k} is not a multiple of {qmm.B16_BK}")
+        sk = qmm.b16_split_k(q.n, q.k) if exact else 1
+        bm, bn, warps, stages, _ = config(q.n, q.k, m, sk, tuned=False)
+        grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+        _fb16[grid](x, q.weight, out, m, x.stride(0), N=q.n, K=k, SK=sk, BM=bm, BN=bn, BK=qmm.B16_BK, F32=f32,
+                    num_warps=warps, num_stages=stages)
+        return out
+    sk = qmm.split_k(q.n, q.k) if exact else 1
+    cfg = config(q.n, q.k, m, sk, loose=not exact)
+    if cfg == USE_QMM:                   # exact, and qmm's split-K kernels are faster on this shape: the same bits
+        return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+    if xs is None:
+        xs = qmm.group_sums(x)
+    bm, bn, warps, stages, gpi = cfg
+    per = (k // GS) // sk
+    grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+    _fq4[grid](x, xs, q.weight, q.scales, q.biases, out, m, x.stride(0), N=q.n, K=k, SK=sk, BM=bm, BN=bn,
+               TN=BN_STORED, GPI=qmm.gpi_for(per, gpi), F32=f32, num_warps=warps, num_stages=stages)
+    return out
+
+
+def matmul_fast(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+                f32: bool = False, part: torch.Tensor | None = None) -> torch.Tensor:
+    """What fast-prefill chunks run behind ``qmm.matmul`` (``fastpf.chunk``): ``matmul_prefill(exact=False)``, one
+    accumulator over K (not qmm's bits; deterministic and row-independent)."""
+
+    return matmul_prefill(x, q, xs, out=out, f32=f32, part=part, exact=False)
+
+
+def matmul(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+           f32: bool = False, part: torch.Tensor | None = None, min_rows: int = 256) -> torch.Tensor:
+    """Dispatch helper for callers: ``matmul_prefill`` from ``min_rows`` rows up, ``qmm.matmul`` below (the decode
+    kernels are tuned for 1-16 rows)."""
+
+    if x.shape[0] >= min_rows:
+        return matmul_prefill(x, q, xs, out=out, f32=f32, part=part)
+    return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+
+
+# -- hyper-connection mixing dots for fast chunks ------------------------------------------------------------------
+@triton.jit
+def _hc_partial_mm(X, FN, PART, R, WIDE: tl.constexpr, NB: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr):
+    """Program (row tile, K block b): ``glue._hc_partial``'s outputs for BM rows -- PART[r, b, 0:24] the dots of
+    the flattened streams with fn over K block b, PART[r, b, 24] the sum of squares -- with fn read once per BM
+    rows (bf16 tensor-core dots, fp32 sums; the per-row kernel re-reads fn's 786 KB from L2 for every row)."""
+
+    pid = tl.program_id(0)
+    b = tl.program_id(1)
+    KB: tl.constexpr = WIDE // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BM, 32), dtype=tl.float32)
+    ss = tl.zeros((BM,), dtype=tl.float32)
+    for t in range(KB // BK):
+        base = b * KB + t * BK
+        x = tl.load(X + rr[:, None] * WIDE + base + k[None, :], mask=ok[:, None], other=0.0)
+        w = tl.load(FN + m[:, None] * WIDE + base + k[None, :], mask=m[:, None] < 24, other=0.0)
+        acc = tl.dot(x, tl.trans(w), acc)
+        xf = x.to(tl.float32)
+        ss += tl.sum(xf * xf, axis=1)
+    pp = PART + (rr[:, None] * NB + b) * 32 + m[None, :]
+    tl.store(pp, acc, mask=ok[:, None] & (m[None, :] < 24))
+    tl.store(PART + (rr * NB + b) * 32 + 24, ss, mask=ok)
+
+
+def hc_partial(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> None:
+    """``glue._hc_partial`` for a fast-prefill chunk: x [R, S*D] bf16 streams, fn [24, S*D] bf16 -> part [R, nb, 32]
+    fp32 (24 dots, then the sum of squares). Row-independent and deterministic (fixed K order), not its bits."""
+
+    rows, wide = x.shape
+    if x.stride(1) != 1 or x.stride(0) != wide or not fn.is_contiguous() or wide % (nb * 64):
+        raise ValueError("hc_partial: contiguous [R, S*D] streams and fn, S*D a multiple of 64 * nb expected")
+    bm = 64
+    _hc_partial_mm[(triton.cdiv(rows, bm), nb)](x, fn, part, rows, WIDE=wide, NB=nb, BM=bm, BK=64, num_warps=4,
+                                                 num_stages=3)
+
+
+def flops(m: int, n: int, k: int) -> float:
+    return 2.0 * m * n * k
