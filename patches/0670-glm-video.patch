+def load_video_bytes(url: str, s: Settings, lim, deadline: float | None = None) -> bytes:
+    """patches/0670: a video part's bytes: a ``data:`` URL, or (GLM53_TF_VISION_FETCH=1) an ``https`` download.
+
+    The same hardened download images use (``image_fetch``: the URL and every redirect checked, resolved, the
+    connection pinned to the checked address), told the container formats a video may be and the video byte ceiling
+    (``GLM53_TF_VIDEO_MAX_BYTES``, 64 MB: an image's is 20 MB).
+    """
+
+    if not isinstance(url, str) or not url:
+        raise VisionError("a video part needs a URL (video_url.url)")
+    if url.startswith("data:"):
+        head, sep, data = url.partition(",")
+        if not sep:
+            raise VisionError("a data: URL without a comma")
+        if ";base64" not in head:
+            raw = urllib.parse.unquote_to_bytes(data)
+        else:
+            if len(data) > (lim.max_encoded_bytes * 4) // 3 + 8:
+                raise VisionError(f"video larger than {lim.max_encoded_bytes} bytes "
+                                  "(GLM53_TF_VIDEO_MAX_BYTES)")
+            try:
+                raw = base64.b64decode(data.strip(), validate=False)
+            except (binascii.Error, ValueError):
+                raise VisionError("the data: URL is not valid base64") from None
+        if len(raw) > lim.max_encoded_bytes:
+            raise VisionError(f"video larger than {lim.max_encoded_bytes} bytes (GLM53_TF_VIDEO_MAX_BYTES)")
+        return raw
+    try:
+        scheme = urllib.parse.urlsplit(url).scheme.lower()
+    except ValueError:
+        scheme = ""
+    if scheme not in ("http", "https"):
+        raise VisionError(f"video URL scheme {scheme or '(none)'!r}: only data:, http and https are accepted")
+    if not s.fetch:
+        raise VisionError("this server does not fetch video URLs (GLM53_TF_VISION_FETCH=0): send a data: URL")
+    from . import image_fetch               # patches/0600 (upstream 391713e): no URL in any message
+
+    policy = image_fetch.Policy(http=s.fetch_http, private=s.fetch_private)
+    now = time.monotonic()
+    until = now + lim.timeout if deadline is None else min(deadline, now + lim.timeout)
+    try:
+        raw, _ = image_fetch.fetch_image(url, max_bytes=lim.max_encoded_bytes, deadline=until, policy=policy,
+                                         media_types=image_fetch.VIDEO_MEDIA_TYPES, what="video")
+    except image_fetch.ImageFetchError as exc:
+        text = str(exc)
+        if "GLM53_TF_VIDEO_MAX_BYTES" in text:
+            raise VisionError(text) from None
+        raise VisionError(f"could not fetch the video URL: {text}") from None
+    return raw
+
