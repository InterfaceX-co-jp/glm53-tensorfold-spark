+@triton.jit
+def _gather_sel(KEYS, T, NEED, OUT, NP, K: tl.constexpr, BLOCK: tl.constexpr):
+    """Program r: the pools with key > T[r], then the first NEED[r] (lowest index) with key == T[r], listed in
