+def _launch_rows(qi, wts, pk, out, pos_dev, R, NP, row0, n, keys: bool = True) -> None:
+    _scores_rows[(triton.cdiv(n, BRB), triton.cdiv(NP, 64))](qi, wts, wts.stride(0), pk, out, pos_dev, row0 + n, NP,
+                                                            row0, 128 ** -0.5, BP=64, BRB=BRB, KEYS=keys,
+                                                            num_warps=4, **_heads(qi, wts))
