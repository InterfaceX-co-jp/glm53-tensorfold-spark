+                q = tl.load(QI + (r * H + hh[:, None]) * D + d[None, :]).to(tl.bfloat16)
+                w = tl.load(W + r * w_stride + hh).to(tl.float32) * (1.0 / 5.656854249492381)
+            else:
+                hm = hh < NH
+                q = tl.load(QI + (r * NH + hh[:, None]) * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.bfloat16)
+                w = tl.load(W + r * w_stride + hh, mask=hm, other=0.0).to(tl.float32) * WS
