+    r = tl.program_id(0).to(tl.int64)
+    t = tl.load(T + r)
+    need = tl.load(NEED + r)
+    n_eq = 0
+    n_sel = 0
+    for start in range(0, NP, BLOCK):
+        p = start + tl.arange(0, BLOCK)
+        k = tl.load(KEYS + r * NP + p, mask=p < NP, other=-2147483648)
+        gt = k > t
+        eq = k == t
+        eqc = tl.cumsum(eq.to(tl.int32), axis=0) + n_eq
+        sel = gt | (eq & (eqc <= need))
+        selc = tl.cumsum(sel.to(tl.int32), axis=0) + n_sel
+        tl.store(OUT + r * K + selc - 1, p, mask=sel)
