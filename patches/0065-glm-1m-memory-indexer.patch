+# -- patches/0065: prefill selection in row blocks (bounded scratch, tile-shared scoring, no full sort) ------------
+#
+# Upstream scores every row against ``np_max`` pools into an [R, np_max] fp32 buffer and stable-sorts all of it
+# (values, int64 indices and the sort's own buffers: ~36 bytes an entry, 9.7 GB at R = 1024 rows and a 1M-token
+# cache, kept by the caching allocator afterwards). ``select_pools_blocked`` gives every row the same 512 pools:
+#
+# - rows go in blocks of at most ``SELECT_MB`` of scratch, and each block scores only up to its last row's complete
+#   pools (rounded up to 64, at least 512): the pools cut off are -inf with higher indices than every kept pool,
+#   so they rank after all of them (the argument of ``pool_bucket`` above, per block);
+# - ``_scores_rows`` runs ``_scores``' per-row arithmetic unchanged (the same [heads, 128] x [128, 64] tensor-core
+#   dot, the same epilogue and head sum, on the same shapes and warps) for ``BRB`` rows a program, loading each
+#   64-pool tile once for all of them instead of once a row. Each dot output depends only on its own query row
+#   and pool, and the head sum only on its own column, so every score has ``_scores``' bits; ``blocked_ok`` checks
+#   that on the device once (bit for bit, else the sort path is used). The score leaves as the 0050 key's upper
+#   half: an int32 ordered as the stable descending sort orders floats (-0.0 == +0.0, NaN above +inf);
+# - the 512th largest key t of a row (``torch.topk`` over the int32 keys: its value is exact whatever its
+#   algorithm), then ``_gather_sel`` lists, in pool order, every pool with key > t and the lowest-index pools with
+#   key == t until 512: exactly the first 512 of the stable descending sort, already ascending.
+
+SMALL_ROWS = 8           # windows up to this many rows (decode, verify, MTP) keep the sorted path
+BRB = 16                 # rows a scoring program serves with one pool tile
+SELECT = os.environ.get("GLM53_TF_SELECT", "blocked").strip() or "blocked"
+if SELECT not in ("blocked", "sort"):
+    raise ValueError(f"GLM53_TF_SELECT must be blocked or sort, not {SELECT!r}")
+SELECT_MB = int(os.environ.get("GLM53_TF_SELECT_MB", "256") or 256)
+_KEY_NONE = -2147483648  # below every score's key (-inf maps to -2139095041)
+
+
+@triton.jit
+def _score_key(s):
+    """fp32 score -> int32 ordered as the stable descending sort orders scores (``_keys``' upper half)."""
+
+    b = s.to(tl.int32, bitcast=True)
+    b = tl.where(s == 0.0, 0, b)
+    b = tl.where(s != s, 0x7FC00000, b)
+    return tl.where(b < 0, b ^ 0x7FFFFFFF, b)
+
+
+@triton.jit
+def _scores_rows(QI, W, w_stride, PK, OUT, POS, R, NP, row0, scale, H: tl.constexpr, D: tl.constexpr,
+                 BP: tl.constexpr, BRB: tl.constexpr, NH: tl.constexpr = 32,
+                 WS: tl.constexpr = 1.0 / 5.656854249492381, KEYS: tl.constexpr = True):
+    """Program (row block, pool block): rows row0 + rb BRB .. (< R) of the window, each exactly as ``_scores``
+    program (r, pb) computes it, against one pool tile loaded for all of them; row r's result goes to row
+    r - row0 of OUT [*, NP] (int32 keys, or with KEYS=False the fp32 scores, for the check)."""
+
+    rb = tl.program_id(0)
+    pb = tl.program_id(1)
+    P = tl.load(POS)
+    p = pb * BP + tl.arange(0, BP)
+    d = tl.arange(0, D)
+    hh = tl.arange(0, H)
+    r_first = row0 + rb * BRB
+    r_last = tl.minimum(r_first + BRB, R) - 1
+    nmax = (P + r_last + 1) // 4
+    # pools past a row's own count score -inf below, so loading up to the block's last row changes no kept score
+    k = tl.load(PK + p[:, None] * D + d[None, :], mask=(p < nmax)[:, None], other=0.0).to(tl.bfloat16)  # [BP, D]
+    for i in range(BRB):
