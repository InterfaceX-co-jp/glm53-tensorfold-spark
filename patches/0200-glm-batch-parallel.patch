+def pick_pieces(prefilling: Sequence[tuple[int, int, int]], allow: bool, short: int = 0) -> list[int]:
+    """patches/0200 (GLM53_TF_BATCH_SHORT=N > 0): this round's pieces, from (slot, tokens left, admission order).
+    Every prompt with at most ``short`` tokens left prefills now, fewest left first, whether or not the fair share
+    allows a piece (its piece ends it: a few hundred ms of expert reads, where waiting a share for each of several
+    new prompts staggers their first tokens by seconds); then, when ``allow``, the next piece of the others
+    (``pick_piece``). short = 0: ``pick_piece`` alone (patches/0120)."""
+
+    if short <= 0:
+        one = pick_piece(prefilling) if allow else None
+        return [] if one is None else [one]
+    small = sorted((p for p in prefilling if p[1] <= short), key=lambda p: (p[1], p[2], p[0]))
+    out = [p[0] for p in small]
+    rest = [p for p in prefilling if p[1] > short]
+    if allow and rest:
+        out.append(pick_piece(rest))
+    return out
+
+
+# -- patches/0200: graph keys ---------------------------------------------------------------------------------------
+def pad_mask(spec: str, most: int) -> int:
+    """GLM53_TF_BATCH_PAD ("2,4,8" or "" / "0": off) as a bit mask of window sizes (bit r-1 for r rows, r <= most):
+    the int both ranks compare at load."""
+
+    mask = 0
+    for part in str(spec or "").replace(";", ",").split(","):
+        part = part.strip()
+        if not part or part == "0":
+            continue
+        r = int(part)
+        if not 1 <= r <= most:
+            raise ValueError(f"GLM53_TF_BATCH_PAD={spec!r}: window sizes are 1..{most}")
+        mask |= 1 << (r - 1)
+    return mask
+
+
+def padded(R: int, mask: int) -> int:
+    """A window of R rows padded up to the next size in ``mask`` (R itself when none is >= R or the mask is 0).
+    Padded rows repeat the window's last token; they are verified like drafts that can never be accepted (the accept
+    rule only reads the real drafts), so the committed rows and every kept bit are those of the unpadded window
+    (rows never depend on their window-mates). The point: fewer distinct (slots, rows) graph keys."""
+
+    r = int(R)
+    while mask and r <= mask.bit_length():
+        if mask >> (r - 1) & 1:
+            return r
+        r += 1
+    return int(R)
+
+
+class Sightings:
+    """patches/0200 (GLM53_TF_BATCH_CAPTURE_AFTER=N): a multi-sequence graph key is captured the N-th time it is met;
+    before that its rounds run eagerly through the same capturable code (the same bits). A capture costs a warm-up
+    forward, the capture itself and the graph's instantiation (tens of ms against a ~90 ms round), so keys met once
+    (most of them, with 2-4 slots of 1-8 rows each) no longer pay it. N = 1: every key on first sight (patches/0120).
+    Both ranks count the same keys in the same order (the rounds are the same)."""
+
+    def __init__(self, after: int = 1) -> None:
+        if int(after) < 1:
+            raise ValueError(f"GLM53_TF_BATCH_CAPTURE_AFTER={after}: expected >= 1")
+        self.after = int(after)
+        self.seen: dict = {}
+
+    def capture(self, key) -> bool:
+        n = self.seen.get(key, 0) + 1
+        self.seen[key] = n
+        return n >= self.after
+
