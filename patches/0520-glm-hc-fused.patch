diff --git i/src/tensorfold/families/glm5_next/cuda/hc_cuda.py w/src/tensorfold/families/glm5_next/cuda/hc_cuda.py
new file mode 100644
index 0000000..262262b
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/hc_cuda.py
@@ -0,0 +1,330 @@
+"""patches/0520: a layer boundary of the hyper-connections as one CUDA kernel (``hc_fused.cu``), GLM53_TF_HC_CUDA=1.
+
+A boundary is ``glue.hc_post(x, x, g, post, comb)`` (the block's gathered partials mixed into the 4 streams) followed
+by the next ``glue.hc_pre`` (``_hc_partial``: the 24 mixing dots in 16 K blocks; ``_hc_finish``: Sinkhorn, pre /
+post / comb, the collapsed row and its RMSNorm + 64-group sums). Three Triton kernels, latency-bound at decode sizes
+(docs/THEORY-2.md section 1.5: ~15.6 us a boundary, 89 boundaries a forward). ``hc_fused.cu`` runs all three in one
+launch with every output bit of the Triton kernels (x, normed, xs, post, comb and the partial buffer): the same fp32
+operations in the same order per element, the same reduction trees, and the same approximate unit instructions with
+the scaling ptxas puts around them (docs/HC-FUSED.md; tests/hc_fused_emu.py is the specification, checked against
+the Triton kernels' PTX and against this kernel's PTX).
+
+Where: ``forward.layer_forward`` (a layer's attention -> MLP boundary, and its MLP -> the next layer's attention
+boundary: the kernel then also computes the next layer's first hc_pre, which that layer skips) and
+``batch.compute_multi`` (the same two). Only for windows of 1 .. GLM53_TF_HC_CUDA_ROWS rows (default 16, at most
+64) outside fast-prefill chunks (their hc_pre is ``fast_qmm``'s / b12x's, other arithmetic); everything else runs the
+Triton kernels as before.
+
+Knobs (read at import on each rank):
+
+``GLM53_TF_HC_CUDA``        0 (default) | 1. Load-time; both ranks must agree (``Engine`` checks, like the other
+                            load-time knobs). With 1 the engine compiles the kernel at load and runs a bitwise
+                            self-check against the Triton kernels on random rows (``self_check``); the kernel is used
+                            only if the check passed on both ranks (a different ptxas / Triton than the one the
+                            kernel was derived from would show here), otherwise both ranks keep the Triton kernels.
+``GLM53_TF_HC_CUDA_ROWS``   the most rows a window may have to use the kernel (1 .. 64, default 16). Placement only.
+``GLM53_TF_HC_CUDA_RG``     rows a group of step CTAs handles (1, 2, 4, 8; default 4). Placement only.
+``GLM53_TF_HC_CUDA_PDL``    1: launch the kernel as a programmatic dependent of the kernel before it (sm_90+): its
+                            CTAs load fn / the norm weight, then ``griddepcontrol.wait`` before reading anything an
+                            earlier kernel wrote. Default 0. Timing only (tests/cuda/bench_hc_fused.py measures it).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from functools import lru_cache
+from pathlib import Path
+
+ENV = "GLM53_TF_HC_CUDA"
+ENV_ROWS = "GLM53_TF_HC_CUDA_ROWS"
+ENV_RG = "GLM53_TF_HC_CUDA_RG"
+ENV_PDL = "GLM53_TF_HC_CUDA_PDL"
+MAX_ROWS = 64                            # hc_fused.cu: 32 step CTAs a group, up to 64 groups; the scratch is sized so
+D = 4096                                 # the only shape the kernel is written for (hidden 4096, 4 streams, 16 blocks)
+S = 4
+NB = 16
+RGS = (1, 2, 4, 8)
+TICKETS = 65                             # hc_fused.cu MAX_GROUPS + 1
+
+
+def parse(value: str | None) -> bool:
+    raw = (value or "").strip().lower()
+    if raw in ("", "0", "off", "false", "no"):
+        return False
+    if raw in ("1", "on", "true", "yes"):
+        return True
+    raise ValueError(f"{ENV} must be 0 or 1, not {value!r}")
+
+
+def parse_rows(value: str | None) -> int:
+    raw = (value or "").strip()
+    if not raw:
+        return 16
+    try:
+        n = int(raw)
+    except ValueError:
+        n = 0
+    if not 1 <= n <= MAX_ROWS:
+        raise ValueError(f"{ENV_ROWS} must be an integer 1 .. {MAX_ROWS}, not {value!r}")
+    return n
+
+
+def parse_rg(value: str | None) -> int:
+    raw = (value or "").strip()
+    if not raw:
+        return 4
+    try:
+        n = int(raw)
+    except ValueError:
+        n = 0
+    if n not in RGS:
+        raise ValueError(f"{ENV_RG} must be one of {RGS}, not {value!r}")
+    return n
+
+
+REQUESTED = parse(os.environ.get(ENV))   # the knob as set
+ROWS = parse_rows(os.environ.get(ENV_ROWS))
+RG = parse_rg(os.environ.get(ENV_RG))
+PDL = parse(os.environ.get(ENV_PDL)) if os.environ.get(ENV_PDL, "").strip() else False
+# the kernel runs only when ON: set by the engine after the load-time self-check passed on both ranks (tests set it)
+ON = False
+BROKEN = ""                              # why the kernel cannot run here (build or launch failure): Triton kernels
+
+
+def settings() -> list[int]:
+    """What both ranks must agree on (``Engine._gather_ints``)."""
+
+    return [int(REQUESTED)]
+
+
+def configure(on: bool, rows: int | None = None, rg: int | None = None) -> None:
+    global ON, ROWS, RG
+    ON = bool(on)
+    if rows is not None:
+        ROWS = parse_rows(str(rows))
+    if rg is not None:
+        RG = parse_rg(str(rg))
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    """Built for this GPU's architecture only (as patches/0440's extensions)."""
+
+    import torch
+    from torch.utils.cpp_extension import load
+
+    here = Path(__file__).parent
+    major, minor = torch.cuda.get_device_capability()
+    saved = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = f"{major}.{minor}"
+    try:
+        return load(name="tensorfold_glm_hc_fused_v1", sources=[str(here / "hc_fused.cpp"), str(here / "hc_fused.cu")],
+                    extra_cuda_cflags=["-O3"], verbose=False)
+    finally:
+        if saved is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = saved
+
+
+class _Scratch:
+    __slots__ = ("xp", "ts", "cnt")
+
+    def __init__(self, device) -> None:
+        import torch
+
+        self.xp = torch.empty((MAX_ROWS, S * D), dtype=torch.bfloat16, device=device)
+        self.ts = torch.empty((MAX_ROWS, NB, 8, 24), dtype=torch.float32, device=device)
+        self.cnt = torch.zeros((TICKETS,), dtype=torch.int32, device=device)
+
+
+_SCRATCH: dict = {}
+
+
+def scratch(part):
+    """The kernel's scratch for the buffers ``part`` belongs to (one per ``Buffers``: windows that could run at the
+    same time never share tickets), allocated on the first (eager) use, before any graph capture. Every launch leaves
+    the tickets at zero."""
+
+    key = (part.device.index, part.untyped_storage().data_ptr())
+    s = _SCRATCH.get(key)
+    if s is None:
+        s = _Scratch(part.device)
+        _SCRATCH[key] = s
+    return s
+
+
+def fits(x, g, post, comb, fn, base, scale, norm_w, out, xs, part, cuda: bool = True) -> str | None:
+    """None when the kernel applies to this boundary, else why not (the Triton kernels run). ``cuda=False`` (tests):
+    the same rules on CPU tensors."""
+
+    from . import glue
+
+    if not ON:
+        return "off"
+    if BROKEN:
+        return BROKEN
+    if glue.FAST_HC is not None or glue.MHC:
+        return "fast-prefill chunk (another hc_pre)"
+    if cuda and not all(t.is_cuda for t in (x, g, post, comb, fn, base, scale, norm_w, out, xs, part)):
+        return "not CUDA"
+    rows, wide = x.shape
+    if not 1 <= rows <= ROWS:
+        return f"{rows} rows"
+    if glue.HC_BLOCKS != NB or wide != S * D or norm_w.shape != (D,):
+        return "shape"
+    import torch
+
+    bf, f32 = torch.bfloat16, torch.float32
+    world = g.shape[0]
+    if (x.dtype != bf or x.stride(1) != 1 or x.stride(0) != wide or g.dtype != f32 or g.dim() != 3
+            or g.shape[1:] != (rows, D) or g.stride(2) != 1 or g.stride(1) != D or not 1 <= world <= 4):
+        return "layout"
+    if (post.dtype != f32 or post.shape != (rows, S) or not post.is_contiguous() or comb.dtype != f32
+            or comb.shape != (rows, S * S) or not comb.is_contiguous()):
+        return "post / comb layout"
+    if (fn.dtype != bf or fn.shape != (24, wide) or not fn.is_contiguous() or base.dtype != f32 or base.numel() < 24
+            or not base.is_contiguous() or scale.dtype != f32 or scale.numel() < 3 or not scale.is_contiguous()
+            or norm_w.dtype != bf or not norm_w.is_contiguous()):
+        return "weights layout"
+    if (out.dtype != bf or out.shape != (rows, D) or not out.is_contiguous() or xs.dtype != f32
+            or xs.shape != (rows, D // 64) or not xs.is_contiguous() or part.dtype != f32
+            or part.shape != (rows, NB, 32) or not part.is_contiguous()):
+        return "output layout"
+    for t in (fn, norm_w, out, x):
+        if t.data_ptr() % 16:
+            return "alignment"
+    return None
+
+
+def pdl_supported() -> bool:
+    import torch
+
+    return torch.cuda.is_available() and torch.cuda.get_device_capability()[0] >= 9
+
+
+def launch(x, g, post, comb, fn, base, scale, norm_w, out, xs, part, eps: float, hc_eps: float, iters: int,
+           rg: int | None = None, pdl: bool | None = None) -> None:
+    """The boundary on ``x`` in place (check ``fits`` first)."""
+
+    rows = x.shape[0]
+    s = scratch(part)
+    pdl = PDL if pdl is None else pdl
+    _ext().hc_fused(x, g, g.stride(0), g.shape[0], post, comb, fn, base, scale, norm_w, out, xs, part, s.xp, s.ts,
+                    s.cnt, rows, min(rows, rg or RG), iters, float(eps), float(hc_eps), bool(pdl and pdl_supported()))
+
+
+def post_pre(x, g, post, comb, h, norm_w, out, xs, part, eps: float, hc_eps: float, iters: int) -> bool:
+    """``glue.hc_post(x, x, g, post, comb)`` then ``glue.hc_pre(x, h.fn, h.base, h.scale, norm_w, out, xs, post,
+    comb, part, ...)`` in one kernel, or False (nothing done: the caller runs the two)."""
+
+    global BROKEN
+    if not ON or h is None:
+        return False
+    if fits(x, g, post, comb, h.fn, h.base, h.scale, norm_w, out, xs, part) is not None:
+        return False
+    if (part.device.index, part.untyped_storage().data_ptr()) not in _SCRATCH and _capturing():
+        return False                    # no allocation inside a capture: this graph keeps the Triton kernels
+    try:
+        launch(x, g, post, comb, h.fn, h.base, h.scale, norm_w, out, xs, part, eps, hc_eps, iters)
+    except Exception as exc:                        # noqa: BLE001 - a build / launch failure: Triton from now on
+        if x.is_cuda and _capturing():
+            raise
+        BROKEN = f"{type(exc).__name__}: {exc}"
+        print(f"[tensorfold] {ENV}: the fused hc kernel cannot run here ({BROKEN}); Triton kernels", file=sys.stderr,
+              flush=True)
+        return False
+    return True
+
+
+def _capturing() -> bool:
+    import torch
+
+    return torch.cuda.is_current_stream_capturing()
+
+
+# -- the layer-to-layer boundary (forward.layer_forward) -----------------------------------------------------------
+def next_layer(w, layer):
+    """The layer after ``layer`` in ``w.layers`` (None for the last one, or a layer without hyper-connections)."""
+
+    nxt = w.meta.get("hc_cuda_next")
+    if nxt is None or nxt[0] is not w.layers:
+        layers = w.layers
+        nxt = (layers, {id(a): b for a, b in zip(layers, layers[1:])})
+        w.meta["hc_cuda_next"] = nxt
+    n = nxt[1].get(id(layer))
+    return n if n is not None and n.attn_hc is not None else None
+
+
+def mark_ready(b, layer, rows: int) -> None:
+    """``layer``'s first hc_pre was computed by the previous boundary's kernel (its outputs are in b.normed / b.xs /
+    b.post / b.comb / b.hcpart for ``rows`` rows)."""
+
+    b.hc_cuda_ready = (id(layer), rows)
+
+
+def take_ready(b, layer, rows: int) -> bool:
+    """Whether ``layer``'s first hc_pre is already done (and forget the mark either way: a mark only ever serves the
+    very next layer_forward, so a stale one after an interrupted forward costs nothing but a recomputation)."""
+
+    got = getattr(b, "hc_cuda_ready", None)
+    if got is None:
+        return False
+    b.hc_cuda_ready = None
+    return got == (id(layer), rows)
+
+
+# -- load-time self-check --------------------------------------------------------------------------------------------
+def self_check(device, rows=(1, 3, 16), seed: int = 0) -> str | None:
+    """Run the kernel and the Triton kernels (glue.hc_post + glue.hc_pre) on the same random rows; None when every
+    output is bit for bit the same (x, normed, xs, post, comb, the partials), else what differs. Compiles the
+    extension on first use."""
+
+    import torch
+
+    from . import glue
+
+    global ON
+    saved = ON
+    try:
+        gen = torch.Generator(device="cpu").manual_seed(seed)
+        bf, f32 = torch.bfloat16, torch.float32
+        fn = (torch.randn((24, S * D), generator=gen) * 0.02).to(bf).to(device)
+        base = (torch.randn((24,), generator=gen) * 0.5).to(f32).to(device)
+        scale = torch.tensor([0.9, 1.4, 2.3], dtype=f32).to(device)
+        nw = (1 + 0.1 * torch.randn((D,), generator=gen)).to(bf).to(device)
+        for r in rows:
+            if r > MAX_ROWS:
+                continue
+            x0 = torch.randn((r, S * D), generator=gen).to(bf).to(device)
+            g = torch.randn((2, r, D), generator=gen).to(f32).to(device)
+            post = (torch.rand((r, S), generator=gen) * 2).to(device)
+            comb = (torch.rand((r, S * S), generator=gen) * 0.5).to(device)
+            outs = []
+            for fused in (False, True):
+                x = x0.clone()
+                p, c = post.clone(), comb.clone()
+                out = torch.zeros((r, D), dtype=bf, device=device)
+                xs = torch.zeros((r, D // 64), dtype=f32, device=device)
+                part = torch.zeros((r, NB, 32), dtype=f32, device=device)
+                if fused:
+                    ON = True
+                    why = fits(x, g, p, c, fn, base, scale, nw, out, xs, part)
+                    if why is not None:
+                        return f"does not apply to the check's rows ({why})"
+                    launch(x, g, p, c, fn, base, scale, nw, out, xs, part, 1e-5, 1e-6, 20)
+                else:
+                    glue.hc_post(x, x, g, p, c)
+                    glue.hc_pre(x, fn, base, scale, nw, out, xs, p, c, part, 1e-5, 1e-6, 20)
+                torch.cuda.synchronize(device)
+                outs.append((x, out, xs, p, c, part[:, :, :25].contiguous()))
+            for name, a, b in zip(("x", "normed", "xs", "post", "comb", "partials"), outs[0], outs[1]):
+                if not torch.equal(a.view(torch.int16) if a.dtype == bf else a.view(torch.int32),
+                                   b.view(torch.int16) if b.dtype == bf else b.view(torch.int32)):
+                    return f"{name} differs at {r} rows"
+        return None
+    except Exception as exc:                        # noqa: BLE001
+        return f"{type(exc).__name__}: {exc}"
+    finally:
+        ON = saved
diff --git i/src/tensorfold/families/glm5_next/cuda/hc_fused.cpp w/src/tensorfold/families/glm5_next/cuda/hc_fused.cpp
new file mode 100644
index 0000000..7cd181b
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/hc_fused.cpp
@@ -0,0 +1,51 @@
+// patches/0520: binding of hc_fused.cu (one hyper-connection boundary in one launch, GLM53_TF_HC_CUDA=1).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void hc_fused_cuda(at::Tensor x, const at::Tensor& g, int64_t rs, int64_t world, at::Tensor post, at::Tensor comb,
+                   const at::Tensor& fn, const at::Tensor& base, const at::Tensor& scale, const at::Tensor& nw,
+                   at::Tensor out, at::Tensor xs, at::Tensor part, at::Tensor xp, at::Tensor ts, at::Tensor cnt,
+                   int64_t R, int64_t rg, int64_t iters, double eps, double hc_eps, bool pdl);
+
+static void check(const at::Tensor& t, at::ScalarType ty, const char* name) {
+    TORCH_CHECK(t.is_cuda() && t.scalar_type() == ty, name, ": expected a CUDA tensor of the right dtype");
+}
+
+void hc_fused(at::Tensor x, const at::Tensor& g, int64_t rs, int64_t world, at::Tensor post, at::Tensor comb,
+              const at::Tensor& fn, const at::Tensor& base, const at::Tensor& scale, const at::Tensor& nw,
+              at::Tensor out, at::Tensor xs, at::Tensor part, at::Tensor xp, at::Tensor ts, at::Tensor cnt, int64_t R,
+              int64_t rg, int64_t iters, double eps, double hc_eps, bool pdl) {
+    constexpr int64_t D = 4096, WIDE = 4 * D;
+    check(x, at::kBFloat16, "x");
+    check(g, at::kFloat, "g");
+    check(post, at::kFloat, "post");
+    check(comb, at::kFloat, "comb");
+    check(fn, at::kBFloat16, "fn");
+    check(base, at::kFloat, "base");
+    check(scale, at::kFloat, "scale");
+    check(nw, at::kBFloat16, "nw");
+    check(out, at::kBFloat16, "out");
+    check(xs, at::kFloat, "xs");
+    check(part, at::kFloat, "part");
+    check(xp, at::kBFloat16, "xp");
+    check(ts, at::kFloat, "ts");
+    check(cnt, at::kInt, "cnt");
+    TORCH_CHECK(R >= 1 && R <= 64 && rg >= 1 && rg <= 8 && world >= 1 && world <= 4 && iters >= 1, "hc_fused: sizes");
+    TORCH_CHECK(x.size(0) == R && x.size(1) == WIDE && x.stride(0) == WIDE && x.stride(1) == 1, "hc_fused: x");
+    TORCH_CHECK(g.dim() == 3 && g.size(0) == world && g.size(1) == R && g.size(2) == D && g.stride(2) == 1 &&
+                g.stride(1) == D && g.stride(0) == rs, "hc_fused: g");
+    TORCH_CHECK(post.is_contiguous() && post.numel() == R * 4 && comb.is_contiguous() && comb.numel() == R * 16,
+                "hc_fused: post / comb");
+    TORCH_CHECK(fn.is_contiguous() && fn.size(0) == 24 && fn.size(1) == WIDE && base.is_contiguous() &&
+                base.numel() >= 24 && scale.is_contiguous() && scale.numel() >= 3 && nw.is_contiguous() &&
+                nw.numel() == D, "hc_fused: weights");
+    TORCH_CHECK(out.is_contiguous() && out.numel() == R * D && xs.is_contiguous() && xs.numel() == R * (D / 64) &&
+                part.is_contiguous() && part.numel() == R * 16 * 32, "hc_fused: outputs");
+    TORCH_CHECK(xp.is_contiguous() && xp.numel() >= R * WIDE && ts.is_contiguous() && ts.numel() >= R * 16 * 8 * 24 &&
+                cnt.is_contiguous() && cnt.numel() >= 65, "hc_fused: scratch");
+    c10::cuda::CUDAGuard guard(x.device());
+    hc_fused_cuda(x, g, rs, world, post, comb, fn, base, scale, nw, out, xs, part, xp, ts, cnt, R, rg, iters, eps,
+                  hc_eps, pdl);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("hc_fused", &hc_fused); }
diff --git i/src/tensorfold/families/glm5_next/cuda/hc_fused.cu w/src/tensorfold/families/glm5_next/cuda/hc_fused.cu
new file mode 100644
index 0000000..9052ec5
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/hc_fused.cu
@@ -0,0 +1,523 @@
+// patches/0520: one layer boundary of the hyper-connections in one launch (GLM53_TF_HC_CUDA=1, off by default):
+//     glue._hc_post  (X_s = bf16(post_s * branch + sum_j comb[j, s] X_j), branch = bf16(sum of the ranks' partials))
+//  -> glue._hc_partial (the 24 mixing dots of the new streams with fn + their square sums, 16 K blocks)
+//  -> glue._hc_finish  (mixes, Sinkhorn, pre / post / comb, the collapsed row and the next RMSNorm + group sums)
+// with every output bit of the three Triton kernels as Triton 3.7.1 and its ptxas compile them for sm_121
+// (docs/HC-FUSED.md; tests/hc_fused_emu.py is the specification, checked against their PTX).
+//
+// Grid: 32 CTAs a group of up to `rg` rows (one for each 128-column step t of each quarter q of the D columns,
+// every stream), then one "finisher" CTA a row; 256 threads each.
+//  - a step CTA computes the new streams X' of its 4 x 128 columns (hc_post, per element), stores them to XP
+//    (scratch: the finisher writes X, after every step CTA of the group has read X), and the partial dots of those
+//    columns: for each stream s (K block b = 4 s + q) and mix row m, _hc_partial's butterfly(8, 4, 2, 1) over 16
+//    lanes of its in-thread 8-column chain -> TS[r][b][t][m]. Then a ticket on the group's counter.
+//  - a finisher waits for the 32 tickets of its group, then: PART[b][m] = ((+0 + TS[b][0][m]) + ..) + TS[b][7][m]
+//    (_hc_partial's accumulator over t), the square sums (_hc_partial's per-column fma chain over t, butterfly over
+//    the warp's 32 columns, (W0 + W2) + (W1 + W3)), X := XP, and _hc_finish with its thread mapping (the same lanes,
+//    warps, butterflies and smem exchanges).
+// Arithmetic: only round-to-nearest intrinsics (__fmaf_rn / __fmul_rn / __fadd_rn / __fsub_rn), which ptxas never
+// contracts, plus the unit instructions (rcp / sqrt / ex2 .approx.ftz = MUFU) with the scaling ptxas wraps around
+// div.full.f32 and ex2.approx.f32 written out; where ptxas fused one of Triton's multiplies with the next add
+// (div.full + hc_eps, the square-sum chain, x / (S D) + eps), this code has the fma.
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace hcf {
+
+constexpr int D = 4096;                 // hidden
+constexpr int S = 4;                    // streams
+constexpr int WIDE = S * D;
+constexpr int NB = 16;                  // K blocks of the mixing dots (glue.HC_BLOCKS)
+constexpr int KB = WIDE / NB;           // 1024 columns a block
+constexpr int STEPS = KB / 128;         // _hc_partial's SUB = 128: 8 steps a block
+constexpr int NQ = D / KB;              // 4 quarters of a stream
+constexpr int STEP_CTAS = NQ * STEPS;   // 32
+constexpr int NM = 24;                  // mix rows
+constexpr int THREADS = 256;
+constexpr int RG_MAX = 8;
+constexpr int MAX_GROUPS = 64;
+constexpr int DONE = MAX_GROUPS;        // cnt[DONE]: finishers past their wait
+
+struct Args {
+    __nv_bfloat16* x;           // [R, 4D] streams: read by the step CTAs, written (X') by the finishers
+    const float* g;             // [world, R, D] the ranks' fp32 partials, rank stride rs
+    long long rs;
+    int world;
+    float* post;                // [R, 4]  read (this site's) by the step CTAs, written (the next hc_pre's)
+    float* comb;                // [R, 16]
+    const __nv_bfloat16* fn;    // [24, 4D]
+    const float* base;          // [24]
+    const float* scale;         // [3]
+    const __nv_bfloat16* nw;    // [D] the next RMSNorm's weight
+    __nv_bfloat16* out;         // [R, D]
+    float* xs;                  // [R, D / 64]
+    float* part;                // [R, 16, 32]
+    __nv_bfloat16* xp;          // scratch [R, 4D]
+    float* ts;                  // scratch [R, 16, 8, 24]
+    int* cnt;                   // [MAX_GROUPS + 1] tickets, zero between launches
+    int R, rg, groups, iters;
+    float eps, hc_eps;
+    int pdl;                    // launched as a programmatic dependent: wait before reading what earlier kernels wrote
+};
+
+// -- the unit instructions and the sequences ptxas builds around them (sm_121) ---------------------------------------
+__device__ __forceinline__ float rcp_unit(float x) {
+    float r;
+    asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(x));
+    return r;
+}
+__device__ __forceinline__ float sqrt_unit(float x) {         // sqrt.approx.ftz.f32 (Triton's tl.sqrt)
+    float r;
+    asm("sqrt.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(x));
+    return r;
+}
+__device__ __forceinline__ float ex2_unit(float x) {
+    float r;
+    asm("ex2.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(x));
+    return r;
+}
+// ex2.approx.f32 (not ftz), as ptxas lowers it: inputs below -126 halved, the result squared back
+__device__ __forceinline__ float ex2_full(float x) {
+    const bool lo = x < -126.0f;
+    const float h = lo ? __fmul_rn(x, 0.5f) : x;
+    const float r = ex2_unit(h);
+    return lo ? __fmul_rn(r, r) : r;
+}
+// div.full.f32 a / b, as ptxas lowers it: both scaled by 1/4 when |b| > 2^126, by 2^24 when |b| < 2^-126, then
+// RCP(b') and a' (the final multiply is left to the caller: r * a', or fma(r, a', c) where ptxas fused it)
+struct DivParts {
+    float a, r;
+};
+__device__ __forceinline__ DivParts div_parts(float a, float b) {
+    const float ab = fabsf(b);
+    if (ab > 0x1p126f) {
+        a = __fmul_rn(a, 0.25f);
+        b = __fmul_rn(b, 0.25f);
+    }
+    if (ab < 0x1p-126f) {
+        a = __fmul_rn(a, 16777216.0f);
+        b = __fmul_rn(b, 16777216.0f);
+    }
+    return DivParts{a, rcp_unit(b)};
+}
+__device__ __forceinline__ float div_full(float a, float b) {
+    const DivParts p = div_parts(a, b);
+    return __fmul_rn(p.r, p.a);
+}
+__device__ __forceinline__ float div_full_add(float a, float b, float c) {   // div.full + add, fused by ptxas
+    const DivParts p = div_parts(a, b);
+    return __fmaf_rn(p.r, p.a, c);
+}
+// the mixed-precision instructions Triton's kernels use (bf16 operand widened exactly)
+__device__ __forceinline__ float fma_bf16(unsigned short a, unsigned short b, float c) {
+    float r;
+    asm("fma.rn.f32.bf16 %0, %1, %2, %3;" : "=f"(r) : "h"(a), "h"(b), "f"(c));
+    return r;
+}
+__device__ __forceinline__ float add_bf16(unsigned short a, float c) {
+    float r;
+    asm("add.rn.f32.bf16 %0, %1, %2;" : "=f"(r) : "h"(a), "f"(c));
+    return r;
+}
+__device__ __forceinline__ uint32_t mul_bf16x2(uint32_t a, uint32_t b) {
+    uint32_t r;
+    asm("mul.bf16x2 %0, %1, %2;" : "=r"(r) : "r"(a), "r"(b));
+    return r;
+}
+__device__ __forceinline__ float bf(unsigned short v) { return __uint_as_float(uint32_t(v) << 16); }
+__device__ __forceinline__ unsigned short to_bf(float v) {
+    return __bfloat16_as_ushort(__float2bfloat16_rn(v));
+}
+__device__ __forceinline__ uint32_t pack_bf(float lo, float hi) {        // cvt.rn.bf16x2.f32
+    return uint32_t(to_bf(lo)) | (uint32_t(to_bf(hi)) << 16);
+}
+__device__ __forceinline__ float shx(float v, int m) { return __shfl_xor_sync(0xffffffffu, v, m); }
+__device__ __forceinline__ unsigned short lo16(uint32_t w) { return (unsigned short)(w & 0xffffu); }
+__device__ __forceinline__ unsigned short hi16(uint32_t w) { return (unsigned short)(w >> 16); }
+__device__ __forceinline__ int ld_acquire(const int* p) {
+    int v;
+    asm volatile("ld.acquire.gpu.global.b32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+__device__ __forceinline__ uint4 ldcg4(const void* p) { return __ldcg(reinterpret_cast<const uint4*>(p)); }
+__device__ __forceinline__ void pdl_wait(int pdl) {
+    if (pdl) asm volatile("griddepcontrol.wait;" ::: "memory");
+}
+
+// -- a step CTA: hc_post of 4 x 128 columns, then their partial dots --------------------------------------------------
+__device__ void step_cta(const Args& A, int grp, int q, int t) {
+    __shared__ __align__(16) float xsm[RG_MAX][S][128];   // X' of the step (fp32 of the bf16 values; float4 reads)
+    const int lt = threadIdx.x;
+    const int r0 = grp * A.rg;
+    const int nr = min(A.rg, A.R - r0);
+    const int col0 = q * KB + t * 128;                     // column of the step inside a stream
+
+    // fn of the (s, m) pairs this thread dots: lane l = lt % 16 of 16, pairs gi, gi + 16, .. (6 of 96)
+    const int l = lt & 15, gi = lt >> 4;
+    uint4 w[6];
+#pragma unroll
+    for (int i = 0; i < 6; ++i) {
+        const int p = gi + 16 * i, s = p / NM, m = p % NM;
+        w[i] = __ldg(reinterpret_cast<const uint4*>(A.fn + (size_t)m * WIDE + s * D + col0 + l * 8));
+    }
+    pdl_wait(A.pdl);                                       // x, g, post, comb: the earlier kernels' outputs
+    // hc_post: thread -> column c = lt % 128, streams 2 h and 2 h + 1
+    const int c = lt & 127, h = lt >> 7;
+    for (int rr = 0; rr < nr; ++rr) {
+        const int r = r0 + rr;
+        const __nv_bfloat16* xr = A.x + (size_t)r * WIDE + col0 + c;
+        const float x0 = __bfloat162float(xr[0]), x1 = __bfloat162float(xr[D]);
+        const float x2 = __bfloat162float(xr[2 * D]), x3 = __bfloat162float(xr[3 * D]);
+        float acc = A.g[(size_t)r * D + col0 + c];
+        for (int k = 1; k < A.world; ++k) acc = __fadd_rn(acc, A.g[k * A.rs + (size_t)r * D + col0 + c]);
+        const float branch = bf(to_bf(acc));
+#pragma unroll
+        for (int e = 0; e < 2; ++e) {
+            const int s = 2 * h + e;
+            const float c0 = A.comb[r * 16 + 0 + s], c1 = A.comb[r * 16 + 4 + s];
+            const float c2 = A.comb[r * 16 + 8 + s], c3 = A.comb[r * 16 + 12 + s];
+            const float ps = A.post[r * S + s];
+            float v = __fmul_rn(x1, c1);
+            v = __fmaf_rn(x0, c0, v);
+            v = __fmaf_rn(x2, c2, v);
+            v = __fmaf_rn(x3, c3, v);
+            v = __fmaf_rn(branch, ps, v);
+            const unsigned short vb = to_bf(v);
+            xsm[rr][s][c] = bf(vb);
+            A.xp[(size_t)r * WIDE + s * D + col0 + c] = __ushort_as_bfloat16(vb);
+        }
+    }
+    __syncthreads();
+    // the dots: _hc_partial's chain (column 1 multiplied, then fma of 0, 2, .. 7), butterfly 8, 4, 2, 1
+    for (int rr = 0; rr < nr; ++rr) {
+        const int r = r0 + rr;
+#pragma unroll
+        for (int i = 0; i < 6; ++i) {
+            const int p = gi + 16 * i, s = p / NM, m = p % NM;
+            const float4 xa = *reinterpret_cast<const float4*>(&xsm[rr][s][l * 8]);
+            const float4 xb = *reinterpret_cast<const float4*>(&xsm[rr][s][l * 8 + 4]);
+            const uint32_t wv[4] = {w[i].x, w[i].y, w[i].z, w[i].w};
+            float v = __fmul_rn(xa.y, bf(hi16(wv[0])));
+            v = __fmaf_rn(xa.x, bf(lo16(wv[0])), v);
+            v = __fmaf_rn(xa.z, bf(lo16(wv[1])), v);
+            v = __fmaf_rn(xa.w, bf(hi16(wv[1])), v);
+            v = __fmaf_rn(xb.x, bf(lo16(wv[2])), v);
+            v = __fmaf_rn(xb.y, bf(hi16(wv[2])), v);
+            v = __fmaf_rn(xb.z, bf(lo16(wv[3])), v);
+            v = __fmaf_rn(xb.w, bf(hi16(wv[3])), v);
+            v = __fadd_rn(v, shx(v, 8));
+            v = __fadd_rn(v, shx(v, 4));
+            v = __fadd_rn(v, shx(v, 2));
+            v = __fadd_rn(v, shx(v, 1));
+            if (l == 0) A.ts[(((size_t)r * NB + (4 * s + q)) * STEPS + t) * NM + m] = v;
+        }
+    }
+    __threadfence();
+    __syncthreads();
+    if (lt == 0) atomicAdd(A.cnt + grp, 1);
+}
+
+// -- a finisher: the row's partial sums, square sums, X, and _hc_finish ----------------------------------------------
+__device__ void finish_cta(const Args& A, int r) {
+    __shared__ float psm[NB][32];                          // PART[r] (slots 25.. zero)
+    __shared__ float wsm[NB][4];
+    __shared__ float lsm[3][4][4];                         // pre / post logits, comb logits
+    __shared__ float tsm[1];
+    const int lt = threadIdx.x, lane = lt & 31, warp = lt >> 5;
+    const int grp = r / A.rg;
+    // inputs no earlier kernel of this boundary writes
+    const uint4 nw0 = __ldg(reinterpret_cast<const uint4*>(A.nw + 8 * lt));
+    const uint4 nw1 = __ldg(reinterpret_cast<const uint4*>(A.nw + D / 2 + 8 * lt));
+    const float bse = lane < NM ? A.base[lane] : 0.0f;
+    const float s_pre = A.scale[0], s_post = A.scale[1], s_comb = A.scale[2];
+    if (lt < NB * 32) (&psm[0][0])[lt] = 0.0f;
+    if (lt + 256 < NB * 32) (&psm[0][0])[lt + 256] = 0.0f;
+    pdl_wait(A.pdl);                                       // nothing below may run before the earlier kernels end
+
+    if (lt == 0) {
+        while (ld_acquire(A.cnt + grp) < STEP_CTAS) __nanosleep(32);
+    }
+    __syncthreads();
+
+    // X' of this thread's 16 columns of every stream (_hc_finish's layout: 8 lt .. 8 lt + 7 and D/2 + 8 lt ..)
+    const __nv_bfloat16* xpr = A.xp + (size_t)r * WIDE;
+    uint4 xv[S][2];
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+        xv[s][0] = ldcg4(xpr + s * D + 8 * lt);
+        xv[s][1] = ldcg4(xpr + s * D + D / 2 + 8 * lt);
+    }
+    // the partial dots: PART[b][m] = sum over t in order from +0
+    float pv[2];
+    int pb[2];
+#pragma unroll
+    for (int e = 0; e < 2; ++e) {
+        const int j = lt + 256 * e;
+        pb[e] = j;
+        float acc = 0.0f;
+        if (j < NB * NM) {
+            const int b = j / NM, m = j % NM;
+            const float* tp = A.ts + ((size_t)r * NB + b) * STEPS * NM + m;
+            float tv[STEPS];
+#pragma unroll
+            for (int u = 0; u < STEPS; ++u) tv[u] = __ldcg(tp + u * NM);
+#pragma unroll
+            for (int u = 0; u < STEPS; ++u) acc = __fadd_rn(acc, tv[u]);
+        }
+        pv[e] = acc;
+    }
+    // the square sums: column k of block b, fma(x, x, s) over the 8 steps from +0
+    const int k = lt & 127, bh = lt >> 7;
+    float sq[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int b = bh + 2 * i;
+        const __nv_bfloat16* p = xpr + b * KB + k;
+        unsigned short xk[STEPS];
+#pragma unroll
+        for (int u = 0; u < STEPS; ++u) xk[u] = __bfloat16_as_ushort(__ldcg(p + u * 128));
+        float s = 0.0f;
+#pragma unroll
+        for (int u = 0; u < STEPS; ++u) s = fma_bf16(xk[u], xk[u], s);
+        sq[i] = s;
+    }
+    // X := X' (every step CTA of the group has read X)
+    __nv_bfloat16* xr = A.x + (size_t)r * WIDE;
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+        *reinterpret_cast<uint4*>(xr + s * D + 8 * lt) = xv[s][0];
+        *reinterpret_cast<uint4*>(xr + s * D + D / 2 + 8 * lt) = xv[s][1];
+    }
+#pragma unroll
+    for (int e = 0; e < 2; ++e) {
+        const int j = pb[e];
+        if (j < NB * NM) {
+            psm[j / NM][j % NM] = pv[e];
+            A.part[((size_t)r * NB + j / NM) * 32 + j % NM] = pv[e];
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        float v = sq[i];
+        v = __fadd_rn(v, shx(v, 16));
+        v = __fadd_rn(v, shx(v, 8));
+        v = __fadd_rn(v, shx(v, 4));
+        v = __fadd_rn(v, shx(v, 2));
+        v = __fadd_rn(v, shx(v, 1));
+        if (lane == 0) wsm[bh + 2 * i][(k >> 5)] = v;
+    }
+    __syncthreads();
+    if (lt < NB) {
+        const float v = __fadd_rn(__fadd_rn(wsm[lt][0], wsm[lt][2]), __fadd_rn(wsm[lt][1], wsm[lt][3]));
+        psm[lt][NM] = v;
+        A.part[((size_t)r * NB + lt) * 32 + NM] = v;
+    }
+    __syncthreads();
+
+    // ---- _hc_finish (lt = its thread id) ----
+    float mix = 0.0f, ss = 0.0f;
+#pragma unroll
+    for (int b = 0; b < NB; ++b) {
+        mix = __fadd_rn(mix, psm[b][lane]);
+        ss = __fadd_rn(ss, psm[b][NM]);
+    }
+    const float rinv = div_full(1.0f, sqrt_unit(__fmaf_rn(ss, 0x1p-14f, A.eps)));
+    const float mixs = __fmul_rn(mix, rinv);
+    auto pick = [&](float sc, int target) {
+        float v = lane == target ? __fmaf_rn(mixs, sc, bse) : 0.0f;
+        v = __fadd_rn(v, shx(v, 16));
+        v = __fadd_rn(v, shx(v, 8));
+        v = __fadd_rn(v, shx(v, 4));
+        v = __fadd_rn(v, shx(v, 2));
+        v = __fadd_rn(v, shx(v, 1));
+        return v;
+    };
+    {
+        const float pl = pick(s_pre, warp & 3);
+        const float ql = pick(s_post, (warp & 3) + 4);
+        const float c1 = pick(s_comb, 8 + warp);            // (i, j) = (warp / 4, warp % 4)
+        const float c2 = pick(s_comb, 16 + warp);           // (warp / 4 + 2, warp % 4)
+        if (lane == 0) {
+            if (warp < 4) {
+                lsm[0][0][warp] = pl;
+                lsm[1][0][warp] = ql;
+            }
+            lsm[2][warp >> 2][warp & 3] = c1;
+            lsm[2][(warp >> 2) + 2][warp & 3] = c2;
+        }
+    }
+    __syncthreads();
+    const int ci = (lane >> 2) & 3, cj = lane & 3;
+    const float pre_l = lsm[0][0][lt & 3], post_l = lsm[1][0][lt & 3];
+    const float cl = lsm[2][ci][cj];
+    // Sinkhorn: rows over j (lanes xor 2, 1), columns over i (lanes xor 8, 4)
+    float cmax = fmaxf(cl, shx(cl, 2));
+    cmax = fmaxf(cmax, shx(cmax, 1));
+    const float ce = ex2_full(__fmul_rn(__fsub_rn(cl, cmax), 1.44269502162933349609375f));
+    float rsum = __fadd_rn(ce, shx(ce, 2));
+    rsum = __fadd_rn(rsum, shx(rsum, 1));
+    float cm = div_full_add(ce, rsum, A.hc_eps);
+    float csum = __fadd_rn(cm, shx(cm, 8));
+    csum = __fadd_rn(csum, shx(csum, 4));
+    cm = div_full(cm, __fadd_rn(csum, A.hc_eps));
+    for (int it = 1; it < A.iters; ++it) {
+        rsum = __fadd_rn(cm, shx(cm, 2));
+        rsum = __fadd_rn(rsum, shx(rsum, 1));
+        cm = div_full(cm, __fadd_rn(rsum, A.hc_eps));
+        csum = __fadd_rn(cm, shx(cm, 8));
+        csum = __fadd_rn(csum, shx(csum, 4));
+        cm = div_full(cm, __fadd_rn(csum, A.hc_eps));
+    }
+    const float tp = div_full(1.0f, __fadd_rn(ex2_full(__fmul_rn(__fsub_rn(0.0f, post_l), 1.44269502162933349609375f)),
+                                              1.0f));
+    const float post = __fadd_rn(tp, tp);
+    const float pre = div_full_add(1.0f, __fadd_rn(ex2_full(__fmul_rn(__fsub_rn(0.0f, pre_l),
+                                                                      1.44269502162933349609375f)), 1.0f),
+                                   A.hc_eps);
+    if (lt < 4) A.post[r * S + lt] = post;
+    if (lt < 16) A.comb[r * 16 + (lt & 12) + (lt & 3)] = cm;
+    float pk[4];
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) {
+        float v = (lt & 3) == kk ? pre : 0.0f;
+        v = __fadd_rn(v, shx(v, 2));
+        v = __fadd_rn(v, shx(v, 1));
+        pk[kk] = v;
+    }
+    // the collapsed row: slot j even: fma(p1, x1, p0 x0), odd: fma(p0, x0, p1 x1); then + p2 x2, + p3 x3
+    float cv[16];
+#pragma unroll
+    for (int hf = 0; hf < 2; ++hf) {
+        const uint32_t* w0 = reinterpret_cast<const uint32_t*>(&xv[0][hf]);
+        const uint32_t* w1 = reinterpret_cast<const uint32_t*>(&xv[1][hf]);
+        const uint32_t* w2 = reinterpret_cast<const uint32_t*>(&xv[2][hf]);
+        const uint32_t* w3 = reinterpret_cast<const uint32_t*>(&xv[3][hf]);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const float a0 = bf(j & 1 ? hi16(w0[j >> 1]) : lo16(w0[j >> 1]));
+            const float a1 = bf(j & 1 ? hi16(w1[j >> 1]) : lo16(w1[j >> 1]));
+            const float a2 = bf(j & 1 ? hi16(w2[j >> 1]) : lo16(w2[j >> 1]));
+            const float a3 = bf(j & 1 ? hi16(w3[j >> 1]) : lo16(w3[j >> 1]));
+            float v = (j & 1) ? __fmaf_rn(pk[0], a0, __fmul_rn(pk[1], a1)) : __fmaf_rn(pk[1], a1, __fmul_rn(pk[0], a0));
+            v = __fmaf_rn(pk[2], a2, v);
+            v = __fmaf_rn(pk[3], a3, v);
+            cv[8 * hf + j] = bf(to_bf(v));
+        }
+    }
+    // square sum: slot 1 squared, then fma of 0, 2, .. 7, 8, .. 15 (ptxas fused the unfused odd squares)
+    float s2 = __fmul_rn(cv[1], cv[1]);
+    s2 = __fmaf_rn(cv[0], cv[0], s2);
+#pragma unroll
+    for (int j = 2; j < 16; ++j) s2 = __fmaf_rn(cv[j], cv[j], s2);
+    s2 = __fadd_rn(s2, shx(s2, 16));
+    s2 = __fadd_rn(s2, shx(s2, 8));
+    s2 = __fadd_rn(s2, shx(s2, 4));
+    s2 = __fadd_rn(s2, shx(s2, 2));
+    s2 = __fadd_rn(s2, shx(s2, 1));
+    __shared__ float wq[8];
+    if (lane == 0) wq[warp] = s2;
+    __syncthreads();
+    if (warp == 0) {
+        float v = lane < 8 ? wq[lane] : 0.0f;
+        v = __fadd_rn(v, shx(v, 4));
+        v = __fadd_rn(v, shx(v, 2));
+        v = __fadd_rn(v, shx(v, 1));
+        if (lane == 0) tsm[0] = v;
+    }
+    __syncthreads();
+    const float rinv2 = div_full(1.0f, sqrt_unit(__fmaf_rn(tsm[0], 0x1p-12f, A.eps)));
+    // y = bf16(w * bf16(c * rinv2)), then the 64-column group sums (8 threads x 8 columns, butterfly 4, 2, 1)
+    uint32_t yw[8];
+    const uint32_t* n0 = reinterpret_cast<const uint32_t*>(&nw0);
+    const uint32_t* n1 = reinterpret_cast<const uint32_t*>(&nw1);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        yw[j] = mul_bf16x2(n0[j], pack_bf(__fmul_rn(rinv2, cv[2 * j]), __fmul_rn(rinv2, cv[2 * j + 1])));
+        yw[4 + j] = mul_bf16x2(n1[j], pack_bf(__fmul_rn(rinv2, cv[8 + 2 * j]), __fmul_rn(rinv2, cv[8 + 2 * j + 1])));
+    }
+    __nv_bfloat16* orow = A.out + (size_t)r * D;
+    *reinterpret_cast<uint4*>(orow + 8 * lt) = make_uint4(yw[0], yw[1], yw[2], yw[3]);
+    *reinterpret_cast<uint4*>(orow + D / 2 + 8 * lt) = make_uint4(yw[4], yw[5], yw[6], yw[7]);
+#pragma unroll
+    for (int hf = 0; hf < 2; ++hf) {
+        const uint32_t* y = yw + 4 * hf;
+        float s = add_bf16(lo16(y[0]), bf(hi16(y[0])));
+        s = add_bf16(lo16(y[1]), s);
+        s = add_bf16(hi16(y[1]), s);
+        s = add_bf16(lo16(y[2]), s);
+        s = add_bf16(hi16(y[2]), s);
+        s = add_bf16(lo16(y[3]), s);
+        s = add_bf16(hi16(y[3]), s);
+        s = __fadd_rn(s, shx(s, 4));
+        s = __fadd_rn(s, shx(s, 2));
+        s = __fadd_rn(s, shx(s, 1));
+        if ((lt & 7) == 0) A.xs[(size_t)r * (D / 64) + hf * (D / 128) + (lt >> 3)] = s;
+    }
+    // the last finisher resets the tickets for the next launch
+    if (lt == 0 && atomicAdd(A.cnt + DONE, 1) == A.R - 1) {
+        for (int gg = 0; gg < A.groups; ++gg) atomicExch(A.cnt + gg, 0);
+        atomicExch(A.cnt + DONE, 0);
+    }
+}
+
+__global__ void __launch_bounds__(THREADS) hc_fused_kernel(const Args A) {
+    const int bid = blockIdx.x;
+    const int nstep = STEP_CTAS * A.groups;
+    if (bid < nstep) {
+        step_cta(A, bid / STEP_CTAS, (bid % STEP_CTAS) / STEPS, bid % STEPS);
+    } else {
+        finish_cta(A, bid - nstep);
+    }
+}
+
+}  // namespace hcf
+
+// ---- host ----------------------------------------------------------------------------------------------------------
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+
+void hc_fused_cuda(at::Tensor x, const at::Tensor& g, int64_t rs, int64_t world, at::Tensor post, at::Tensor comb,
+                   const at::Tensor& fn, const at::Tensor& base, const at::Tensor& scale, const at::Tensor& nw,
+                   at::Tensor out, at::Tensor xs, at::Tensor part, at::Tensor xp, at::Tensor ts, at::Tensor cnt,
+                   int64_t R, int64_t rg, int64_t iters, double eps, double hc_eps, bool pdl) {
+    hcf::Args A;
+    A.x = reinterpret_cast<__nv_bfloat16*>(x.data_ptr());
+    A.g = g.data_ptr<float>();
+    A.rs = rs;
+    A.world = int(world);
+    A.post = post.data_ptr<float>();
+    A.comb = comb.data_ptr<float>();
+    A.fn = reinterpret_cast<const __nv_bfloat16*>(fn.data_ptr());
+    A.base = base.data_ptr<float>();
+    A.scale = scale.data_ptr<float>();
+    A.nw = reinterpret_cast<const __nv_bfloat16*>(nw.data_ptr());
+    A.out = reinterpret_cast<__nv_bfloat16*>(out.data_ptr());
+    A.xs = xs.data_ptr<float>();
+    A.part = part.data_ptr<float>();
+    A.xp = reinterpret_cast<__nv_bfloat16*>(xp.data_ptr());
+    A.ts = ts.data_ptr<float>();
+    A.cnt = cnt.data_ptr<int>();
+    A.R = int(R);
+    A.rg = int(rg);
+    A.groups = int((R + rg - 1) / rg);
+    A.iters = int(iters);
+    A.eps = float(eps);
+    A.hc_eps = float(hc_eps);
+    A.pdl = pdl ? 1 : 0;
+    const int blocks = hcf::STEP_CTAS * A.groups + A.R;
+    if (!pdl) {
+        hcf::hc_fused_kernel<<<blocks, hcf::THREADS, 0, at::cuda::getCurrentCUDAStream()>>>(A);
+    } else {
+        cudaLaunchConfig_t cfg = {};
+        cfg.gridDim = dim3(blocks);
+        cfg.blockDim = dim3(hcf::THREADS);
+        cfg.stream = at::cuda::getCurrentCUDAStream();
+        cudaLaunchAttribute attr[1];
+        attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+        attr[0].val.programmaticStreamSerializationAllowed = 1;
+        cfg.attrs = attr;
+        cfg.numAttrs = 1;
+        C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, hcf::hc_fused_kernel, A));
+    }
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
