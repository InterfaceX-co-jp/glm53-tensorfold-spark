@@ -0,0 +1,295 @@
+"""patches/0420: the drafters' vocabulary trimmed to a ranked token list (GLM53_TF_DRAFT_VOCAB; DECODE-PLAN E7,
+FR-Spec style).
+
+A draft step's last matmul is the vocabulary head: 77,440 rows a rank (4-bit, 178 MB), about 0.9 ms of a 1.7 ms
+MTP step. With the knob, the drafters score only a list of token ids: each rank a head of its own listed rows (the
+same 4-bit words, scales and biases, gathered once at load), and the draft is drawn among them. The candidates'
+local indices map back to token ids (``ids_of``) before the ranks exchange them, so the draw is the usual keyed rule
+on token ids: the same Gumbel noise per (seed, position, token id) the target uses.
+
+Exactness does not depend on the list. Drafts only propose; every committed token is the target's own keyed sample
+of its full-vocabulary logits (``decode.sample_rows`` / ``batch.sample_multi`` without ``draft``: untouched), and a
+draft is kept exactly when it equals that token. A token outside the list can never be drafted, so a chain of
+accepted drafts ends there (an acceptance cost, docs/DRAFT-VOCAB.md).
+
+Knobs (load time; both ranks must agree, ``Engine`` checks):
+
+- ``GLM53_TF_DRAFT_VOCAB``: ``""`` / ``0`` / ``off`` (default): the whole vocabulary, upstream's code path and graphs.
+  ``N`` (an integer, 128..154,879): each rank drafts over the first N / 2 ids of its vocabulary half (rank 0: ids below
+  77,440) in the shipped ranking (``draft_vocab.txt``, most frequent first; built from public text by
+  bench/draftvocab_public.py), then that half's other ids by id, rounded up to a multiple of 64 rows. A path: that
+  file's ids (token ids, most frequent first, ``#`` comments; e.g. a ranking of your own traffic written by
+  bench/draftvocab.py --write-list) take the place of the shipped ranking; each rank drafts over the file's ids in
+  its half (at least 64, rounded up to a multiple of 64 with the half's lowest unlisted ids), so the larger half's
+  count decides the cost. ``path:N`` takes the first N / 2 a half of that file.
+- ``GLM53_TF_DRAFT_VOCAB_ARMS``: which drafters use the list: ``mtp`` (default: the study finds DFlash2 rounds lose
+  more tokens than their one head pass saves), ``dflash``, ``all``.
+- ``GLM53_TF_DRAFT_VOCAB_FALLBACK``: ``RATE[,WINDOW]`` (default ``0.03,256``): a request drafts over the whole
+  vocabulary while more than RATE of the last WINDOW tokens its MTP head absorbed (prompt, then every committed
+  token) are unlisted: a CJK conversation, a file of rare identifiers. ``0`` / ``off``: never. The rule reads only
+  committed tokens, so both ranks decide alike; its graphs (full-head MTP steps, a full-head DFlash2 block) are
+  captured next to the trimmed ones at load.
+"""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+import torch
+
+from .qmm import BN, Q4, make_q4
+
+ENV, ARMS_ENV, FB_ENV = "GLM53_TF_DRAFT_VOCAB", "GLM53_TF_DRAFT_VOCAB_ARMS", "GLM53_TF_DRAFT_VOCAB_FALLBACK"
+RANKING = Path(__file__).with_name("draft_vocab.txt")
+ROWS = BN                               # a rank's rows are a multiple of the matmul's column tile
+MIN_ROWS = 64
+FB_DEFAULT = (0.03, 256)
+
+
+@dataclass(frozen=True)
+class Settings:
+    order: tuple[int, ...]              # token ids, most frequent first
+    half: int                           # ids a half takes from ``order`` (0: all of them)
+    mtp: bool
+    dflash: bool
+    fb_rate: float                      # > 1: never
+    fb_window: int
+    source: str
+
+    def ints(self) -> list[int]:  # noqa: D401
+        """What both ranks must agree on, as integers (``Engine._gather_ints``)."""
+
+        digest = hashlib.sha256(",".join(map(str, self.order)).encode()).digest()
+        return [1, self.half, int(self.mtp), int(self.dflash), int(round(min(self.fb_rate, 2.0) * 1e6)),
+                self.fb_window, int.from_bytes(digest[:4], "little") & 0x7FFFFFFF]
+
+
+def read_ids(path: str | Path, vocab: int | None = None) -> list[int]:
+    """A token list file: whitespace-separated ids (``#`` starts a comment), most frequent first; repeats keep
+    their first place."""
+
+    out: dict[int, None] = {}
+    for n, line in enumerate(Path(path).read_text().splitlines(), 1):
+        for word in line.split("#", 1)[0].split():
+            try:
+                i = int(word)
+            except ValueError:
+                raise ValueError(f"{ENV}: {path}:{n}: {word!r} is not a token id") from None
+            if i < 0 or (vocab is not None and i >= vocab):
+                raise ValueError(f"{ENV}: {path}:{n}: token id {i} outside the vocabulary (0..{(vocab or 1) - 1})")
+            out.setdefault(i, None)
+    if not out:
+        raise ValueError(f"{ENV}: {path}: no token ids")
+    return list(out)
+
+
+def _fallback(value: str) -> tuple[float, int]:
+    v = value.strip().lower()
+    if v in ("0", "off", "no", "none"):
+        return 2.0, 1
+    if not v:
+        return FB_DEFAULT
+    try:
+        parts = [p.strip() for p in v.split(",")]
+        rate = float(parts[0])
+        window = int(parts[1]) if len(parts) > 1 and parts[1] else FB_DEFAULT[1]
+    except (ValueError, IndexError):
+        raise ValueError(f"{FB_ENV}={value!r}: expected RATE[,WINDOW] (e.g. 0.03,256) or off") from None
+    if not 0.0 < rate < 1.0 or not 16 <= window <= 65536:
+        raise ValueError(f"{FB_ENV}={value!r}: RATE in (0, 1), WINDOW in 16..65536")
+    return rate, window
+
+
+def settings(env: dict | None = None, vocab: int = 154880) -> Settings | None:
+    """The knobs, parsed (None: off). Raises ValueError on a bad value, at load."""
+
+    env = os.environ if env is None else env
+    v = str(env.get(ENV, "")).strip()
+    if v.lower() in ("", "0", "off", "no", "false", "none"):
+        return None
+    arms = str(env.get(ARMS_ENV, "") or "mtp").strip().lower()
+    if arms not in ("mtp", "dflash", "all"):
+        raise ValueError(f"{ARMS_ENV}={arms!r}: expected mtp, dflash or all")
+    rate, window = _fallback(str(env.get(FB_ENV, "")))
+    half = 0
+    if v.isdigit():
+        n = int(v)
+        if not 2 * MIN_ROWS <= n < vocab:
+            raise ValueError(f"{ENV}={v}: expected {2 * MIN_ROWS}..{vocab - 1} token ids, a token list file, or off")
+        path, half = RANKING, -(-n // 2)
+    else:
+        path = Path(v)
+        if ":" in v and not path.exists():
+            head, _, tail = v.rpartition(":")
+            if tail.isdigit():
+                path, half = Path(head), -(-int(tail) // 2)
+        if not path.is_file():
+            raise ValueError(f"{ENV}={v!r}: not a number of token ids nor a token list file")
+    order = tuple(read_ids(path, vocab))
+    return Settings(order, half, arms in ("mtp", "all"), arms in ("dflash", "all"), rate, window, str(path))
+
+
+def rank_ids(s: Settings, rank: int, world: int, vocab: int) -> np.ndarray:
+    """This rank's listed token ids in the order of its trimmed head's rows: its half's ids from ``s.order`` (the
+    first ``s.half`` of them, or all), then the half's lowest unlisted ids. Every rank has the same number of rows:
+    ``s.half``, or the larger half's count of listed ids (a draft step lasts as long as the larger half, so the
+    other half's extra rows cost nothing), at least 64, rounded up to a multiple of 64."""
+
+    per = vocab // world
+    lo, hi = rank * per, (rank + 1) * per
+    mine = [i for i in s.order if lo <= i < hi]
+    if s.half:
+        mine = mine[:s.half]
+        want = s.half
+    else:
+        counts = collections.Counter(min(i // per, world - 1) for i in s.order)
+        want = max(counts.values())
+    want = min(per, -(-max(MIN_ROWS, want) // ROWS) * ROWS)
+    if want >= per:
+        raise ValueError(f"{ENV}: {want} rows a rank is the whole half ({per}): nothing to trim")
+    taken = set(mine)
+    j = lo
+    while len(mine) < want:
+        if j not in taken:
+            mine.append(j)
+        j += 1
+    return np.asarray(mine, dtype=np.int64)
+
+
+def take_rows(q: Q4, rows: torch.Tensor) -> Q4:
+    """The rows ``rows`` (local indices) of a tiled 4-bit matrix as a 4-bit matrix of their own: the same words,
+    scales and biases (only the listed rows are read; nothing the size of the whole head is allocated)."""
+
+    rows = rows.to(device=q.weight.device, dtype=torch.long)
+    if rows.numel() == 0 or int(rows.min()) < 0 or int(rows.max()) >= q.n:
+        raise ValueError(f"take_rows: rows outside 0..{q.n - 1}")
+    words = q.weight[rows // BN, :, rows % BN, :]                        # [m, K/64, 8]
+    words = words.reshape(rows.numel(), q.k // 8)
+    return make_q4(words.contiguous(), q.scales[:, rows].t().contiguous(), q.biases[:, rows].t().contiguous())
+
+
+@dataclass
+class DraftVocab:
+    s: Settings
+    head: Q4                            # this rank's listed rows
+    gids: torch.Tensor                  # int32 [n]: row r's token id
+    n: int
+
+    @property
+    def mtp(self) -> bool:
+        return self.s.mtp
+
+    @property
+    def dflash(self) -> bool:
+        return self.s.dflash
+
+    @property
+    def fallback(self) -> bool:
+        return self.s.fb_rate < 1.0
+
+
+def attach(w, s: Settings | None = None) -> DraftVocab | None:
+    """``w.draft_vocab`` for this rank from the knobs (None: off; upstream's heads). The rows come from the head
+    the drafters read today (``w.draft_head``, else ``w.head``), which must be 4-bit."""
+
+    s = settings() if s is None else s
+    if s is None:
+        w.draft_vocab = None
+        return None
+    src = w.draft_head if w.draft_head is not None else w.head
+    if not isinstance(src, Q4):
+        raise ValueError(f"{ENV}: the drafters' head is not 4-bit ({type(src).__name__}); trimming needs a 4-bit head")
+    ids = rank_ids(s, w.rank, w.world, w.cfg.vocab)
+    local = torch.from_numpy(ids - w.vocab_offset).to(w.device)
+    dv = DraftVocab(s, take_rows(src, local), torch.from_numpy(ids).to(device=w.device, dtype=torch.int32), len(ids))
+    w.draft_vocab = dv
+    return dv
+
+
+def of(w) -> DraftVocab | None:
+    return getattr(w, "draft_vocab", None)
+
+
+# -- which head a pass reads, and which ids its columns are -------------------------------------------------------
+def upstream_head(w):
+    return w.draft_head if w.draft_head is not None else w.head
+
+
+def head_for(w, arm: str, full: bool = False):
+    """The head a draft pass of ``arm`` ("mtp" / "dflash") reads: the listed rows unless ``full`` or the arm is
+    not trimmed."""
+
+    dv = of(w)
+    if dv is None or full or not (dv.mtp if arm == "mtp" else dv.dflash):
+        return upstream_head(w)
+    return dv.head
+
+
+def ids_of(w, local: torch.Tensor, width: int) -> torch.Tensor:
+    """Token ids (int32) of draft logits' column indices ``local``: a pass over the listed rows (``width`` == the
+    list's rows) maps through them, a full-head pass adds the rank's vocabulary offset. Capturable (a gather)."""
+
+    dv = of(w)
+    if dv is not None and width == dv.n:
+        return dv.gids[local.long()]
+    return (local + w.vocab_offset).to(torch.int32)
+
+
+# -- the fallback rule ---------------------------------------------------------------------------------------------
+def track(w, st, tokens: Sequence[int]) -> None:
+    """The tokens the MTP head is about to absorb for ``st`` (prompt positions, then committed ones): the rule's
+    window. A head starting over (``mtp_len`` 0) starts the window over."""
+
+    dv = of(w)
+    if dv is None or not dv.fallback or not len(tokens):
+        return
+    t = getattr(st, "_dv_window", None)
+    if t is None or getattr(st, "mtp_len", 0) == 0:
+        t = st._dv_window = [collections.deque(maxlen=dv.s.fb_window), 0, None]
+    q = t[0]
+    listed = t[2]
+    if listed is None:
+        listed = t[2] = _listed(dv, w)
+    for tok in list(tokens)[-dv.s.fb_window:]:
+        miss = int(tok) not in listed
+        if len(q) == q.maxlen:
+            t[1] -= q[0]
+        q.append(miss)
+        t[1] += miss
+
+
+def _listed(dv: DraftVocab, w) -> frozenset:
+    """Every listed id of both ranks (the rule must read the same on both: it is computed from the settings)."""
+
+    got = getattr(dv, "_all", None)
+    if got is None:
+        got = frozenset(int(i) for r in range(w.world) for i in rank_ids(dv.s, r, w.world, w.cfg.vocab))
+        dv._all = got
+    return got
+
+
+def full(w, st, arm: str) -> bool:
+    """Whether ``st``'s drafts of ``arm`` ("mtp" / "dflash") use the whole vocabulary now: the fallback rule, for
+    an arm that drafts over the list (False otherwise: an untrimmed arm reads the whole head anyway)."""
+
+    dv = of(w)
+    if dv is None or not dv.fallback or st is None or not (dv.mtp if arm == "mtp" else dv.dflash):
+        return False
+    t = getattr(st, "_dv_window", None)
+    return t is not None and len(t[0]) > 0 and t[1] > dv.s.fb_rate * len(t[0])
+
+
+def describe(dv: DraftVocab, rank: int) -> str:
+    s = dv.s
+    arms = "MTP and DFlash2" if s.mtp and s.dflash else "MTP" if s.mtp else "DFlash2"
+    fb = (f"whole vocabulary while > {s.fb_rate:.1%} of a request's last {s.fb_window} tokens are unlisted"
+          if dv.fallback else "no fallback")
+    return (f"{arms} drafts over {dv.n} listed token ids a rank (rank {rank}; {s.source}"
+            + (f", first {s.half} a half" if s.half else "") + f"; {dv.head.nbytes() / 1e6:.1f} MB head); {fb} "
+            "(patches/0420)")
