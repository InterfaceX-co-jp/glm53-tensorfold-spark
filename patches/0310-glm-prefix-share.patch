+def role_token_ids(model_dir) -> list[int]:
+    """The chat template's role tokens (``ROLE_TOKENS``) in the checkpoint's tokenizer: GLM53_TF_PREFIX_SHARE_TOKENS
+    (comma-separated ids) when set, else tokenizer_config.json's ``added_tokens_decoder``, else tokenizer.json's
+    ``added_tokens``."""
+
+    import json
+    from pathlib import Path
+
+    raw = os.environ.get("GLM53_TF_PREFIX_SHARE_TOKENS", "").strip()
+    if raw:
+        return sorted({int(x) for x in raw.replace(" ", "").split(",") if x})
+    found: dict[str, int] = {}
+    d = Path(model_dir) if model_dir is not None else None
+    if d is not None and (d / "tokenizer_config.json").exists():
+        dec = json.loads((d / "tokenizer_config.json").read_text()).get("added_tokens_decoder") or {}
+        for i, t in dec.items():
+            if isinstance(t, dict) and t.get("content") in ROLE_TOKENS:
+                found[t["content"]] = int(i)
+    if len(found) < len(ROLE_TOKENS) and d is not None and (d / "tokenizer.json").exists():
+        for t in json.loads((d / "tokenizer.json").read_text()).get("added_tokens") or []:
+            if t.get("content") in ROLE_TOKENS:
+                found.setdefault(t["content"], int(t["id"]))
+    return sorted(found.values())
+
