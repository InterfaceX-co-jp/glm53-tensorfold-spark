+    def points_of(self, prompt: Sequence[int]) -> list[int]:
+        """Positions p of the first ``points`` role tokens (the prefix before each), lo <= p <= hi."""
+
+        out: list[int] = []
+        hi = min(len(prompt), self.hi + 1)
+        at = 0
+        while len(out) < self.points and at < hi:
+            p = self._first(prompt, at, hi)
+            if p < 0:
+                break
+            if p >= self.lo:
+                out.append(p)
+            at = p + 1
+        return out
+
+    def is_prefix(self, ids: Sequence[int]) -> bool:
+        """A system-only prefix: no role token after the first position (reports and tests)."""
+
+        return len(ids) > 1 and self._first(ids, 1, len(ids)) < 0
+
