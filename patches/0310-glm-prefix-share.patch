+def prefix_share() -> bool:
+    """GLM53_TF_PREFIX_SHARE=1 (patches/0310): marks at the end of the system prompt; default 0 (off)."""
+
+    v = os.environ.get("GLM53_TF_PREFIX_SHARE", "0").strip()
+    if v not in ("0", "1", ""):
+        raise ValueError(f"GLM53_TF_PREFIX_SHARE={v}: expected 0 or 1")
+    return v == "1"
