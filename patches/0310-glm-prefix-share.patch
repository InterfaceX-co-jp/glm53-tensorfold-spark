+class PrefixShare:
+    """Where a prompt's system part ends: extra marks in rank 0's plan (``SessionStore.plan``)."""
+
+    def __init__(self, roles, *, lo: int = 2048, hi: int = 131072, points: int = 1, keep: int = 4,
+                 wait: bool = True) -> None:
+        self.roles = sorted({int(r) for r in roles})
+        self.lo, self.hi, self.points, self.keep, self.wait = int(lo), int(hi), int(points), int(keep), bool(wait)
+
+    @classmethod
+    def from_env(cls, model_dir=None) -> "PrefixShare | None":
+        if not prefix_share():
+            return None
+        roles = role_token_ids(model_dir)
+        if not roles:
+            raise ValueError("GLM53_TF_PREFIX_SHARE=1: no role tokens (<|user|>, <|assistant|>, <|observation|>) in "
+                             "the tokenizer; set GLM53_TF_PREFIX_SHARE_TOKENS")
+        return cls(roles, lo=_env_int("GLM53_TF_PREFIX_SHARE_MIN", 2048, 1),
+                   hi=_env_int("GLM53_TF_PREFIX_SHARE_MAX", 131072, 1),
+                   points=_env_int("GLM53_TF_PREFIX_SHARE_POINTS", 1, 1),
+                   keep=_env_int("GLM53_TF_PREFIX_SHARE_KEEP", 4, 0),
+                   wait=_env_int("GLM53_TF_PREFIX_SHARE_WAIT", 1, 0) == 1)
