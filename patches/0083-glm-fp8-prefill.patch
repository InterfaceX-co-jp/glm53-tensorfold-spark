+"""FP8 fast prefill for GLM-5.3-Flash on CUDA (patches/0083, GLM53_TF_FP8_PREFILL=1 or ``tf_knobs.fp8_prefill``).
+
+A variant of patches/0080's fast prefill: the same chunk grid, the same kernels for everything but the parts below,
+which run on FP8 (e4m3) tensor cores or on tensor-core tiles that the row-invariant kernels cannot use. Only the main
+model's fast chunks change; decode, verify, the MTP head, DFlash2 and exact (``fast_prefill: 0``) prefills never
+run any of it.
+
+What changes in a fast chunk when it is on
+------------------------------------------
+- Non-expert 4-bit matmuls with at least ``fast_qmm.FP8_MIN_NK`` weights (KDA q|k|v|f_a|g_a|b and o_proj, DSA
+  q_a|kv_a, q_b and o_proj, the indexer's q_b, the dense MLP, the shared expert): ``fast_qmm.matmul_fp8``. Each row
+  of x is scaled by its own power of two s_x (the smallest with amax / s_x <= 448) and rounded to e4m3 (RTNE); a
+  4-bit weight value q (0..15) is an exact e4m3 number; each 64-input group is one fp8 tensor-core dot from zero (fp32 result), then
+
+      acc[m, n] += P[m, n, g] * s[n, g] + X8[m, g] * b[n, g]        (X8: the group's sum of the e4m3 inputs)
+      y[m, n]    = s_x[m] * acc[m, n]
+
+  i.e. exactly "round the row to e4m3 with a per-row scale, then the exact 4-bit matmul", summed in fp32 in group
+  order. BF16 weights: per-output-channel e4m3 scales (amax / 448 of the row), fp32 accumulation in 64-input steps.
+  The tiny shapes (f_b / g_b 4096 x 128, the indexer's k|w 160 x 4096) stay on ``matmul_fast``: the quantization
+  prologue would cost more than it saves.
+- Latent MLA (patches/0060, GLM53_TF_LATENT_KV=1): ``absorb`` and ``expand`` run as bf16 tensor-core GEMMs over
+  64-row tiles (the row-invariant versions dequantize kv_b in fp32 and multiply on the FMA pipes, 16 rows a tile),
+  and dense / sparse latent attention uses 32 (row, head) queries a tile (``latent.FAST_BM``) instead of 16: one
+  gather of the selected latent rows serves all 32 heads of a row. Attention itself stays bf16 (see
+  ``docs/PATCHES.md``, 0083: it is not bound by the MMA rate, so fp8 there would add error for no speed).
+
+Exactness
+---------
+New arithmetic, like 0080's fast mode: a prefill's tokens change with the switch. Everything above is deterministic
+and ROW-INDEPENDENT (a row's scale is its own amax; tile shapes are fixed per weight shape, never by the row count;
+no atomics; fixed summation order), so every argument of ``fastpf`` holds unchanged: drafted == serial (the prefill
+is deterministic; decode windows stay on the row-invariant kernels) and resumed == fresh (chunks on the grid C).
+Snapshots of an FP8 prefill are tagged ``grid = C + 1`` (C is a multiple of 64): only FP8 fast requests of the same
+grid resume from them, and they never resume from bf16 fast or exact snapshots. Lean prefill (0082) keeps its
+"same bits as 0080's chunk" property within the FP8 mode for the same reason (row-independent kernels).
+
+Quality: e4m3 keeps 3 mantissa bits (relative rounding error at most 2^-4, ~1.8% rms per activation), per row; each
+projection output then carries ~1-2% relative noise, below the 4-bit weights' own quantization error, and the
+residual streams, norms, KDA recurrence and attention softmax stay bf16/fp32. Expected effect: within noise on
+MMLU-style evaluations (W8A8-FP8 with per-token scales is lossless-to-0.5-point on published LLM evaluations);
+check with the MMLU suite on hardware before making it a default.
+"""
+
+from __future__ import annotations
+
+import os
+
+TAG = 1                  # added to the chunk grid C (a multiple of 64) in an FP8 prefill's snapshots
+
+ON = False               # the running prefill's setting (``decode._prefill`` sets it); read by fast_qmm / latent
+
+
+def enabled() -> bool:
+    """GLM53_TF_FP8_PREFILL (default 0): fast prefills run the FP8 kernels by default (``tf_knobs.fp8_prefill``
+    per request). Has no effect on exact (non-fast) prefills."""
+
+    v = os.environ.get("GLM53_TF_FP8_PREFILL", "0").strip().lower()
+    if v not in ("", "0", "1", "true", "false", "yes", "no", "on", "off"):
+        raise ValueError(f"GLM53_TF_FP8_PREFILL={v!r}: expected 0 or 1")
+    return v in ("1", "true", "yes", "on")
+
+
+def available() -> bool:
+    """FP8 e4m3 tensor-core dots are there: Triton's float8e4nv, torch's float8_e4m3fn and a GPU of compute
+    capability 8.9 or later (GB10 is 12.1); Triton's CPU interpreter counts (tests)."""
+
+    try:
+        import torch
+        import triton.language as tl
+    except ImportError:
+        return False
+    if not hasattr(tl, "float8e4nv") or not hasattr(torch, "float8_e4m3fn"):
+        return False
+    if os.environ.get("TRITON_INTERPRET") == "1":
+        return True
+    return torch.cuda.is_available() and torch.cuda.get_device_capability() >= (8, 9)
+
+
+def default() -> bool:
+    """The load-time default of the switch: GLM53_TF_FP8_PREFILL, when the kernels can run here."""
+
+    return enabled() and available()
+
+
+def tag(grid: int, on: bool) -> int:
+    """The snapshot grid tag of a prefill: 0 (exact), C (bf16 fast) or C + TAG (FP8 fast)."""
+
+    return grid + TAG if grid and on else grid
+
+
+def grid_of(t: int) -> int:
+    """The chunk grid C of a snapshot tag."""
+
+    return t - (t % 64)
+
+
+def settings() -> list[int]:
+    """This rank's FP8 prefill settings (both ranks must agree: they decide the prefill's bits)."""
+
+    return [int(enabled()), int(available())]
