+        wt = _wtile(W, S, B, n0, g, N, L, IS_Q4).to(tl.bfloat16)                      # [64 outputs n, 64 latent j]
+        acc = tl.dot(x.to(tl.bfloat16), tl.trans(wt), acc)
+    tl.store(OUT + rm[:, None] * N + n0 + j[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
