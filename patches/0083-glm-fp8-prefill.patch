+                                                      BMR=TC_ROWS, num_warps=4, num_stages=2)
+    return out
+
+
+@triton.jit
+def _expand_tc(U, W, S, B, OUT, M, H: tl.constexpr, DV: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+               IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """``_expand`` on bf16 tensor cores: u rounded to bf16, the kv_b value tile dequantized in fp32 then rounded to
+    bf16, BMR rows a program; fp32 sums over the latent in 64-wide groups, in order."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    n0 = tl.program_id(1) * 64
