+# -- patches/0083: tensor-core absorb / expand for FP8 fast prefill chunks ---------------------------------------------
+@triton.jit
+def _absorb_tc(Q, W, S, B, QA, M, H: tl.constexpr, DQ: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+               IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """``_absorb`` on bf16 tensor cores: the kv_b key tile dequantized exactly in fp32 then rounded to bf16, BMR rows a
+    program; fp32 sums over the head's inputs in 64-wide steps, in order."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    h = tl.program_id(1)
+    g = tl.program_id(2)
+    ok = rm < M
+    k = tl.arange(0, 64)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for it in range(DQ // 64):
+        x = tl.load(Q + (rm[:, None] * H + h) * DQ + it * 64 + k[None, :], mask=ok[:, None], other=0.0)
+        wt = _wtile(W, S, B, h * DQ + it * 64, g, N, L, IS_Q4).to(tl.bfloat16)      # [64 inputs i, 64 latent j]
+        acc = tl.dot(x.to(tl.bfloat16), wt, acc)
+    tl.store(QA + (rm[:, None] * H + h) * L + g * 64 + k[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+def absorb_tc(q: torch.Tensor, kv_k: Q4 | B16, out: torch.Tensor) -> torch.Tensor:
+    """``absorb`` for FP8 fast prefill chunks (patches/0083): bf16 tensor cores, 64-row tiles. Row-independent and
+    deterministic; not ``absorb``'s bits."""
+
+    R, H, DQ = q.shape
+    L = out.shape[2]
+    W, S, B, is_q4 = _parts(kv_k)
