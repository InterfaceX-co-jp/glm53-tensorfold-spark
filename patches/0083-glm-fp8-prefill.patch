+# -- patches/0083: FP8 (e4m3) tensor-core prefill matmuls -----------------------------------------------------------
+# A row of x is scaled by its own power of two s_x, the smallest with amax / s_x <= 448 (e4m3's largest finite value),
+# and rounded to e4m3 (RTNE) by ``_fp8_rows``, which also writes the fp32 sums of each 64-input group of the ROUNDED
+# row. A power of two makes x / s_x exact (no division, no double rounding: the host model ``fp8_reference`` gets
+# the same bits) and costs nothing in precision: e4m3's relative step is the same anywhere in its normal range, the
+# row only uses at most one binade less of it (its largest value lands in (224, 448]). A 4-bit
+# weight value q in 0..15 is an exact e4m3 number (``FP8_WENC = "cvt"``: 1..15 are normal numbers), or, with
+# ``"bits"``, the nibble itself read as an e4m3 bit pattern, which is exactly q * 2^-9 (0..7 subnormal, 8..15 in the
+# first normal binade; the 2^9 goes into the scale): no conversion instruction, but it relies on the tensor cores
+# keeping e4m3 subnormals. Per 64-input group g, ``_f8q4`` computes P = x8 . q8 on the fp8 tensor cores from zero
+# (fp32 result: the group's products are exact and at most 64 are summed, so the tensor cores' accumulator width does
+# not matter), then acc += P * s[n, g] + X8[m, g] * b[n, g] in fp32, in group order, and finally y = s_x[m] * acc.
+# That is "x rounded to e4m3 per row, times the exact 4-bit weights", the bias term taken on the rounded sums so the
+# rounding error is sum((x8 - x) * w), not sum((x8 - x) * (w - b)).
+#
+# Row-independent and deterministic: a row's scale, its groups' sums and its dots never see another row; the tile
+# (FP8_TILE) is fixed for every shape and row count; no atomics. So lean sub-blocks (patches/0082) and any row
+# grouping give a row the same bits.
+FP8_MAX = 448.0
+FP8_MIN_NK = 4 * 1024 * 1024     # smaller weights (4096x128, 160x4096) stay on the bf16 kernel: the prologue dominates
+FP8_WENC = "cvt"                 # "cvt" | "bits" (see above); both exact, same bits
+# (BM, BN, warps, stages) for every Q4 / B16 shape: 128 rows share each unpacked weight group, 64 columns share each
+# e4m3 row tile. Swept on GB10 over the real shapes at 2048 and 8192 rows: 128,64,4,2 is the fastest or within 2% at
+# every shape (1.0-1.27x the bf16 fast kernel; 128,128,8,3 was 0.8-0.9x). GLM53_TF_FP8_TILE=bm,bn,warps,stages
+# overrides it (the tile never changes which fp32 operations a row sees, only which program runs them: same bits).
+FP8_TILE = (128, 64, 4, 2)
+
+
+def fp8_tile() -> tuple[int, int, int, int]:
+    import os
+
+    v = os.environ.get("GLM53_TF_FP8_TILE", "").strip()
+    if not v:
+        return FP8_TILE
+    t = tuple(int(p) for p in v.split(","))
+    if len(t) != 4 or t[0] not in (16, 32, 64, 128, 256) or t[1] not in (32, 64, 128, 256):
+        raise ValueError(f"GLM53_TF_FP8_TILE={v!r}: expected bm,bn,warps,stages (bm 16-256, bn 32-256, powers of 2)")
+    return t
+
+
+@triton.jit
+def _fp8_rows(X, x_stride, X8, SX, XS8, K: tl.constexpr, KP: tl.constexpr, KG: tl.constexpr):
+    """Program r: row r of x (bf16) -> X8[r] e4m3 (x / s_x), SX[r] = s_x (a power of two: amax / s_x in (224, 448]),
+    XS8[r, g] = fp32 sum of group g of the e4m3 values (unscaled)."""
+
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, KP)
+    ok = k < K
+    x = tl.load(X + r * x_stride + k, mask=ok, other=0.0).to(tl.float32)
+    amax = tl.max(tl.abs(x), 0)
+    # amax = 1.m * 2^E; 448 = 1.75 * 2^8: s = E - 8, or E - 7 when 1.m > 1.75 (clamped for rows of ~0 or inf)
+    bits = amax.to(tl.int32, bitcast=True)
+    e = ((bits >> 23) & 0xFF) - 127
+    sh = e - 8 + ((bits & 0x7FFFFF) > 0x600000).to(tl.int32)
+    sh = tl.minimum(tl.maximum(sh, -100), 100)
+    inv = ((127 - sh) << 23).to(tl.float32, bitcast=True)
+    sx = ((127 + sh) << 23).to(tl.float32, bitcast=True)
+    y = tl.minimum(tl.maximum(x * inv, -448.0), 448.0)
+    y8 = y.to(tl.float8e4nv)
+    tl.store(X8 + r * K + k, y8, mask=ok)
+    gs = tl.sum(tl.reshape(y8.to(tl.float32), (KP // 64, 64)), 1)
+    g = tl.arange(0, KP // 64)
+    tl.store(XS8 + r * KG + g, gs, mask=g < KG)
+    tl.store(SX + r, sx)
+
+
+def fp8_rows(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """x (M, K) bf16, unit column stride -> (x8 (M, K) e4m3, s_x (M,) fp32, group sums of x8 (M, K/64) fp32)."""
+
+    m, k = x.shape
+    if x.stride(1) != 1 or k % GS:
+        raise ValueError("fp8_rows: rows of unit column stride and a multiple of 64 wide expected")
+    x8 = torch.empty((m, k), dtype=torch.float8_e4m3fn, device=x.device)
+    sx = torch.empty((m,), dtype=torch.float32, device=x.device)
+    xs8 = torch.empty((m, k // GS), dtype=torch.float32, device=x.device)
+    if m:
+        kp = triton.next_power_of_2(k)
+        _fp8_rows[(m,)](x, x.stride(0), x8, sx, xs8, K=k, KP=kp, KG=k // GS, num_warps=8 if kp >= 4096 else 4)
+    return x8, sx, xs8
+
+
+@triton.jit
+def _f8q4(X8, SX, XS8, W, S, B, OUT, M, N: tl.constexpr, K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+          TN: tl.constexpr, F32: tl.constexpr, BITS: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] = s_x * sum over groups in order of (P s + X8 b), P the
+    group's fp8 tensor-core dot."""
+
+    KG: tl.constexpr = K // 64
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)      # grouped order (0081's ``_tile``)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    rw = tl.arange(0, 8)
+    shifts = tl.arange(0, 8) * 4
+    m_ok = rm < M
+    n_ok = rn < N
+    wrow = (rn // TN).to(tl.int64) * (KG * TN * 8) + (rn % TN) * 8
+    xrow = rm.to(tl.int64) * K
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for g in range(KG):
+        words = tl.load(W + wrow[:, None] + g * (TN * 8) + rw[None, :], mask=n_ok[:, None], other=0)
+        q = tl.reshape((words[:, :, None] >> shifts[None, None, :]) & 0xF, (BN, 64))
+        if BITS:
+            q8 = q.to(tl.int8).to(tl.float8e4nv, bitcast=True)          # q * 2^-9, exactly
+        else:
+            q8 = q.to(tl.float16).to(tl.float8e4nv)                     # q, exactly
+        x8 = tl.load(X8 + xrow[:, None] + (g * 64 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        p = tl.dot(x8, tl.trans(q8))
+        s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        if BITS:
+            s = s * 512.0
+        b = tl.load(B + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        xs = tl.load(XS8 + rm * KG + g, mask=m_ok, other=0.0)
+        acc = acc + p * s[None, :] + xs[:, None] * b[None, :]
+    sx = tl.load(SX + rm, mask=m_ok, other=0.0)
+    total = acc * sx[:, None]
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+@triton.jit
+def _f8b16(X8, SX, W, WINV, WS, OUT, M, N: tl.constexpr, K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+           F32: tl.constexpr):
+    """BF16 weights: each 64-input step rounds the weight tile to e4m3 with its row's scale (WINV = 448 / amax),
+    one fp8 dot from zero, added in fp32 in K order; out = s_x * s_w * acc."""
+
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)      # grouped order (0081's ``_tile``)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    m_ok = rm < M
+    n_ok = rn < N
+    winv = tl.load(WINV + rn, mask=n_ok, other=0.0)
+    xrow = rm.to(tl.int64) * K
+    wrow = rn.to(tl.int64) * K
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for k0 in range(0, K, 64):
+        x8 = tl.load(X8 + xrow[:, None] + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        w = tl.load(W + wrow[:, None] + (k0 + rk)[None, :], mask=n_ok[:, None], other=0.0).to(tl.float32)
+        w8 = tl.minimum(tl.maximum(w * winv[:, None], -448.0), 448.0).to(tl.float8e4nv)
+        acc = acc + tl.dot(x8, tl.trans(w8))
+    sx = tl.load(SX + rm, mask=m_ok, other=0.0)
+    ws = tl.load(WS + rn, mask=n_ok, other=0.0)
+    total = acc * sx[:, None] * ws[None, :]
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+def b16_fp8_scales(q: B16) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-output-channel e4m3 scales of a BF16 weight (s_w = amax / 448, and 448 / amax; 0 for an all-zero row),
+    computed once and kept on the matrix (the same weights always give the same scales)."""
+
+    got = q.__dict__.get("_fp8_scales")
+    if got is None:
+        amax = q.weight.float().abs().amax(dim=1)
+        ws = (amax / FP8_MAX).contiguous()
+        winv = torch.where(amax > 0, FP8_MAX / amax, torch.zeros_like(amax)).contiguous()
+        got = (winv, ws)
+        q.__dict__["_fp8_scales"] = got
+    return got
+
+
+def fp8_eligible(m: int, q: Q4 | B16) -> bool:
+    """The shapes and row counts ``matmul_fp8`` runs in fp8 (the rest go to ``matmul_prefill(exact=False)``)."""
+
+    return m >= MIN_ROWS and q.n * q.k >= FP8_MIN_NK and q.k % GS == 0
+
+
+def matmul_fp8(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+               f32: bool = False, part: torch.Tensor | None = None) -> torch.Tensor:
+    """``qmm.matmul``'s contract on FP8 tensor cores (patches/0083): x (M, K) bf16 (rows may be strided) @ q.T with
+    x rounded to e4m3 per row. ``xs`` is not used (the kernel needs the sums of the rounded rows). Shapes below
+    ``FP8_MIN_NK`` weights and calls below ``MIN_ROWS`` rows run ``matmul_prefill(exact=False)`` (the bf16 fast
+    kernel; qmm below 64 rows) instead. Deterministic and row-independent; not the bf16 kernels' bits."""
+
+    m, k = x.shape
+    if not fp8_eligible(m, q):
+        return matmul_prefill(x, q, xs, out=out, f32=f32, part=part, exact=False)
+    if k != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_fp8: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    out = _out(x, q.n, out, f32)
+    x8, sx, xs8 = fp8_rows(x)
+    bm, bn, warps, stages = fp8_tile()
+    grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+    if isinstance(q, B16):
+        winv, ws = b16_fp8_scales(q)
+        _f8b16[grid](x8, sx, q.weight, winv, ws, out, m, N=q.n, K=k, BM=bm, BN=bn, F32=f32, num_warps=warps,
+                     num_stages=stages)
+        return out
+    _f8q4[grid](x8, sx, xs8, q.weight, q.scales, q.biases, out, m, N=q.n, K=k, BM=bm, BN=bn, TN=BN_STORED, F32=f32,
+                BITS=FP8_WENC == "bits", num_warps=warps, num_stages=stages)
+    return out
+
+
+def fp8_row_values(xf: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Host model of ``_fp8_rows``: (the e4m3 values of x / s_x as fp32, s_x [M, 1])."""
+
+    bits = xf.abs().amax(dim=1, keepdim=True).view(torch.int32)
+    sh = ((bits >> 23) & 0xFF) - 127 - 8 + ((bits & 0x7FFFFF) > 0x600000).to(torch.int32)
+    sh = sh.clamp(-100, 100)
