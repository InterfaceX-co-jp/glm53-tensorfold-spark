+@dataclass
+class Q8:
+    """An 8-bit matrix [n, k]: weight int8 [n, k] row-major, scales bf16 [k / gs, n] (group-major), gs 128 (64 when
+    k is not a multiple of 128)."""
+
+    weight: torch.Tensor
+    scales: torch.Tensor
+    n: int
+    k: int
+    gs: int = Q8_GS
+
+    def nbytes(self) -> int:
+        return sum(t.numel() * t.element_size() for t in (self.weight, self.scales))
