+# -- patches/0470: 8-bit weights (``qmm.Q8``) --------------------------------------------------------------------------
+# ``qmm._q8mm``'s arithmetic per output element (per group of G inputs: one tensor-core dot from zero, times the
+# group's scale, added in group order; ``qmm.q8_split_k``'s slices summed in slice order when ``exact``), over the
+# whole K in one program: ``exact`` gives qmm's bits, ``exact=False`` (fast chunks) one accumulator. Tiles (BM, BN,
+# warps, stages): chosen offline as the largest that compile for sm_121 without spills at every per-rank shape
+# (tests/test_q8_compile.py: a group's dot result and the running sum are two BM x BN fp32 accumulators, the exact
+# variant's slice total a third; 128 x 64 spilled 140 B, 64 x 64 12 B); not yet timed on GB10 (docs/QUALITY-PLAN.md).
+# GLM53_TF_Q8_TILE=bm,bn,warps,stages overrides both (no tile changes bits).
+Q8_TILE_EXACT = (64, 32, 8, 3)
+Q8_TILE_LOOSE = (128, 32, 8, 2)
+
+
+def q8_tile(exact: bool) -> tuple[int, int, int, int]:
+    import os
+
+    v = os.environ.get("GLM53_TF_Q8_TILE", "").strip()
+    if not v:
+        return Q8_TILE_EXACT if exact else Q8_TILE_LOOSE
+    t = tuple(int(p) for p in v.split(","))
+    if len(t) != 4 or t[0] not in (16, 32, 64, 128, 256) or t[1] not in (32, 64, 128, 256):
+        raise ValueError(f"GLM53_TF_Q8_TILE={v!r}: expected bm,bn,warps,stages (bm 16-256, bn 32-256, powers of 2)")
+    return t
+
+
+@triton.jit
+def _fq8(X, W, S, OUT, M, x_stride, N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr,
+         BN: tl.constexpr, G: tl.constexpr, F32: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] over all K with ``qmm._q8mm``'s per-group arithmetic, its K
+    slices summed in slice order (SK = 1: one accumulator)."""
+
+    KG: tl.constexpr = K // G
+    PER: tl.constexpr = KG // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    m_ok = rm < M
+    n_ok = rn < N
+    wrow = W + rn[:, None].to(tl.int64) * (K // 4) + tl.arange(0, 16)[None, :]      # int32 words (qmm._q8_unpack)
+    xrow = X + rm[:, None].to(tl.int64) * x_stride + rk[None, :]
+    # qmm's K slices as an order of summation in ONE loop (a static loop a slice unrolled SK copies of the pipelined
+    # body and spilled): the slice sum restarts at each slice's first group and is added to the total at its last
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for g in range(KG):
+        p = tl.zeros((BM, BN), dtype=tl.float32)
+        for h in tl.static_range(G // 64):              # qmm._q8mm's 64-input halves: the same k16 mma chain
+            k0 = g * G + h * 64
+            words = tl.load(wrow + k0 // 4, mask=n_ok[:, None], other=0)
+            x = tl.load(xrow + k0, mask=m_ok[:, None], other=0.0)
+            p = tl.dot(x, tl.trans(qmm._q8_unpack(words, BN, 64)), p)
+        s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        if SK == 1:
+            acc = acc + p * s[None, :]
+        else:
+            acc = tl.where(g % PER == 0, 0.0, acc) + p * s[None, :]
+            last = g % PER == PER - 1
+            total = tl.where(last, tl.where(g < PER, acc, total + acc), total)
+    if SK == 1:
+        total = acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
