+
+def quantize8(w: torch.Tensor, chunk: int = 8192) -> Q8:
+    """bf16 (N, K) -> ``Q8``: q = round_half_even(w / s) in -127..127 per group of ``q8_group(K)`` inputs (patches/0470,
+    GLM53_TF_NONEXPERT=q8). Elementwise torch ops only: the same bits on the CPU and the GPU."""
+
+    n, k = w.shape
+    gs = q8_group(k)
+    q = torch.empty((n, k), dtype=torch.int8, device=w.device)
+    scales = torch.empty((n, k // gs), dtype=torch.bfloat16, device=w.device)
+    for r in range(0, n, chunk):
