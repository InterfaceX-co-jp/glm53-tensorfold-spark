+
+def q8_scales(amax: torch.Tensor) -> torch.Tensor:
+    """fp32 group amax -> bf16 scales: the smallest bf16 >= amax / 127 (no value clips), 1 for an all-zero group."""
+
+    s32 = amax / 127.0
+    s = s32.to(torch.bfloat16)
+    low = s.float() < s32
+    s = torch.where(low, (s.view(torch.int16) + 1).view(torch.bfloat16), s)      # positive: next bf16 up
+    return torch.where(amax > 0, s, torch.ones_like(s))
