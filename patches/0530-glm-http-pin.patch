diff --git i/src/tensorfold/families/glm5_next/cuda/rocedump.py w/src/tensorfold/families/glm5_next/cuda/rocedump.py
new file mode 100644
index 0000000..cd1abdb
--- /dev/null
+++ w/src/tensorfold/families/glm5_next/cuda/rocedump.py
@@ -0,0 +1,73 @@
+"""patches/0530: the RoCE exchange trace (0460's ``GLM53_TF_ROCE_TRACE`` ring) dumped from a running server, so the
+per-exchange transport / skew split (``roce.trace_summary``) can be measured in production conditions without nsys
+(THEORY-2 idea 6). Off by default.
+
+- ``GLM53_TF_ROCE_TRACE_DUMP=<path prefix>`` (needs ``GLM53_TF_ROCE_TRACE=N``): each rank appends one JSON line to
+  ``<prefix>-r<rank>.jsonl`` whenever at least ``GLM53_TF_ROCE_TRACE_EVERY`` exchanges completed since its last dump
+  (default 16 x the ring): ``{"t", "rank", "completed", "rows": roce.Runtime.trace_rows()}``. Both ranks number the
+  exchanges alike, so a reader pairs the two ranks' rows by ``seq`` (results/THEORY2-SESSION/rocetrace.py).
+- Checked once a round (``cpupin.tick``, both ranks, between rounds); a dump reads the ring after the round's work
+  (one small device-to-host copy). Reads only: no exchange, no kernel changes.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+
+_S = {"on": None, "path": None, "every": 0, "last": 0, "errors": 0}
+
+
+def _setup() -> bool:
+    raw = os.environ.get("GLM53_TF_ROCE_TRACE_DUMP", "").strip()
+    _S["on"] = False
+    if not raw:
+        return False
+    from . import roce
+
+    rt = _runtime()
+    if rt is None or getattr(rt, "trace_buf", None) is None:
+        return False                            # NCCL, or no trace ring: nothing to dump (checked again later)
+    ring = int(rt.s.trace)
+    every = int(os.environ.get("GLM53_TF_ROCE_TRACE_EVERY", "") or 16 * ring)
+    _S.update(on=True, path=f"{raw}-r{rt.rank}.jsonl", every=max(1, every), last=0)
+    print(f"[tensorfold] RoCE trace dump (patches/0530): every {_S['every']} exchanges -> {_S['path']} "
+          f"(ring {ring}, {roce.__name__})", file=sys.stderr, flush=True)
+    return True
+
+
+def _runtime():
+    from . import roce
+
+    comms = getattr(roce, "COMMS", None)
+    return comms[-1].rt if comms else None
+
+
+def tick() -> None:
+    """Once a round: a dump when due (cheap otherwise: one host read of the completed counter)."""
+
+    if _S["on"] is False:
+        return
+    if _S["on"] is None and not _setup():
+        if _runtime() is None:
+            _S["on"] = None                     # the communicator is made after the first ticks: look again
+        return
+    rt = _runtime()
+    try:
+        from .roce import CTRL_COMPLETED
+
+        done = int(rt.ctrl[CTRL_COMPLETED])
+        if done - _S["last"] < _S["every"]:
+            return
+        rows = rt.trace_rows()
+        with open(_S["path"], "a") as f:
+            f.write(json.dumps({"t": time.time(), "rank": rt.rank, "completed": done, "rows": rows}) + "\n")
+        _S["last"] = done
+    except Exception as exc:                    # noqa: BLE001 - a measurement must never stop serving
+        _S["errors"] += 1
+        if _S["errors"] <= 3:
+            print(f"[tensorfold] RoCE trace dump failed ({type(exc).__name__}: {exc})", file=sys.stderr, flush=True)
+        if _S["errors"] >= 3:
+            _S["on"] = False
