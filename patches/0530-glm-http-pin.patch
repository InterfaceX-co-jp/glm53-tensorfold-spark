+def _http_plan(spec, low: str, fast: list[int], allowed: frozenset[int]) -> Plan:
+    """patches/0530: ``http[=cpus][;engine=cpus|fast]``."""
+
+    http, engine = None, None
+    for i, part in enumerate(low.split(";")):
+        part = part.strip()
+        if not part:
+            continue
+        key, eq, val = part.partition("=")
+        key, val = key.strip(), val.strip()
+        if i == 0 and key == "http":
+            http = parse_cpulist(val) if eq else None
+            if eq and not http:
+                raise ValueError(f"GLM53_TF_CPU_PIN={spec!r}: http= is empty")
+        elif key == "engine" and eq:
+            engine = frozenset(fast) if val == "fast" else parse_cpulist(val)
+            if not engine:
+                raise ValueError(f"GLM53_TF_CPU_PIN={spec!r}: engine= is empty")
+        else:
+            raise ValueError(f"GLM53_TF_CPU_PIN={spec!r}: expected http, http=<cpus> or http=<cpus>;engine=<cpus|fast>")
+    if http is None:
+        http = allowed - frozenset(fast)
+        if not http:                            # no slow cores: the lower half of the allowed ones
+            ids = sorted(allowed)
+            http = frozenset(ids[:max(1, len(ids) // 2)])
+    for name, got in (("http", http), ("engine", engine)):
+        if got is not None and not got <= allowed:
+            raise ValueError(f"GLM53_TF_CPU_PIN {name}={cpulist(got)}: cpus {cpulist(got - allowed)} are not allowed "
+                             f"here (allowed: {cpulist(allowed)})")
+    if engine is not None and engine & http:
+        raise ValueError(f"GLM53_TF_CPU_PIN={spec!r}: engine and http cpus overlap ({cpulist(engine & http)})")
+    return Plan("http", frozenset(), frozenset(), frozenset(), None, 0, tuple(fast), http=http, engine=engine,
+                allowed=allowed)
+
