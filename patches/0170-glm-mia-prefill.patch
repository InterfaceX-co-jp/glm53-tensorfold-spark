+                         stages, ticket);
+}
+
+void down_fat(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+              const at::Tensor& members, const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t slots,
+              int64_t stages, bool ticket) {
+    check(XD, at::kHalf, "XD");
+    check(TD, at::kInt, "TD");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_d, at::kHalf, "svh_d");
