+
+// exl3.cu ``rot_in``'s first output only (x bf16 [rows, >= K] with row stride x_stride; out0 [rows * slots, K] fp16)
+void rot_in1(const at::Tensor& x, int64_t x_stride, const at::Tensor& pick, const at::Tensor& suh0, at::Tensor out0,
