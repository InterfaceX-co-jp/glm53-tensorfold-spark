+// patches/0170: ``gateup``'s contract; ``shared_x``: both matrices multiply XG (XU is not read); stages 3 | 4
+void gateup_fat(const at::Tensor& XG, const at::Tensor& XU, const at::Tensor& TG, const at::Tensor& TU,
+                const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, const at::Tensor& svh_g,
+                const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t slots,
