+        reinterpret_cast<const half*>(suh0.data_ptr()), reinterpret_cast<half*>(out0.data_ptr()), (int)K, (int)slots,
+        (int)items);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
