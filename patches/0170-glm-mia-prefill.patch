+// Xg only (``fat::rot_in1_kernel``: rot_in's code for the gate's sign vector), for gate and up sharing it.
+void exl3_rot_in1_cuda(const at::Tensor& x, int64_t x_stride, const at::Tensor& pick, const at::Tensor& suh0,
+                       at::Tensor& out0, int64_t rows, int64_t K, int64_t slots) {
