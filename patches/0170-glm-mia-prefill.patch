+    check(TU, at::kInt, "TU");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(XG.size(-1) == K && (shared_x || XU.size(-1) == K) && xd.size(-1) == N, "gateup_fat: X [P, K], Xd [P, N]");
+    TORCH_CHECK(TG.size(1) * 16 == K && TG.size(2) * 16 == N && TG.sizes() == TU.sizes(), "gateup_fat: trellis shapes");
