@@ -0,0 +1,489 @@
+"""patches/0290: one paged pool of latent KV rows shared by every batch slot (GLM53_TF_KV_POOL_TOKENS, default off).
+
+Without it every ``forward.State`` reserves its whole capacity at load: the 11 DSA layers' latent rows, the MTP head's
+latent rows, the MTP head's index keys and gates and the 12 pool-key caches (7,616 B a token a rank with FP8 rows,
+docs/MEMORY-4x256k.md), so 4 slots of 262k cost 7.45 GiB a node whether they hold 1k or 262k tokens each. With the
+pool, those caches of every slot live in one set of tensors of ``tokens`` rows cut into pages of ``page`` tokens, and
+each slot maps its logical pages (position // page) to physical ones through a page table: any one slot can grow to
+the engine's capacity (CONTEXT, e.g. 1,048,576) as long as the pages of all slots fit in the pool.
+
+Bits: a kernel reads and writes the same row values at other addresses. Every reader and writer of these caches
+translates a logical row r to ``table[r >> shift] << shift | (r & (rows a page - 1))`` (``latent._prow``) before its
+load or store, under the same masks, so what it computes is what it computed on the contiguous cache: outputs are
+byte-identical to the unpaged path (tests: ``tests/test_kvpool_interpreter.py``,
+``tests/cuda/test_kv_pool_patches.py``).
+With the knob off nothing here is built and every kernel gets PT=None / PSH=0: the paged branch is pruned at compile
+time, the same loads and stores as before.
+
+What is paged (per slot, a logical view ``Paged`` of a shared physical tensor):
+- ``State.kc`` (11 latent caches, [capacity, 528] uint8 FP8 rows or [capacity, 512] bf16) and ``State.mtp_kc``;
+- ``State.index``'s capacity-sized tensors: the MTP head's index keys and gates (and the model layers' when
+  GLM53_TF_INDEX_RING=0) and all 12 pool-key caches ([capacity / 4 + 2, 128]; page / 4 rows a page).
+Per slot as before: patches/0065's index rings (window-sized), the KDA state, conv windows, DFlash2's ring.
+
+Pages: ``page`` tokens, a multiple of the session store's 256-token page (``sessions.PAGE``), so every stored page the
+store and the NVMe tier copy lies inside one physical page and stays a plain tensor view; runs of stored pages are
+copied a page at a time, and an entry's tail (the rows past its last full page; with a fast grid it may cover several
+pages) is gathered / written page by page (``Paged.gather`` / ``write``; the disk tier stages it and writes it after the
+read is checked). The pool has one more page than it hands out, the
+null page: unmapped table entries point at it (all zeros), so a stray read reads zeros and never another slot's rows;
+``KvPool.null_clean`` checks nothing ever wrote it (GLM53_TF_KV_POOL_CHECK=1 checks after every batched round).
+
+Allocation (both ranks do the same operations in the same order, so their pools stay identical; the lowest free page
+first): ``SlotPages.ensure(end)`` maps pages up to position ``end`` (called by ``forward.check_room`` before every
+forward / MTP / lean chunk, and before a session restore or disk read); ``truncate(keep)`` returns the pages past
+``keep``. The admission policy (``batch.Batcher``, docs/KV-POOL.md) reserves a request's pages up front as a quota, so
+an admitted request can always finish.
+"""
+
+from __future__ import annotations
+
+import heapq
+import os
+from typing import Any
+
+POOL_ENV = "GLM53_TF_KV_POOL_TOKENS"
+PAGE_ENV = "GLM53_TF_KV_POOL_PAGE"
+SLACK_ENV = "GLM53_TF_KV_POOL_SLACK"
+CHECK_ENV = "GLM53_TF_KV_POOL_CHECK"
+STORE_PAGE = 256             # ``sessions.PAGE`` (not imported: this module is imported by the kernels' modules)
+DEFAULT_PAGE = 256
+DEFAULT_SLACK = 64           # tokens past prompt + max_tokens a request may write (verify / pad windows, MTP drafts)
+
+
+class PoolExhausted(ValueError):
+    """No free page for a slot that needs one. Raised instead of writing anywhere else (never a silent overwrite)."""
+
+
+def _int_env(name: str, default: int) -> int:
+    v = os.environ.get(name, "").strip()
+    if not v:
+        return default
+    try:
+        return int(v)
+    except ValueError:
+        raise ValueError(f"{name} must be an integer, not {v!r}") from None
+
+
+def settings() -> tuple[int, int, int]:
+    """(pool tokens, page tokens, slack tokens) from the environment; pool tokens 0 = off (the default).
+    Load-time; both ranks must agree (``engine.GlmEngine`` checks)."""
+
+    tokens = _int_env(POOL_ENV, 0)
+    page = _int_env(PAGE_ENV, DEFAULT_PAGE)
+    slack = _int_env(SLACK_ENV, DEFAULT_SLACK)
+    if tokens < 0:
+        raise ValueError(f"{POOL_ENV}={tokens}: expected >= 0 (0 = off)")
+    if page < STORE_PAGE or page & (page - 1):
+        raise ValueError(f"{PAGE_ENV}={page}: expected a power of two >= {STORE_PAGE} (the session store's page, so a "
+                         "stored page is never split across pool pages)")
+    if slack < 0:
+        raise ValueError(f"{SLACK_ENV}={slack}: expected >= 0")
+    if tokens:
+        tokens = -(-tokens // page) * page
+    return tokens, page, slack
+
+
+def enabled() -> bool:
+    return settings()[0] > 0
+
+
+def check_on() -> bool:
+    return os.environ.get(CHECK_ENV, "0").strip() not in ("", "0")
+
+
+def pages_for(tokens: int, page: int) -> int:
+    return -(-max(int(tokens), 0) // page)
+
+
+def need_tokens(prompt: int, max_tokens: int, capacity: int, slack: int = DEFAULT_SLACK) -> int:
+    """Positions a request may write: its prompt, its reply, the windows past the committed end; at most the slot's
+    capacity (``check_room`` refuses more)."""
+
+    return min(int(prompt) + max(int(max_tokens), 0) + int(slack), int(capacity))
+
+
+# -- host bookkeeping (no torch) --------------------------------------------------------------------------------------
+class PageAlloc:
+    """Free physical pages 0 .. n - 1, handed out lowest first (deterministic: both ranks, same operations, same
+    pages)."""
+
+    def __init__(self, n: int) -> None:
+        self.n = int(n)
+        self.heap = list(range(self.n))
+        self.used = 0
+
+    @property
+    def n_free(self) -> int:
+        return len(self.heap)
+
+    def take(self, k: int) -> list[int]:
+        if k > len(self.heap):
+            raise PoolExhausted(f"KV pool: {k} pages asked, {len(self.heap)} free of {self.n}")
+        out = [heapq.heappop(self.heap) for _ in range(k)]
+        self.used += k
+        return out
+
+    def give(self, pages) -> None:
+        for p in pages:
+            heapq.heappush(self.heap, int(p))
+        self.used -= len(pages)
+
+
+class SlotPages:
+    """One slot's page table: logical page i -> physical page ``pages[i]`` (host list) and the device table the
+    kernels read (int32 [max_pages], unmapped entries = the null page). ``quota``: pages the batcher reserved for the
+    slot's request (None: no admission control, the lone engine)."""
+
+    def __init__(self, pool: "PoolBook", capacity: int, table: Any = None) -> None:
+        self.pool = pool
+        self.page = pool.page
+        self.capacity = int(capacity)
+        self.max_pages = pages_for(capacity, pool.page)
+        self.pages: list[int] = []
+        self.quota: int | None = None
+        self.table = table                       # torch int32 [max_pages] (None: host-only tests)
+        self.over = 0                            # pages taken past the quota (from pages nobody had reserved)
+
+    @property
+    def held(self) -> int:
+        return len(self.pages)
+
+    @property
+    def outstanding(self) -> int:
+        """Reserved pages not mapped yet (the admission promise still to keep)."""
+
+        return max(0, (self.quota or 0) - len(self.pages))
+
+    def tokens(self) -> int:
+        return len(self.pages) * self.page
+
+    def _write(self, i0: int, values: list[int]) -> None:
+        if self.table is None or not values:
+            return
+        import torch
+
+        self.table[i0:i0 + len(values)].copy_(torch.tensor(values, dtype=torch.int32))
+
+    def ensure(self, end: int) -> None:
+        """Map every page holding positions < ``end`` (a no-op when mapped already: the common case)."""
+
+        need = pages_for(end, self.page)
+        have = len(self.pages)
+        if need <= have:
+            return
+        if need > self.max_pages:
+            raise ValueError("context past the cache capacity")
+        k = need - have
+        if self.quota is not None and need > self.quota:
+            # past the admission's reservation: only pages nobody else reserved (never another request's promise)
+            spare = self.pool.alloc.n_free - self.pool.outstanding(exclude=self)
+            extra = need - max(self.quota, have)
+            if extra > spare:
+                raise PoolExhausted(f"KV pool: slot needs {need} pages, reserved {self.quota}, {spare} unreserved free "
+                                    "(GLM53_TF_KV_POOL_TOKENS)")
+            self.over += extra
+        new = self.pool.alloc.take(k)
+        self.pages.extend(new)
+        self._write(have, new)
+
+    def truncate(self, keep: int) -> int:
+        """Return the pages past position ``keep`` (their rows are dead: nothing reads a slot past its kept length);
+        -> pages returned."""
+
+        k = pages_for(keep, self.page)
+        if k >= len(self.pages):
+            return 0
+        drop = self.pages[k:]
+        del self.pages[k:]
+        self.pool.alloc.give(drop)
+        self._write(k, [self.pool.null] * len(drop))
+        return len(drop)
+
+    def reserve(self, pages: int | None) -> None:
+        self.quota = None if pages is None else int(pages)
+
+
+class PoolBook:
+    """The pool's host side: the free list, the page size and every slot's table (for the reservations)."""
+
+    def __init__(self, npages: int, page: int) -> None:
+        self.npages = int(npages)
+        self.page = int(page)
+        self.shift = page.bit_length() - 1
+        self.null = self.npages                  # the extra all-zero page unmapped entries point at
+        self.alloc = PageAlloc(npages)
+        self.slots: list[SlotPages] = []
+
+    def outstanding(self, exclude: SlotPages | None = None) -> int:
+        return sum(s.outstanding for s in self.slots if s is not exclude)
+
+    def available(self) -> int:
+        """Free pages no admitted request has reserved: what a new admission may count on."""
+
+        return self.alloc.n_free - self.outstanding()
+
+    def describe(self) -> str:
+        return (f"{self.alloc.n_free} of {self.npages} pages free, {self.outstanding()} reserved, "
+                f"{self.npages - self.alloc.n_free} mapped")
+
+
+# -- the logical view of a pool tensor ------------------------------------------------------------------------------
+class Paged:
+    """A slot's cache as the rest of the engine sees it: ``shape[0]`` is the slot's logical rows (its capacity, or
+    capacity / 4 + 2 pool keys), rows live on the slot's pages of ``phys`` ([(npages + 1) x per, ...]).
+
+    Kernels take ``phys``, the slot's device ``pt`` and ``shift`` (log2 of ``per``, rows a page). Host code (the session
+    store, the NVMe tier, snapshots' tails) slices it: a slice inside one page (``[a:b]`` with a // per == (b - 1) //
+    per) is a view of those physical rows, as a slice of the contiguous cache is; a slice across pages raises (use
+    ``segments``); an int index reads a row (the null page's row where unmapped: shape / size queries only)."""
+
+    is_paged = True
+
+    def __init__(self, phys, slot: SlotPages, per: int, rows: int) -> None:
+        self.phys = phys
+        self.slot = slot
+        self.per = int(per)
+        self.shift = self.per.bit_length() - 1
+        if 1 << self.shift != self.per:
+            raise ValueError(f"paged cache: {per} rows a page is not a power of two")
+        self.rows = int(rows)
+
+    # tensor-like attributes the engine reads
+    @property
+    def shape(self):
+        return (self.rows, *self.phys.shape[1:])
+
+    @property
+    def dtype(self):
+        return self.phys.dtype
+
+    @property
+    def device(self):
+        return self.phys.device
+
+    @property
+    def is_cuda(self) -> bool:
+        return self.phys.is_cuda
+
+    @property
+    def pt(self):
+        return self.slot.table
+
+    def is_contiguous(self) -> bool:
+        return True              # rows within a page are; every slice handed out lies within one page
+
+    def data_ptr(self) -> int:
+        return self.phys.data_ptr()
+
+    def element_size(self) -> int:
+        return self.phys.element_size()
+
+    def dim(self) -> int:
+        return self.phys.dim()
+
+    def row_bytes(self) -> int:
+        return int(self.phys[0].numel() * self.phys.element_size())
+
+    def view_rows(self, dtype):
+        raise TypeError("a paged cache has no flat view: copy it page by page (segments)")
+
+    def clone(self):
+        raise TypeError("a paged State cannot be cloned (its rows live in the shared KV pool, patches/0290)")
+
+    # rows
+    def _loc(self, r: int, *, write: bool = False) -> int:
+        if not 0 <= r < self.rows:
+            raise IndexError(f"row {r} outside the paged cache's {self.rows}")
+        p, o = divmod(r, self.per)
+        if p >= len(self.slot.pages):
+            if write:
+                raise IndexError(f"row {r} is on page {p}, which this slot has not mapped (KV pool)")
+            return self.slot.pool.null * self.per + o
+        return self.slot.pages[p] * self.per + o
+
+    def _range(self, key: slice) -> tuple[int, int]:
+        a, b, step = key.indices(self.rows)
+        if step != 1:
+            raise IndexError("paged cache: slices must be contiguous")
+        return a, max(a, b)
+
+    def __getitem__(self, key):
+        if isinstance(key, int):
+            return self.phys[self._loc(key)]
+        if isinstance(key, slice):
+            a, b = self._range(key)
+            if b == a:
+                return self.phys[0:0]
+            if a // self.per != (b - 1) // self.per:
+                raise IndexError(f"paged cache: rows {a}..{b} span pages; copy them page by page (segments)")
+            base = self._loc(a, write=True)
+            return self.phys[base:base + (b - a)]
+        raise TypeError(f"paged cache: index {key!r} (an int or a slice of rows)")
+
+    def __setitem__(self, key, value) -> None:
+        if isinstance(key, int):
+            self.phys[self._loc(key, write=True)] = value
+            return
+        view = self[key]
+        if hasattr(value, "shape"):
+            view.copy_(value)
+        else:
+            view.fill_(value)
+
+    def segments(self, a: int, b: int) -> list[tuple[int, int, Any]]:
+        """Logical rows [a, b) as (first row, end row, physical view) pieces, one a page."""
+
+        out = []
+        r = a
+        while r < b:
+            end = min(b, (r // self.per + 1) * self.per)
+            base = self._loc(r, write=True)
+            out.append((r, end, self.phys[base:base + (end - r)]))
+            r = end
+        return out
+
+    def gather(self, a: int, b: int):
+        """Logical rows [a, b) as a new contiguous tensor (host checks, tests)."""
+
+        import torch
+
+        segs = self.segments(a, b)
+        if not segs:
+            return self.phys[0:0].clone()
+        return torch.cat([v for _, _, v in segs]).clone()
+
+    def write(self, a: int, src) -> None:
+        """``src`` into logical rows a .. a + len(src) (mapped already)."""
+
+        for lo, hi, view in self.segments(a, a + src.shape[0]):
+            view.copy_(src[lo - a:hi - a])
+
+    def zero_rows(self, a: int, b: int) -> None:
+        for _, _, view in self.segments(a, b):
+            view.zero_()
+
+
+def is_paged(t) -> bool:
+    return bool(getattr(t, "is_paged", False))
+
+
+def kernel_args(t):
+    """(tensor, page table, shift) a kernel takes for cache ``t``: (t, None, 0) for a plain tensor."""
+
+    if is_paged(t):
+        return t.phys, t.pt, t.shift
+    return t, None, 0
+
+
+def slot_of(st) -> SlotPages | None:
+    return getattr(st, "pages", None)
+
+
+def ensure(st, end: int) -> None:
+    """Map a State's pages up to position ``end`` (nothing without the pool)."""
+
+    sp = getattr(st, "pages", None)
+    if sp is not None:
+        sp.ensure(end)
+
+
+def ensure_comps(comps, end: int) -> None:
+    """The session store's view: map the pages of whichever slot ``comps`` (``sessions.Comp`` list) belong to."""
+
+    for c in comps:
+        if is_paged(c.live):
+            c.live.slot.ensure(end)
+            return
+
+
+# -- the device side ------------------------------------------------------------------------------------------------
+class KvPool(PoolBook):
+    """The physical tensors (built lazily per cache family: every slot uses the same families) and the tables."""
+
+    def __init__(self, w, tokens: int, page: int, slack: int = DEFAULT_SLACK) -> None:
+        import torch
+
+        super().__init__(tokens // page, page)
+        self.w = w
+        self.slack = int(slack)
+        self.device = w.device
+        self.rows = (self.npages + 1) * page         # + the null page
+        self.t: dict[tuple, Any] = {}
+        self._torch = torch
+
+    def _family(self, key: tuple, make):
+        t = self.t.get(key)
+        if t is None:
+            t = make()
+            self.t[key] = t
+        return t
+
+    def new_slot(self, capacity: int) -> SlotPages:
+        torch = self._torch
+        mp = pages_for(capacity, self.page)
+        table = torch.full((mp,), self.null, dtype=torch.int32, device=self.device)
+        sp = SlotPages(self, capacity, table)
+        self.slots.append(sp)
+        return sp
+
+    def latent(self, sp: SlotPages, n: int) -> list[Paged]:
+        """The DSA layers' latent caches of a slot (``latent.caches`` rows: FP8 528 B or bf16)."""
+
+        from . import latent
+
+        phys = self._family(("latent", n), lambda: latent.caches(self.w, self.rows, n))
+        return [Paged(t, sp, self.page, sp.capacity) for t in phys]
+
+    def mtp_latent(self, sp: SlotPages) -> Paged:
+        from . import latent
+
+        phys = self._family(("mtp",), lambda: latent.caches(self.w, self.rows, 1)[0])
+        return Paged(phys, sp, self.page, sp.capacity)
+
+    def index_rows(self, sp: SlotPages, i: int, which: str) -> Paged:
+        """Index layer i's keys (``which`` "k") or gates ("g"), [capacity, index_dim] bf16, one row a token."""
+
+        torch = self._torch
+        d = self.w.cfg.index_dim
+        phys = self._family(("index", which, i),
+                            lambda: torch.zeros((self.rows, d), dtype=torch.bfloat16, device=self.device))
+        return Paged(phys, sp, self.page, sp.capacity)
+
+    def pool_keys(self, sp: SlotPages, i: int) -> Paged:
+        """Index layer i's pool keys, [capacity / 4 + 2, index_dim] bf16 logically (one row a complete pool of 4)."""
+
+        torch = self._torch
+        d = self.w.cfg.index_dim
+        per = self.page // 4
+        phys = self._family(("pk", i), lambda: torch.zeros(((self.npages + 1) * per, d), dtype=torch.bfloat16,
+                                                           device=self.device))
+        return Paged(phys, sp, per, sp.capacity // 4 + 2)
+
+    def nbytes(self) -> int:
+        return sum(int(t.numel() * t.element_size()) for v in self.t.values()
+                   for t in (v if isinstance(v, list) else [v]))
+
+    def token_bytes(self) -> int:
+        return self.nbytes() // max(self.rows, 1)
+
+    def null_clean(self) -> bool:
+        """The null page is still all zeros in every tensor (nothing wrote an unmapped row)."""
+
+        for key, v in self.t.items():
