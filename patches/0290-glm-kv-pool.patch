diff --git c/src/tensorfold/families/glm5_next/cuda/batchplan.py i/src/tensorfold/families/glm5_next/cuda/batchplan.py
index 2c4ac33..4187b53 100644
--- c/src/tensorfold/families/glm5_next/cuda/batchplan.py
+++ i/src/tensorfold/families/glm5_next/cuda/batchplan.py
@@ -302,6 +302,24 @@ def place_entry(free: Sequence[int], overlap: dict[int, int], used: dict[int, in
     return min(free, key=lambda s: (-overlap.get(s, 0), used.get(s, 0), s))
 
 
+def pool_spills(need: int, avail: int, idle: Sequence[tuple[int, int, int]],
+                prefer: int | None = None) -> list[int] | None:
+    """patches/0290 (GLM53_TF_KV_POOL_TOKENS): the idle slots whose pages a new request's ``need`` pages take when
+    only ``avail`` are free and unreserved. ``idle``: (slot, pages it holds, round of its last admission). The least
+    recently admitted go first, ``prefer`` (the slot the request would resume in) last; [] when ``avail`` covers it,
+    None when even every idle slot's pages do not (the request waits for a running one to end)."""
+
+    if need <= avail:
+        return []
+    out: list[int] = []
+    for slot, held, _ in sorted([x for x in idle if x[1] > 0], key=lambda x: (x[0] == prefer, x[2], x[0])):
+        out.append(slot)
+        avail += held
+        if need <= avail:
+            return out
+    return None
+
+
 def admit_free(free: int, store_headroom: int) -> int:
     """patches/0180: device memory a new request may count on: what is free less what the session store may still
     take within its budget (the store is budgeted at load alongside the slots, so admission leaves it that room)."""
