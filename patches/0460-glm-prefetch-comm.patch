+        comp["wait"].append((r["flag"] - r["bell"]) / 1e3)
+        comp["copy"].append((r["end"] - r["flag"]) / 1e3)
+        comp["total"].append((r["end"] - r["start"]) / 1e3)
+        by_seq[r["seq"]] = (r["flag"] - r["bell"]) / 1e3
