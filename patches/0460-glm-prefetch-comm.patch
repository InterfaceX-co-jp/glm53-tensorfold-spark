diff --git a/src/tensorfold/families/glm5_next/cuda/l2pf.cpp b/src/tensorfold/families/glm5_next/cuda/l2pf.cpp
new file mode 100644
index 0000000..4f7d832
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/l2pf.cpp
@@ -0,0 +1,66 @@
+// Bindings of the L2 prefetch kernels (patches/0460, GLM53_TF_L2PF; l2pf.cu). Launches go on the CURRENT stream
+// (l2pf.py switches to its side stream first), so they are captured in CUDA graphs like any kernel.
+
+#include <stdint.h>
+
+#include <stdexcept>
+#include <string>
+
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <torch/extension.h>
+
+namespace tfl2pf {
+
+cudaError_t launch_segments(const int64_t *table, int n, int grid, int threads, uint32_t chunk, bool bulk,
+                            cudaStream_t stream);
+cudaError_t launch_experts(const int32_t *ids, const int32_t *count, int maxu, const int64_t *bases, int nmat,
+                           int64_t stride_bytes, int64_t bytes, int64_t experts, int grid, int threads, uint32_t chunk,
+                           bool bulk, cudaStream_t stream);
+
+static void check(cudaError_t e, const char *what) {
+    if (e != cudaSuccess) {
+        throw std::runtime_error(std::string("l2pf: ") + what + ": " + cudaGetErrorString(e));
+    }
+}
+
+static void chunk_ok(int64_t chunk) {
+    if (chunk < 16 || chunk % 16 != 0 || chunk > (int64_t(1) << 24)) {
+        throw std::invalid_argument("l2pf: chunk must be a multiple of 16 bytes in [16, 16 MiB]");
+    }
+}
+
+// table: int64 [n, 2] on the device, (address, bytes) rows; addresses 16-byte aligned, bytes multiples of 16
+void segments(torch::Tensor table, int64_t grid, int64_t threads, int64_t chunk, bool bulk) {
+    TORCH_CHECK(table.is_cuda() && table.scalar_type() == torch::kInt64 && table.dim() == 2 && table.size(1) == 2 &&
+                    table.is_contiguous(),
+                "l2pf.segments: an int64 [n, 2] contiguous CUDA table");
+    chunk_ok(chunk);
+    if (table.size(0) == 0) {
+        return;
+    }
+    check(launch_segments(table.data_ptr<int64_t>(), int(table.size(0)), int(grid), int(threads), uint32_t(chunk), bulk,
+                          c10::cuda::getCurrentCUDAStream().stream()),
+          "segments launch");
+}
+
+// ids int32 [MAXU], count int32 [1]: qmm.Group; bases int64 [nmat] (device addresses of expert 0 of each matrix)
+void experts(torch::Tensor ids, torch::Tensor count, torch::Tensor bases, int64_t stride_bytes, int64_t bytes,
+             int64_t n_experts, int64_t grid, int64_t threads, int64_t chunk, bool bulk) {
+    TORCH_CHECK(ids.is_cuda() && ids.scalar_type() == torch::kInt32 && ids.is_contiguous(), "l2pf.experts: ids");
+    TORCH_CHECK(count.is_cuda() && count.scalar_type() == torch::kInt32 && count.numel() >= 1, "l2pf.experts: count");
+    TORCH_CHECK(bases.is_cuda() && bases.scalar_type() == torch::kInt64 && bases.is_contiguous(), "l2pf.experts: bases");
+    TORCH_CHECK(bytes > 0 && bytes % 16 == 0 && bytes <= stride_bytes, "l2pf.experts: bytes a multiple of 16, <= stride");
+    chunk_ok(chunk);
+    check(launch_experts(ids.data_ptr<int32_t>(), count.data_ptr<int32_t>(), int(ids.numel()),
+                         bases.data_ptr<int64_t>(), int(bases.numel()), stride_bytes, bytes, n_experts, int(grid),
+                         int(threads), uint32_t(chunk), bulk, c10::cuda::getCurrentCUDAStream().stream()),
+          "experts launch");
+}
+
+}  // namespace tfl2pf
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("segments", &tfl2pf::segments);
+    m.def("experts", &tfl2pf::experts);
+}
diff --git a/src/tensorfold/families/glm5_next/cuda/l2pf.cu b/src/tensorfold/families/glm5_next/cuda/l2pf.cu
new file mode 100644
index 0000000..e315b8a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/l2pf.cu
@@ -0,0 +1,114 @@
+// L2 prefetch kernels for the decode rounds' idle windows (patches/0460, GLM53_TF_L2PF).
+//
+// Every kernel here only READS weight memory into the GPU's L2 and writes nothing the model reads, so it cannot change
+// a bit of any result; it only changes where the next kernels find their weights (L2 instead of DRAM).
+//
+//   bulk   one cp.async.bulk.prefetch.L2.global per CHUNK bytes (sm_90+ PTX; GB10 is sm_121): the SM's bulk-copy
+//          unit streams the range into L2 with no registers, no shared memory and no data returned to the SM, so
+//          the kernel is a handful of instructions per thread and the side stream holds no SM for the transfer
+//   lines  one prefetch.global.L2 per 128-byte line (any sm_70+ GPU): the fallback if the bulk form is slower here
+//
+// Two entry points:
+//   prefetch_segments  a static per-site table of (address, bytes) (the plans of l2pf.py: the next kernels' weights)
+//   prefetch_experts   device-indexed: the first ``bytes`` of every distinct routed expert the router picked this
+//                      window (qmm.Group ids[0 .. count)), in each listed matrix (EXL3 trellis [E, ...] per expert),
+//                      without a host round trip, so it is captured in the round's CUDA graph like the rest
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace tfl2pf {
+
+constexpr uint32_t LINE = 128;
+
+__device__ __forceinline__ void bulk_prefetch(const void *p, uint32_t bytes) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" ::"l"(p), "r"(bytes) : "memory");
+#else   // the pre-sm_90 targets of TORCH_CUDA_ARCH_LIST (never run on GB10): a line prefetch per 128 bytes
+    for (uint32_t o = 0; o < bytes; o += LINE) asm volatile("prefetch.global.L2 [%0];" ::"l"((const char *)p + o));
+#endif
+}
+
+__device__ __forceinline__ void line_prefetch(const void *p) {
+    asm volatile("prefetch.global.L2 [%0];" ::"l"(p));
+}
+
+// ``bytes`` of [p, p + bytes) in pieces of ``chunk`` bytes (a multiple of 16), piece i by thread i of ``stride``.
+// Bulk prefetches need a 16-byte aligned address and a size that is a multiple of 16: the host rounds every segment
+// to that (l2pf.py), and the last piece is the remainder (also a multiple of 16).
+template <bool Bulk>
+__device__ __forceinline__ void range(const uint8_t *p, uint64_t bytes, uint32_t chunk, uint64_t index,
+                                      uint64_t stride) {
+    if (Bulk) {
+        const uint64_t pieces = (bytes + chunk - 1) / chunk;
+        for (uint64_t i = index; i < pieces; i += stride) {
+            const uint64_t off = i * chunk;
+            const uint64_t left = bytes - off;
+            bulk_prefetch(p + off, static_cast<uint32_t>(left < chunk ? left : chunk));
+        }
+    } else {
+        const uint64_t lines = (bytes + LINE - 1) / LINE;
+        for (uint64_t i = index; i < lines; i += stride) {
+            line_prefetch(p + i * LINE);
+        }
+    }
+}
+
+// table: n pairs of int64 (device address, bytes)
+template <bool Bulk>
+__global__ void __launch_bounds__(256) segments_kernel(const int64_t *table, int n, uint32_t chunk) {
+    const uint64_t index = static_cast<uint64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const uint64_t stride = static_cast<uint64_t>(gridDim.x) * blockDim.x;
+    for (int s = 0; s < n; s++) {
+        const uint8_t *p = reinterpret_cast<const uint8_t *>(static_cast<uintptr_t>(table[2 * s]));
+        const uint64_t bytes = static_cast<uint64_t>(table[2 * s + 1]);
+        // segment s's first piece goes to thread s (mod the grid): a table of many one-piece heads (the chunk heads of
+        // a 4-bit matrix) is spread over the threads instead of all landing on thread 0
+        const uint64_t first = (index + stride - static_cast<uint64_t>(s) % stride) % stride;
+        range<Bulk>(p, bytes, chunk, first, stride);
+    }
+}
+
+// Block u (grid-stride over maxu) prefetches the first ``bytes`` of expert ids[u] in each of the ``nmat`` matrices
+// (bases[m] + ids[u] * stride_bytes) when u < count[0]. ids / count are the router's device output (qmm.Group).
+template <bool Bulk>
+__global__ void __launch_bounds__(256) experts_kernel(const int32_t *ids, const int32_t *count, int maxu,
+                                                      const int64_t *bases, int nmat, int64_t stride_bytes,
+                                                      int64_t bytes, int64_t experts, uint32_t chunk) {
+    const int n = min(static_cast<int>(*count), maxu);
+    for (int u = blockIdx.x; u < n; u += gridDim.x) {
+        const int64_t e = static_cast<int64_t>(ids[u]);
+        if (e < 0 || e >= experts) {
+            continue;                    // never read outside the expert tensors
+        }
+        for (int m = 0; m < nmat; m++) {
+            const uint8_t *p = reinterpret_cast<const uint8_t *>(static_cast<uintptr_t>(bases[m])) + e * stride_bytes;
+            range<Bulk>(p, static_cast<uint64_t>(bytes), chunk, threadIdx.x, blockDim.x);
+        }
+    }
+}
+
+cudaError_t launch_segments(const int64_t *table, int n, int grid, int threads, uint32_t chunk, bool bulk,
+                            cudaStream_t stream) {
+    if (bulk) {
+        segments_kernel<true><<<grid, threads, 0, stream>>>(table, n, chunk);
+    } else {
+        segments_kernel<false><<<grid, threads, 0, stream>>>(table, n, chunk);
+    }
+    return cudaGetLastError();
+}
+
+cudaError_t launch_experts(const int32_t *ids, const int32_t *count, int maxu, const int64_t *bases, int nmat,
+                           int64_t stride_bytes, int64_t bytes, int64_t experts, int grid, int threads, uint32_t chunk,
+                           bool bulk, cudaStream_t stream) {
+    if (bulk) {
+        experts_kernel<true><<<grid, threads, 0, stream>>>(ids, count, maxu, bases, nmat, stride_bytes, bytes, experts,
+                                                           chunk);
+    } else {
+        experts_kernel<false><<<grid, threads, 0, stream>>>(ids, count, maxu, bases, nmat, stride_bytes, bytes, experts,
+                                                            chunk);
+    }
+    return cudaGetLastError();
+}
+
+}  // namespace tfl2pf
diff --git a/src/tensorfold/families/glm5_next/cuda/l2pf.py b/src/tensorfold/families/glm5_next/cuda/l2pf.py
new file mode 100644
index 0000000..65418c9
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/l2pf.py
@@ -0,0 +1,482 @@
+"""GLM53_TF_L2PF (patches/0460): the next kernels' weights into L2 during a decode round's latency-bound windows, on
+every forward path (lone ``forward.compute``, the Batcher's ``batch.compute_multi``, the MTP head alone and batched).
+Default off; off, every hook below is one dict lookup that finds nothing.
+
+Why
+---
+A decode round is DRAM-bound except for its latency-bound stretches: each block's all-gather (RoCE, 11-20 us),
+hc_post + the next hc_pre, the router, the KDA chains and the attention core. In those windows the memory system
+idles (docs/PROFILE.md section 5, docs/ROOFLINE.md section 2). patches/0040 (``GLM53_TF_COMM=prefetch``) used the
+all-gather windows, but only in ``forward.compute``: ``batch.compute_multi`` never tagged a site, so production's
+multi-slot rounds (``GLM53_TF_BATCH=4``) never prefetched, and its Triton loads held half the SMs while they ran.
+
+What
+----
+Sites (``GLM53_TF_L2PF_SITES``, default ``a,f,o``), each a static list of (address, bytes) built at load
+(``plans``), capped at ``GLM53_TF_L2PF_MB`` a site:
+
+- ``a``  at a layer's attention all-gather: its FFN's first reads (the mix ``ffn_hc.fn``, post norm, the router and
+         its bias, the shared expert's gate/up; or a dense MLP's gate/up) -- 0040's plan;
+- ``f``  at a layer's FFN all-gather: the next layer's ``attn_hc.fn``, input norm and attention input projection
+         (after the last layer: the final norm and the head) -- 0040's plan;
+- ``o``  NEW, after a layer's attention projections, before its attention core (the KDA chains, or the DSA
+         cache write + attention; per slot in a batched round, so this window grows with the slots): the attention
+         output projection (and on the latent path the value expansion ``kv_v`` first, which runs before it);
+- ``e``  NEW, device-indexed, right after the router: the first ``GLM53_TF_L2PF_EXPERT_KB`` of every distinct routed
+         expert the window picked (EXL3 gate and up trellis), from ``qmm.Group`` on the device (no host round trip,
+         captured in the graph). It overlaps the shared expert (computed first while a prefetcher is installed, as in
+         0040) and the routed kernels' input rotation; the routed kernels then start on L2 hits.
+The MTP head's own sites are ``("mtp", "a" | "f" | "o")``. A 4-bit matrix whose ``qmm`` launch is one wave (at most
+192 programs: the shared expert's gate/up, DSA's input projection, KDA's output projection, ``kv_v``) is prefetched as
+the head of every (64-column tile, K slice) chunk, so every program starts on L2 hits; larger launches by their first
+bytes (the first wave's programs).
+
+Mechanism (``GLM53_TF_L2PF``): ``bulk`` (= ``1``) a tiny kernel issues ``cp.async.bulk.prefetch.L2.global`` per
+``GLM53_TF_L2PF_CHUNK_KB`` (the SM's bulk-copy unit streams the bytes into L2; no registers, no shared memory, no data
+back to the SM); ``lines`` one ``prefetch.global.L2`` per 128-byte line; ``touch`` 0040's Triton loads into a sink.
+Every launch goes on a side stream forked from the current stream at the site (so it runs beside the main stream's
+next kernels, never in front of them), and every forward joins it before it returns (captured graphs hold no open
+fork). Windows wider than ``GLM53_TF_L2PF_ROWS`` rows (prefill chunks) skip every site.
+
+Exactness: the kernels only read weights into L2 and write nothing the model reads; every model kernel runs with the
+same arguments in the same stream order, except the EXL3 shared expert, which runs before the routed experts while a
+prefetcher is installed (0040's order: disjoint inputs and outputs, so the same bits). L2 residency changes timing,
+never values. Both ranks may even differ in these knobs (nothing crosses the link), though A/Bs set both.
+
+Knobs
+-----
+``GLM53_TF_L2PF``            ``0`` (default) | ``1`` / ``bulk`` | ``lines`` | ``touch``
+``GLM53_TF_L2PF_MB``         bytes a site (depth), MiB. 4 (capped at half the L2: 12 MiB on GB10)
+``GLM53_TF_L2PF_SITES``      comma list of a, f, o, e. ``a,f,o``
+``GLM53_TF_L2PF_EXPERT_KB``  per picked expert and matrix (site ``e``). 64
+``GLM53_TF_L2PF_ROWS``       largest window (rows of the forward) that prefetches. 64
+``GLM53_TF_L2PF_CHUNK_KB``   bytes a bulk prefetch instruction. 32
+``GLM53_TF_COMM=prefetch`` (0040) and ``GLM53_TF_L2PF`` exclude each other (the load refuses both).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import NamedTuple
+
+import torch
+
+ENV = "GLM53_TF_L2PF"
+MODES = ("bulk", "lines", "touch")
+SITES = ("a", "f", "o", "e")
+DEFAULT_SITES = ("a", "f", "o")
+L2_FALLBACK = 24 * 2**20                  # GB10 (results/W11/probe-head.log: 24.0 MB)
+ALIGN = 16                                # cp.async.bulk: 16-byte aligned address, size a multiple of 16
+
+
+@dataclass(frozen=True)
+class Settings:
+    mode: str | None = None               # None: off
+    mb: float = 4.0
+    sites: tuple = DEFAULT_SITES
+    expert_kb: int = 64
+    rows: int = 64
+    chunk_kb: int = 32
+
+    @property
+    def on(self) -> bool:
+        return self.mode is not None
+
+
+def _num(env: dict, name: str, default, lo, hi, kind=float):
+    raw = str(env.get(name, "")).strip()
+    if not raw:
+        return default
+    try:
+        v = kind(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def settings(env: dict | None = None) -> Settings:
+    env = os.environ if env is None else env
+    raw = str(env.get(ENV, "")).strip().lower()
+    if raw in ("", "0", "off", "none"):
+        return Settings()
+    mode = "bulk" if raw == "1" else raw
+    if mode not in MODES:
+        raise ValueError(f"{ENV}={raw!r}: expected 0, 1, bulk, lines or touch")
+    mb = _num(env, ENV + "_MB", 4.0, 0.0625, 12.0)
+    sites_raw = str(env.get(ENV + "_SITES", "")).strip().lower()
+    sites = DEFAULT_SITES
+    if sites_raw:
+        sites = tuple(s.strip() for s in sites_raw.split(",") if s.strip())
+        bad = [s for s in sites if s not in SITES]
+        if bad or not sites:
+            raise ValueError(f"{ENV}_SITES={sites_raw!r}: expected a comma list of a, f, o, e")
+    return Settings(mode, float(mb), tuple(dict.fromkeys(sites)),
+                    int(_num(env, ENV + "_EXPERT_KB", 64, 1, 2048, int)),
+                    int(_num(env, ENV + "_ROWS", 64, 1, 1 << 16, int)),
+                    int(_num(env, ENV + "_CHUNK_KB", 32, 1, 1024, int)))
+
+
+# -- plans ------------------------------------------------------------------------------------------------------------
+class Span(NamedTuple):
+    tensor: torch.Tensor                  # the weight (kept for touch mode's views)
+    addr: int
+    nbytes: int
+
+
+def _span(t, left: int) -> Span | None:
+    """The first ``left`` bytes of tensor t, rounded for the bulk form (16-byte aligned start, a multiple of 16
+    bytes), or None."""
+
+    if not isinstance(t, torch.Tensor) or not t.is_contiguous() or t.numel() == 0:
+        return None
+    start = t.data_ptr()
+    end = start + t.numel() * t.element_size()
+    a = -(-start // ALIGN) * ALIGN
+    n = min(left, end - a) // ALIGN * ALIGN
+    if n <= 0:
+        return None
+    return Span(t, a, n)
+
+
+ONE_WAVE = 192                            # qmm programs resident at once on GB10 (4 CTAs an SM x 48 SMs; W11 ncu)
+
+
+def _is_q4(q) -> bool:
+    return all(hasattr(q, a) for a in ("weight", "scales", "biases", "n", "k"))
+
+
+def _q4_heads(q, left: int) -> list[Span]:
+    """A 4-bit matrix (``qmm.Q4``: words [N/64, K/64, 64, 8], one contiguous chunk of K * 32 / SK bytes per (64-column
+    tile, K slice), which is what one program of ``qmm.matmul`` streams): the first ``left / chunks`` bytes of EVERY
+    chunk, so every program of a single-wave launch starts on L2 hits (the first bytes of the tensor would only help
+    the first programs, and the launch lasts as long as its slowest one). [] if the launch is more than one wave (the
+    heads of later waves would be evicted by the earlier waves' stream) or the heads would be under 512 bytes."""
+
+    from . import qmm
+
+    w = q.weight
+    tiles = -(-int(q.n) // qmm.BN)
+    sk = qmm.split_k(int(q.n), int(q.k))
+    total = w.numel() * w.element_size()
+    chunks = tiles * sk
+    if chunks <= 0 or chunks > ONE_WAVE or total % chunks:
+        return []
+    size = total // chunks
+    per = min(size, left // chunks) // ALIGN * ALIGN
+    if per < 512 or w.data_ptr() % ALIGN or size % ALIGN:
+        return []
+    base = w.data_ptr()
+    return [Span(w, base + c * size, per) for c in range(chunks)]
+
+
+def take(items: list, budget: int) -> list[Span]:
+    """The spans of ``items`` in order, up to ``budget`` bytes in all. A tensor: its first bytes. A 4-bit matrix: its
+    scales and biases (small, read by every program), then its words -- the head of every (tile, K slice) chunk when
+    its launch is one wave (``_q4_heads``), else its first bytes (the first wave's programs). A BF16 matrix
+    (``qmm.B16``): its first bytes."""
+
+    out, left = [], int(budget)
+
+    def add(t) -> None:
+        nonlocal left
+        if left < ALIGN:
+            return
+        s = _span(t, left)
+        if s is not None:
+            out.append(s)
+            left -= s.nbytes
+
+    for it in items:
+        if left < ALIGN:
+            break
+        if isinstance(it, torch.Tensor):
+            add(it)
+        elif _is_q4(it):
+            add(it.scales)
+            add(it.biases)
+            heads = _q4_heads(it, left)
+            if heads:
+                out += heads
+                left -= sum(h.nbytes for h in heads)
+            else:
+                add(it.weight)
+        elif hasattr(it, "weight"):
+            add(it.weight)
+    return out
+
+
+def _ffn_items(layer, with_hc: bool) -> list:
+    """What the kernels after a layer's attention all-gather read first (0040's ``_ffn_reads``, matrices whole)."""
+
+    items = [layer.ffn_hc.fn] if with_hc and layer.ffn_hc is not None else []
+    items.append(layer.post_norm)
+    if layer.mlp is not None:
+        items.append(layer.mlp.gu)
+    elif layer.moe is not None:
+        items += [layer.moe.router, layer.moe.bias]
+        if layer.moe.shared is not None:
+            items.append(layer.moe.shared.gu)
+    return items
+
+
+def _attn_items(layer) -> list:
+    """... after the previous layer's FFN all-gather (0040's ``_attn_reads``)."""
+
+    items = [layer.attn_hc.fn] if layer.attn_hc is not None else []
+    items.append(layer.in_norm)
+    items.append(layer.kda.proj if layer.kind == "kda" else layer.dsa.proj)
+    return items
+
+
+def _out_items(layer, latent_kv: bool) -> list:
+    """... after a layer's attention core: the value expansion (latent DSA: it runs before the output projection),
+    then the output projection."""
+
+    if layer.kind == "kda":
+        return [layer.kda.o]
+    a = layer.dsa
+    return ([a.kv_v] if latent_kv else []) + [a.o]
+
+
+def plans(w, budget: int, sites=DEFAULT_SITES, latent_kv: bool | None = None) -> dict:
+    """Per site key ((layer index, kind) or ("mtp", kind)): the spans to prefetch, at most ``budget`` bytes: 0040's
+    ``a`` / ``f`` reads, plus ``o``."""
+
+    if latent_kv is None:
+        from . import latent
+
+        latent_kv = bool(latent.on(w))
+    out = {}
+    layers = w.layers
+    for i, layer in enumerate(layers):
+        if "a" in sites:
+            out[(layer.index, "a")] = take(_ffn_items(layer, True), budget)
+        if "f" in sites:
+            nxt = _attn_items(layers[i + 1]) if i + 1 < len(layers) else [w.norm, w.head]
+            out[(layer.index, "f")] = take(nxt, budget)
+        if "o" in sites:
+            out[(layer.index, "o")] = take(_out_items(layer, latent_kv), budget)
+    if w.mtp is not None:
+        if "a" in sites:
+            out[("mtp", "a")] = take(_ffn_items(w.mtp.layer, False), budget)
+        if "f" in sites:
+            from . import draftvocab
+
+            out[("mtp", "f")] = take([w.mtp.norm, draftvocab.head_for(w, "mtp")], budget)
+        if "o" in sites:
+            out[("mtp", "o")] = take(_out_items(w.mtp.layer, latent_kv), budget)
+    return {k: v for k, v in out.items() if v}
+
+
+def expert_plans(w, nbytes: int) -> dict:
+    """Per MoE layer with EXL3 experts (key: the ``Exl3Experts`` object's id): (bases [gate, up] addresses, bytes an
+    expert apart, bytes to prefetch an expert and matrix, expert count)."""
+
+    out = {}
+    layers = list(w.layers) + ([w.mtp.layer] if w.mtp is not None else [])
+    for layer in layers:
+        m = getattr(layer, "moe", None)
+        ex = getattr(m, "experts", None) if m is not None else None
+        if ex is None or not hasattr(ex, "gt") or not hasattr(ex, "ut"):
+            continue
+        gt, ut = ex.gt, ex.ut
+        if not (gt.is_contiguous() and ut.is_contiguous()) or gt.shape[0] != ut.shape[0] or gt.shape != ut.shape:
+            continue
+        stride = gt[0].numel() * gt.element_size()
+        n = min(int(nbytes), stride) // ALIGN * ALIGN
+        if n <= 0 or gt.data_ptr() % ALIGN or ut.data_ptr() % ALIGN or stride % ALIGN:
+            continue
+        out[id(ex)] = ([gt.data_ptr(), ut.data_ptr()], stride, n, int(gt.shape[0]))
+    return out
+
+
+def key(w, layer, kind: str):
+    """The site key of ``layer`` (the MTP head's layer is keyed ("mtp", kind): its index may equal a main layer's)."""
+
+    mtp = getattr(w, "mtp", None)
+    if mtp is not None and layer is mtp.layer:
+        return ("mtp", kind)
+    return (layer.index, kind)
+
+
+# -- hooks (called by forward / batch / latent; no-ops unless a 0460 prefetcher is installed) ------------------------
+def mark(w, layer, kind: str, R: int) -> None:
+    """Site ``kind`` of ``layer`` reached with R rows (``o``: after the attention projections)."""
+
+    pf = w.meta.get("prefetch")
+    if pf is not None and getattr(pf, "L2PF", False):
+        pf.launch(key(w, layer, kind), R)
+
+
+def experts(w, layer, grp, R: int) -> None:
+    """Site ``e``: right after the router wrote ``grp`` (ids / count on the device)."""
+
+    pf = w.meta.get("prefetch")
+    if pf is not None and getattr(pf, "L2PF", False):
+        pf.experts(layer, grp, R)
+
+
+# -- the prefetcher ---------------------------------------------------------------------------------------------------
+_EXT = None
+
+
+def _ext():
+    global _EXT
+    if _EXT is None:
+        from torch.utils.cpp_extension import load
+
+        here = Path(__file__).parent
+        _EXT = load(name="tensorfold_glm_l2pf_v1", sources=[str(here / "l2pf.cpp"), str(here / "l2pf.cu")],
+                    extra_cflags=["-O2"], extra_cuda_cflags=["-O3"], verbose=False)
+    return _EXT
+
+
+@dataclass
+class Stats:
+    launches: int = 0                     # site launches (eager calls + captures)
+    skipped_rows: int = 0                 # sites skipped: window wider than GLM53_TF_L2PF_ROWS
+    expert_launches: int = 0
+    bytes_planned: int = 0                # sum over sites of their plan's bytes (once, at load)
+    by_kind: dict = field(default_factory=dict)
+
+
+class Prefetcher:
+    """0040's interface (``launch(site)``, ``join()``, ``pending``) plus rows, the ``o`` / ``e`` sites and the bulk /
+    lines mechanisms. ``L2PF`` tells the 0460 hooks apart from 0040's ``overlap.Prefetcher`` (which has no ``o`` / ``e``
+    sites)."""
+
+    L2PF = True
+    THREADS = 128
+
+    def __init__(self, w, s: Settings) -> None:
+        dev = w.device
+        props = torch.cuda.get_device_properties(dev)
+        l2 = int(getattr(props, "L2_cache_size", 0) or 0) or L2_FALLBACK
+        self.s = s
+        self.budget = min(int(s.mb * 2**20), l2 // 2)
+        self.sms = int(props.multi_processor_count)
+        self.chunk = s.chunk_kb * 1024
+        self.plans = plans(w, self.budget, s.sites)
+        self.stats = Stats(bytes_planned=sum(sp.nbytes for v in self.plans.values() for sp in v))
+        for (_, kind), v in self.plans.items():
+            self.stats.by_kind[kind] = self.stats.by_kind.get(kind, 0) + sum(sp.nbytes for sp in v)
+        self.side = torch.cuda.Stream(device=dev)
+        self.pending = False
+        self._cap = False
+        self.tables: dict = {}
+        self.views: dict = {}
+        if s.mode in ("bulk", "lines"):
+            ext = _ext()
+            self.ext = ext
+            for k, spans in self.plans.items():
+                self.tables[k] = torch.tensor([[sp.addr, sp.nbytes] for sp in spans], dtype=torch.int64,
+                                              device=dev).view(-1, 2)
+        else:                                             # touch: 0040's loads, over int32 views of the same spans
+            from .overlap import Prefetcher as Touch
+
+            self.progs = max(1, self.sms // 2)
+            self.sink = torch.zeros((self.progs,), dtype=torch.int32, device=dev)
+            self._touch = Touch
+            for k, spans in self.plans.items():
+                self.views[k] = [_view(sp) for sp in spans]
+        self.eplans = {}
+        if "e" in s.sites and s.mode in ("bulk", "lines"):
+            for k, (bases, stride, n, count) in expert_plans(w, s.expert_kb * 1024).items():
+                self.eplans[k] = (torch.tensor(bases, dtype=torch.int64, device=dev), stride, n, count)
+
+    @property
+    def launches(self) -> int:                            # 0040's counter
+        return self.stats.launches
+
+    def _fork(self) -> None:
+        cur = torch.cuda.current_stream()
+        cap = torch.cuda.is_current_stream_capturing()
+        if self.pending and cap != self._cap:
+            self.pending = False                          # an eager fork never joins a capture (and vice versa)
+        self.side.wait_stream(cur)                        # after the main stream's work so far, beside what follows
+        self._cap = cap
+        self.pending = True
+
+    def _grid(self, nbytes: int) -> int:
+        per = self.chunk if self.s.mode == "bulk" else 128
+        pieces = -(-nbytes // per)
+        return max(1, min(self.sms, -(-pieces // self.THREADS)))
+
+    def launch(self, site, R: int | None = None) -> None:
+        if R is not None and R > self.s.rows:
+            self.stats.skipped_rows += 1
+            return
+        if self.s.mode == "touch":
+            segs = self.views.get(site)
+            if not segs:
+                return
+            self._fork()
+            with torch.cuda.stream(self.side):
+                for v in segs:
+                    self._touch_kernel(v)
+        else:
+            table = self.tables.get(site)
+            if table is None:
+                return
+            self._fork()
+            nbytes = sum(sp.nbytes for sp in self.plans[site])
+            with torch.cuda.stream(self.side):
+                self.ext.segments(table, self._grid(nbytes), self.THREADS, self.chunk, self.s.mode == "bulk")
+        self.stats.launches += 1
+
+    def _touch_kernel(self, v: torch.Tensor) -> None:
+        from .overlap import _touch
+
+        _touch[(self.progs,)](v, self.sink, v.numel(), BLOCK=self._touch.BLOCK, PROGS=self.progs, num_warps=4)
+
+    def experts(self, layer, grp, R: int) -> None:
+        if R > self.s.rows or not self.eplans:
+            return
+        ex = getattr(getattr(layer, "moe", None), "experts", None)
+        plan = self.eplans.get(id(ex))
+        if plan is None:
+            return
+        bases, stride, n, count = plan
+        self._fork()
+        with torch.cuda.stream(self.side):
+            self.ext.experts(grp.ids, grp.count, bases, stride, n, count, min(self.sms, int(grp.ids.numel())),
+                             self.THREADS, self.chunk, self.s.mode == "bulk")
+        self.stats.expert_launches += 1
+
+    def join(self) -> None:
+        if self.pending:
+            if torch.cuda.is_current_stream_capturing() == self._cap:
+                torch.cuda.current_stream().wait_stream(self.side)
+            self.pending = False
+
+
+def _view(sp: Span) -> torch.Tensor:
+    """touch mode: the span as an int32 view of its weight (the same memory; spans are multiples of 16 bytes)."""
+
+    t = sp.tensor
+    off = sp.addr - t.data_ptr()
+    return t.reshape(-1).view(torch.uint8)[off:off + sp.nbytes].view(torch.int32)
+
+
+def install(w):
+    """At engine build, after 0040's ``overlap.install`` (before any graph is captured): a 0460 prefetcher on
+    ``w.meta["prefetch"]`` when ``GLM53_TF_L2PF`` is on. Unlike 0040 it also runs with one rank (nothing it does
+    involves the link; the windows it fills are also the small kernels')."""
+
+    s = settings()
+    if not s.on:
+        return None
+    if w.meta.get("prefetch") is not None:
+        raise ValueError(f"{ENV} and GLM53_TF_COMM=prefetch (patches/0040) exclude each other: set one")
+    if not torch.cuda.is_available():
+        return None
+    pf = Prefetcher(w, s)
+    w.meta["prefetch"] = pf
+    kinds = ", ".join(f"{k} {v / 2**20:.1f} MiB" for k, v in sorted(pf.stats.by_kind.items()))
+    print(f"[tensorfold] l2pf: {s.mode}, {pf.budget / 2**20:g} MiB a site, sites {','.join(s.sites)} ({kinds}); "
+          f"experts {len(pf.eplans)} layers x {s.expert_kb} KiB; windows <= {s.rows} rows", flush=True)
+    return pf
