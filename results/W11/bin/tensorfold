#!/usr/bin/env bash
# W11 shim (W7's): the real /usr/local/bin/tensorfold under an idle nsys session "w11" (collection starts with `nsys start`)
if [[ "${W11_NSYS:-0}" == 1 ]]; then
    exec nsys launch --session-new=w11 --trace=cuda-sw,nvtx --cuda-graph-trace=node --cuda-event-trace=false \
        --trace-fork-before-exec=false /usr/local/bin/tensorfold "$@"
fi
exec /usr/local/bin/tensorfold "$@"
