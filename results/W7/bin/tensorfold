#!/usr/bin/env bash
# W7 shim: the real /usr/local/bin/tensorfold under an idle nsys session (collection starts with `nsys start`)
if [[ "${W7_NSYS:-0}" == 1 ]]; then
    exec nsys launch --session-new=w7 --trace=cuda-sw,nvtx --cuda-graph-trace=node --cuda-event-trace=false \
        --trace-fork-before-exec=false /usr/local/bin/tensorfold "$@"
fi
exec /usr/local/bin/tensorfold "$@"
