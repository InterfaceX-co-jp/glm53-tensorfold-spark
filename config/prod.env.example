# Production config (2026-09-29, docs/RESULTS.md W15, load B7; image b7 = patches 0001-0490 + 0500 + 0540): 4
# concurrent requests (GLM53_TF_BATCH=4) sharing one 1,048,576-token latent KV pool (patches/0290; each request up to
# CONTEXT = 1M tokens while the pool has room), FP8 latent KV (0220), sessions inside the batch slots (0180) with a
# 2 GiB RAM store and an NVMe tier (0250), shared system-prompt reuse (0310), row-split prefill (0320), the RoCE
# all-gather (0230/0350), b12x bit 4 (0360), MLA expand v2 (0390), decode overlap (0370), 16-row verify windows (0380),
# L2 weight prefetch in decode (0460, W12), image input (0500, W15), replay snapshots at n - 64 and early first tokens
# (0540, W15; GLM53_TF_SNAPSHOT_BEFORE_END / GLM53_TF_EMIT_FIRST default on), reasoning in the `reasoning` field only.
# Gates of this config (docs/RESULTS.md W15): exact 10/10 twice, batchexact 4/4 twice, W9 transcripts identical, reply
# sha 8794a3463259cc2f, every glmbench reply hash == W12, long-prompt exactness (N1) 12/12, prefill 24.5k / 98k
# ~1,605-1,610 tok/s, decode within noise of W12 (4 streams 80.6 tok/s), identical 8K / 32K / 64K prompts resent:
# 0.23 / 0.26 / 0.29 s to the first token (n - 64 cached), images (screenshots, receipts, counts, charts), MMLU-200
# 88.0%, refusals 0/10, 4 x 250k stress MemAvailable min 8.27 / 8.28 GiB (head / worker), no OOM, needle at 314k found
# (during it, after the stress and MMLU, MemAvailable dipped to 6.39 / 6.42 GiB for ~35 s: docs/MEMORY-SAFETY.md).
# Memory: the head node carries the 1.13 GB vision tower; both nodes now sit at the same stress floor. 8,192-row prefill
# chunks (PREFILL_ROWS_MAX / SOLO_PIECE 8192, ~+4% prefill) took the worker's stress minimum under 8 GiB (7.23), so 4,096
# stays. Vision off (drop GLM53_TF_VISION*) gives the head ~1.1-1.9 GiB back; text replies are bit-identical either way.
# Not adopted (knobs off; docs/PATCHES.md records each): 0400 KDA v2, 0410 sparse v2, 0420 draft vocabulary, 0440
# streaming decode kernels, 0450 GPU-resident rounds, 0470 8-bit non-experts, GLM53_TF_CPU_PIN, 0330, 0270, 0280, 0340.
# 0510-0530, 0550 and 0560 are in the default build (every patch in patches/, all off) but were not in the b7 image;
# to build exactly b7: PATCHES="<the list in results/W15/build-patches.txt>" scripts/serve.sh build.
# THIS IS THE DEFAULT: scripts/serve.sh reads config/prod.env unless CONFIG is set. Set up (README Quickstart, AGENTS.md):
#   cp config/prod.env.example config/prod.env; fill in the four <placeholders> below (WORKER_SSH, HEAD_IP, HEAD_HF,
#   WORKER_HF) and check NCCL_SOCKET_IFNAME / NCCL_IB_HCA; then scripts/serve.sh build; preflight; start.
# Change nothing else unless you are experimenting: every other value below is the tested production setting.
# Simpler earlier configs: config/prod-batch.env.example (4 x 256k, no pool) and config/prod-single.env.example
# (single stream, 524k, bf16 KV). If RoCE fails on your link, GLM53_TF_COMM_BACKEND=nccl (docs/ROCE-FIX.md).

# --- nodes / link (fill in; AGENTS.md step 2 shows how to find each value) ----------
WORKER_SSH="<worker-ssh>"
HEAD_IP="<head-ip>"
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
MASTER_PORT=29551

# --- weights ----------------------------------------------------------------------
# absolute host paths of each node's Hugging Face cache (e.g. /home/<you>/.cache/huggingface)
HEAD_HF="<head HF cache>"
WORKER_HF="<worker HF cache>"
# patches/0140 prepared rank folders: <HF cache>/../glm53-tf/prepared on each node (written by the first start)
MODEL_PATH=/root/.cache/huggingface/hub/models--neko-legends--GLM-5.3-Flash-Uncensored-EXL3/snapshots/07135ec082f8f11f7a71e4244a4e5167a0f96277
# optional DFlash2 drafter: CC BY-NC-ND 4.0, non-commercial use only; download it yourself. Empty = MTP drafts only
DRAFTER=/root/.cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/7d74cdd881ed7e32c31175984a67823127b66cfe

# --- serving ------------------------------------------------------------------------
IMAGE=glm53-tensorfold:dev
SERVED_NAME=GLM-5.3-Flash-EXL3
HOST=127.0.0.1
PORT=8000
CONTEXT=1048576
MAX_TOKENS=32768

# --- ops (scripts/serve.sh) ---------------------------------------------------------
CANARY=warn
WARMUP_LENGTHS="4096 16384"
# the 4th slot needs MemFree (not MemAvailable): page cache counts against the load-time slot rule
MEM_GATE_GIB=108
MEM_GATE_TIMEOUT=300
MEM_GATE_DROP_CACHES=1

# --- engine -------------------------------------------------------------------------
GLM53_TF_NONEXPERT=q4mse
GLM53_TF_LATENT_KV=1
GLM53_TF_KV_DTYPE=fp8
GLM53_TF_PREFILL_ROWS=auto
# W8: 8,192-row fast chunks (lean buffers 3.10 GiB a rank, was 0.78); used by lone requests via SOLO_PIECE below
# W9: 4,096 (1.55 GiB a rank): with 8,192 the 4 x 250k stress minimum fell under 8 GiB on the worker node (7.82)
GLM53_TF_PREFILL_ROWS_MAX=4096
GLM53_TF_FAST_PREFILL=1
GLM53_TF_LEAN_PREFILL=1
GLM53_TF_LEAN_BLOCK=512
GLM53_TF_PREFILL_OVERLAP=1
# W8: patches/0320 row split: hc_post / hc_pre on each rank's half of every 512-row sub-block (same bits, +7-8% prefill)
GLM53_TF_PREFILL_PP=1
GLM53_TF_FAST_GATHER=bf16
GLM53_TF_FP8_PREFILL=0
# W5 (docs/RESULTS.md): fat stays; 0270 auto / fast2 are 2-5% slower end to end at 2,048-row chunks despite faster kernels
GLM53_TF_FAST_EXPERTS=fat
# patches/0190: parallel MoE grouping + in-place combine (same bits). W1 (docs/RESULTS.md): 32-query latent tiles
# in fast chunks (same bits, +5% prefill) and the MTP head's prefill rows as cache writes only (same bits, +5%);
# together +11% at 24.5k / 98k, decode and memory unchanged. mtp_window stays off (a no-op in batch pieces; zeroed
# head rows cost MTP acceptance in single-stream mode, Z2).
GLM53_TF_MOE_GLUE=5
GLM53_TF_ATTN_BM32=1
GLM53_TF_MTP_PREFILL_CACHE=1
GLM53_TF_EXPERT_LOOP=1
GLM53_TF_EXPERT_LOOP_CFG=4,2
GLM53_TF_CALIB=cached
GLM53_TF_CALIB_ONLINE=1
GLM53_TF_DEPTH=cost
GLM53_TF_LOOKUP=1
GLM53_TF_AUTO_FDRAFTS=7
GLM53_TF_PROFILE=0

# W9: patches/0230 + 0350: model all-gathers up to 256 KiB a rank over RoCE (both CX7 functions), control exchanges on
# NCCL; a run-time RoCE failure writes the marker and the next start of both ranks uses NCCL (delete it to retry)
GLM53_TF_COMM_BACKEND=roce
GLM53_TF_ROCE_MARK=/cache/roce-failed
# W9: patches/0360: b12x bit 4 = one-pass sparse latent attention in fast prefill chunks (FP8 KV; own snapshot tag)
GLM53_TF_B12X=4
# W10: patches/0390: latent absorb / expand v2 kernels (same bits as v1; 4-warp tiles from the W10 sweep)
GLM53_TF_MLA_EXPAND=v2
# W10: patches/0370: decode-round host work off the critical path (sync, emit, plan rider, 500 us GIL switch); both ranks
GLM53_TF_DECODE_OVERLAP=1
# W10: patches/0380: verify windows of up to 16 rows (drafts past the 8th only when confident; edit / copy streams)
GLM53_TF_MAX_DRAFT_ROWS=16
# W12: patches/0460: the next kernels' weights prefetched into L2 during decode's latency-bound windows (sites a, f, o),
# every decode path incl. the batcher's; 8 MiB a site (4 MiB: +0.8% only); reads only, same bits (1 stream +2.4%)
GLM53_TF_L2PF=1
GLM53_TF_L2PF_MB=8

# --- batching (0120 / 0200) ----------------------------------------------------------
GLM53_TF_BATCH=4
GLM53_TF_BATCH_PIECE=2048
# W8: patches/0335: a fast prompt alone in the batch prefills in 8,192-token pieces (+6% prefill; a newcomer waits up to
# one ~5.5 s piece); back to 2,048 at the next piece once another request is admitted
# W9: 4,096 (see PREFILL_ROWS_MAX)
GLM53_TF_SOLO_PIECE=4096
GLM53_TF_BATCH_RESERVE_GB=11
GLM53_TF_BATCH_ADMIT_GB=2
# W12: 8 (was 3): 4-slot graph keys rarely repeat and a capture costs a forward (W11); lone requests keep their graphs
GLM53_TF_BATCH_CAPTURE_AFTER=8
GLM53_TF_BATCH_PARITY_KEY=1
GLM53_TF_BATCH_MTP=1
GLM53_TF_BATCH_ROW_MS=6.5
GLM53_TF_BATCH_SHORT=1024

# --- sessions (0110, in batch slots with 0180) -----------------------------------------
GLM53_TF_BATCH_SESSIONS=1
GLM53_TF_SESSION_GIB=2
GLM53_TF_SESSION_RESERVE_GIB=6
# patches/0250: the store's NVMe tier at /sessions (W4 2026-09-28: 6 x 39k sessions on 4 slots + 2 GiB RAM resumed in
# 0.42-0.45 s with 38,912 cached, also after a restart; same reply hashes; exact 10/10; results/W4)
GLM53_TF_SESSION_DISK=/sessions
GLM53_TF_SESSION_DISK_GIB=64
# patches/0290 shared KV pool (W6): pages of 256 tokens; a request reserves prompt + max_tokens + 64 at admission,
# idle slots spill to the session store when short, else it waits
GLM53_TF_KV_POOL_TOKENS=1048576
# W8: patches/0310: a snapshot at the end of the system prompt (2k-131k tokens, <= 4 kept in RAM), admissions wait for
# a partner's mark (a 4-session burst over a 20k system prompt: 24.8 s wall instead of 72 s; resumed == fresh)
GLM53_TF_PREFIX_SHARE=1
# W8: patches/0300: one JSON line a request (no text; hashes only), rank 0; scripts/traffic-report.py reads it
GLM53_TF_REQUEST_LOG=/sessions/requests.jsonl

# Reasoning effort (patches/0150): default high for thinking requests that name none; honour OpenAI top-level
# reasoning_effort (none/minimal = thinking off, low, medium->high, high, max).
GLM53_TF_DEFAULT_EFFORT=high
GLM53_TF_EFFORT_FIELD=1

# W15: patches/0500 image input (OpenAI image_url parts, data: and http(s) URLs fetched by rank 0; the BF16 vision tower
# on rank 0, 1.13 GB); row and preprocessed-image caches at 64 MB each (docs/VISION.md: stress sizing). http(s) URLs are
# fetched from the head node's network: set GLM53_TF_VISION_FETCH=0 to accept data: URLs only (docs/VISION.md).
GLM53_TF_VISION=1
GLM53_TF_VISION_CACHE_MB=64
GLM53_TF_VISION_PREP_MB=64
# W15: reasoning in delta.reasoning / message.reasoning only (what the vLLM kit sends; RigMark counted "both" twice).
# Clients that read only reasoning_content: GLM53_TF_REASONING_FIELDS=both
GLM53_TF_REASONING_FIELDS=reasoning
