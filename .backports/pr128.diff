+def test_dense_pass_in_row_blocks_keeps_the_bits(P, R):
+    """A prompt chunk's dense pass in PROMPT_ATT_ROWS-row blocks (forward.dense_attention, the partials holding one
+    block) against one latent.attention call over all its rows (the partials holding the chunk), bitwise."""
+    from tensorfold.families.glm5_next.cuda import forward, latent
+
